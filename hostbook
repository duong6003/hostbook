# CLI luôn dùng bản một dòng, độc lập với kiểu người dùng đang chọn.
search_hosts(){ cmd_list compact | grep '^h:' | fzf --filter "$*" --delimiter="$TAB" --with-nth=2.. --accept-nth=1 | sed 's/^h://'; }
fzf_opts(){ # mỗi dòng một tham số để đưa vào mảng bash, không eval
  local border preview
