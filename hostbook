        for (i=1;i<=np;i++) { p=po[i]; if (!(p in used) && PS[p]>bv) { bv=PS[p]; best=p } }
        if (best=="") break; used[best]=1
        if (r==1) { top=best; topv=bv } else if (r==2) second=bv
        why=""; c=0
        for (w=55; w>=10 && c<3; w-=5) for (j=1;j<=nl && c<3;j++) { l=LO[j]; if (LW[l]==w && ((best SUBSEP l) in LC)) { why=why (why==""?"":" · ") sprintf(sg_cnt, l, LC[best SUBSEP l]); c++ } }
        printf "project\t%s\t%d\t%s\t%s\n", best, bv, dots(bv), why }
      print "auto\t" ((top!="" && topv>=80 && topv-second>=30) ? 1 : 0)
      bp=""; bs=59.999; for (i=1;i<=N;i++) if (S[nm[i]]>bs) { bs=S[nm[i]]; bp=nm[i] }
      if (bp!="") { why=L[bp]; gsub(/\|/," · ",why); printf "peer\t%s\t%d\t%s\n", bp, bs, why }
      G=(force!="") ? force : top
      print "group\t" G
      ba=""; bv=14.999; for (i=1;i<=N;i++) if (AD[nm[i]]>bv) { bv=AD[nm[i]]; ba=nm[i] }
      if (ba!="" && pfx(ba)!="") { why=L[ba]; sub(/\|.*/,"",why); printf "field\tprefix\t%s\t%s\n", pfx(ba), why }
      print "field\tport\t" (port==""?"22":port) "\t"
      ng=0; for (i=1;i<=N;i++) if (P[nm[i]]==G) { n=nm[i]; ng++; UW[U[n]]+=S[n]+1; if (!(U[n] in useen)) { useen[U[n]]=1; uo[++nu]=U[n] } }
      if (user!="") print "field\tuser\t" user "\t"
      else { bu=""; bv=0; for (i=1;i<=nu;i++) if (UW[uo[i]]>bv) { bv=UW[uo[i]]; bu=uo[i] }
        if (bu!="") print "field\tuser\t" bu "\t" sprintf(sg_like, G); else print "field\tuser\t" me "\t" sg_me }
      cu=(user!="") ? user : bu
      if (G=="" || ng==0) exit
