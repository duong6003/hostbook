    [0-9]*) printf ${2:+-v "$2"} '\033[38;5;%sm' "$c";;
    *) case $c in bright-*) n=90; c=${c#bright-};; esac
       case $c in black) ;; red) n=$((n+1));; green) n=$((n+2));; yellow) n=$((n+3));; blue) n=$((n+4));; magenta) n=$((n+5));; cyan) n=$((n+6));; white) n=$((n+7));; esac
