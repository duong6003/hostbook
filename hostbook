parse_addr(){ # "user@host:port" → print user, host, and port on three lines
  local s=$1 u="" p=""
  case $s in *@*) u=${s%%@*}; s=${s#*@};; esac
  case $s in *:*) p=${s##*:}; s=${s%:*};; esac
  case $s in ""|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0-9._-]*) return 1;; esac
  case $u in *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0-9._-]*) return 1;; esac
  case $p in ""|[0-9]|[0-9][0-9]|[0-9][0-9][0-9]|[0-9][0-9][0-9][0-9]|[0-9][0-9][0-9][0-9][0-9]) ;; *) return 1;; esac
  printf '%s\n%s\n%s\n' "$u" "$s" "$p"
