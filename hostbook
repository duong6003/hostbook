    e=l; for (i=l+1;i<=NR;i++) { if (tolower(line[i]) ~ /^[ \t]*(host|match)[ \t]/) break; e=i }
    # trailing blank lines and comments belong to the next block (tags/desc/secret for the next server)
    while (e>l && (line[e] ~ /^[ \t]*$/ || line[e] ~ /^[ \t]*#/)) e--; print s, e }' "$f"; }
host_shared(){ local f l; f=$(host_field "$1" 10); l=$(host_field "$1" 11); [ "$(awk -v l="$l" 'NR==l{print NF-1; exit}' "$f")" -gt 1 ]; }
jump_users(){ awk -F'\t' -v n="$1" '{ m=split($6,a,","); for (i=1;i<=m;i++) if (a[i]==n) print $1 }' "$IDX" | tr '\n' ' '; }
groups_rename(){ # old [new]: rename or remove a server in every group; remove groups left with no servers
  legacy_destinations "$GRP" "$GRP.tmp" || return 65
  [ -f "$GRP" ] || return 0
  awk -F'\t' -v OFS='\t' -v o="$1" -v n="${2:-}" '{sub(/\r$/,"")} { m=split($3,a," "); out=""; for (i=1;i<=m;i++) { h=(a[i]==o?n:a[i]); if (h!="") out=out (out==""?"":" ") h } $3=out; if (out!="") print }' "$GRP" > "$GRP.tmp" && mv "$GRP.tmp" "$GRP"
}
delete_host_raw(){ # name [keep-groups]
  legacy_destinations "$DIR"/*.conf "$GRP.tmp" || return 65
  local n=$1 f l r
  f=$(host_field "$n" 10); l=$(host_field "$n" 11)
  legacy_destinations "$f" "$f.tmp" || return 65
  if host_shared "$n"; then
    awk -v l="$l" -v n="$n" 'NR==l { out=$1; for (i=2;i<=NF;i++) if ($i!=n) out=out " " $i; print out; next } { print }' "$f" > "$f.tmp" || return 1
  else r=$(block_range "$n")
    awk -v s="${r% *}" -v e="${r#* }" 'NR>=s && NR<=e { next } { if ($0 ~ /^[ \t]*$/ && prevblank) next; prevblank=($0 ~ /^[ \t]*$/); print }' "$f" > "$f.tmp" || return 1
  fi
  mv "$f.tmp" "$f" || return 1
  if ! grep -q '[^[:space:]]' "$f"; then rm -f "$f" || return 1; fi   # remove files containing only blank lines
  [ -n "${2:-}" ] || groups_rename "$n"
}
rename_host_raw(){ # old new: rename in the Host line, other servers ProxyJump entries, groups, and history
  legacy_destinations "$DIR"/*.conf "$GRP.tmp" "$HIST.tmp" || return 65
  local o=$1 n=$2 f l c
  f=$(host_field "$o" 10); l=$(host_field "$o" 11)
  legacy_destinations "$f" "$f.tmp" || return 65
  awk -v l="$l" -v o="$o" -v n="$n" 'NR==l { for (i=2;i<=NF;i++) if ($i==o) $i=n } { print }' "$f" > "$f.tmp" && mv "$f.tmp" "$f" || return 1
  for c in "$DIR"/*.conf; do
    awk -v o="$o" -v n="$n" 'tolower($1)=="proxyjump" { m=split($2,a,","); v=""; for (i=1;i<=m;i++) v=v (i>1?",":"") (a[i]==o?n:a[i]); match($0,/^[ \t]*/); print substr($0,1,RLENGTH) $1 " " v; next } { print }' "$c" > "$c.tmp" || return 1
