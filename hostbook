          for l in age meta pub; do g checkout -q "--$side" -- "secrets/$sn.$l" 2>/dev/null; g add -A -- "secrets/$sn.$l" 2>/dev/null; done;; esac;; esac; done
      while :; do
        for f in $(g diff --name-only --diff-filter=U | grep -v '^secrets/'); do l=$(grep -n '^<<<<<<<' "$DIR/$f" | head -1 | cut -d: -f1); $ed "+${l:-1}" "$DIR/$f"; done
        if grep -l '^<<<<<<<\|^>>>>>>>' "$DIR"/*.conf "$GRP" >/dev/null 2>&1; then warn "$(t rc_markers)"
        elif ! e=$(validate); then warn "$(t rc_cfg_bad "$(printf '%s' "$e" | head -1)")"
        else g add -A; g commit -qm "Gộp với kho" >/dev/null; break; fi
        confirm "$(t rc_again)" || { g merge --abort; unlock; return 1; }
      done;;
  esac
  if ! e=$(validate); then g reset -q --hard ORIG_HEAD 2>/dev/null; unlock; err "$(t rc_undone "$e")"; return 1; fi
  if ! g push -q 2>/dev/null; then
    ahead=$(g rev-list --count '@{u}..HEAD'); set_status pending "$ahead"
    unlock; build_index; flash "${CY}${ICON_WARN} $(t rc_pending "$ahead")${C0}"; return 1
  fi
  set_status ok
  unlock; build_index; flash "${CG}${ICON_OK} $(t done_merged)${C0}"
}

# ---------- connection checks ----------
# One-line reason for a failed connection (a shorter explain, used when checking many servers).
classify_log(){ # name log
  local n=$1 f=$2 ip port j sc type
  ip=$(host_field "$n" 3); port=$(host_field "$n" 5); port=${port:-22}; j=$(host_field "$n" 6); sc=$(host_field "$n" 12); type=""; [ -n "$sc" ] && type=$(secret_meta "$sc" type)
  if grep -qiE 'IDENTIFICATION HAS CHANGED|Host key verification failed' "$f"; then t cl_hostkey
  elif grep -qi 'Permission denied' "$f"; then
    if [ "$type" = password ]; then t cl_pw_wrong "$sc"
    elif [ "$type" = key ]; then t cl_key_refused "$sc"
    else t cl_denied; fi
  elif grep -qi 'Could not resolve hostname' "$f"; then t cl_dns "$ip"
  elif grep -qi 'Connection refused' "$f"; then t cl_refused "$ip" "$port"
  elif grep -qiE 'No route to host|Network is unreachable|Host is down' "$f"; then t cl_unreach "$ip"
  elif grep -qiE 'timed out|hostbook: timeout' "$f"; then
    if [ -n "$j" ] && ! grep -q 'Authenticated to' "$f"; then t cl_jump_down "$j"
    elif [ -n "$j" ]; then t cl_jump_hop "$j" "$ip" "$port"
    else t cl_noresp "$ip" "$port"; fi
  elif grep -qiE 'Connection closed|Connection reset|kex_exchange_identification' "$f"; then t cl_closed
  else t cl_other "$(tr -d '\r' < "$f" | grep -vE '^(debug[0-9]|OpenSSH_|Warning: Permanently)' | grep . | tail -1 | cut -c1-80)"; fi
  echo
}
check_one(){ # name directory → write <directory>/<name>.res = "ok|fail<TAB>reason". Log in and immediately exit without running server commands.
  local h=$1 d=$2 sc type pid i=0 rc
  sc=$(host_field "$h" 12); type=""; [ -n "$sc" ] && type=$(secret_meta "$sc" type)
  if [ "$type" = password ]; then   # BatchMode disables password authentication, so use askpass without prompting the user
    SSH_ASKPASS="$STATE/askpass" SSH_ASKPASS_REQUIRE=force HB_ASKPASS_NOTTY=1 HB_ASKPASS_HOST="$h" HB_ASKPASS_COUNT="$d/$h.cnt" \
      sshx -v -E "$d/$h.log" -o ConnectTimeout=5 -o NumberOfPasswordPrompts=1 -o StrictHostKeyChecking=accept-new "$h" true </dev/null >/dev/null 2>&1 & pid=$!
  else sshx -v -E "$d/$h.log" -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new "$h" true </dev/null >/dev/null 2>&1 & pid=$!; fi
  while kill -0 $pid 2>/dev/null && [ $i -lt 80 ]; do sleep 0.1; i=$((i+1)); done   # eight-second fallback deadline
  if kill -0 $pid 2>/dev/null; then kill $pid 2>/dev/null; echo "hostbook: timeout after 8s" >> "$d/$h.log"; rc=124; else wait $pid; rc=$?; fi
  if [ $rc -eq 0 ]; then printf 'ok\t%s\n' "$(if [ -n "$sc" ]; then t chk_ok_sc "$sc"; else t chk_ok; fi)" > "$d/$h.res"; else printf 'fail\t%s\n' "$(classify_log "$h" "$d/$h.log")" > "$d/$h.res"; fi
}
check_rec(){ printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$(date +%s)" >> "$4/run.tsv"; }   # name result reason dir; the epoch is the per-host check time
# Check servers by jump-host depth, eight in parallel per batch. Write results to $STATE/last-check.tsv.
check_run(){ # name… → results in $STATE/check/run.tsv; a progress line (elapsed / limit, ctrl-c) unless HB_PLAIN is set; status 130 after ctrl-c
  local d=$STATE/check all="$*" h j pending done_bad=" " batch n=0 total=$# lvl st why pids p k alive t0 stop= m
  [ -d "$d" ] && rm -rf "${d:?}"; mkdir -p "$d"; : > "$d/run.tsv"
  prepare_login "$@" || return 1
  [ -f "$STATE/askpass" ] || { printf '#!/bin/sh\nexec %s _askpass "$@"\n' "$(printf %q "$SELF")" > "$STATE/askpass"; chmod 700 "$STATE/askpass"; }
  PROG_COLS=$(term_cols); trap 'stop=1' INT   # ctrl-c stops the check and returns to hostbook
  pending=" $all "
  while [ -n "${pending// /}" ] && [ -z "$stop" ]; do
    lvl=""
    for h in $pending; do j=$(host_field "$h" 6 | cut -d, -f1)
      case $done_bad in *" $j "*) [ -n "$j" ] && { check_rec "$h" skip "$(t chk_skip "$j")" "$d"; done_bad="$done_bad$h "; pending=${pending/ $h / }; n=$((n+1)); continue; };; esac
      case " $pending " in *" $j "*) [ -n "$j" ] && continue;; esac   # jump host still awaiting a check: defer this server to the next batch
      lvl="$lvl $h"; done
    [ -n "$lvl" ] || break
    set -- $lvl
    while [ $# -gt 0 ] && [ -z "$stop" ]; do
      batch=""; pids=""; t0=$SECONDS; k=0
      for h in "$1" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" "${7:-}" "${8:-}"; do [ -n "$h" ] && { batch="$batch $h"; check_one "$h" "$d" & pids="$pids $!"; }; done
      while :; do   # tick while the batch runs: one line with the count, the batch's 8-second limit and ctrl-c
        alive=; for p in $pids; do if kill -0 "$p" 2>/dev/null; then alive=1; break; fi; done
        [ -n "$alive" ] && [ -z "$stop" ] || break
        if [ -z "${HB_PLAIN:-}" ]; then tv m chk_running "$n" "$total"; prog_line "$m" $(( SECONDS - t0 )) 8 "$k"; fi
        k=$((k+1)); sleep 0.2; done
      if [ -n "$stop" ]; then printf '\r\033[K' >&2; fi
      { [ -z "$stop" ] || kill_tree $pids; wait; } 2>/dev/null   # bash reports killed jobs on stderr: keep that out of the screen
      [ -z "$stop" ] || break
      for h in $batch; do IFS="$TAB" read -r st why < "$d/$h.res"; check_rec "$h" "$st" "$why" "$d"; n=$((n+1)); pending=${pending/ $h / }
        [ "$st" = ok ] || done_bad="$done_bad$h "; done
      shift $(( $# < 8 ? $# : 8 ))
    done
  done
  trap - INT; [ -z "${HB_PLAIN:-}" ] && printf '\r\033[K' >&2
  # last-check.tsv keeps the latest result of every host: replace only the rows of hosts checked now
  { [ -f "$STATE/last-check.tsv" ] && awk -F'\t' 'NR==FNR{r[$1]=1; next} !($1 in r)' "$d/run.tsv" "$STATE/last-check.tsv"; cat "$d/run.tsv"; } > "$STATE/last-check.tsv.new" && mv "$STATE/last-check.tsv.new" "$STATE/last-check.tsv"
  [ -z "$stop" ] || return 130
  return 0
}
check_hosts(){ # name…
  local nok nbad h rows sum lines cap rc i items=() names=() why redo=1
  rows=$STATE/check/run.tsv
  at "$(t chk_title "$#")" "$([ $# -eq 1 ] && echo "$1")"
  [ $# -gt 30 ] && { ui_confirm --affirmative "$(t chk_yes)" --negative "$(t cancel)" "$(t chk_many_q "$#")" "$CD$(t chk_many_how)$C0" || return 0; }
  while :; do
    if [ -n "$redo" ]; then   # not after "Show error details": the results are still the ones on screen
      clear; title "$UI_AT"; dimw "$(t chk_intro)"; echo
      check_run "$@"; rc=$?
      [ $rc = 130 ] && { flash "${CD}$(t chk_cancelled)${C0}"; dim "$(t chk_cancelled)"; return 130; }
      [ $rc = 0 ] || { pause; return 1; }
    fi
    redo=1
    nok=$(awk -F'\t' '$2=="ok"' "$rows" | grep -c .); nbad=$(awk -F'\t' '$2!="ok"' "$rows" | grep -c .)
    if [ "$nbad" -eq 0 ]; then   # nothing to decide: say it where the user is going next
      if [ "$nok" -eq 1 ]; then flash "${CG}${ICON_OK} $(t done_check_ok "$(cut -f1 "$rows")" "$(cut -f3 "$rows")")${C0}"; else flash "${CG}${ICON_OK} $(t done_check_all "$nok")${C0}"; fi
      return 0; fi
    cap=$(( $(term_rows) - 20 )); [ $cap -ge 3 ] || cap=3
    sum="$CG${ICON_OK} $(t chk_sum_ok "$nok")$C0 · $CR${ICON_ERR} $(t chk_sum_bad "$nbad")$C0"
    lines=$(awk -F'\t' -v g="$CG$ICON_OK$C0" -v r="$CR$ICON_ERR$C0" -v d="$CD" -v z="$C0" -v max="$cap" -v more="$(t chk_more)" '
      { st[NR] = $2; nm[NR] = $1; why[NR] = $3 }
      END { for (pass = 1; pass <= 2; pass++) for (i = 1; i <= NR; i++) {
              if ((pass == 1) == (st[i] == "ok")) continue
              if (shown >= max) { rest++; continue }
              shown++
              if (st[i] == "ok") printf "  %s %s  %s%s%s\n", g, nm[i], d, why[i], z
              else if (st[i] == "skip") printf "  %s·%s %s  %s%s%s\n", d, z, nm[i], d, why[i], z
              else printf "  %s %s  %s\n", r, nm[i], why[i] }
            if (rest) { printf "%s  ", d; printf more, rest; printf "%s\n", z } }' "$rows")
    i=$(UI_HEAD="$sum$NL $NL$lines" ui_menu "$(t chk_next)" "$(t act_chk_retry)" "$(t act_chk_details)" "$(t act_chk_done)") || i=2
    case $i in
      0) set -- $(awk -F'\t' '$2!="ok"{print $1}' "$rows");;
      1) items=(); names=()
         while IFS="$TAB" read -r h why; do items+=("$h|$why"); names+=("$h"); done < <(awk -F'\t' '$2=="fail"{print $1 "\t" $3}' "$rows")
         if [ ${#names[@]} -gt 0 ] && i=$(ui_menu "$(t chk_which)" "${items[@]}"); then
           h=${names[$i]}; at "$(t chk_title "$#")|$h" "$h"; clear; title "$UI_AT"; explain "$h" "$STATE/check/$h.log" pane; pause
           at "$(t chk_title "$#")" "$([ $# -eq 1 ] && echo "$1")"; redo=; fi;;
      *) return 0;;
    esac
  done
}

