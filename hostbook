cmd_demo(){ # fixed sample data; no network checks or changes to real configuration
  local arg=${1:-preset=cards} d key value cols border preview width left right body rendered record rule style sep theme IDX
  d=$(tmpd) || return 1; IDX=$d/index
  key=${arg%%=*}; value=${arg#*=}
  if [ "$key" = preset ]; then PRESET_SET=cfg_mem apply_preset "$value" || return 1; else cfg_mem "$key" "$value" || return 1; fi
  apply_theme
  demo_rows | awk -F'\t' '$1~/^h:/ {print $2 "\t" $3}' > "$IDX"
  cols=${FZF_PREVIEW_COLUMNS:-80}; [[ $cols =~ ^[0-9]+$ ]] || cols=80; [ "$cols" -ge 20 ] || cols=20
  cfg border rounded border; cfg preview right preview; cfg list cards style; cfg separator on sep; cfg theme hostbook theme; width=$((cols - 6))
  if [ "$preview" = right ] && [ $((cols * 38 / 100)) -ge 36 ]; then width=$((cols * 60 / 100 - 6)); fi
  demo_rows | list_rows "$style" "$width" > "$d/rows"
  if [ "$style" = cards ]; then
    rule=$(printf '%*s' "$width" '' | tr ' ' '-')
    rendered=$(while IFS= read -r -d '' record; do
      record=${record#*"$TAB"}; printf '%s\n' "${record%"$TAB"*}"
      [ "$sep" != on ] || printf '%s%s%s\n' "$CD" "$rule" "$C0"
    done < "$d/rows")
  else rendered=$(cut -f2 "$d/rows"); fi
  left=$(printf '%sTìm > booking%s\n\n%s\n\n%senter ssh · tab chọn · ^t đổi kiểu%s' "$CP" "$C0" "$rendered" "$CD" "$C0")
  right=$(printf '%sbooking-api  %sprod%s\n10.0.1.11 · @ubuntu\nĐăng nhập: key-prod\nLần dùng: 2 giờ trước' "$CU$CB" "$CR" "$C0")
  local split=0; [ "$preview" = right ] && [ $((cols * 38 / 100)) -ge 36 ] && split=1
  if [ $split = 0 ]; then
    if [ "$preview" = bottom ]; then left=$(printf '%s\n\n%sChi tiết%s\n%s' "$left" "$CU" "$C0" "$right"); fi
    right=
  fi
  printf '%s%s · %s · %s%s\n' "$CU" "$style" "$theme" "$preview" "$C0"
  # Piped output (fzf preview) makes gum drop all colour, so a single awk draws the same plain box instead of three gum
  # processes. A tty or any line wider than its column (gum would wrap it) falls back to gum.
  if [ ! -t 1 ] && demo_box "$left" "$right" "$((width + 2))" "$((cols - width - 8))" "$((cols - 2))" "$border"; then return 0; fi
  if [ $split = 1 ]; then
    body=$(gum join --horizontal --align top "$(gum style --width "$((width + 2))" "$left")" "$(gum style --width "$((cols - width - 8))" "$right")")
  else body=$left; fi
  case $border in sharp) border=normal;; bold) border=thick;; esac
  gum style --border "$border" --border-foreground "$(gum_color "$TH_BORDER")" --width "$((cols - 2))" "$body"
}
demo_box(){ # left right wl wr total border; plain box like "gum join | gum style --border"; status 1 when a line would wrap
  L=$1 R=$2 LC_ALL=C awk -v wl="$3" -v wr="$4" -v tw="$5" -v border="$6" '
    function vlen(s){gsub(/\033\[[0-9;]*m/,"",s); gsub(/[\200-\277]/,"",s); return length(s)}
    function strip(s){gsub(/\033\[[0-9;]*m/,"",s); return s}
    function sp(n, o){o=sprintf("%" (n>0?n:1) "s",""); return n>0?o:""}
    function pad(s,w){if(vlen(s)>w)bad=1; return s sp(w-vlen(s))}
    BEGIN {
      nl=split(ENVIRON["L"],l,"\n"); nr=(ENVIRON["R"]=="")?0:split(ENVIRON["R"],r,"\n"); n=nl>nr?nl:nr
      for(i=1;i<=n;i++) line[i]=nr?pad(strip(l[i]),wl) pad(strip(r[i]),wr):strip(l[i])
      if(border=="none"){for(i=1;i<=n;i++)out=out pad(line[i],tw) "\n"; if(bad)exit 1; printf "%s",out; exit}
      if(border=="sharp"){tl="┌";tr="┐";bl="└";br="┘";h="─";v="│"}
      else if(border=="bold"){tl="┏";tr="┓";bl="┗";br="┛";h="━";v="┃"}
      else if(border=="double"){tl="╔";tr="╗";bl="╚";br="╝";h="═";v="║"}
      else {tl="╭";tr="╮";bl="╰";br="╯";h="─";v="│"}
      rule=sp(tw-2); gsub(/ /,h,rule)
      out=tl rule tr "\n"
      for(i=1;i<=n;i++)out=out v pad(line[i],tw-2) v "\n"
      if(bad)exit 1; printf "%s%s\n",out,bl rule br
    }'
}

# ---------- main screen ----------
home(){
  local q=${1:-} out rc key sel first t n hosts opt opts=() fd foot ft
  # fzf control-port token: only child processes of this invocation may send commands
  FZF_API_KEY=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n'); [ ${#FZF_API_KEY} -eq 32 ] || { err 'Không tạo được khoá cho ô tìm'; return 1; }; export FZF_API_KEY
  clip_offer
  fd=$(tmpd) || return 1
  # Runs in $SHELL on every focus/multi event, after "t={1};": POSIX only, builtins only (no hostbook boot; #1).
  foot="c=\${FZF_SELECT_COUNT:-0}
    if [ \"\$c\" -gt 0 ]; then n=\${#c}; [ \$n -lt 4 ] || n=4; IFS= read -r f < $(printf %q "$fd")/f-m\$n; printf \"\$f\\n\" \"\$c\"
    else case \$t in [hgs]:*) n=\${t%%:*};; *) n=x;; esac; IFS= read -r f < $(printf %q "$fd")/f-\$n; printf '%s\n' \"\$f\"; fi"
  fwrite="t={1}; [ -z \"\$t\" ] || printf '%s\n' \"\$t\" > $(printf %q "$STATE/current"); "
  while :; do
    [ -n "${ONLY_NEXT:-}" ] && { export HOSTBOOK_ONLY=$ONLY_NEXT; ONLY_NEXT=""; q=""; }
    ADDED=""; rm -f "$STATE/current" "$STATE/share-request"
    cmd_footers "$fd"; IFS= read -r ft < "$fd/f-x"
    # After a resize: same footer for the current row. Read-only on purpose: only the focus bind writes current, since a
    # write-back here could put a stale row there while focus moves, and → / ^e would open the wrong server.
    printf 'IFS= read -r t < %q 2>/dev/null || t=\n%s\n' "$STATE/current" "$foot" > "$fd/foot"; write_relayout "$fd"
    opts=(); while IFS= read -r opt; do opts+=("$opt"); done < <(fzf_opts "$fd")
    out=$(cmd_list | fzf "${opts[@]}" --ansi --multi --layout=reverse --height=100% --no-separator \
      --delimiter="$TAB" --with-nth=2.. --accept-nth=1 --tiebreak=index --info=inline-right \
      --prompt='> ' --ghost='Tìm theo tên, #tag, @user, IP, mô tả…' --marker='+' \
      --header "$(cmd_header)" --footer "$ft" \
      --preview "$(self_cmd) _preview {1}" --gutter=' ' --ellipsis='' --no-hscroll \
      --bind "resize:$(relayout_actions "$fd")" \
      --listen --bind "start:execute-silent($(self_cmd) _bg_sync >/dev/null 2>&1 &)" \
      --bind 'tab:transform:case {1} in h:*) echo toggle+down;; *) echo down;; esac' \
      --bind "ctrl-y:execute-silent(touch $(printf %q "$STATE/share-request"))+transform:[ \"\${FZF_SELECT_COUNT:-0}\" -gt 0 ] && echo accept || echo select-all+accept" \
      --bind "focus:transform-footer:$fwrite$foot" --bind "multi:transform-footer:$fwrite$foot" \
      --bind 'esc:transform:if [ -n "$FZF_QUERY" ]; then echo clear-query; elif [ "${FZF_SELECT_COUNT:-0}" -gt 0 ]; then echo clear-selection; else echo abort; fi' \
      --expect='enter,ctrl-a,ctrl-e,ctrl-g,ctrl-o,ctrl-s,ctrl-t,right,?' --print-query --query "$q"); rc=$?
    if [ $rc -eq 130 ] && [ -n "${HOSTBOOK_ONLY:-}" ]; then unset HOSTBOOK_ONLY; q=""; continue; fi   # Esc in filtered mode: return to the full list
    [ $rc -eq 130 ] || [ $rc -eq 2 ] && return 0
    q=$(printf '%s\n' "$out" | sed -n 1p); key=$(printf '%s\n' "$out" | sed -n 2p); sel=$(printf '%s\n' "$out" | sed -n '3,$p')
    first=$(printf '%s\n' "$sel" | sed -n 1p)
    case $key in right|ctrl-e) [ -s "$STATE/current" ] && first=$(cat "$STATE/current");; esac
    t=${first%%:*}; n=${first#*:}
    hosts=$(printf '%s\n' "$sel" | sed -n 's/^h://p' | tr '\n' ' ')
    clear
    if [ -f "$STATE/share-request" ]; then   # ^y: share selected rows, or all matching rows
      rm -f "$STATE/share-request"
      set -- $hosts $(printf '%s\n' "$sel" | sed -n 's/^g://p' | while read -r n; do group_field "$n" 3; done)
      share_flow $(printf '%s\n' "$@" | awk '!s[$0]++'); continue
    fi
    case $key in
      ''|enter) set -- $hosts
         if [ $# -ge 2 ]; then open_many "" "$@"
         elif [ "$t" = h ]; then connect "$n"
         elif [ "$t" = g ]; then open_many "$n" $(group_field "$n" 3)
         elif [ "$t" = s ]; then attach "$n"; fi;;
      ctrl-a) add_host; [ -n "${ADDED:-}" ] && q=$ADDED;;
      ctrl-e) [ "$t" = h ] && edit_host "$n";;
      ctrl-g) set -- $hosts; if [ $# -ge 2 ]; then save_group "$@"; else flash "${CY}Chọn ít nhất 2 server bằng tab rồi nhấn ^g${C0}"; fi;;
      ctrl-o) SECRET_QUERY=""; tools; [ -n "${SECRET_QUERY:-}" ] && q=$SECRET_QUERY;;
      ctrl-t) if [ "$(cfg list cards)" = cards ]; then cfg_set list compact; else cfg_set list cards; fi;;
      ctrl-s) gum spin --title "Đang đồng bộ với kho" -- bash "$SELF" _sync_now;;
      right) set -- $hosts; if [ $# -ge 2 ]; then batch_actions "$@"; continue; fi
             case $t in h) host_actions "$n";; g) group_actions "$n";;
               s) confirm --default=false "Đóng hẳn phiên ${n#hb-}? Các kết nối trong đó sẽ bị ngắt." && tmux kill-session -t "$n" && flash "Đã đóng phiên ${n#hb-}";; esac;;
      '?') show_help;;
    esac
  done
}

# ---------- installation and version ----------
# Add a shortcut only if no command, alias, or function already uses the name. Query the user shell interactively
# to include aliases created by plugins (oh-my-zsh…), rather than checking PATH alone.
shortcut_free(){ local out; out=$("${SHELL:-/bin/sh}" -ic "type $1" </dev/null 2>/dev/null) || return 0
  case $out in *hostbook*) return 0;; esac; return 1; }
shortcut_name(){ grep -hoE '^alias (hb|hop)=hostbook$' "$HOME/.zshrc" "$HOME/.bashrc" 2>/dev/null | head -1 | sed 's/^alias //; s/=hostbook$//'; }
install_hint(){
  if is_windows; then printf "Cài lại từ PowerShell: powershell -NoProfile -ExecutionPolicy Bypass -File '%s'\n" "$(native_path "$(dirname "$SELF")/install.ps1" | sed "s/'/''/g")"
  else printf 'Cài lại: curl -fsSL %s/raw/main/install.sh | bash\n' "$REPO_URL"; fi
}
check_age(){ have age && have age-plugin-batchpass && have age-keygen || { err "Cần age >= $AGE_MIN cho kho secret" >&2; install_hint >&2; return 1; }; }
# A passing check is cached in $STATE/deps: line 1 is the key, the rest are the tool paths. It stays valid while PATH and
# the minimum versions are unchanged and the stamp is strictly newer than every tool binary and PATH directory (a tool
# added, removed or replaced changes one of them; equal times count as changed, as -nt may have 1 s precision) (#5).
deps_cached(){
  local s=$STATE/deps p
  [ -r "$s" ] || return 1
  { IFS= read -r p && [ "$p" = "$PATH|$FZF_MIN|$GUM_MIN|$AGE_MIN" ] || return 1
    while IFS= read -r p; do [ -x "$p" ] && [ "$s" -nt "$p" ] || return 1; done; } < "$s"   # -x: a symlink whose target is gone fails
  local IFS=:; for p in $PATH; do [ -z "$p" ] || [ "$s" -nt "$p" ] || return 1; done
  return 0
}
check_deps(){ # report: print each item; otherwise return 1 and print instructions if dependencies are missing
  local bad=0 v
  [ "${1:-}" = report ] || ! deps_cached || return 0
  have git || { err "Thiếu git"; bad=1; }
  if have age && have age-plugin-batchpass; then v=$(age --version | sed 's/^v//'); if ver_ge "$v" "$AGE_MIN"; then [ "${1:-}" = report ] && ok "age $v"; else err "age $v quá cũ, cần >= $AGE_MIN"; bad=1; fi
  else err "Thiếu age (kèm age-plugin-batchpass)"; bad=1; fi
  if have fzf; then v=$(fzf --version | awk '{print $1}')
    if ver_ge "$v" "$FZF_MIN"; then [ "${1:-}" = report ] && ok "fzf $v"; else err "fzf $v quá cũ, cần >= $FZF_MIN"; bad=1; fi
  else err "Thiếu fzf"; bad=1; fi
  if have gum; then v=$(gum --version | awk '{print $3}' | sed 's/^v//')
    if ver_ge "$v" "$GUM_MIN"; then [ "${1:-}" = report ] && ok "gum $v"; else err "gum $v quá cũ, cần >= $GUM_MIN"; bad=1; fi
  else err "Thiếu gum"; bad=1; fi
  [ $bad = 0 ] && { { printf '%s\n' "$PATH|$FZF_MIN|$GUM_MIN|$AGE_MIN"; type -P git age age-plugin-batchpass fzf gum; } 2>/dev/null > "$STATE/deps"; return 0; }
  [ "${1:-}" = report ] || dim "$(install_hint)"
  return 1
}
setup(){
  local rc_file
  title "Cài hostbook cho máy này"
  if is_windows; then ok "Lệnh hostbook: PowerShell / Windows Terminal"
  else mkdir -p "$HOME/.local/bin"; ln -sf "$SELF" "$HOME/.local/bin/hostbook"; ok "Lệnh hostbook: ~/.local/bin/hostbook"; fi
  mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
  if ! grep -qs "Include.*ssh-hosts" "$HOME/.ssh/config"; then
    [ -f "$HOME/.ssh/config" ] && cp "$HOME/.ssh/config" "$HOME/.ssh/config.bak"
    { echo "# Server list in ~/ssh-hosts (hostbook syncs it with the shared repository)"; echo "Include ~/ssh-hosts/*.conf"; echo; cat "$HOME/.ssh/config" 2>/dev/null || true; } > "$HOME/.ssh/config.new" && mv "$HOME/.ssh/config.new" "$HOME/.ssh/config"
    chmod 600 "$HOME/.ssh/config"; ok "Đã thêm Include vào ~/.ssh/config$( [ -f "$HOME/.ssh/config.bak" ] && echo ', bản cũ ở ~/.ssh/config.bak')"
  else ok "~/.ssh/config đã có Include"; fi
  if is_windows; then rc_file=""
  else case ${SHELL:-} in */zsh) rc_file=$HOME/.zshrc;; */bash) rc_file=$HOME/.bashrc;; *) rc_file="";; esac; fi
  if [ -n "$rc_file" ]; then
    # older versions used "s" (too generic and prone to collisions): remove it and switch to hb
    if grep -qsE '^alias s=(sshm|hostbook)$' "$rc_file"; then
      sed -i.bak -E '/^# (sshm|hostbook): tìm và kết nối server SSH$/d; /^alias s=(sshm|hostbook)$/d' "$rc_file" && rm -f "$rc_file.bak"; ok "Đã bỏ lối tắt cũ s"; fi
    if ! grep -qsE '^alias (hb|hop)=hostbook$' "$rc_file"; then
      local sc="" c
      for c in hb hop; do shortcut_free "$c" && { sc=$c; break; }; done
      if [ -n "$sc" ]; then printf '\n# hostbook: find and connect to SSH servers\nalias %s=hostbook\n' "$sc" >> "$rc_file"
        if [ "$sc" = hb ]; then ok "Lối tắt: hb"; else ok "hb đã được dùng cho việc khác trên máy này, lối tắt là hop"; fi
      else warn "hb và hop đều đã được dùng cho việc khác, không thêm lối tắt: gõ hostbook"; fi
    fi
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) grep -qs '.local/bin' "$rc_file" || { printf 'export PATH="$HOME/.local/bin:$PATH"\n' >> "$rc_file"; ok "Đã thêm ~/.local/bin vào PATH"; };; esac
  fi
  if [ -d /Applications/Ghostty.app ] || have ghostty; then
    mkdir -p "$HOME/.config/ghostty"
    grep -qs 'ssh-env' "$HOME/.config/ghostty/config" || { printf '# ssh-env: use TERM=xterm-256color for SSH so servers without Ghostty terminfo display correctly\nshell-integration-features = ssh-env\n' >> "$HOME/.config/ghostty/config"; ok "Đã bật ssh-env cho Ghostty"; }
  fi
  [ -d "$DIR" ] && { chmod 700 "$DIR"; build_index; ok "Sẵn sàng · $(wc -l < "$IDX" | tr -d ' ') server"; }
  return 0
}
update(){
  if is_windows; then
    git -C "$(native_path "$(dirname "$SELF")")" pull -q --ff-only || { err "Không tải được bản cập nhật hostbook"; return 1; }
    powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$(dirname "$SELF")/install.ps1")"
    return $?
  fi
  local d; d=$(dirname "$SELF")
  if [ -d "$d/.git" ]; then git -C "$d" pull -q --ff-only && ok "Đã cập nhật hostbook lên $("$SELF" --version)" || err "Không cập nhật được, thử: curl -fsSL $REPO_URL/raw/main/install.sh | bash"
  else dim "Bản này không cài bằng git. Cập nhật bằng: curl -fsSL $REPO_URL/raw/main/install.sh | bash"; fi
}
first_run(){ # ~/ssh-hosts does not exist yet
  local i m url n
  clear; box title "${CU}${CB}Chào mừng đến hostbook${C0}" "Máy này chưa có danh sách server."; echo
  i=$(pick "Bắt đầu thế nào?" "Dùng kho ở máy khác|lấy danh sách server về máy này" "Đây là máy đầu tiên|tạo danh sách ở máy này, kho để sau" "Tạo kho trên máy này|máy luôn bật, các máy khác đồng bộ với nó") || return 1
  case $i in
    0) m=$(pick_machine "Kho ở máy nào?" url) || return 1
       if is_url "$m"; then url=$m; else ensure_key "$m" || return 1; url="$m:repos/ssh-hosts.git"; fi
       GIT_SSH_COMMAND=$(git_ssh 8) gum spin --title "Lấy danh sách từ kho" -- git clone -q "$url" "$(native_path "$DIR")" || { err "Không lấy được kho từ $url"; return 1; };;
    *) private_dir "$DIR" || return 1; git -C "$(native_path "$DIR")" init -q
       ensure_git_identity || return 1
       printf '*\n!*.conf\n!.gitignore\n!.gitattributes\n!groups.tsv\n!secrets/\n!secrets/*.age\n!secrets/*.pub\n!secrets/*.meta\n' > "$DIR/.gitignore"
       if [ -f "$HOME/.ssh/config" ] && grep -qiE '^[[:space:]]*host[[:space:]]+[^*]' "$HOME/.ssh/config" && confirm "Nhập các server đang có trong ~/.ssh/config?"; then
         cp "$HOME/.ssh/config" "$HOME/.ssh/config.bak"
         n=$(split_config "$HOME/.ssh/config.bak" "$DIR" "$HOME/.ssh/config")
         ok "Đã chuyển $n khối Host sang ~/ssh-hosts, chia dự án theo phần đầu tên (bản cũ ở ~/.ssh/config.bak)"
         dim "Khối Host * và Match vẫn để trong ~/.ssh/config vì chúng là cấu hình riêng của máy này."
       fi
       g add -A && g commit -qm "Tạo danh sách" >/dev/null;;
  esac
  chmod 700 "$DIR"; ensure_merge_setup
  setup
  [ "$i" = 2 ] && make_kho_here
  [ "$i" = 1 ] && confirm --negative "Để sau" "Kết nối kho ngay để sao lưu và dùng trên nhiều máy?" && connect_kho
  cfg_set list cards
  local pos=1; case ${COLORFGBG:-} in 7|15|*\;7|*\;15) pos=6;; esac
  setting_pick preset "Chọn giao diện · đổi lại trong Công cụ → Giao diện" "$pos" || :
  pause "enter để bắt đầu"
}

