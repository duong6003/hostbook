share_password(){ # four words + two digits, e.g. cam-sao-bien-lua-73
  local w=($SHARE_WORDS) out="" i r
  for i in 1 2 3 4; do r=$(od -An -N2 -tu2 /dev/urandom | tr -d ' '); out="$out${w[$((r % ${#w[@]}))]}-"; done
  r=$(od -An -N2 -tu2 /dev/urandom | tr -d ' '); printf '%s%02d\n' "$out" $((r % 100))
}
# Custom option lines in a Host block (excluding lines hostbook can regenerate).
block_extras(){ # file Host-line
  awk -v l="$2" 'NR>l { if (tolower($1)=="host" || tolower($1)=="match") exit
      k=tolower($1); if ($0 ~ /^[ \t]*(#|$)/) next
      if (k=="hostname"||k=="user"||k=="port"||k=="proxyjump"||k=="identityfile"||k=="identitiesonly"||k=="pubkeyauthentication"||k=="preferredauthentications") next
      print }' "$1"
}
in_list(){ case " $2 " in *" $1 "*) return 0;; esac; return 1; }   # separate helper: Bash 3.2 cannot parse case inside $(...)
share_closure(){ # name… → print names, recursively including missing jump hosts
  local all=" $* " h j changed=1
  while [ -n "$changed" ]; do changed=""
    for h in $all; do for j in $(host_field "$h" 6 | tr ',' ' '); do host_exists "$j" || continue
      case $all in *" $j "*) ;; *) all="$all$j "; changed=1;; esac; done; done; done
  printf '%s\n' $all
}
# Build an unencrypted package directory. Flatten Host blocks to effective values independent of sender wildcard blocks.
share_build(){ # directory include-secrets(0|1) name…
  local out=$1 ws=$2 h sc p used=" " line n; shift 2
  mkdir -p "$out/conf"; [ "$ws" = 1 ] && mkdir -p "$out/secrets"
  for h in "$@"; do
    host_exists "$h" || continue
    sc=$(host_field "$h" 12); [ "$ws" = 1 ] && secret_exists "$sc" || sc=""
    p=$(host_field "$h" 2)
    { [ -s "$out/conf/$p.conf" ] && echo
      host_block "$h" "$(host_field "$h" 3)" "$(host_field "$h" 4)" "$(host_field "$h" 5)" "$(host_field "$h" 6)" "$sc" "$(host_field "$h" 8)" "$(host_field "$h" 9)" | awk '$1=="ProxyJump" && $2=="none" {next} {print}'
      block_extras "$(host_field "$h" 10)" "$(host_field "$h" 11)"; } >> "$out/conf/$p.conf"
    [ -n "$sc" ] && case $used in *" $sc "*) ;; *) used="$used$sc ";; esac
  done
  for sc in $used; do
    cp "$SEC/$sc.meta" "$out/secrets/$sc.meta"
    if [ "$(secret_meta "$sc" type)" = password ]; then secret_get "$sc" > "$out/secrets/$sc.pass" || return 1
    else secret_get "$sc" > "$out/secrets/$sc.key" || return 1; cp "$SEC/$sc.pub" "$out/secrets/$sc.pub"; fi
  done
  : > "$out/groups.tsv"
  [ -f "$GRP" ] && while IFS= read -r line; do [ -n "$line" ] || continue; group_line "$line"
    n=""; for h in $GH; do case " $* " in *" $h "*) n="$n${n:+ }$h";; esac; done
    [ "$(printf '%s\n' $n | grep -c .)" -ge 2 ] && printf '%s\t%s\t%s\n' "$GN" "$GM" "$n" >> "$out/groups.tsv"
  done < "$GRP"
  printf 'version=1\nfrom=%s\ndate=%s\nhosts=%s\nsecrets=%s\n' "$(hostname | cut -d. -f1)" "$(date +%FT%T)" "$#" "$(printf '%s\n' $used | grep -c .)" > "$out/manifest"
}
share_pack(){ # directory password → print the package
  printf '# hostbook-share v1 · %s server · từ %s\n' "$(sed -n 's/^hosts=//p' "$1/manifest")" "$(sed -n 's/^from=//p' "$1/manifest")"
  (set -o pipefail; tar -czf - -C "$1" . | age_pw_enc "$2")
}
share_flow(){ # name…
  local all extra d ws=1 pw pack f np ns i h head res note
  ensure_index
  all=$(share_closure "$@" | tr '\n' ' '); extra=$(for h in $all; do in_list "$h" "$*" || printf '%s ' "$h"; done)
  set -- $all; [ $# -gt 0 ] || { flash "${CY}${ICON_WARN} $(t share_none)${C0}"; return 1; }
  np=0; for h in "$@"; do is_prod "$h" && np=$((np+1)); done
  ns=$(for h in "$@"; do host_field "$h" 12; done | grep . | sort -u | tr '\n' ' ')
  at "$(t share_title)"
  head="$(t share_count "$#")$( [ -n "$ns" ] && t share_secrets_part "${ns% }")$( [ $np -gt 0 ] && printf "   %s${ICON_PROD} %s%s" "$CR" "$(t share_prod "$np")" "$C0")"
  for i in $(for h in "$@"; do host_field "$h" 2; done | sort -u); do head="$head$NL  $CU$i$C0  $(for h in "$@"; do [ "$(host_field "$h" 2)" = "$i" ] && printf '%s ' "$h"; done | cut -c1-90)"; done
  [ -n "$extra" ] && head="$head$NL$CD  $(t share_extra "${extra% }")$C0"
  if [ -n "$ns" ]; then case $(UI_HEAD=$head ui_menu "$(t share_how)" "$(t act_share_with)|$(t act_share_with_hint)" "$(t act_share_without)|$(t act_share_without_hint)") in 0) ws=1;; 1) ws=0;; *) return 1;; esac
  else ws=0; UI_HEAD=$head ui_confirm --affirmative "$(t share_yes)" --negative "$(t cancel)" "$(t share_q)" || return 1; fi
  d=$(tmpd) || return 1; d=$d/pack; share_build "$d" "$ws" "$@" || { flash "${CR}${ICON_ERR} $(t err_share_vault)${C0}"; return 1; }
  pw=$(share_password) && pack=$(share_pack "$d" "$pw") || { rm -rf "${d:?}"; err "$(t err_pack_bad)"; return 1; }; rm -rf "${d:?}"
  f=$(mktemp "$( [ -d "$HOME/Downloads" ] && echo "$HOME/Downloads" || echo "$HOME")/hostbook-$(date +%Y%m%d-%H%M)-XXXXXX") || return 1
  if ! (set -o noclobber; printf '%s\n' "$pack" > "$f.hbshare"); then rm -f "$f"; err "$(t err_share_write)"; return 1; fi
  rm -f "$f"; f=$f.hbshare
  chmod 600 "$f"
  res="$CG$ICON_OK$C0 $(t share_saved)$NL  ${f/#$HOME/~}"
  if printf '%s\n' "$pack" | copy 2>/dev/null; then res="$res$NL$CG$ICON_OK$C0 $(t share_copied "$(( ${#pack} / 1024 + 1 ))")"; fi
  # the password sits alone on an indented line, so selecting it copies nothing else
  head="$res$NL $NL$CB$(t share_pw_label)$C0$NL  $CG$CB$pw$C0$NL$CD$(t share_pw_note)$C0$NL$CD$(t share_recipient)$C0"; note=
  while :; do
    case $(UI_HEAD=$head${note:+$NL $NL$note} ui_menu "$(t share_next)" "$(t act_share_done)" "$(t act_share_copy_pw)|$(t act_share_copy_pw_hint)") in
      1) printf '%s' "$pw" | copy && note="$CG$ICON_OK$C0 $(t share_pw_copied)" || note="$CY$ICON_WARN$C0 $(t share_copy_fail)";;
      *) break;;
    esac
  done
  flash "${CG}${ICON_OK} $(t done_shared "$#")${C0}"
}

batch_actions(){ # name… (multiple servers selected)
  at "$(t batch_crumb "$#")"
  case $(ui_menu "$C0$CD$*" "#$(t sec_connect)" "$(t act_batch_open)" "$(t act_check)" "#$(t sec_other)" "$(t act_share_batch)" "$(t act_save_group)") in
    0) open_many "" "$@";; 1) check_hosts "$@";; 2) share_flow "$@";; 3) save_group "$@";;
  esac
}
# ---------- groups, multiple servers, and tmux ----------
suggest_group_base(){ # server… → "tags|name|none<TAB>base": the tags all servers share, else the leading words their names share
  ensure_index
  local out kind
  out=$(awk -F'\t' -v want=" $* " -v first="$1" '
    function norm(s) { s = tolower(s); sub(/[0-9]+$/, "", s); return s }
    index(want, " " $1 " ") { k++; names[k] = $1; m = split($8, a, " "); for (i = 1; i <= m; i++) c[a[i]]++ }
    $1 == first { order = $8 }
    END { m = split(order, a, " "); out = ""; used = 0; kind = "tags"
      for (i = 1; i <= m && used < 2; i++) if (c[a[i]] == k) { out = out (out == "" ? "" : "-") a[i]; used++ }
      if (out == "") { kind = "name"; com = split(names[1], t0, /[-._]/)
        for (j = 2; j <= k; j++) { nj = split(names[j], tj, /[-._]/); if (nj < com) com = nj
          for (i = 1; i <= com; i++) if (norm(t0[i]) != norm(tj[i])) { com = i - 1; break } }
        for (i = 1; i <= com; i++) { w = norm(t0[i]); if (w != "") out = out (out == "" ? "" : "-") w } }
      if (out == "") kind = "none"
      print kind "\t" out }' "$IDX")
  kind=${out%%"$TAB"*}; printf '%s\t%s\n' "$kind" "$(printf '%s' "${out#*"$TAB"}" | tr -cd 'a-z0-9-')"
}
suggest_group_name(){ # a name nobody uses yet, from suggest_group_base
  local b base n=2 name; b=$(suggest_group_base "$@"); base=${b#*"$TAB"}
  [ -n "$base" ] || tv base group_default; name=$base
  while [ -n "$(group_field "$name" 1)" ]; do name=$base-$n; n=$((n+1)); done
  echo "$name"
}
save_group(){
  legacy_destinations "$GRP.tmp" || return 65
  local hosts="$*" name d sug kind why prev
  at "$(t group_title)"; d=$(tmpd) || return 1; awk -F'\t' '{print $1}' "$GRP" > "$d/taken" 2>/dev/null
  kind=$(suggest_group_base "$@"); kind=${kind%%"$TAB"*}; sug=$(suggest_group_name "$@")
  case $kind in tags) why=$(t group_why_tags "$sug");; name) why=$(t group_why_name "$sug");; *) why=$(t group_why_none);; esac
  prev="$(t group_preview '%s' "$#")"$'\n'"$(printf '  • %s\n' "$@")"
  name=$(UI_TAKEN=err_group_taken ui_field "$(t group_label)" "$sug" "gname:$d/taken" "$(t group_rule)" "$prev" \
    "$(t group_intro "$#" "$hosts")"$'\n'"$CD$(t group_shared)$C0"$'\n'"$CD$why$C0") || return 1
  printf '%s\t\t%s\n' "$name" "$hosts" >> "$GRP"
  save_and_sync "$(t done_group_saved "$name")"
}
need_tmux(){
  local d
  at "$(t tmux_title)"
  have tmux && return 0
  if is_mac && have brew; then
    ui_confirm --affirmative "$(t tmux_yes)" --negative "$(t tmux_later)" "$(t tmux_need_q)" "$CD$(t tmux_need_how)$C0" || return 1
    d=$(tmpd) || return 1; clear; title "$UI_AT"; echo
    run_progress "$(t tmux_installing)" 300 "$d/out" brew install tmux && return 0
    shown; err "$(t err_tmux_install)"; tail -3 "$d/out" | sed 's/^/  /'; pause
  else clear; title "$UI_AT"; warn "$(t tmux_need)"; dimw "  $(t tmux_hint_install)"; pause; fi
  return 1
}
resume_without_sync(){ # session/window IDs from one list-windows snapshot
  local session=${1%% *} row_session window panes pane synchronized states
  [ -n "$session" ] || return 1
  while IFS=' ' read -r row_session window; do
    [ "$row_session" = "$session" ] && [ -n "$window" ] &&
      tmux set-window-option -t "$window" synchronize-panes off >/dev/null 2>&1 || return 1
  done <<< "$1"
  # A pane can override the window's synchronize-panes option.
  panes=$(tmux list-panes -s -t "$session" -F '#{pane_id} #{synchronize-panes}' 2>/dev/null) || return 1
  while IFS=' ' read -r pane synchronized; do
    case $synchronized in
      0) ;;
      1) tmux set-option -pu -t "$pane" synchronize-panes >/dev/null 2>&1 || return 1;;
      *) return 1;;
    esac
  done <<< "$panes"
  tmux set -t "$session" status-right " $(t tmux_hint "$2" "$2") " >/dev/null 2>&1 || return 1
  states=$(tmux list-panes -s -t "$session" -F '#{synchronize-panes}' 2>/dev/null) || return 1
  case ${states//$'\n'/} in ''|*[!0]*) return 1;; esac
  attach "$session"
}
open_many(){ # group-name-or-empty host...
  local grp=$1; shift
  local mode="" s session="" windows pfx synchronized=off hint h nprod=0 last ok_hosts="" missing="" sshcmd=ssh diagram d0 d1 d2
  need_tmux || return 1
  for h in "$@"; do if valid_name "$h" && host_exists "$h"; then ok_hosts="$ok_hosts $h"; else missing="$missing $h"; fi; done
  set -- $ok_hosts; [ $# -gt 0 ] || { flash "${CR}${ICON_ERR} $(t err_open_none)${C0}"; return 1; }
  [ -z "$missing" ] || flash "${CY}${ICON_WARN} $(t warn_open_missing "${missing# }")${C0}"
  [ -n "$grp" ] && mode=$(group_field "$grp" 2)
  if [ -z "$grp" ] && [ $# -eq 1 ]; then   # one server: skip the open-mode prompt; inside tmux, open a tab in the current session
    record "$1"; sshcmd=$(pane_cmd)
    if [ -n "${TMUX:-}" ]; then tmux new-window -n "$1" "$sshcmd $(printf %q "$1")"; return; fi
    mode=tabs
  fi
  if [ -z "$mode" ]; then
    last=$(cat "$STATE/lastmode" 2>/dev/null || :)
    case $last in sync) mode=2;; tabs) mode=3;; *) mode=1;; esac
    at "$(t open_title "$#")"
    printf -v d0 '%q' "[ 1 ][ 2 ]$NL[ 3 ][ 4 ]$NL$(t act_open_split_hint)"
    printf -v d1 '%q' "[ 1 ][ 2 ]$NL[ 3 ][ 4 ]$NL$(t act_open_sync_hint)"
    printf -v d2 '%q' "[ 1 | 2 | 3 ]$NL$(t act_open_tabs_hint)"
    diagram="case {1} in 0) printf '%s\\n' $d0;; 1) printf '%s\\n' $d1;; 2) printf '%s\\n' $d2;; esac"
    mode=$(UI_POS=$mode UI_HEAD="$CD$*$C0" UI_PREVIEW="$diagram" UI_PREVIEW_WINDOW='right,45%,wrap,<75(down,40%,wrap)' ui_choice "$(t open_how)$( [ -n "$grp" ] && echo " · $(t open_remember "$grp")")" "$(t act_open_split)" "$(t act_open_sync)" "$(t act_open_tabs)") || return 1
    case $mode in 0) mode=split;; 1) mode=sync;; *) mode=tabs;; esac
    echo "$mode" > "$STATE/lastmode"
    [ -n "$grp" ] && { set_group_mode "$grp" "$mode"; save_and_sync "$(t done_group_mode "$grp" "$(mode_label "$mode")")"; }
  fi
  # name group sessions after the group; temporary selections use the first server + count + set hash to distinguish different selections
  if [ -n "$grp" ]; then s="hb-$grp"; elif [ $# -eq 1 ]; then s="hb-$1"
  else s="hb-$1+$(( $# - 1 ))-$(printf '%s\n' "$@" | sort | cksum | cut -c1-4)"; fi
  s=$(printf '%s' "$s" | tr -c 'a-zA-Z0-9_+-' '-')
  pfx=$(tmux show -gv prefix 2>/dev/null | sed 's/^C-/^/'); pfx=${pfx:-^b}
  if windows=$(tmux list-windows -t "=$s" -F '#{session_id} #{window_id}' 2>/dev/null); then
    if [ "$mode" = sync ]; then flash "${CY}${ICON_WARN} $(t warn_open_sync_existing)${C0}"; return 1; fi
    resume_without_sync "$windows" "$pfx" || { flash "${CR}${ICON_ERR} $(t err_open_session)${C0}"; return 1; }
    return 0
  fi
  hint=$(t tmux_hint "$pfx" "$pfx")
  if [ "$mode" = sync ]; then
    for h in "$@"; do is_prod "$h" && nprod=$((nprod+1)); done
    if [ "$nprod" -gt 0 ]; then
      at "$(t open_title "$#")"; ui_confirm --default=false --affirmative "$(t open_prod_yes)" --negative "$(t cancel)" "$(t open_prod_q "$nprod")" "$CD$(t open_prod_detail)$C0" || return 1
    fi
    synchronized=on; hint=$(t tmux_hint_sync "$pfx")
  fi
  prepare_login "$@" || { pause; return 1; }   # unlock and load keys once here so panes do not prompt simultaneously
  record "$@"
  sshcmd=$(pane_cmd)
  for h in "$@"; do
    if [ -z "$session" ]; then
      # Set the mode in the create command queue. A later Split resume must win.
      session=$(tmux new-session -dP -F '#{session_id}' -s "$s" -n "${grp:-$h}" "$sshcmd $(printf %q "$h")" \
        \; set-window-option -t "=$s:" synchronize-panes "$synchronized" \
        \; set-option -t "=$s:" status-right " $hint " 2>/dev/null) && [ -n "$session" ] || {
        flash "${CR}${ICON_ERR} $(t err_open_session)${C0}"; return 1
      }
    elif [ "$mode" = tabs ]; then
      tmux new-window -t "$session:" -n "$h" "$sshcmd $(printf %q "$h")" &&
        tmux set-window-option -t "$session:" synchronize-panes off >/dev/null || return 1
    else
      tmux split-window -t "$session:" "$sshcmd $(printf %q "$h")" || return 1
      tmux select-layout -t "$session:" tiled >/dev/null
    fi
    tmux select-pane -t "$session:" -T "$h$(is_prod "$h" && echo ' · PROD')"
    is_prod "$h" && tmux set -p -t "$session:" pane-border-style "fg=$(tmux_color "$TH_ERR")" \; set -p -t "$session:" pane-active-border-style "fg=$(tmux_color "$TH_ERR"),bold" 2>/dev/null
  done
  tmux set -t "$session:" remain-on-exit on \; set -t "$session:" pane-border-status top \; set -t "$session:" pane-border-format ' #{pane_title} ' \; \
    set -t "$session" status-style "bg=$(tmux_color "$TH_OK"),fg=$(tmux_color "$TH_CHIP_FG")" \; set -t "$session" status-left "[${s#hb-}] " \; \
    set -t "$session" status-left-length 30 >/dev/null
  [ "$mode" = tabs ] && tmux select-window -t "$session:^" 2>/dev/null
  attach "$session"
}
# Each tmux pane runs hostbook itself, providing connection progress and error explanations.
# The tmux server may predate this process and lack its environment variables, so pass them explicitly.
pane_cmd(){ local v e=""
  for v in HOSTBOOK_DIR HOSTBOOK_STATE HOSTBOOK_SSH_CONFIG HOSTBOOK_CONNECT_TIMEOUT HOSTBOOK_KEYCHAIN HOSTBOOK_MASTER XDG_CONFIG_HOME SSH_AUTH_SOCK LC_CTYPE; do eval "[ -n \"\${$v:-}\" ] && e=\"\$e $v=\$(printf %q \"\${$v}\")\""; done
  printf 'env%s %q _connect' "$e" "$SELF"; }
attach(){ if [ -n "${TMUX:-}" ]; then tmux switch-client -t "$1"; else tmux attach -t "$1"; fi; }

# ---------- single-server actions ----------
pf_presets(){ # name → "port|description|usage"
  local t=" $(host_field "$1" 8) "
  case $t in *" postgres "*) echo "5432|PostgreSQL|psql -h localhost -p 5432";; esac
  case $t in *" mysql "*) echo "3306|MySQL|mysql -h 127.0.0.1 -P 3306";; esac
  case $t in *" redis "*) echo "6379|Redis|redis-cli -p 6379";; esac
  case $t in *" rabbitmq "*) echo "15672|RabbitMQ web|$(t pf_open http://localhost:15672)";; esac
  case $t in *" elastic "*) echo "9200|Elasticsearch|curl localhost:9200";; esac
  echo "8080|Web app|$(t pf_open http://localhost:8080)"
}
port_forward(){ # name [port]
  local n=$1 port=${2:-} use="" lp
  at "$n|$(t pf_title)" "$n"
  if [ -z "$port" ]; then port=$(UI_ENTER=$(t key_forward) ui_field "$(t pf_label)" "" port "$(t example 3000)" "localhost:%s  ${CD}→$C0  $n:%s") || return 1; fi
  use=$(pf_presets "$n" | awk -F'|' -v p="$port" '$1==p{print $3}')
  lp=$port; while port_open 127.0.0.1 "$lp"; do lp=$((lp+1)); done
  shown
  box ok "${CG}${CB}localhost:$lp  →  $n:$port${C0}" "$(t pf_use "${use:-localhost:$lp}")" "$( [ "$lp" != "$port" ] && t pf_busy "$port" "$lp")" "${CD}$(t pf_stop)${C0}"
  record "$n"
  sshx -N -o ExitOnForwardFailure=yes -L "$lp:localhost:$port" "$n"
}
send_file(){
  local n=$1 src us ip dst
  ip=$(host_field "$n" 3); us=$(host_field "$n" 4); at "$n|$(t send_title)"
  src=$(file_pick "$HOME" "$(t send_card "$n" "${us:+$us@}$ip")" "$(t key_send)") || return 1
  src=${src/#\~/$HOME}
  at "$n|$(t send_title)|$(t send_dest_title)"
  dst=$(UI_ENTER=$(t key_send) ui_field "$(t send_dest_label "$n")" "~" any "$(t send_dest_rule)" "$(basename "$src")  ${CD}→$C0  $n:%s/") || return 1
  dst=${dst:-"~"}; shown; record "$n"
  if scpx -r "$src" "$n:${dst%/}/"; then flash "${CG}${ICON_OK} $(t done_sent "$(basename "$src")" "$n:${dst%/}/")${C0}"; else err "$(t err_send)"; pause; return 1; fi
}
get_file(){
  local n=$1 src dst="${PWD/#$HOME/~}"
  at "$n|$(t get_title)" "$n"
  src=$(UI_ENTER=$(t key_download) ui_field "$(t get_label)" "" text "$(t example /var/log/nginx/error.log)" "$n:%s  ${CD}→$C0  $dst") || return 1
  shown; record "$n"
  if scpx -r "$n:$src" "$PWD/"; then flash "${CG}${ICON_OK} $(t done_got "$dst/$(basename "$src")")${C0}"; else err "$(t err_get)"; pause; return 1; fi
}
change_login(){
  local n=$1 sc
  at "$n|$(t act_login)" "$n"
  host_shared "$n" && { shown; err "$(t err_shared "$n")"; pause; return 1; }
  sc=$(pick_login "$(host_field "$n" 12)") || return 1
  ensure_index
  apply_change "$(t done_login "$n")" set_host_secret "$n" "$sc"
}
host_actions(){
  local n=$1 ip p1 pport pname login tmx
  ip=$(host_field "$n" 3); p1=$(pf_presets "$n" | head -1); pport=${p1%%|*}; pname=$(printf '%s' "$p1" | cut -d'|' -f2)
  login=$(host_field "$n" 12); [ -n "$login" ] || login=$(t card_ssh_self)
  tmx="$(t act_tmux)|$(t act_tmux_hint)"; [ -n "${TMUX:-}" ] && tmx=$(t act_tmux_tab)
  at "$n" "$n"
  case $(pick "" "#$(t sec_connect)" "$(t act_ssh)|$(t act_ssh_hint)" "$tmx" "$(t act_forward "$pname")|localhost:$pport → $n:$pport" "$(t act_forward_other)" \
      "#$(t sec_files)" "$(t act_send)" "$(t act_get)" \
      "#$(t sec_edit)" "$(t act_edit)|^e" "$(t act_rename)" "$(t act_move)|$(t act_move_hint "$(host_field "$n" 2)")" "$(t act_login)|$(t act_login_hint "$login")" \
      "#$(t sec_other)" "$(t act_copy_ip)|$ip" "$(t act_copy_ssh)|ssh $n" "$(t act_check)" "$(t act_share)" \
      "#$(t sec_danger)" "!$(t act_delete)|$(t act_delete_hint)") in
    0) connect "$n";;
    1) open_many "" "$n";;
    2) port_forward "$n" "$pport";;
    3) port_forward "$n";;
    4) send_file "$n";;
    5) get_file "$n";;
    6) edit_host "$n";;
    7) rename_server "$n";;
    8) move_server "$n";;
    9) change_login "$n";;
    10) printf '%s' "$ip" | copy && flash "${CG}${ICON_OK} $(t done_copied "$ip")${C0}";;
    11) printf 'ssh %s' "$n" | copy && flash "${CG}${ICON_OK} $(t done_copied "ssh $n")${C0}";;
    12) check_hosts "$n";;
    13) share_flow "$n";;
    14) delete_server "$n";;
  esac
}
group_actions(){
  local n=$1 members c
  members=$(group_field "$n" 3); c=$(printf '%s\n' $members | grep -c .); at "$n"
  case $(ui_menu "$C0$CD$(t group_members "$c" "$members")" "#$(t sec_connect)" "$(t act_group_open)" "$(t act_group_mode)|$(t act_group_mode_hint "$(mode_label "$(group_field "$n" 2)")")" \
      "#$(t sec_danger)" "!$(t act_group_delete)|$(t act_group_delete_hint)") in
    0) open_many "$n" $members;;
    1) set_group_mode "$n" ""; open_many "$n" $members;;
    2) at "$n|$(t act_group_delete)"
       ui_confirm --danger --default=false --affirmative "$(t group_delete_yes "$n")" --negative "$(t cancel)" "$(t group_delete_q "$n")" \
         "$CB$(t delete_removes)$C0" "  • $(t group_delete_line "$n")" " " "$CB$(t delete_keeps)$C0" "  • $(t group_delete_keeps "$c")" " " "$CD$(t delete_undo)$C0" \
         && { awk -F'\t' -v n="$n" '$1!=n' "$GRP" > "$GRP.tmp" && mv "$GRP.tmp" "$GRP"; save_and_sync "$(t done_group_deleted "$n")"; };;
  esac
}

# ---------- shared repository, new machines, and keys ----------
# Machines reachable over the network: LAN (mDNS) and Tailscale, if available. Print "address|description".
discover(){
  local tmp p inst me lan; tmp=$(mktemp -d); lan=$(t disc_lan)
  if is_mac && have dns-sd; then
    me=$(scutil --get LocalHostName 2>/dev/null).local
    dns-sd -B _ssh._tcp local. > "$tmp/b" 2>/dev/null & p=$!; sleep 1.2; kill $p 2>/dev/null; wait $p 2>/dev/null
    # dns-sd -B returns display names only; dns-sd -L resolves them to xxx.local network names
    awk -F'_ssh._tcp.' '/ Add / { n=$2; sub(/^[ \t]+/,"",n); print n }' "$tmp/b" | sort -u > "$tmp/names"
    while IFS= read -r inst; do ( dns-sd -L "$inst" _ssh._tcp local. > "$tmp/r.$RANDOM" 2>/dev/null & q=$!; sleep 1; kill $q 2>/dev/null ) & done < "$tmp/names"; wait
    cat "$tmp"/r.* 2>/dev/null | sed -n 's/.*reached at \([^ ]*\)\.:[0-9]*.*/\1/p' | sort -u | grep -vx "$me" | sed "s/\$/|$lan/"
  elif have avahi-browse; then avahi-browse -tpr _ssh._tcp 2>/dev/null | awk -F';' '$1=="=" {print $7}' | sort -u | grep -vx "$(hostname).local" | sed "s/\$/|$lan/"; fi
  # phones (iOS, Android) cannot host a repository, so omit them
  if have tailscale; then tailscale status 2>/dev/null | awk 'NR>1 && $1 ~ /^100\./ && $5!="offline" && tolower($4) !~ /^(ios|android)$/ {print $1 "|" $2 " · " ts}' ts="$(t disc_ts)"; fi
  rm -rf "$tmp"
}
pick_machine(){ # header [url] [intro] → print one "user@host" line (or a git URL if allowed) to stdout; screens go to the terminal because callers use $(...)
  local header=$1 allow_url=${2:-} intro=${3:-} items=() kinds=() vals=() choices=() x i m= e= base=$UI_AT d f head picker=ui_menu
  d=$(tmpd) || return 1
  { clear; title "${base:+$base|}$(t disc_title)"; dimw "$(t disc_intro)"; echo; } >&2   # Progress: what runs, elapsed / limit, ctrl-c
  run_progress "$(t disc_running)" 8 "$d/found" bash "$SELF" _discover; [ $? = 130 ] && { UI_AT=$base; rm -rf "${d:?}"; return 1; }
  UI_AT=$base
  while IFS= read -r x; do [ -n "$x" ] || continue; items+=("$ME@${x%%|*}|${x#*|}"); kinds+=(m); vals+=("$ME@${x%%|*}"); done < "$d/found"
  [ ${#items[@]} -eq 0 ] || items=("#$(t sec_found)" "${items[@]}")
  items+=("#$(t sec_other)" "$(t act_machine_other)|$(t act_machine_other_hint "$ME")"); kinds+=(a); vals+=("")
  [ -z "$allow_url" ] || { items+=("$(t act_machine_url)|$(t act_machine_url_hint)"); kinds+=(u); vals+=(""); }
  head=${intro:+$CD$intro$C0}; [ ${#kinds[@]} -gt 1 ] || head="${head:+$head$NL}$CD$(t disc_none)$C0"
  if [ ${#kinds[@]} -le 5 ]; then
    picker=ui_choice
    for x in "${items[@]}"; do case $x in \#*) ;; *) choices+=("$x");; esac; done
  else choices=("${items[@]}"); fi
  i=$(UI_HEAD=$head "$picker" "$header" "${choices[@]}") || { rm -rf "${d:?}"; return 1; }
  rm -rf "${d:?}"
  case ${kinds[$i]} in
    u) at "${base:+$base|}$(t act_machine_url)"
       while :; do
         m=$(ui_field "$(t kho_url_label)" "$m" text "$(t kho_url_rule)"$'\n'"$(t example "$(t kho_url_example)")" "" "$e") || { UI_AT=$base; return 1; }
         case $m in *[[:space:]\;\|\&\$\`]*) e="$CR$ICON_ERR $(t err_kho_url_chars)$C0"; continue;; esac
         is_url "$m" || { e="$CR$ICON_ERR $(t err_kho_url)$C0"; continue; }
         break; done
       UI_AT=$base; printf '%s\n' "$m"; return 0;;
    a|m) if [ "${kinds[$i]}" = m ]; then m=${vals[$i]}; at "${base:+$base|}$(t disc_title)"
       else at "${base:+$base|}$(t act_machine_other)"; fi
       while :; do
         m=$(ui_field "$(t kho_addr_label)" "$m" addr "$(t kho_addr_rule "$ME")"$'\n'"$(t example "$(t kho_addr_example)")" "" "$e") || { UI_AT=$base; return 1; }
         case $m in *@*) f=$m;; *) f="$ME@$m";; esac
         case ${f#*@} in ""|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0-9._-]*) e="$CR$ICON_ERR $(t err_kho_host)$C0"; continue;; esac
         case ${f%%@*} in ""|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0-9._-]*) e="$CR$ICON_ERR $(t err_kho_user)$C0"; continue;; esac
         break; done
       UI_AT=$base; printf '%s\n' "$f"; return 0;;
  esac
  printf '%s\n' "${vals[$i]}"
}
ensure_key(){ # ensure a key can log in to machine $1; otherwise create one and run ssh-copy-id (one password prompt)
  local m=$1
  sshx -o BatchMode=yes -o ConnectTimeout=5 "$m" true 2>/dev/null && return 0
  if [ ! -f "$HOME/.ssh/id_ed25519" ] && [ ! -f "$HOME/.ssh/id_rsa" ]; then mkdir -p "$HOME/.ssh"; ssh-keygen -q -t ed25519 -N "" -f "$HOME/.ssh/id_ed25519" && ok "$(t ek_created)"; fi
  dim "$(t ek_first "$m")"
  ssh-copy-id ${SSHCFG:+-F "$SSHCFG"} "$m" || { err "$(t err_ek_login "$m")"; return 1; }
  ok "$(t ek_added "$m")"
}
restore_origin(){ # previous URL and upstream; caller owns the writer lock
  legacy_destinations "$DIR/.git" || return 65
  if [ -n "$1" ]; then g remote set-url origin "$1"; else g remote remove origin; fi
  if [ -n "$2" ]; then g branch -q --set-upstream-to="$2" 2>/dev/null; else g branch --unset-upstream 2>/dev/null || :; fi
}
connect_kho(){ # connect ~/ssh-hosts to a repository on another machine
  legacy_destinations || return 65
  local m url old_url old_upstream checkpoint e
  at "$(has_remote && t kho_title_change || t kho_title_connect)"
  m=$(pick_machine "$(t kho_where)" url "$(t kho_intro)") || return 1
  if is_url "$m"; then url=$m   # the remote is an existing git repo (private GitHub, Gitea…): no need to create it
  else
    clear; title "$UI_AT"
    ensure_key "$m" || { pause; return 1; }
    if ! sshx -o ConnectTimeout=8 "$m" 'test -d ~/repos/ssh-hosts.git' 2>/dev/null; then
      ui_confirm --affirmative "$(t kho_create_yes)" --negative "$(t cancel)" "$(t kho_create_q "$m")" "$CD$(t kho_create_where)$C0" || return 1
      shown; sshx "$m" 'git init -q --bare ~/repos/ssh-hosts.git' || { err "$(t err_kho_create)"; pause; return 1; }
      ok "$(t kho_created "$m")"
    fi
    url="$m:repos/ssh-hosts.git"
  fi
  export GIT_SSH_COMMAND; GIT_SSH_COMMAND=$(git_ssh 8)
  lock 10 || { shown; err "$(t err_kho_busy)"; pause; return 1; }
  old_url=$(remote_url) || old_url=
  old_upstream=$(g rev-parse --abbrev-ref '@{u}' 2>/dev/null) || old_upstream=
  if [ -n "$old_url" ]; then g remote set-url origin "$url"; else g remote add origin "$url"; fi || { unlock; shown; err "$(t err_kho_read "$url")"; pause; return 1; }
  ensure_merge_setup
  if ! g ls-remote origin >/dev/null 2>&1; then restore_origin "$old_url" "$old_upstream"; unlock; shown; err "$(t err_kho_read "$url")"; pause; return 1; fi
  checkpoint=$(g rev-parse HEAD) || { restore_origin "$old_url" "$old_upstream"; unlock; return 1; }
  if g fetch -q origin 2>/dev/null && g ls-remote --exit-code origin HEAD >/dev/null 2>&1; then
    # the repository already has data: merge with the local list (--allow-unrelated-histories handles separate histories)
    if ! { g branch -q --set-upstream-to="origin/$(g symbolic-ref --short HEAD)" 2>/dev/null || { g fetch -q origin "+refs/heads/*:refs/remotes/origin/*" && g branch -q --set-upstream-to="origin/$(g remote show origin 2>/dev/null | sed -n 's/.*HEAD branch: //p')"; }; }; then
      restore_origin "$old_url" "$old_upstream"; unlock; shown; err "$(t err_kho_merge)"; pause; return 1
    fi
    if ! g merge -q --no-edit --allow-unrelated-histories '@{u}' >/dev/null 2>&1; then
      g merge --abort 2>/dev/null; restore_origin "$old_url" "$old_upstream"; unlock; shown; err "$(t err_kho_merge)"; pause; return 1
    fi
    if ! e=$(validate); then
      g reset -q --keep "$checkpoint" 2>/dev/null || :
      restore_origin "$old_url" "$old_upstream"; build_index; set_status invalid "$(printf '%s' "$e" | head -1)"
      unlock; shown; err "$(t err_kho_merge)"; dim "$e"; pause; return 1
    fi
  fi
  sync_locked; unlock; build_index
  case $(sed -n 1p "$ST") in ok|pulled) flash "${CG}${ICON_OK} $(t done_kho_linked "$(kho_addr)")${C0}";; *) flash "${CY}${ICON_WARN} $(t kho_unsynced "$(kho_addr)" "$(sync_text)")${C0}";; esac
}
make_kho_here(){
  local addrs first how i steps head note=
  at "$(t hub_title)"
  while ! port_open 127.0.0.1 22; do   # Result with a next step: turn SSH on, then check again
    if is_mac; then how=$(t hub_ssh_mac); else how=$(t hub_ssh_linux); fi
    i=$(UI_HEAD="$CY$ICON_WARN $(t hub_ssh_off)$C0$NL  $CB$how$C0${note:+$NL $NL$note}" ui_choice "$(t hub_ssh_q)" "$(t act_hub_check)") || return 1
    note="$CR$ICON_ERR $(t err_hub_ssh)$C0"
  done
  steps="$CG$ICON_OK$C0 $(t hub_ssh_ok)"
  [ -d "$HOME/repos/ssh-hosts.git" ] || git init -q --bare "$HOME/repos/ssh-hosts.git"; steps="$steps$NL$CG$ICON_OK$C0 $(t hub_repo_ok)"
  if [ -d "$DIR/.git" ]; then
    if has_remote; then g remote set-url origin "$HOME/repos/ssh-hosts.git"; else g remote add origin "$HOME/repos/ssh-hosts.git"; fi
    g push -q -u origin HEAD 2>/dev/null && steps="$steps$NL$CG$ICON_OK$C0 $(t hub_pushed)"
  fi
  addrs="$( (is_mac && echo "$(scutil --get LocalHostName 2>/dev/null).local"); (is_mac && ipconfig getifaddr en0 2>/dev/null) || hostname -I 2>/dev/null | awk '{print $1}'; have tailscale && tailscale ip -4 2>/dev/null | head -1 ) | grep . | tr '\n' ' ')"
  first=${addrs%% *}
  head="$steps$NL $NL$CG$CB$(t hub_ready)$C0$NL$(t hub_addrs "${addrs% }")$NL$(t hub_auto)$NL$CD$(t hub_vpn)$C0"
  while :; do
    case $(UI_HEAD=$head ui_choice "$(t hub_next)" "$(t act_hub_done)" "$(t act_hub_copy)|$first") in
      1) printf '%s' "$first" | copy && head="$head$NL $NL$CG$ICON_OK$C0 $(t hub_copied "$first")";;
      *) break;;
    esac
  done
  flash "${CG}${ICON_OK} $(t hub_ready)${C0}"
}
undo_when(){ # [commit] → how long ago it was made
  local ct d; ct=$(g log -1 --no-color --format=%ct "${1:-HEAD}" 2>/dev/null); [ -n "$ct" ] || return 1; d=$(( $(date +%s) - ct ))
  if [ $d -lt 60 ]; then t ago_now; elif [ $d -lt 3600 ]; then t ago_min $((d / 60)); elif [ $d -lt 86400 ]; then t ago_hour $((d / 3600)); else t ago_day $((d / 86400)); fi
}
# Host blocks that differ between two versions of a .conf file (a block includes the comment lines above its Host line):
# prints "+name", "-name" or "~name". Wildcard Host lines are ignored.
undo_hosts(){ # old-file new-file
  awk 'FNR == 1 { side = (FILENAME == ARGV[1]) ? "o" : "n"; cur = ""; pend = "" }
    { sub(/\r$/, "") }
    /^[ \t]*#/ { pend = pend $0 "\n"; next }
    tolower($1) == "host" { cur = ($2 ~ /[*?!]/) ? "" : $2; if (cur != "") txt[side, cur] = pend $0 "\n"; pend = ""; next }
    tolower($1) == "match" { cur = ""; pend = ""; next }
    { if (cur != "") txt[side, cur] = txt[side, cur] $0 "\n"; pend = "" }
    END { for (k in txt) { split(k, a, SUBSEP)
            if (a[1] == "o") { if (!(("n" SUBSEP a[2]) in txt)) print "-" a[2]; else if (txt[k] != txt["n", a[2]]) print "~" a[2] }
            else if (!(("o" SUBSEP a[2]) in txt)) print "+" a[2] } }' "$1" "$2" | sort
}
undo_paths_clean(){
  local f untracked paths=()
  # Git can overwrite ignored files at an affected path or in a file/directory replacement.
  while IFS= read -r -d '' f; do
    paths+=(":(literal,icase)$f")
    while [ "$f" != "${f%/*}" ]; do
      f=${f%/*}
      if [ -L "$DIR/$f" ] || { [ -e "$DIR/$f" ] && [ ! -d "$DIR/$f" ]; }; then
        paths+=(":(literal,icase)$f")
      fi
    done
  done < "$1"
  [ "${#paths[@]}" -gt 0 ] || return 1
  untracked=$(g ls-files --others -- "${paths[@]}") || return 1
  [ -z "$untracked" ] && g diff --quiet --no-ext-diff --no-textconv --ignore-submodules=none -- "${paths[@]}"
}
undo_locked(){ # caller owns the sync lock; print the translation key on failure
  legacy_destinations "$DIR/.git" || return 65
  local id=$1 parent=$2 paths=$3 gitdir tree failure=err_undo
  shift 3
  [ "$(g rev-parse HEAD 2>/dev/null)" = "$id" ] || { echo err_undo_moved; return 1; }
  gitdir=$(g rev-parse --absolute-git-dir) || { echo err_undo; return 1; }
  if [ -e "$gitdir/MERGE_HEAD" ] || [ -e "$gitdir/REVERT_HEAD" ] || [ -e "$gitdir/CHERRY_PICK_HEAD" ] ||
     [ -d "$gitdir/sequencer" ] || [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ] ||
     ! g diff --cached --ita-visible-in-index --quiet; then echo err_undo; return 1; fi
  [ -n "$parent" ] || parent=$(g hash-object -t tree --stdin </dev/null) || { echo err_undo; return 1; }
  if ! g diff --name-only --no-renames -z "$id" "$parent" -- > "$paths" ||
     ! undo_paths_clean "$paths"; then echo err_undo; return 1; fi
  if ! g revert --no-commit "$@" "$id" >/dev/null 2>&1; then
    # A checkout error can leave partial changes without Git's recovery marker.
    if ! revert_in_progress && [ "$(g rev-parse HEAD 2>/dev/null)" = "$id" ]; then
      if g diff --cached --ita-visible-in-index --quiet && undo_paths_clean "$paths"; then echo err_undo; return 1; fi
      g update-ref REVERT_HEAD "$id" "" >/dev/null 2>&1
    fi
    echo err_undo_restore
    return 1
  fi
  tree=$(g write-tree 2>/dev/null) || { echo err_undo_restore; return 1; }
  if ! validate >/dev/null; then failure=err_undo_broken
  elif [ "$(g rev-parse HEAD 2>/dev/null)" = "$id" ] &&
       [ "$(g write-tree 2>/dev/null)" = "$tree" ] &&
       undo_paths_clean "$paths" &&
       g commit --no-edit >/dev/null 2>&1; then return 0; fi
  # Reverse only the staged revert, preserving unstaged edits and leaving HEAD untouched.
  if [ "$(g rev-parse HEAD 2>/dev/null)" != "$id" ] ||
     ! undo_paths_clean "$paths" ||
     ! g read-tree -m -u "$tree" "$id" >/dev/null 2>&1 ||
     ! g revert --quit >/dev/null 2>&1; then failure=err_undo_restore; fi
  printf '%s\n' "$failure"
  return 1
}
undo_last(){
  local id par m=() files f sec="" grp="" lines=() d h c o n add="" rem="" edt="" r
  id=$(g rev-parse -q --verify HEAD 2>/dev/null) || return 1
  [ -z "${1:-}" ] || [ "$id" = "$1" ] || { shown; err "$(t err_undo_moved)"; pause; return 1; }
  par=$(g rev-parse -q --verify "$id^1" 2>/dev/null); [ -z "$(g rev-parse -q --verify "$id^2" 2>/dev/null)" ] || m=(-m 1)
  if [ -n "$par" ]; then files=$(g diff --no-color --name-only "$par" "$id"); else files=$(g show --no-color --name-only --format= "$id"); fi
  d=$(tmpd) || return 1
  for f in $files; do
    case $f in
      *.conf) if [ -n "$par" ]; then g show --no-color "$par:$f" > "$d/o" 2>/dev/null || : > "$d/o"; else : > "$d/o"; fi
              g show --no-color "$id:$f" > "$d/n" 2>/dev/null || : > "$d/n"
              while IFS= read -r r; do case $r in +*) add="$add ${r#?}";; -*) rem="$rem ${r#?}";; ~*) edt="$edt ${r#?}";; esac; done < <(undo_hosts "$d/o" "$d/n");;
      groups.tsv) grp=1;;
      secrets/*.age|secrets/*.meta|secrets/*.pub) f=${f#secrets/}; f=${f%.*}; case " $sec " in *" $f "*) ;; *) sec="$sec $f";; esac;;
    esac
  done
  lines=("$(t undo_when "$(undo_when "$id")")")
  [ "${#m[@]}" -eq 0 ] || lines+=("$(t undo_merge)")
  [ -z "$add" ] || lines+=("$(t undo_added "${add# }")"); [ -z "$rem" ] || lines+=("$(t undo_removed "${rem# }")"); [ -z "$edt" ] || lines+=("$(t undo_edited "${edt# }")")
  [ -z "$grp" ] || lines+=("$(t undo_groups)"); [ -z "$sec" ] || lines+=("$(t undo_secrets "${sec# }")")
  [ ${#lines[@]} -gt 1 ] || [ -z "$files" ] || lines+=("$(t undo_files "$(printf '%s ' $files | sed 's/ $//')")")
  lines+=(" " "$CD$(t undo_effect)$C0")
  at "$(t tools_title)|$(t act_undo)"
  ui_confirm --default=false --affirmative "$(t undo_yes)" --negative "$(t cancel)" "$(t undo_q)" "${lines[@]}" || return 1
  lock 10 || { shown; err "$(t sync_busy)"; pause; return 1; }
  if ! r=$(undo_locked "$id" "$par" "$d/undo.paths" ${m[@]+"${m[@]}"}); then unlock; shown; err "$(t "$r")"; pause; return 1; fi
  unlock
  build_index; flash "${CG}${ICON_OK} $(t done_undone)${C0}"; : > "$ST.force"
}
doctor(){ # Report: grouped sections; every problem line carries "→ fix"
  local n e out np=0 cols st f line d dp
  cols=$(term_cols); d=$(tmpd) || return 1
  dr(){ # ok|warn|err text [fix]: one line under the current section; counts the problems
    local c i; case $1 in ok) c=$CG; i=$ICON_OK;; warn) c=$CY; i=$ICON_WARN; np=$((np+1));; *) c=$CR; i=$ICON_ERR; np=$((np+1));; esac
    printf '  %s%s%s %s\n' "$c" "$i" "$C0" "$2"; [ -z "${3:-}" ] || printf '      %s→ %s%s\n' "$CD" "$3" "$C0"; }
  dh(){ printf '\n%s%s%s\n' "$CU" "$1" "$C0"; }
  {
    dh "$(t doc_s_software)"
    dr ok "$(t doc_version "$VERSION")"
    dp=$(check_deps report); [ $? = 0 ] || np=$((np+1)); printf '%s\n' "$dp" | sed 's/^/  /'
    if have tmux; then dr ok "$(t doc_tmux_ok)"; else dr warn "$(t doc_tmux_no)" "$(t doc_tmux_fix)"; fi
    dh "$(t doc_s_config)"
    e=$(cfg_errors); [ -z "$e" ] || while IFS= read -r line; do dr warn "$line"; done <<< "$e"
    n=$(cfg theme hostbook); if ! theme_builtin "$n" >/dev/null; then e=$(theme_check "$CONF/themes/$n.theme" 2>&1) || dr warn "$e"; fi
    if grep -qs "Include.*ssh-hosts" "$HOME/.ssh/config"; then dr ok "$(t doc_inc_ok)"; else dr err "$(t doc_inc_bad)" "$(t doc_fix_setup)"; fi
    if e=$(validate); then ensure_index; dr ok "$(t doc_cfg_ok "$(wc -l < "$IDX" | tr -d ' ')")"; else dr err "$(t doc_cfg_bad "$(printf '%s' "$e" | head -1)")" "$(t doc_cfg_bad_fix)"; fi
    [ -s "$STATE/skipped" ] && dr warn "$(t doc_skipped "$(sed "s|$DIR/||" "$STATE/skipped" | head -3 | tr '\n' ' ')")" "$(t doc_skipped_fix)"
    case $(perm "$DIR") in 700) dr ok "$(t doc_perm_ok)";; *) dr warn "$(t doc_perm_bad)" "$(t doc_perm_fix)";; esac
    if [ -d "$HOME/.config/ghostty" ] || [ -d /Applications/Ghostty.app ]; then if grep -qs 'ssh-env' "$HOME/.config/ghostty/config"; then dr ok "$(t doc_ghostty_ok)"; else dr warn "$(t doc_ghostty_bad)" "$(t doc_fix_setup)"; fi; fi
    dh "$(t doc_s_sync)"
    if [ -d "$DIR/.git" ]; then dr ok "$(t doc_dir_ok)"; else dr err "$(t doc_dir_bad)" "$(t doc_dir_fix)"; fi
    if has_remote; then
      if GIT_SSH_COMMAND=$(git_ssh 4) g ls-remote -q origin >/dev/null 2>&1; then dr ok "$(t doc_remote_ok "$(kho_addr)")"; else dr warn "$(t doc_remote_bad "$(kho_addr)")" "$(t doc_remote_bad_fix)"; fi
    else dr warn "$(t doc_remote_none)" "$(t doc_remote_none_fix)"; fi
    f=$(g status --porcelain 2>/dev/null | grep -c .); if [ "$f" -gt 0 ]; then dr warn "$(t doc_unsynced "$f")" "$(t doc_unsynced_fix)"; else dr ok "$(t doc_synced)"; fi
    st=$(sed -n 1p "$ST" 2>/dev/null)
    case $st in pending) dr warn "$(t doc_pending "$(sed -n 2p "$ST")")" "$(t doc_pending_fix)";; conflict) dr err "$(t doc_conflict)" "$(t doc_conflict_fix)";; esac
    dh "$(t doc_s_vault)"
    if vault_exists; then
      if kc_get >/dev/null 2>&1; then dr ok "$(t doc_vault_open "$(kc_label)" "$(secret_names | grep -c .)")"; else dr warn "$(t doc_vault_locked)" "$(t doc_vault_locked_fix)"; fi
      for n in $(secret_names); do [ -f "$SEC/$n.pub" ] && [ "$(perm "$SEC/$n.pub")" != 600 ] && chmod 600 "$SEC/$n.pub"; done
      n=$(awk -F'\t' '$12!=""{print $12}' "$IDX" | sort -u | while read -r e; do secret_exists "$e" || printf '%s ' "$e"; done)
      [ -n "$n" ] && dr err "$(t doc_missing_sc "${n% }")" "$(t doc_missing_sc_fix)"
      n=$(for e in $(secret_names); do [ -n "$(secret_users "$e")" ] || printf '%s ' "$e"; done); [ -n "$n" ] && printf '  %s· %s%s\n' "$CD" "$(t doc_unused_sc "${n% }")" "$C0"
    else printf '  %s· %s · %s%s\n' "$CD" "$(t doc_vault_none)" "$(t doc_vault_none_fix)" "$C0"; fi
    n=$(legacy_keys | grep -c .); [ "$n" -gt 0 ] && dr warn "$(t doc_legacy "$n")" "$(t doc_legacy_fix)"
    :
  } > "$d/r" 2>&1
  out=$(ui_wrap $((cols - 1)) < "$d/r"); rm -rf "${d:?}"   # a group, not a pipe: the problem count stays in this shell
  clear; title "$(t doc_title)"
  if [ "$np" -gt 0 ]; then printf '%s%s%s %s\n' "$CY" "$ICON_WARN" "$C0" "$(t doc_problems "$np")"; else ok "$(t doc_all_ok)"; fi
  printf '%s\n' "$out"; pause
}
tools(){
  local items=() keys=() i
  at "$(t tools_title)"
  [ "$(sed -n 1p "$ST" 2>/dev/null)" = conflict ] && { items+=("#$(t sec_attention)" "$(t act_conflict)|$(t act_conflict_hint)"); keys+=(conflict); }
  items+=("#$(t sec_server)" "$(t act_import)|$(t act_import_hint)" "$(t act_sync)|$(t act_sync_hint)" "$(t act_undo)|$(t act_undo_hint "$(undo_when)")" "#$(t sec_store)")
  if has_remote; then items+=("$(t act_kho_change)|$(t act_kho_change_hint "$(kho_addr)")"); else items+=("$(t act_kho_connect)|$(t act_kho_connect_hint)"); fi
  items+=("$(t act_hub)|$(t act_hub_hint)" "#$(t sec_machine)" "$(t act_secrets)|$(t act_secrets_hint)" "$(t act_doctor)|$(t act_doctor_hint)" "$(t act_settings)|$(t act_settings_hint)")
  keys+=(import sync undo kho hub keys doctor settings)
  i=$(ui_menu "$(t tools_head)" "${items[@]}") || return
  case ${keys[$i]} in
    conflict) resolve_conflict;; import) import_flow;;
    sync) sync_ui;;
    doctor) doctor;; undo) undo_last;; kho) connect_kho;; keys) SECRET_QUERY=""; secret_manager;; hub) make_kho_here;; settings) settings;;
  esac
}
show_help(){ # Report: grouped sections; a pager when it does not fit
  local cols rows out; cols=$(term_cols); rows=$(term_rows)
  # wide screens: two columns; narrow screens: keys on one line, descriptions indented below. $2 is a lang key (+ its arguments).
  r(){ local k=$1 d; shift; d=$(t "$@")
    if [ "$cols" -ge 80 ]; then printf '  %s%s%*s%s %s\n' "$CP" "$k" $((28-${#k})) '' "$C0" "$d"
    else printf '  %s%s%s\n' "$CP" "$k" "$C0"; printf '%s\n' "$d" | fold -s -w $((cols - 8)) | sed 's/^/      /'; fi; }
  h(){ printf '\n%s%s%s\n' "$CU" "$(t "$1")" "$C0"; }
  local pf; pf=$(tmux show -gv prefix 2>/dev/null | sed 's/^C-/^/'); pf=${pf:-^b}
  out=$( title "$(t help_title)"; dim "$(t help_ver "$VERSION")"
    h help_s_search
    r 'web prod' help_and; r 'aweb1' help_fuzzy; r '#prod' help_tag; r '@deploy' help_user
    r '^b-' help_prefix; r '!staging' help_not; r 'db | cache' help_or; r '10.8' help_ip
    h help_s_keys
    r enter help_enter; r '→' help_right
    r tab help_tab; r '^g' help_ctrl_g
    r '^y' help_ctrl_y; r "$(t help_k_multi)" help_multi; r '^a / ^e' help_ctrl_ae
    r '^s' help_ctrl_s; r '^o' help_ctrl_o
    r '^t / ctrl-/' help_ctrl_t; r 'hb settings' help_settings
    h help_s_secret
    r "$(t help_k_secret)" help_secret
    r 'hostbook unlock' help_unlock $((KEY_TTL/3600))
    r 'hostbook lock' help_lock
    r esc help_esc
    h help_s_connect
    r "$(t help_k_progress)" help_progress "$CTO"
    r 'ctrl-c' help_ctrl_c
    h help_s_tmux
    r "$pf d" help_t_detach; r "$(t help_k_arrows "$pf")" help_t_pane; r "$pf n / p" help_t_tab; r "$pf x" help_t_close
    h help_s_cli
    r 'hostbook web1' help_c_open; r 'hostbook add ubuntu@10.0.1.13' help_c_add
    r 'hostbook import [file]' help_c_import; r "$(t help_k_share)" help_c_share; r "$(t help_k_check)" help_c_check; r 'hostbook sync · doctor' help_c_sync
    r 'hostbook setup · update' help_c_setup; r 'hostbook vault passwd · recover' help_c_vault; r "$(shortcut_name || true)" help_c_shortcut )
  clear
  if [ "$(printf '%s\n' "$out" | wc -l)" -gt $(( rows - 3 )) ]; then { printf '%s\n' "$out" | sed -n 1,2p; printf '%s%s%s\n' "$CD" "$(t help_pager)" "$C0"; printf '%s\n' "$out" | sed 1,2d; } | less -R   # longer than the screen: allow scrolling, q to return
  else printf '%s\n' "$out"; pause; fi
}

