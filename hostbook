apply_theme

# ---------- điểm vào ----------
case ${1:-} in
  _demo) cmd_demo "${2:-preset=cards}";; settings) check_deps || exit 1; settings;;
  _list) cmd_list;; _preview) cmd_preview "$2";; _header) cmd_header;; _footer) cmd_footer "${2:-}";;
  _connect) ensure_index; while :; do connect "$2" pane; rc=$?; [ $rc -eq 255 ] || exit $rc
             printf '\n%senter: thử lại · q rồi enter: đóng ô%s ' "$CD" "$C0"; read -r a </dev/tty; [ "$a" = q ] && exit 255; done;;
  _explain) ensure_index; explain "$2" "$3" pane;;
  _askpass) cmd_askpass "${2:-}";;
  _run) ensure_index; h=$2; shift 2; prepare_login "$h" || exit 1; ssh_login "$h" ${HB_LOG:+-v -E "$HB_LOG"} -o ConnectTimeout=6 "$h" "$@" </dev/null;;
  _secret_replace) ensure_index; secret_replace "$2" "$3" "${4:-yes}";;
  _vault_init) vault_exists || vault_create "$2";; _vault_recover) vault_recover "$2" "$3";; _vault_id) vault_identity >/dev/null && echo ok;;
  _secret_add_key) secret_add_key "$2" "${3:-}" "${4:-}";; _secret_add_password) secret_add_password "$2" "$3";; _secret_get) secret_get "$2";;
  _set_host_secret) ensure_index; apply_change "đổi đăng nhập" set_host_secret "$2" "${3:-}";; _migrate) migrate_keys_raw;;
  _secret_rename) ensure_index; apply_change "đổi tên secret" secret_rename_raw "$2" "$3";; _secret_delete) ensure_index; apply_change "xoá secret" secret_delete_raw "$2";;
  _load) agent_ready && load_secret "$2";; _secrets_for) ensure_index; secrets_for "$2";;
  unlock) cmd_unlock;; lock) cmd_lock "${2:-}";; secret|secrets) check_deps || exit 1; ensure_index; secret_manager;;
  vault) case ${2:-} in init) vault_init;; passwd) vault_passwd;; recover) vault_recover;; recovery-code) vault_recovery_code;; *) echo "hostbook vault init | passwd | recover | recovery-code";; esac;;
  _share_build) ensure_index; d=$2; ws=$3; shift 3; share_build "$d" "$ws" $(share_closure "$@");; _share_pack) ensure_index; pw=$2; shift 2; d=$(tmpd)/p; share_build "$d" 1 $(share_closure "$@") && share_pack "$d" "$pw";;
  _share_pw) share_password;; _share_words) printf '%s\n' $SHARE_WORDS;;
  _import_classify) x=$(pack_open "$2") && pack_classify "$x";;
  _import_apply) ensure_index; x=$(pack_open "$2") || exit 1; { ls "$x"/secrets/*.meta >/dev/null 2>&1 && ! vault_exists; } && { vault_create "$HOSTBOOK_MASTER" >/dev/null; }
                 pack_classify "$x" > "$x/classes"; pack_decide "$x" "$3" > "$x/decisions"; apply_change "Nhập gói" pack_apply_raw "$x" "$x/decisions";;
  _check) ensure_index; shift; HB_PLAIN=1 check_run "$@"; cat "$STATE/last-check.tsv";;
  share) check_deps || exit 1; ensure_index; shift; if [ $# -gt 0 ]; then share_flow $(search_hosts "$*"); else share_flow $(cut -f1 "$IDX"); fi;;
  check) check_deps || exit 1; ensure_index; shift; if [ $# -gt 0 ]; then check_hosts $(search_hosts "$*"); else check_hosts $(cut -f1 "$IDX"); fi;;
  _merge) merge_driver "$2" "$3" "$4" "${5:-}"; exit $?;; _bg_sync) cmd_bg_sync;; _sync_now) rm -f "$ST"; sync_quiet 10;; _discover) discover;; _index) build_index full; cat "$IDX";;
  _suggest_host) suggest "$2" "${3:-}" "${4:-}" "${5:-}" "${6:-}";; _suggest) shift; suggest_group_name "$@";; _parse) parse_addr "$2";;
  _write) write_host "$2" "$3";; _delete) ensure_index; apply_change "xoá $2" delete_host_raw "$2";;
  _rename) ensure_index; apply_change "đổi tên" rename_host_raw "$2" "$3";; _move) ensure_index; apply_change "chuyển" move_host_raw "$2" "$3";;
  _import_parse) import_parse;; _import_write) ensure_index; apply_change "nhập" import_write "$2" "${3:-}";;
  _split) split_config "$2" "$3" "$4";; _resolve) resolve_conflict "$2";; _kho_addr) kho_addr;; _block) shift; host_block "$@";; _validate) validate;;
  --version|-v|version) echo "hostbook $VERSION";;
  add) check_deps || exit 1; [ -d "$DIR" ] || { err "Chưa có ~/ssh-hosts · chạy hostbook để thiết lập"; exit 1; }; add_host "${2:-}" "${3:-}";;
  sync) "$SELF" _sync_now; "$SELF" _header | sed -n 1p;;
  import) check_deps || exit 1; [ -d "$DIR" ] || { err "Chưa có ~/ssh-hosts · chạy hostbook để thiết lập"; exit 1; }; ensure_index; import_flow "${2:-}";;
  doctor) doctor;; setup) setup;; update) update;; kho) check_deps || exit 1; connect_kho;; help|-h|--help) show_help;;
  *) check_deps || exit 1
     if [ ! -d "$DIR/.git" ]; then first_run || exit 1; fi
     if [ -n "${1:-}" ]; then
       ensure_index
       if valid_name "$1" && [ $# -eq 1 ] && host_exists "$1"; then connect "$1"; exit; fi   # đúng tên thì vào thẳng
       m=$(search_hosts "$*")
       if [ "$(printf '%s\n' "$m" | grep -c .)" = 1 ]; then connect "${m#h:}"; exit; fi
     fi
     home "$*";;
esac
