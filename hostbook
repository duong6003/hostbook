preset_data(){
  case $1 in
    cards) echo 'cards rounded right on unicode hostbook';;
    compact) echo 'compact rounded right off unicode hostbook';;
    minimal) echo 'minimal none hidden off unicode terminal';;
    dracula) echo 'cards rounded right on unicode dracula';;
    nord) echo 'compact sharp right off unicode nord';;
    light) echo 'cards rounded right on unicode light';;
    high-contrast) echo 'compact bold right off ascii high-contrast';;
    *) return 1;;
  esac
}
apply_preset(){
  local values; values=$(preset_data "$1") || return 1; set -- $values
  local put=${PRESET_SET:-cfg_set}   # _demo swaps in cfg_mem so previews never touch the file
  $put list "$1" && $put border "$2" && $put preview "$3" && $put separator "$4" && $put icons "$5" && $put theme "$6"
}
demo_rows(){
