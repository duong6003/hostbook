  case $preview in right) echo '--preview-window=right,38%,wrap,<36(hidden)';; bottom) echo '--preview-window=down,40%,wrap';; hidden) echo '--preview-window=right,38%,wrap,hidden,<36(hidden)';; esac
  printf '%s\n' "--bind=ctrl-/:toggle-preview+reload('$SELF' _list)+transform-header('$SELF' _header)+transform-footer('$SELF' _footer {1})" "--color=$(fzf_colors)" "--pointer=$ICON_PTR" '--highlight-line'
  if [ "$(cfg list cards)" = cards ]; then
