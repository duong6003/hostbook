      for (i=1;i<=nj;i++) if (tot>0 && JC[jo[i]] >= 0.8*tot) { print "field\tjump\t" jo[i] "\t" sprintf(sg_jump, G); break }
      for (i=1;i<=N;i++) { n=nm[i]; if (P[n]!=G || SC[n]=="") continue; if (!(SC[n] in sseen)) { sseen[SC[n]]=1; so[++ns]=SC[n] }; SA[SC[n]]++; if (U[n]==cu) SU[SC[n]]++ }
      bsn=""; bv=0; for (i=1;i<=ns;i++) if (SU[so[i]]>bv) { bv=SU[so[i]]; bsn=so[i] }
      if (bsn=="") for (i=1;i<=ns;i++) if (SA[so[i]]>bv) { bv=SA[so[i]]; bsn=so[i] }
      if (bsn!="") print "field\tsecret\t" bsn "\t" sprintf(sg_sec, SA[bsn], G)
      tags=""
      for (i=1;i<=N;i++) { n=nm[i]; if (P[n]!=G) continue; m=split(TG[n],t," "); for (j=1;j<=m;j++) { TC[t[j]]++; if (!(t[j] in tseen)) { tseen[t[j]]=1; to[++nt]=t[j] } } }
      for (i=1;i<=nt;i++) if (TC[to[i]] >= 0.6*ng) { tags=tags (tags==""?"":" ") to[i]; chosen[to[i]]=1 }
      extra=0; m=split(tolower(name),t,/[-_.0-9]+/)
