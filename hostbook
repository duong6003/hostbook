# Recheck names under the sync lock and list only paths these operations can write (including scratch files).
change_paths(){ # command args... -> NUL-separated absolute paths
  local cmd=$1 n=${2:-} to=${3:-} f e paths=(); shift
  case $cmd in
    delete_host_raw|rename_host_raw|move_host_raw|set_host_secret)
      host_exists "$n" || return 1
      f=$(host_field "$n" 10)
      case $f in "$DIR"/*.conf) ;; *) return 1;; esac
      paths+=("$f")
      case $cmd in
        delete_host_raw) paths+=("$GRP");;
        rename_host_raw)
          valid_name "$to" && ! host_exists "$to" || return 1
          paths+=("$GRP" "$HIST")
          for f in "$DIR"/*.conf; do [ ! -e "$f" ] && [ ! -L "$f" ] || paths+=("$f"); done;;
        move_host_raw)
          valid_name "$to" || return 1   # existing projects may come from imported filenames
          if [ ! -f "$DIR/$to.conf" ]; then
            case $to in *[!abcdefghijklmnopqrstuvwxyz0-9-]*) return 1;; esac
          fi
          host_shared "$n" && return 1
          paths+=("$DIR/$to.conf" "$DIR/$to.conf.extra");;
      esac;;
    secret_rename_raw|secret_delete_raw)
      valid_secret_name "$n" && secret_exists "$n" && [ ! -L "$SEC" ] || return 1
      if [ "$cmd" = secret_rename_raw ]; then
        valid_secret_name "$to" || return 1
        for e in age meta pub; do
          [ ! -e "$SEC/$to.$e" ] && [ ! -L "$SEC/$to.$e" ] || return 1
          paths+=("$SEC/$to.$e")
        done
      fi
      for e in age meta pub; do paths+=("$SEC/$n.$e"); done
      for f in "$DIR"/*.conf; do [ ! -f "$f" ] || paths+=("$f"); done;;
    *) return 1;;
  esac
  for f in "${paths[@]}"; do printf '%s\0%s\0' "$f" "$f.tmp" || return 1; done
}
change_locked(){ # description command...; caller owns the sync lock
  legacy_destinations "$DIR"/*.conf "${SEC:-$DIR/secrets}"/* || return 65
  local msg=$1 rollback f e i=0 failed=0 restore=0 idxfile; shift
  if ! e=$(validate); then err "$(t err_apply_broken)"; dim "$e"; return 1; fi
  ensure_index || return 1
  rollback=$(mktemp -d "$STATE/change-rollback.XXXXXX") || return 1
  if ! change_paths "$@" > "$rollback/paths"; then rm -rf "$rollback"; return 1; fi
  # Raw operations do not stage files. Keep the exact index too, including any pre-existing staged edits.
  idxfile=$(g rev-parse --git-path index) || { rm -rf "$rollback"; return 1; }
  case $idxfile in /*) ;; *) idxfile=$DIR/$idxfile;; esac
  printf '%s\0' "$idxfile" >> "$rollback/paths" || { rm -rf "$rollback"; return 1; }
  while IFS= read -r -d '' f; do
    if [ -L "$f" ] || { [ -e "$f" ] && [ ! -f "$f" ]; }; then rm -rf "$rollback"; return 1; fi
    if [ -f "$f" ]; then cp -p "$f" "$rollback/$i" || { rm -rf "$rollback"; return 1; }; fi
    i=$((i+1))
  done < "$rollback/paths"
  "$@" || failed=1
  if [ "$failed" = 0 ]; then
    if ! e=$(validate); then failed=1; err "$(t err_apply_broken)"; dim "$e"; fi
  fi
  if [ "$failed" = 0 ]; then
    build_index && commit_all "$msg" || { failed=1; flash "${CR}${ICON_ERR} $(t err_not_saved)${C0}"; }
  fi
  if [ "$failed" = 1 ]; then
    i=0
    while IFS= read -r -d '' f; do
      if [ -L "$f" ] || { [ -e "$f" ] && [ ! -f "$f" ]; }; then restore=1
      elif [ -f "$rollback/$i" ]; then cp -p "$rollback/$i" "$f" || restore=1
      else rm -f "$f" || restore=1; fi
      i=$((i+1))
    done < "$rollback/paths"
    build_index || restore=1
    if [ "$restore" = 0 ]; then rm -rf "$rollback"; else err "$(t err_apply_restore "$rollback")" >&2; fi
    return 1
  fi
  rm -rf "$rollback"
  saved_notice "$msg"
  return 0
}
apply_change(){ # description command...
  local rc
  lock 10 || { err "$(t sync_busy)"; return 1; }
  change_locked "$@"; rc=$?
  unlock; return "$rc"
}
host_where(){ # server → "file.conf line N · groups g1, g2" for previews
  local f l gs; f=$(host_field "$1" 10); l=$(host_field "$1" 11)
