# ---------- server index ----------
# index.tsv: name project hostname user port proxyjump key tags desc file line   (values from "ssh -G" match SSH interpretation)
# Each .conf file has its own index in $STATE/idx; rebuild only changed files. Wildcard blocks can affect
# servers in other files, so changing a file with wildcards rebuilds every index.
IDXD=$STATE/idx2
has_wild(){ grep -qE '^[[:space:]]*[Hh][Oo][Ss][Tt][[:space:]].*[*?]' "$1" 2>/dev/null; }
index_file(){ # file → print index rows; run "ssh -G" in parallel, 16 servers per batch
  local f=$1 tmp i=0 n p t d ff l sc r; tmp=$(mktemp -d)   # read-loop variables must be local to avoid overwriting variables in the caller
  awk -v proj="$(basename "$f" .conf)" -v file="$f" -v skip="$STATE/skipped" '
    {sub(/\r$/,"")}
    /^[ \t]*#[ \t]*tags:/ { s=$0; sub(/^[ \t]*#[ \t]*tags:[ \t]*/,"",s); tags=s; next }
    /^[ \t]*#[ \t]*desc:/ { s=$0; sub(/^[ \t]*#[ \t]*desc:[ \t]*/,"",s); desc=s; next }
    /^[ \t]*#[ \t]*secret:/ { s=$0; sub(/^[ \t]*#[ \t]*secret:[ \t]*/,"",s); sub(/[ \t]+$/,"",s); sec=s; next }
    tolower($1)=="host" { for (i=2;i<=NF;i++) if ($i !~ /[*?!]/) {
                            if ($i ~ /^[A-Za-z0-9._-]+$/) printf "%s\t%s\t%s\t%s\t%s\t%d\t%s\n", $i, proj, (tags==""?"-":tags), (desc==""?"-":desc), file, NR, (sec==""?"-":sec)
                            else print FILENAME ":" NR ": " $i >> skip }
                          tags=""; desc=""; sec=""; next }
    /^[ \t]*(#|$)/ { next }
    { tags=""; desc=""; sec="" }' "$f" > "$tmp/list"
  while IFS="$TAB" read -r n p t d ff l sc; do
    ( sshx -G "$n" 2>/dev/null | awk -v n="$n" -v p="$p" -v t="$t" -v d="$d" -v f="$ff" -v l="$l" -v sc="$sc" '
        $1=="hostname"{h=$2} $1=="user"{u=$2} $1=="port"{po=$2} $1=="proxyjump"{j=$2} $1=="identityfile"&&k==""{k=$0; sub(/^[^ \t]+[ \t]+/,"",k)}
        END { if (j=="none") j=""; if (t=="-") t=""; if (d=="-") d=""
              # secret: use "# secret:"; otherwise infer it from the effective IdentityFile pointing to secrets/<name>.pub (wildcard block)
              if (sc=="-") { sc=""; if (match(k, /secrets\/[^\/]+\.pub$/)) sc=substr(k, RSTART+8, RLENGTH-12) }
              printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", n,p,h,u,po,j,k,t,d,f,l,sc }' > "$tmp/$l-$n.row" ) &
    i=$((i+1)); [ $((i % 16)) -eq 0 ] && wait
  done < "$tmp/list"; wait
  ls "$tmp" | grep '\.row$' | sort -t- -k1,1n | while read -r r; do cat "$tmp/$r"; done
  rm -rf "$tmp"
}
# Detect changes with checksums (cksum), not modification times: Bash "-nt" has only second precision.
conf_sums(){ cksum "$DIR"/*.conf "${SSHCFG:-$HOME/.ssh/config}" 2>/dev/null; }
build_index(){ # [full]
  local f base full=${1:-} now old config=${SSHCFG:-$HOME/.ssh/config}
  if legacy_authority_present; then
    legacy_destinations "$DIR"/*.conf "$IDXD" "$IDXD"/* "$IDX.tmp" "$STATE/skipped" || return 65
    local TMPDIR=$IDXD
    export TMPDIR
  fi
  mkdir -p "$IDXD"; now=$(conf_sums); old=$(cat "$IDXD/sums" 2>/dev/null)
  sum_of(){ printf '%s\n' "$2" | awk -v f="$1" '{path=$0; sub(/^[^ \t]+[ \t]+[^ \t]+[ \t]+/,"",path); if(path==f) print $1 " " $2}'; }
  [ "$(sum_of "$config" "$now")" != "$(sum_of "$config" "$old")" ] && [ -n "$old" ] && full=1
  for base in "$IDXD"/*.tsv; do [ -f "$base" ] || continue; f=$DIR/$(basename "$base" .tsv).conf
    [ -f "$f" ] && continue; [ -f "$base.wild" ] && full=1; rm -f "$base" "$base.wild"; done   # the file was deleted
  for f in "$DIR"/*.conf; do [ -f "$f" ] || continue; base=$IDXD/$(basename "$f" .conf).tsv
    if [ ! -f "$base" ] || [ "$(sum_of "$f" "$now")" != "$(sum_of "$f" "$old")" ]; then
      { has_wild "$f" || [ -f "$base.wild" ]; } && [ -f "$base" ] && full=1
      : > "$base.dirty"; fi; done
  [ -n "$full" ] && { rm -f "$IDXD"/*.tsv "$IDXD"/*.wild; : > "$STATE/skipped"; }
  for f in "$DIR"/*.conf; do [ -f "$f" ] || continue; base=$IDXD/$(basename "$f" .conf).tsv
    if [ ! -f "$base" ] || [ -f "$base.dirty" ]; then
      index_file "$f" > "$base.tmp" && mv "$base.tmp" "$base"
      if has_wild "$f"; then : > "$base.wild"; else rm -f "$base.wild"; fi
    fi; rm -f "$base.dirty"; done
  { for f in "$DIR"/*.conf; do [ -f "$f" ] && cat "$IDXD/$(basename "$f" .conf).tsv"; done; } > "$IDX.tmp" 2>/dev/null; mv "$IDX.tmp" "$IDX"
  printf '%s\n' "$now" > "$IDXD/sums"
}
ensure_index(){
  [ -d "$DIR" ] || { [ -z "$LEGACY_READONLY" ] || return 65; : > "$IDX"; return; }
  local old=; IFS= read -r -d '' old 2>/dev/null < "$IDXD/sums" || :
  [ -f "$IDX" ] && [ "$(conf_sums)" = "${old%$'\n'}" ] && return 0
  # Only a cache miss reaches the cold builder, which validates every destination on an approved device.
  build_index
}
host_field(){ awk -F'\t' -v n="$1" -v c="$2" '{sub(/\r$/,"")} $1==n{print $c; exit}' "$IDX"; }   # 2 project 3 ip 4 user 5 port 6 jump 7 key 8 tags 9 desc 10 file 11 line 12 secret
host_exists(){ awk -F'\t' -v n="$1" '$1==n{f=1; exit} END{exit !f}' "$IDX"; }
is_prod(){ case " $(host_field "$1" 8) " in *" prod "*) return 0;; esac; return 1; }
record(){ local n; for n in "$@"; do printf '%s\t%s\n' "$(date +%s)" "$n" >> "$HIST"; done
  [ "$(wc -l < "$HIST")" -gt 3000 ] && { tail -n 1500 "$HIST" > "$HIST.tmp" && mv "$HIST.tmp" "$HIST"; }; }

# Validate the entire SSH config, including Include files. Print errors and return 1 if invalid.
validate(){ local out; out=$(sshx -G hostbook-validate-probe 2>&1 >/dev/null) && return 0; printf '%s\n' "$out" | grep -v 'terminating'; return 1; }

# ---------- groups ----------
# groups.tsv may have an empty open-mode column; read with IFS=tab collapses adjacent tabs, so split manually
group_line(){ local line=${1%$'\r'}; GN=${line%%"$TAB"*}; line=${line#*"$TAB"}; GM=${line%%"$TAB"*}; GH=${line#*"$TAB"}; }
group_field(){ awk -F'\t' -v n="$1" -v c="$2" '{sub(/\r$/,"")} $1==n{print $c; exit}' "$GRP" 2>/dev/null; }
set_group_mode(){ legacy_destinations "$GRP.tmp" || return 65; awk -F'\t' -v OFS='\t' -v n="$1" -v m="$2" '{sub(/\r$/,"")} $1==n{$2=m} {print}' "$GRP" > "$GRP.tmp" && mv "$GRP.tmp" "$GRP"; }

# ---------- fzf list ----------
mode_label(){ case $1 in sync|split|tabs) t "mode_$1";; *) t mode_ask;; esac; }
# Width available for list content, accounting for preview position and borders.
list_width(){ # [var]
  local c w preview border; term_cols c; w=$((c - 6)); cfg preview right preview
  # fzf callbacks expose the actual preview dimensions; these variables are absent when the preview is hidden.
  if [ -n "${FZF_COLUMNS:-}" ]; then
    if [ "${FZF_PREVIEW_LEFT:-0}" -gt $((c / 2)) ]; then preview=right; else preview=hidden; fi
  fi
  if [ "$preview" = right ] && [ $((c * 38 / 100)) -ge 36 ]; then w=$((c - c * 38 / 100 - 8)); fi
  cfg border rounded border; [ "$border" != none ] || w=$((w + 2))
  [ "$w" -ge 12 ] || w=12
  if [ -n "${1:-}" ]; then printf -v "$1" '%s' "$w"; else echo "$w"; fi
}
list_data(){ # key, name, project, IP, user, tags, description, secret, last use / secondary line
  local s alive line only=${HOSTBOOK_ONLY:-} IDX=$IDX GRP=$GRP f_sess f_sess_h f_grp
  tv f_sess list_session; tv f_sess_h list_session_hint; tv f_grp list_group   # once, not per row (hot path)
  local filter= history=$HIST
  [ -f "$history" ] || history=/dev/null
  if [ -n "$only" ] && [ -f "$only" ]; then filter=$only; GRP=/dev/null; fi
  if have tmux && [ -z "$only" ]; then
    while IFS="$TAB" read -r s alive; do
      printf "s:%s\t%s\t\t\t\t\t$f_sess\t\t%s\n" "$s" "${s#hb-}" "$alive" "$f_sess_h"
    done < <(tmux list-panes -a -F '#{session_name}	#{pane_dead}' 2>/dev/null | awk -F '\t' '$1 ~ /^hb-/ && $2 == 0 {if (!($1 in count)) order[++n]=$1; count[$1]++} END {for (i=1; i<=n; i++) print order[i] "\t" count[order[i]]}')
  fi
  if [ -f "$GRP" ]; then while IFS= read -r line; do
    [ -n "$line" ] || continue; group_line "$line"; set -- $GH
    printf "g:%s\t%s\t\t\t\t\t$f_grp\t\t%s\n" "$GN" "$GN" "$#" "$(mode_label "$GM")" "$GH"
  done < "$GRP"; fi
  awk -F'\t' -v now="$(date +%s)" -v filter="$filter" '
    BEGIN {if(filter!="") while ((getline item < filter)>0) allowed[item]=1}
    function ago(t, d){if(!t)return "-"; d=now-t; return d<3600?(d<120?1:int(d/60)) "m":d<86400?int(d/3600) "h":int(d/86400) "d"}
    FILENAME==ARGV[1] {d=now-$1; score[$2]+=(d<3600?4:d<86400?2:d<604800?1:0.5); if($1>last[$2])last[$2]=$1; next}
    filter!="" && !($1 in allowed) {next}
    {printf "%010.2f\th:%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",score[$1],$1,$1,$2,$3,$4,$8,$9,$12,ago(last[$1])}
  ' "$history" "$IDX" | sort -t"$TAB" -k1,1r -k2,2 | cut -f2-
}
esc_bg(){ # color [var]
  local fg; esc_fg "$1" fg
  case $fg in "$E[38;"*) fg="$E[48;${fg#"$E[38;"}";; "$E[3"*) fg="$E[4${fg#"$E[3"}";; "$E[9"*) fg="$E[10${fg#"$E[9"}";; esac
  printf ${2:+-v "$2"} '%s' "$fg"
}
list_rows(){ # style, width; field 2 contains visible content only, field 3 preserves all searchable data
  local chips='' c chipmap='' p i n=0 b chipfg=''
  for c in $TH_CHIPS; do n=$((n+1)); [ -n "${NO_COLOR:-}" ] || { esc_bg "$c" b; chips="$chips$b,"; }; done
  [ -n "${NO_COLOR:-}" ] || esc_fg "$TH_CHIP_FG" chipfg
  if [ "${3:-}" = demo ] || [ -f "$IDX" ]; then
    while IFS= read -r p; do i=$(printf '%s' "$p" | cksum | cut -d' ' -f1); chipmap="$chipmap$p:$((i % n + 1))\n"; done < <(if [ "${3:-}" = demo ]; then demo_rows | awk -F'\t' '$1~/^h:/&&!seen[$3]++ {print $3}'; else cut -f2 "$IDX" | sort -u; fi)
  fi
  LC_ALL=C awk -F'\t' -v style="$1" -v W="$2" -v cb="$CB" -v c0="$C0" -v cd="$CD" -v cu="$CU" -v cr="$CR" \
    -v group="$ICON_GROUP" -v session="$ICON_SESSION" -v prod="$ICON_PROD" -v chips="$chips" -v chipfg="$chipfg" -v chipmap="$chipmap" '
    function vlen(s, t){t=s; gsub(/\033\[[0-9;]*m/,"",t); gsub(/[\200-\277]/,"",t); return length(t)}
    function fit(s,w, o,i,c,esc,ch){
      if(w<1)return ""; if(vlen(s)<=w)return s
      o="";c=0;esc=0
      for(i=1;i<=length(s);i++){ch=substr(s,i,1); if(ch=="\033")esc=1
        if(!esc && ch !~ /[\200-\277]/){if(c>=w-1)break;c++} o=o ch; if(esc && ch=="m")esc=0}
      return o "…" c0
    }
    function pad(s,w){return fit(s,w) sprintf("%" (w>vlen(s)?w-vlen(s):0) "s","")}
    BEGIN {split(chips,bg,","); count=split(chipmap,cm,"\n"); for(i=1;i<=count;i++){split(cm[i],kv,":"); color[kv[1]]=kv[2]}}
    {
      type=substr($1,1,1); hidden=$2 " " $3 " " $4 " @" $5 " " $7 " " $9; tags=$6; gsub(/ +/," #",tags); hidden=hidden " #" tags " secret:" $8
      if(type!="h"){
        name=(type=="g"?group:session) " " $2
        vis=fit(cu cb name c0 "  " cd $7 c0,W)
        if(style=="cards")vis=vis "\n" fit(cd "  " $9 c0,W)
      }else if(style=="minimal"){
        mark=(" " $6 " " ~ / prod /?" " cr prod "prod" c0:"")
        room=W-vlen(mark)-vlen($4)-2
        if(room>=8)vis=fit($2,room) mark "  " cd $4 c0
        else vis=fit($2,W-vlen(mark)) mark
      }else{
        tagtext=""; nt=split($6,tt," ")
        for(i=1;i<=nt;i++)if(tt[i]!="" && tt[i]!="prod")tagtext=tagtext (i>1?" ":"") (tt[i]=="prod"?cr prod "prod":cu "#" tt[i]) c0
        nw=(W<70?16:W<110?20:26); if(style=="cards" && W>=45)nw=26; if(nw>W-4)nw=W-4
        mark=(" " $6 " " ~ / prod /?" " cr prod "prod" c0:"")
        name=fit($2,nw-vlen(mark)) mark
        if(style=="cards"){
          chip=(bg[1]==""?cu:bg[(color[$3]?color[$3]:1)] chipfg)
          vis=fit(cb pad(name,nw) c0 "  " chip " " $3 " " c0 "  " tagtext,W)
          detail="  " $4 " · @" $5 ($7!=""?" · " $7:""); age=$9
          room=W-vlen(age)-2; vis=vis "\n" cd pad(detail,room) "  " age c0
        }else{
          vis=pad(name,nw) "  "; used=nw+2
          if(used+19<=W){vis=vis pad(tagtext,18) " ";used+=19}
          if(used+16<=W){vis=vis cd pad($4,16) c0;used+=16}
          if(used+11<=W){vis=vis cd pad("@" $5,11) c0;used+=11}
          if(used+13<=W){vis=vis cd pad($3,13) c0;used+=13}
          if(used+5<=W){vis=vis cd pad($9,5) c0;used+=5}
          if(used+8<=W)vis=vis cd fit($7,W-used) c0
          vis=fit(vis,W)
        }
      }
      split(vis,vl,"\n"); vis=pad(vl[1],W); if(style=="cards")vis=vis "\n" pad(vl[2],W)
