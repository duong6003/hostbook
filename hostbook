# Change a server login method: remove the old login lines from its block and write new ones.
set_host_secret(){ # server-name secret-name(empty = SSH handles it)
  legacy_destinations "$DIR"/*.conf || return 65
  local n=$1 sc=${2:-} f l r old oldpw="" ll
  f=$(host_field "$n" 10); l=$(host_field "$n" 11); r=$(block_range "$n"); old=$(host_field "$n" 12)
  legacy_destinations "$f" "$f.tmp" || return 65
  [ -n "$old" ] && [ "$(secret_meta "$old" type)" = password ] && oldpw=1
  ll=$(tmpd) || return 1; ll=$ll/ll; login_lines "$sc" > "$ll" || return 1
