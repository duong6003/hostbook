    i=$(UI_HEAD="$(t first_data_intro)" \
      ui_choice "$(t first_how)" "$(t act_first_new)" "$(t act_first_remote)") || return 1
  fi
  case $i in
    1) m=$(pick_machine "$(t first_pick_machine)" url) || return 1
       if is_url "$m"; then url=$m; else ensure_key "$m" || return 1; url="$m:repos/ssh-hosts.git"; fi
       GIT_SSH_COMMAND=$(git_ssh 8) gum spin --title "$(t first_cloning)" -- git clone -q "$url" "$DIR" || { err "$(t err_clone "$url")"; return 1; };;
    *) private_dir "$DIR" || return 1; git -C "$DIR" init -q
       printf '*\n!*.conf\n!.gitignore\n!.gitattributes\n!groups.tsv\n!secrets/\n!secrets/*.age\n!secrets/*.pub\n!secrets/*.meta\n' > "$DIR/.gitignore"
       if [ -f "$HOME/.ssh/config" ] && grep -qiE '^[[:space:]]*host([[:space:]]|=)+[^*[:space:]]' "$HOME/.ssh/config"; then
         initial=$(tmpd) || return 1
         cp "$HOME/.ssh/config" "$initial/original" || return 1
         awk 'tolower($1)=="include" && $2=="~/ssh-hosts/*.conf" && NF==2 {next} {print}' "$initial/original" > "$initial/import" || return 1
       fi
       g add -A && g commit -qm "$(t first_commit)" >/dev/null;;
  esac
  chmod 700 "$DIR"; ensure_merge_setup
  if [ -n "$initial" ]; then
    : > "$initial/empty" || return 1
    SSHCFG="$initial/empty" vault_init || return 1
  else vault_init || return 1; fi
  if [ -n "$initial" ] && ui_confirm --affirmative "$(t first_import_yes)" --negative "$(t first_import_no)" "$(t first_import_q)"; then
    [ ! -L "$HOME/.ssh/config" ] || { err "$(t err_import_config_symlink)" >&2; return 1; }
