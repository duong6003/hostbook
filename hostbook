#!/usr/bin/env bash
# hostbook: find, connect to, and sync SSH servers.
#
# Data (in ~/ssh-hosts, synced with git, separate from the app):
#   <project>.conf   standard SSH config; "# tags: a b" and "# desc: ..." go immediately above Host
#   groups.tsv       groups: name<TAB>open mode<TAB>server server ...
# The shared repository is the "origin" remote of ~/ssh-hosts: a bare repo on an always-on machine reachable over the network.
# Local to each machine (not synced): ~/.local/state/hostbook (usage history, index, status).
#
# Requires git, fzf >= 0.63, gum >= 0.14, and tmux to open multiple servers. Bash 3.2 compatible.
resolve_self(){ # path → SELF, absolute with symlinks resolved; cd in this shell instead of a subshell
  local p=$1 l d o=$PWD link_tool=/usr/bin/readlink
  while [ -L "$p" ]; do
    [ -x "$link_tool" ] || link_tool=/bin/readlink
    l=$("$link_tool" "$p") || return 65
    case $l in /*) p=$l;; *) case $p in */*) p=${p%/*}/$l;; *) p=$l;; esac;; esac
  done
  case $p in */*) d=${p%/*}; [ -n "$d" ] || d=/;; *) d=.;; esac
  SELF=; CDPATH= cd -- "$d" 2>/dev/null && SELF=$PWD/${p##*/}; CDPATH= cd -- "$o" 2>/dev/null || :
}
legacy_authority_present(){
  local HOME
  unset HOME
  local authority_home=~
  local parent=$authority_home next part
  for part in .config hostbook; do
    [ -d "$parent" ] && [ -x "$parent" ] && [ -r "$parent" ] || return 0
    next=$parent/$part
    [ ! -L "$next" ] || return 0
    [ -e "$next" ] || return 1
    parent=$next
  done
  [ -d "$parent" ] && [ -x "$parent" ] && [ -r "$parent" ] || return 0
  [ -e "$parent/store-account-v1.json" ] || [ -L "$parent/store-account-v1.json" ]
}
# The authority check cannot delegate a decision to the caller's PATH.
guard_python_path(){
  if [ -x /usr/bin/python3 ]; then GUARD_PYTHON=/usr/bin/python3; return 0; fi
  case $OSTYPE in linux*) ;; *) return 65;; esac
  local exe part properties owner mode stat_tool=/usr/bin/stat link_tool=/usr/bin/readlink
  [ -x "$stat_tool" ] || stat_tool=/bin/stat
  [ -x "$link_tool" ] || link_tool=/bin/readlink
  exe=$("$link_tool" -f /usr/local/bin/python3) || return 65
  [[ $exe =~ ^/usr/local/bin/python3[.][0-9]+$ ]] || return 65
  for part in / /usr /usr/local /usr/local/bin "$exe"; do
    properties=$("$stat_tool" -Lc '%u %a' "$part") || return 65
    owner=${properties%% *}; mode=${properties#* }
    [ "$owner" = 0 ] && [[ $mode =~ ^[0-7]+$ ]] && [ $((8#$mode & 022)) -eq 0 ] || return 65
  done
  GUARD_PYTHON=$exe
}
guard_python(){ local GUARD_PYTHON; guard_python_path && "$GUARD_PYTHON" "$@"; }
# Refusing a source must preserve paths and options already set in the caller.
if [ "${BASH_SOURCE:-}" != "$0" ]; then
  if [ -e "${HOSTBOOK_DIR:-$HOME/ssh-hosts}/.hostbook" ] || [ -L "${HOSTBOOK_DIR:-$HOME/ssh-hosts}/.hostbook" ]; then
    return 65
  fi
  if legacy_authority_present && ! (
    resolve_self "${BASH_SOURCE[0]}" || exit 65
    guard_python -I -B -S "${SELF%/*}/lib/store_context.py" _legacy_destinations \
      "${HOSTBOOK_DIR:-$HOME/ssh-hosts}" "${HOSTBOOK_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/hostbook}" \
      "${XDG_CONFIG_HOME:-$HOME/.config}/hostbook" >/dev/null 2>&1
  ); then return 65; fi
fi
set -u
# Closing the terminal must end hostbook and its gum/fzf (#4). "trap cleanup EXIT" makes bash defer SIGHUP until the
# foreground child exits, and gum ignores a revoked terminal. So the terminal's process is this trap-free parent: it
# dies on SIGHUP at once, the kernel then hangs up the whole foreground group, and the app below runs cleanup.
# Internal callbacks, scoped Connect and sourced tests skip it.
# Limit: SIGTERM sent to this parent alone (e.g. `timeout`) is not forwarded; signal the process group instead.
if [ -z "${HOSTBOOK_APP:-}" ] && [ "${BASH_SOURCE:-}" = "$0" ]; then
  case ${1:-}:$OSTYPE in _*:*|store-connect:*) ;; *:darwin*|*:linux*) HOSTBOOK_APP=1 "$BASH" "$0" "$@"; exit;; esac
fi
unset HOSTBOOK_APP
umask 077   # only the machine owner can read the server list and state
VERSION=0.4.0
case ${1:-} in --version|-v|version) echo "hostbook $VERSION"; exit 0;; esac   # before parsing the rest: this is the cheapest path
FZF_MIN=0.63; GUM_MIN=0.14; AGE_MIN=1.3.0
REPO_URL=https://github.com/duong6003/hostbook

# Boot runs on every fzf callback: no forks here unless needed (#5).
resolve_self "${BASH_SOURCE[0]}" || { [ "${BASH_SOURCE[0]}" = "$0" ] || return 65; exit 65; }
LEGACY_GUARD_LIB=${SELF%/*}/lib/store_context.py
# Store registration and queries run before legacy state initialization.
case ${1:-} in
  store-transfer|store-transfer-recover|store-transfer-preview|_store_add|store-add|_store_import|store-import|_store_mode|store-mode|_store_settle|store-settle|_store_edit_address|store-edit-address|_store_receive|store-receive)
    if [ "${BASH_SOURCE:-}" = "$0" ]; then
      guard_python_path || exit 64
      exec "$GUARD_PYTHON" -I -B -S "$LEGACY_GUARD_LIB" "$@"
    fi;;
  _store_context|_approve_store_account|_refresh_store_index|_refresh_store_status|_store_hosts|_store_preview|_store_connect|store-hosts|store-preview|store-connect)
    if [ "${BASH_SOURCE:-}" = "$0" ]; then
      command -v python3 >/dev/null 2>&1 || exit 64
      exec python3 -I -B -S "${SELF%/*}/lib/store_context.py" "$@"
    fi;;
esac
# ---------- languages (docs/design/screens.md#language) ----------
# UI text lives in lang/<code>.sh as L_<key>='…' (a printf format when the key takes arguments). vi.sh is the complete
# base and other languages override it, so a missing translation shows Vietnamese rather than a key name.
lang_load(){
  local d=${HOSTBOOK_LANG_DIR:-${SELF%/*}/lang} l
  l=${HOSTBOOK_LANG:-}; [ -n "$l" ] || cfg lang "" l   # HOSTBOOK_LANG overrides the config (tests, one-off runs)
  case $l in vi|en) ;; *) l=;; esac   # a name is used as a file name below: only known languages
  if [ -z "$l" ]; then case ${LC_ALL:-${LC_MESSAGES:-${LANG:-}}} in vi*) l=vi;; *) l=en;; esac; fi
  # every language file defines every key (tests/screens.sh, S11), so one file is enough
  UI_LANG=$l; if [ -f "$d/$l.sh" ]; then . "$d/$l.sh"; elif [ -f "$d/vi.sh" ]; then . "$d/vi.sh"; UI_LANG=vi; fi   # no lang dir (a copied script): keys show as ‹L_…›, nothing fails
}
t(){ # key [args…] → text for key (printf format when arguments follow); an unknown key prints ‹L_key›
  local _k=L_$1; shift
  if [ $# -gt 0 ]; then printf -- "${!_k-‹${_k}›}" "$@"; else printf '%s' "${!_k-‹${_k}›}"; fi; }
LIBDIR=${HOSTBOOK_LIB_DIR:-${SELF%/*}/lib}
IS_MAC=; LOCK_TOOL=flock; case $OSTYPE in darwin*) IS_MAC=1; LOCK_TOOL=lockf;; esac
private_dir(){ legacy_destinations "$1" && mkdir -p "$1" && chmod 700 "$1"; }
DIR=${HOSTBOOK_DIR:-$HOME/ssh-hosts}
case ${1:-} in
  _store_transfer_labels)
    [ "${BASH_SOURCE[0]}" = "$0" ] || return 65
    HOSTBOOK_LANG_DIR=${SELF%/*}/lang HOSTBOOK_LANG=${HOSTBOOK_LANG:-${LANG:-en}} lang_load
    printf '%s\n' "$FZF_MIN"
    for key in transfer_source_pw transfer_destination_pw transfer_backup_pw transfer_backup_repeat transfer_recovery_code transfer_code_repeat; do t "$key"; printf '\n'; done
    exit 0;;
  add|import)
    if [ "${BASH_SOURCE[0]}" = "$0" ] && legacy_authority_present &&
       guard_python -I -B -S "$LEGACY_GUARD_LIB" _registered_selection "$DIR" >/dev/null 2>&1; then
      case $1:$# in
        add:3) guard_python -I -B -S "$LEGACY_GUARD_LIB" store-add "$3" "$2"; exit $?;;
        import:2) [ -f "$2" ] || exit 65; guard_python -I -B -S "$LEGACY_GUARD_LIB" store-import < "$2"; exit $?;;
      esac
    fi;;
esac
# A v1 checkout requires explicit registration and scoped store operations.
if [ -e "$DIR/.hostbook" ] || [ -L "$DIR/.hostbook" ]; then
  [ "${BASH_SOURCE:-}" = "$0" ] || return 65
  HOSTBOOK_LANG_DIR=${SELF%/*}/lang HOSTBOOK_LANG=${HOSTBOOK_LANG:-${LANG:-en}} lang_load
  t err_legacy_store >&2; printf '\n' >&2
  exit 65
fi
# Check the effective account's independently approved bindings again at cold data-writing helpers.
# Local HOME isolation keeps a caller-supplied HOME from selecting the authority.
legacy_destinations(){
  legacy_authority_present || return 0
  [ -r "$LEGACY_GUARD_LIB" ] && guard_python -I -B -S "$LEGACY_GUARD_LIB" _legacy_destinations \
    "$DIR" "${STATE:-${HOSTBOOK_STATE:-}}" "${SEC:-}" "${GRP:-}" "${IDX:-}" "${HIST:-}" \
    "${GIT_DIR:-}" "${GIT_COMMON_DIR:-}" "${GIT_WORK_TREE:-}" "${GIT_INDEX_FILE:-}" "${GIT_OBJECT_DIRECTORY:-}" \
    "$@" >/dev/null 2>&1 || return 65
}
STATE=${HOSTBOOK_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/hostbook}
LEGACY_READONLY=
case ${1:-} in
  _demo|_list|_preview|_header|_footer|_footers|_footer_data) legacy_authority_present && LEGACY_READONLY=1;;
  *) if ! legacy_destinations "$STATE/history" "$STATE/idx2" "$STATE/index.tsv" "${XDG_CONFIG_HOME:-$HOME/.config}/hostbook"; then
       [ "${BASH_SOURCE[0]}" = "$0" ] || return 65
       HOSTBOOK_LANG_DIR=${SELF%/*}/lang HOSTBOOK_LANG=${HOSTBOOK_LANG:-${LANG:-en}} lang_load
       t err_legacy_store >&2; printf '\n' >&2; exit 65
     fi ;;
esac
SSHCFG=${HOSTBOOK_SSH_CONFIG:-}   # test override for ~/.ssh/config
IDX=$STATE/index.tsv; HIST=$STATE/history; ST=$STATE/status; FLASH=$STATE/flash
GRP=$DIR/groups.tsv
ME=${USER:-$(id -un)}
TAB=$'\t'; NL=$'\n'
# ${#string} counts accented characters correctly only in a UTF-8 locale; minimal Ubuntu has C.UTF-8, macOS has en_US.UTF-8
case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in *[Uu][Tt][Ff]*8*) ;; *)
  for l in C.UTF-8 en_US.UTF-8; do locale -a 2>/dev/null | grep -qix "$l\|${l%UTF-8}utf8" && { export LC_CTYPE=$l; break; }; done;; esac
# Commands a person runs re-apply 700 to the state dir; callbacks and --version only create a missing one (mkdir+chmod fork).
private=1
case ${1:-} in _*) [ -d "$STATE" ] && [ -O "$STATE" ] && private=;; esac
if [ -z "$LEGACY_READONLY" ] && [ -n "$private" ]; then
  private_dir "$STATE" || STATE_FAIL=1   # reported once the language is loaded (bottom of this file)
fi
[ -n "$LEGACY_READONLY" ] || [ -f "$HIST" ] || { cp "$HOME/.local/state/sshm/history" "$HIST" 2>/dev/null || : > "$HIST"; }   # preserve history from the sshm prototype

E=$'\033'; C0="$E[0m"; CB="$E[1m"

# ---------- helpers ----------
LOCK_HELD=""
# A closing terminal can send SIGHUP twice. Bash's default handling of a second one kills it before the EXIT trap,
# so trap HUP explicitly, and keep rm/rmdir from dying of it.
cleanup(){ [ -z "$LEGACY_READONLY" ] || return 0; trap '' HUP; set -- "$STATE/tmp/$$".*; [ ! -e "$1" ] || rm -rf "$@" 2>/dev/null; [ -z "$LOCK_HELD" ] || unlock; return 0; }
trap cleanup EXIT; trap 'exit 129' HUP
# Only the owner can read temporary directories; plaintext secrets must stay here. Removed automatically on exit.
tmpd(){ private_dir "$STATE/tmp" || return 1; mktemp -d "$STATE/tmp/$$.XXXXXX"; }
ssh_path(){ case $1 in *[[:space:]]*) printf '\"%s\"' "$1";; *) printf '%s' "$1";; esac; }
self_cmd(){ printf 'bash %q' "$SELF"; }
clip_get(){ if have pbpaste; then pbpaste; elif have wl-paste; then wl-paste; elif have xclip; then xclip -o -selection clipboard; elif have xsel; then xsel -ob; else return 1; fi; }
sha256(){ if have sha256sum; then sha256sum | cut -d' ' -f1; else shasum -a 256 | cut -d' ' -f1; fi; }
export GIT_OPTIONAL_LOCKS=0   # background git status must not contend for the index lock with another sync
g(){
  case ${1:-} in
    add|checkout|commit|fetch|merge|pull|push|read-tree|rebase|reset|revert|rm|update-ref|write-tree|-c)
      legacy_destinations "$DIR/.git" || return 65;;
  esac
  git -C "$DIR" "$@"
}
revert_in_progress(){ g rev-parse -q --verify REVERT_HEAD >/dev/null 2>&1; }
sshx(){ if [ -n "$SSHCFG" ]; then ssh -F "$SSHCFG" "$@"; else ssh "$@"; fi; }
scpx(){ if [ -n "$SSHCFG" ]; then scp -F "$SSHCFG" "$@"; else scp "$@"; fi; }
git_ssh(){ printf 'ssh%s -o BatchMode=yes -o ConnectTimeout=%s' "${SSHCFG:+ -F $(printf %q "$SSHCFG")}" "${1:-4}"; }
ok(){ printf "%s${ICON_OK}%s %s\n" "$CG" "$C0" "$*"; }
warn(){ printf '%s%s%s %s\n' "$CY" "$ICON_WARN" "$C0" "$*"; }
err(){ printf "%s${ICON_ERR}%s %s\n" "$CR" "$C0" "$*"; }
dim(){ printf '%s%s%s\n' "$CD" "$*" "$C0"; }
flash(){ printf '%s\t%s\n' "$(date +%s)" "$*" > "$FLASH"; }
have(){ command -v "$1" >/dev/null 2>&1; }
perm(){ stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }
port_open(){ # host port [seconds]: check whether a TCP port is open; use Bash /dev/tcp on minimal Linux without nc
  if have nc; then if is_mac; then nc -z -G "${3:-1}" "$1" "$2" 2>/dev/null; else nc -z -w "${3:-1}" "$1" "$2" 2>/dev/null; fi
  else (exec 3<>"/dev/tcp/$1/$2") 2>/dev/null; fi; }   # try GNU first: on Linux, "stat -f" is a different command that does not fail
is_mac(){ [ -n "$IS_MAC" ]; }
copy(){ if have pbcopy; then pbcopy; elif have wl-copy; then wl-copy; elif have xclip; then xclip -selection clipboard; elif have xsel; then xsel -b; else return 1; fi; }
has_remote(){ [ -n "$(g remote 2>/dev/null)" ]; }
remote_url(){ g remote get-url origin 2>/dev/null; }
kho_addr(){ local u; u=$(remote_url); case $u in /*) t kho_addr_here;; file://*) u=${u#file://}; t kho_addr_dir "${u/#$HOME/~}";; *://*) u=${u#*://}; u=${u#*@}; echo "${u%%/*}";; *@*:*) echo "${u%%:*}";; *) echo "$u";; esac; }
is_url(){ case $1 in *://*|*@*:*) return 0;; esac; return 1; }   # a git URL (ssh://…, git@host:path/to/repo), rather than user@machine
valid_name(){ case $1 in ""|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0-9._-]*) return 1;; esac; }   # server names allow only letters, digits, . _ - (untrusted repository names must not execute as commands)
ver_ge(){ [ "$(printf '%s\n%s\n' "$2" "$1" | sort -t. -k1,1n -k2,2n -k3,3n | head -1)" = "$2" ]; }   # $1 >= $2

tv(){ local _o=$1 _k=L_$2; shift 2; if [ $# -gt 0 ]; then printf -v "$_o" -- "${!_k-‹${_k}›}" "$@"; else printf -v "$_o" '%s' "${!_k-‹${_k}›}"; fi; }

# Progress screens are text: `title`, a short line, then one line that shows what runs, elapsed / limit and how to cancel.
PROG_COLS=80
prog_line(){ # message elapsed limit tick → that one line, redrawn in place (on stderr, callers may be inside $(...))
  local m=$1 tail sp=('⣾' '⣽' '⣻' '⢿' '⡿' '⣟' '⣯' '⣷')
  tv tail prog_tail "$2" "$3"; [ $(( ${#m} + ${#tail} + 6 )) -le "$PROG_COLS" ] || tv tail prog_tail_short "$2" "$3"
  [ $(( ${#m} + ${#tail} + 6 )) -le "$PROG_COLS" ] || m="${m:0:$(( PROG_COLS - ${#tail} - 7 ))}…"
  printf '\r\033[K  %s%s%s %s%s%s%s' "$CP" "${sp[$(( $4 % 8 ))]}" "$C0" "$m" "$CD" "$tail" "$C0" >&2
}
kill_tree(){ # pid… → TERM each process and all its descendants (found first, so nothing is reparented away), KILL what is left
  local all="" new="$*" c p
  while [ -n "$new" ]; do all="$all $new"; c=""
    # Keep a ps fallback for minimal systems without pgrep.
    if have pgrep; then for p in $new; do c="$c $(pgrep -P "$p" 2>/dev/null | tr '\n' ' ')"; done
    else c=$(ps -ef 2>/dev/null | awk -v l=" $new " '{ if (index(l, " " $3 " ")) printf "%s ", $2 }'); fi
    new=$(echo $c); done
  kill -TERM $all 2>/dev/null || :; sleep 0.3; kill -KILL $all 2>/dev/null || :; return 0
}
# run_progress MESSAGE LIMIT OUTFILE CMD… → CMD runs in the background (stdout in OUTFILE) under a progress line. Status: CMD's
# own; 130 after ctrl-c; 124 when the limit passed. In both of the last two cases CMD is stopped.
run_progress(){
  local msg=$1 lim=$2 out=$3 pid t0=$SECONDS el k=0 stop=; shift 3
  PROG_COLS=$(term_cols); "$@" > "$out" 2>/dev/null </dev/null & pid=$!
  trap 'stop=130' INT
  while kill -0 $pid 2>/dev/null; do
    el=$(( SECONDS - t0 )); [ -z "$stop" ] || break; [ "$el" -lt "$lim" ] || { stop=124; break; }
    prog_line "$msg" "$el" "$lim" "$k"; k=$((k+1)); sleep 0.2
  done
  trap - INT; printf '\r\033[K' >&2
  if [ -n "$stop" ]; then kill_tree $pid; { wait $pid; } 2>/dev/null; return "$stop"; fi
  wait $pid
}
ask_pw(){ # header [error] → print what was typed. Password fields stay gum input (fzf cannot mask): the breadcrumb first, the rule in gum's
  # header. Everything but the password goes to stderr because callers use $(...).
  { clear; title "$UI_AT"; [ -z "${2:-}" ] || err "$2"; ui_keys "enter:$(t key_confirm)" "esc:$(t key_cancel)"; printf '\n\n'; } >&2
  gum input --password --placeholder "" --header "$1"
}
. "$LIBDIR/ui.sh" || exit 1

# ---------- machine-local configuration and theme ----------
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/hostbook
CFG=$CONF/config
# Helpers that take an optional trailing [var] assign the result to it with printf -v instead of printing (no subshell).
kv_next(){ # read the next "key = value  # comment" line of stdin into KK and KV, skipping comment lines; 1 at EOF
  local line ws=$' \t'
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}; KK=${line#"${line%%[!$ws]*}"}; case $KK in '#'*) continue;; esac
    KK=${line%%=*}; KK=${KK#"${KK%%[!$ws]*}"}; KK=${KK%"${KK##*[!$ws]}"}
    KV=${line#*=}; KV=${KV%%[$ws]'# '*}; KV=${KV#"${KV%%[!$ws]*}"}; KV=${KV%"${KV##*[!$ws]}"}
    return 0
  done; return 1
}
cfg_load(){ # parse $CFG into CFG_MEM ("\nkey=value" lines, last wins); cfg reloads when CFG changes, cfg_set after writing
  local KK KV; CFG_SRC=$CFG; CFG_MEM=$'\n'
  [ -f "$CFG" ] || return 0
  while kv_next; do [ -z "$KK" ] || CFG_MEM="$CFG_MEM$KK=$KV"$'\n'; done < "$CFG"
}
cfg_raw(){ # key [var]: value as written, or nothing (status 1) when unset
  local _cr; [ "${CFG_SRC-}" = "$CFG" ] || cfg_load
  case $CFG_MEM in *$'\n'"$1="*) ;; *) return 1;; esac
  _cr=${CFG_MEM##*$'\n'"$1="}; _cr=${_cr%%$'\n'*}
  if [ -n "${2:-}" ]; then printf -v "$2" '%s' "$_cr"; else printf '%s\n' "$_cr"; fi
}
duration(){ local d; case $1 in *h) d=$(( ${1%h} * 3600 ));; *m) d=$(( ${1%m} * 60 ));; *) d=$1;; esac
  if [ -n "${2:-}" ]; then printf -v "$2" '%s' "$d"; else echo "$d"; fi; }
valid_theme_name(){ case $1 in ''|*[!a-zA-Z0-9_-]*) return 1;; esac; }
cfg_valid(){
  case $1:$2 in lang:vi|lang:en|list:cards|list:compact|list:minimal|border:rounded|border:sharp|border:bold|border:double|border:none|preview:right|preview:bottom|preview:hidden|separator:on|separator:off|icons:unicode|icons:ascii|icons:nerd) return 0;;
    theme:*) valid_theme_name "$2" && { theme_builtin "$2" >/dev/null || [ -f "$CONF/themes/$2.theme" ]; }; return;;
    key_ttl:*|connect_timeout:*) [[ $2 =~ ^[1-9][0-9]*[hm]?$ ]] || return 1
      [ "$1" = key_ttl ] || [[ $2 =~ ^[1-9][0-9]*$ ]] || return 1
      [ ${#2} -le 10 ] || return 1
      local n; duration "$2" n; [ "$n" -gt 0 ] && [ "$n" -le 2147483647 ]; return;;
  esac; return 1
}
cfg(){ # key default [var]
  local _cv=; cfg_raw "$1" _cv || :; cfg_valid "$1" "$_cv" || _cv=$2
  if [ -n "${3:-}" ]; then printf -v "$3" '%s' "$_cv"; else printf '%s\n' "$_cv"; fi
}
cfg_set(){
  legacy_destinations "$CONF" "$CFG" || return 65
  cfg_valid "$1" "$2" || return 1
  mkdir -p "$CONF"; local t; t=$(mktemp "$CONF/config.XXXXXX") || return 1
  { [ ! -f "$CFG" ] || awk -F= -v k="$1" '{s=$1; gsub(/^[ \t]+|[ \t]+$/,"",s); if(s!=k)print}' "$CFG"; printf '%s = %s\n' "$1" "$2"; } > "$t"
  mv "$t" "$CFG" && cfg_load
}
cfg_mem(){ cfg_valid "$1" "$2" || return 1; [ "${CFG_SRC-}" = "$CFG" ] || cfg_load; CFG_MEM="$CFG_MEM$1=$2"$'\n'; }   # like cfg_set, in memory only
cfg_init(){ [ -e "$CFG" ] || { [ ! -d "$DIR/.git" ] || cfg_set list compact; }
  local l; [ ! -d "$DIR/.git" ] || cfg_raw lang l || cfg_set lang vi; }   # installs from before languages keep Vietnamese
cfg_errors(){
  [ -f "$CFG" ] || return 0
  local line k v i=0
  while IFS= read -r line || [ -n "$line" ]; do
    i=$((i+1)); line=${line%$'\r'}; case $line in ''|\#*) continue;; esac
    k=$(printf '%s' "${line%%=*}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'); case $k in ''|\#*) continue;; esac
    v=$(printf '%s' "${line#*=}" | sed 's/[[:space:]]# .*$//;s/^[[:space:]]*//;s/[[:space:]]*$//')
    cfg_valid "$k" "$v" || { t cfg_bad_line "${CFG/#$HOME/~}" "$i" "$k" "$v"; echo; }
  done < "$CFG"
}
theme_names(){ printf '%s\n' hostbook dracula nord gruvbox solarized-dark solarized-light light high-contrast terminal; }
theme_builtin(){ # name [var]
  local palette
  # Palettes: draculatheme.com/contribute, nordtheme.com, ethanschoonover.com/solarized, github.com/morhetz/gruvbox.
  case $1 in
    hostbook) palette='212 141 244 114 221 204 238 236 235 dark|110 179 222 152 175 114 216 147';;
    dracula) palette='#ff79c6 #bd93f9 #a5abc2 #50fa7b #f1fa8c #ff5555 #6272a4 #44475a #282a36 dark|#8be9fd #ffb86c #f1fa8c #50fa7b #bd93f9';;
    nord) palette='#88c0d0 #81a1c1 #a3b1c9 #a3be8c #ebcb8b #bf616a #4c566a #434c5e #2e3440 dark|#88c0d0 #ebcb8b #a3be8c #b48ead #d08770';;
    gruvbox) palette='#fe8019 #d3869b #a89984 #b8bb26 #fabd2f #fb4934 #665c54 #3c3836 #282828 dark|#83a598 #fabd2f #b8bb26 #d3869b #8ec07c';;
