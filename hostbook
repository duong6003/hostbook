effective(){ sshx -G "$1" 2>/dev/null | awk '$1=="hostname"||$1=="user"||$1=="port"||$1=="proxyjump" {print $1 " " $2} $1=="identityfile"&&!k {k=1; print $1 " " $2}'; }
move_host_raw(){ # name project: move the entire block, then make values inherited from the old project wildcard explicit
  legacy_destinations "$DIR"/*.conf "$DIR/$2.conf" "$DIR/$2.conf.extra" || return 65
