cmd_preview(){
  local t=${1%%:*} n=${1#*:}
  case $t in
    h) ensure_index
       awk -F'\t' -v n="$n" -v cb="$CB" -v c0="$C0" -v cd="$CD" -v cu="$CU" -v cr="$CR" -v iprod="$ICON_PROD" '$1==n {
         prod=(" " $8 " " ~ / prod /)
         printf "%s%s%s%s\n", cb, $1, c0, (prod? "  " cr cb iprod " PROD" c0 : "")
         printf "%s%s%s\n", cd, ($9==""?"(chưa có mô tả)":$9), c0
         t=$8; gsub(/ /," #",t); printf "%s%s%s\n\n", cu, ($8==""?"(chưa có tag)":"#" t), c0
         printf "%sHost%s %s\n  %sHostName%s %s\n  %sUser%s %s\n", cu, c0, $1, cd, c0, $3, cd, c0, $4
         if ($5!="22") printf "  %sPort%s %s\n", cd, c0, $5
         if ($6!="") printf "  %sProxyJump%s %s\n", cd, c0, $6
         if ($12=="" && $7!="") printf "  %sIdentityFile%s %s\n", cd, c0, $7
         printf "\n%s%s:%s%s\n", cd, $10, $11, c0 }' "$IDX" | sed "s|$HOME|~|g"
       local psc; psc=$(host_field "$n" 12)
       if [ -n "$psc" ]; then if secret_exists "$psc"; then printf '%sĐăng nhập:%s %s %s(%s)%s\n' "$CD" "$C0" "$psc" "$CD" "$(secret_label "$psc")" "$C0"; else printf '%sĐăng nhập: secret %s không còn trong kho secret%s\n' "$CR" "$psc" "$C0"; fi
       elif [ -n "$(host_field "$n" 7)" ] && [ -f "$(host_field "$n" 7 | sed "s|^~|$HOME|")" ]; then printf '%sĐăng nhập: key trên máy này (chưa vào kho secret)%s\n' "$CY" "$C0"; fi
       awk -F'\t' -v n="$n" -v now="$(date +%s)" -v cd="$CD" -v c0="$C0" '$2==n{c++; if($1>l)l=$1} END{
         if (!c) { printf "%sChưa kết nối lần nào từ máy này%s\n", cd, c0; exit }
         d=now-l; a=(d<3600? int(d/60) " phút" : d<86400? int(d/3600) " giờ" : int(d/86400) " ngày")
         printf "%sLần gần nhất: %s trước · %d lần%s\n", cd, a, c, c0 }' "$HIST"
       local ip po jp; ip=$(host_field "$n" 3); po=$(host_field "$n" 5); jp=$(host_field "$n" 6)
       if [ -n "$jp" ]; then printf '%sĐi qua %s, không kiểm tra trực tiếp%s\n' "$CD" "$jp" "$C0"
       elif port_open "$ip" "${po:-22}" 1; then printf "%s${ICON_PROD} mở cổng %s%s\n" "$CG" "${po:-22}" "$C0"
       else printf "%s${ICON_PROD} không thấy cổng %s từ máy này%s\n" "$CY" "${po:-22}" "$C0"; fi ;;
    g) local h; ensure_index
       printf '%s%s%s\n%sNhóm · mở bằng: %s%s\n\n' "$CU$CB" "$n" "$C0" "$CD" "$(mode_label "$(group_field "$n" 2)")" "$C0"
       for h in $(group_field "$n" 3); do
         if ! host_exists "$h"; then printf '  %s%s  đã bị xoá%s\n' "$CD" "$h" "$C0"
         elif is_prod "$h"; then printf '  %s%s%s  %s%s%s\n' "$CR" "$h" "$C0" "$CD" "$(host_field "$h" 3)" "$C0"
         else printf '  %s  %s%s%s\n' "$h" "$CD" "$(host_field "$h" 3)" "$C0"; fi; done
       printf '\n%s→ để đổi kiểu mở hoặc xoá nhóm%s\n' "$CD" "$C0" ;;
    s) printf '%s%s%s\n%sPhiên tmux đang chạy nền. Đóng terminal không mất phiên.%s\n\n' "$CG$CB" "${n#hb-}" "$C0" "$CD" "$C0"
       tmux list-panes -s -t "$n" -F '  #{pane_title}#{?pane_dead, (đã thoát),}' 2>/dev/null
       printf '\n%senter vào lại · → để đóng hẳn%s\n' "$CD" "$C0" ;;
  esac
}

strip_ansi(){ printf '%s' "$1" | sed $'s/\033\\[[0-9;]*m//g'; }
cmd_header(){
  local n state long="" short="" t f fl="" cols line1 p1 pl
  ensure_index
  n=$( [ -s "$IDX" ] && wc -l < "$IDX" | tr -d ' ' || echo 0); cols=$(( $(list_width) + 2 ))   # phần đầu nằm trong cột danh sách, không tràn sang ô xem trước
  if [ -f "$FLASH" ]; then IFS="$TAB" read -r t f < "$FLASH"; [ $(( $(date +%s) - t )) -lt 30 ] && fl=$f; fi
  # mỗi trạng thái có bản dài và bản ngắn; màn hẹp dùng bản ngắn
  state=$(sed -n 1p "$ST" 2>/dev/null); f=$(sed -n 2p "$ST" 2>/dev/null)
  if [ "$state" = invalid ]; then long="${CR}${ICON_ERR} File lỗi, chưa đồng bộ: $f${C0}"; short="${CR}${ICON_ERR} File lỗi: ${f%%:*}${C0}"   # báo cả khi chưa có kho
  elif ! has_remote; then long="${CY}${ICON_PROD} Chưa có kho, danh sách chỉ nằm trên máy này${C0}${CD} · ^o kết nối kho${C0}"; short="${CY}${ICON_PROD} Chưa có kho${C0}${CD} · ^o${C0}"
  else
    case $state in
      ok) long="${CD}${ICON_OK} đã đồng bộ với kho${C0}"; short="${CD}${ICON_OK} đã đồng bộ${C0}";;
      checking) long="${CP}… đang kiểm tra kho${C0}"; short=$long;;
      offline) long="${CY}⏸ Không kết nối được kho ($(kho_addr))${C0}${CD} · ^s thử lại${C0}"; short="${CY}⏸ Không thấy kho${C0}${CD} · ^s${C0}";;
      pending) long="${CY}⏸ $f thay đổi chờ đẩy lên kho${C0}${CD} · ^s thử lại${C0}"; short="${CY}⏸ $f chờ đẩy${C0}${CD} · ^s${C0}";;
      conflict) long="${CR}${ICON_ERR} Kho và máy này cùng sửa một chỗ${C0}${CD} · ^o → Gộp xung đột${C0}"; short="${CR}${ICON_ERR} Xung đột${C0}${CD} · ^o${C0}";;
      invalid) long="${CR}${ICON_ERR} File lỗi, chưa đồng bộ: $f${C0}"; short="${CR}${ICON_ERR} File lỗi${C0}${CD} · ^o kiểm tra${C0}";;
      pulled) long="${CG}↓ $f${C0}"; short="${CG}↓ Có thay đổi từ máy khác${C0}";;
      *) long="${CD}kho ở $(kho_addr) · chưa kiểm tra${C0}"; short="${CD}chưa kiểm tra kho${C0}";;
    esac
  fi
  local hn ps room; hn=$(hostname -s); room=$(( cols - ${#n} - 22 ))   # tên máy dài (máy CI, máy công ty) thì cắt bớt
  [ ${#hn} -gt $room ] && { [ $room -gt 4 ] && hn="${hn:0:$((room - 1))}…" || hn=""; }
  line1="${CU}${CB}hostbook${C0} ${CD}${hn:+$hn · }$n server${C0}"; p1=$(strip_ansi "$line1")
  pl=$(strip_ansi "$long"); ps=$(strip_ansi "$short")
  if [ $(( ${#p1} + ${#pl} + 6 )) -le "$cols" ]; then printf '%s %s· %s%s\n' "$line1" "$CD" "$C0" "$long"
  elif [ $(( ${#pl} + 4 )) -le "$cols" ]; then printf '%s\n%s\n' "$line1" "$long"
  elif [ $(( ${#p1} + ${#ps} + 6 )) -le "$cols" ]; then printf '%s %s· %s%s\n' "$line1" "$CD" "$C0" "$short"
  else printf '%s\n%s\n' "$line1" "$short"; fi
  [ -n "$fl" ] && printf '%s\n' "$fl"
  [ -n "${HOSTBOOK_ONLY:-}" ] && [ -f "${HOSTBOOK_ONLY:-}" ] && printf '%sĐang xem %s server vừa nhập · esc để xem tất cả%s\n' "$CU" "$(grep -c . "$HOSTBOOK_ONLY")" "$C0"
  if [ "$n" = 0 ]; then   # trạng thái trống: mỗi việc một dòng, không bị cắt ở màn hẹp
    printf '\n%sChưa có server nào.%s\n\n' "$CB" "$C0"
    printf '  %s^a%s  thêm server đầu tiên %s(dán user@ip là đủ)%s\n' "$CP" "$C0" "$CD" "$C0"
    printf '  %s^o%s  công cụ: nhập nhiều server, kết nối kho\n' "$CP" "$C0"
    printf '  %s?%s   trợ giúp\n' "$CP" "$C0"
  fi
  return 0
}

cmd_footer(){
  local t=${1%%:*} c=${FZF_SELECT_COUNT:-0}
  [ -n "${1:-}" ] && printf '%s\n' "$1" > "$STATE/current"   # dòng đang trỏ, cho → và ^e (fzf chỉ trả về các dòng đã chọn)
  local cols used=2; cols=$(list_width)
  k(){ local w=$(( ${#1} + ${#2} + 4 )); [ $(( used + w )) -gt "$cols" ] && return 0; used=$(( used + w )); printf '%s%s%s %s%s%s   ' "$CP" "$1" "$C0" "$CD" "$2" "$C0"; }   # hết chỗ thì bỏ phím ít quan trọng (đứng sau)
  if [ "$c" -gt 0 ]; then k enter "mở $c server"; k '→' 'thao tác khác'; k '^y' 'chia sẻ'; k esc 'bỏ chọn'; k '^g' 'lưu thành nhóm'; k tab 'chọn thêm'
  else case $t in
    h) k enter ssh; k '→' 'thao tác'; k '?' 'trợ giúp'; k '^a' thêm; k '^o' 'công cụ'; k '^t' 'kiểu'; k tab 'chọn nhiều'; k '^y' 'chia sẻ'; k '^e' sửa;;
    g) k enter 'mở nhóm'; k '→' 'đổi kiểu mở / xoá'; k '?' 'trợ giúp'; k '^a' thêm; k '^o' 'công cụ';;
    s) k enter 'vào lại phiên'; k '→' 'đóng hẳn'; k '?' 'trợ giúp'; k '^a' thêm; k '^o' 'công cụ';;
    *) k '^a' 'thêm server'; k '^o' 'công cụ'; k '?' 'trợ giúp';;
  esac; fi
  echo
}


# ---------- gộp theo từng server ----------
# Git gộp theo dòng nên hai máy cùng thêm server vào cuối một file cũng bị coi là xung đột.
# Bộ gộp này chia file thành từng khối Host (groups.tsv: từng dòng theo tên nhóm) rồi gộp 3 chiều theo khối:
# chỉ khi cùng một server bị sửa khác nhau ở hai nơi mới là xung đột thật.
merge_driver(){ # base ours theirs đường-dẫn
  local kind=conf rc; case ${4:-} in *.tsv) kind=tsv;; esac
  awk -v kind="$kind" -v prefer="${HOSTBOOK_MERGE_PREFER:-}" '
    function norm(t){ sub(/\n+$/, "", t); return t }
    function add(fi, key, t){ if (!((fi, key) in txt)) { ord[fi, ++cnt[fi]]=key } txt[fi, key]=txt[fi, key] t }
    FNR==1 { if (fi && pend!="") add(fi, (blk==""?"__head__":blk), pend)
             fi=(FILENAME==ARGV[1])?1:(FILENAME==ARGV[2])?2:3; blk=""; pend="" }   # theo tên file: file gốc rỗng không có dòng nào
    kind=="tsv" { if ($0 ~ /^[ \t]*$/) next; k=$0; sub(/\t.*/, "", k); add(fi, "g:" k, $0 "\n"); next }
    tolower($1)=="host" || tolower($1)=="match" { k=tolower($0); gsub(/[ \t]+/, " ", k); sub(/^ /, "", k); blk=k; add(fi, blk, pend $0 "\n"); pend=""; next }
    /^[ \t]*#/ { pend=pend $0 "\n"; next }   # comment (tags, desc) thuộc về khối Host ngay dưới
    blk=="" { if (pend!="") { add(fi, "__head__", pend); pend="" } add(fi, "__head__", $0 "\n"); next }
    { if (pend!="") { add(fi, blk, pend); pend="" } add(fi, blk, $0 "\n") }
    END {
      if (fi && pend!="") add(fi, (blk==""?"__head__":blk), pend)
      n=0
      for (j=1;j<=cnt[2];j++) { k=ord[2,j]; if (!(k in inl)) { inl[k]=1; L[++n]=k } }
      # khối chỉ có ở kho: chèn trước khối wildcard đầu tiên để không bị wildcard che
      firstw=n+1; for (j=1;j<=n;j++) if (L[j] ~ /^host .*[*?]/) { firstw=j; break }
      m=0; for (j=1;j<=cnt[3];j++) { k=ord[3,j]; if (!(k in inl)) { inl[k]=1; X[++m]=k } }
      out=""; conflict=0
      for (j=1;j<=n+m;j++) {
        if (j<firstw) k=L[j]; else if (j<firstw+m) k=X[j-firstw+1]; else k=L[j-m]
        b=((1,k) in txt) ? norm(txt[1,k]) : "\001"; o=((2,k) in txt) ? norm(txt[2,k]) : "\001"; t=((3,k) in txt) ? norm(txt[3,k]) : "\001"
        if (o==t) r=o; else if (o==b) r=t; else if (t==b) r=o
        else if (o=="\001") r=t; else if (t=="\001") r=o          # một bên sửa, bên kia xoá: giữ bản đã sửa, không mất dữ liệu
        else if (prefer=="ours") r=o; else if (prefer=="theirs") r=t
        else { r="<<<<<<< máy này\n" o "\n=======\n" t "\n>>>>>>> kho"; conflict=1 }
        if (r=="\001") continue
        out=out r "\n" (kind=="conf" && k!="__head__" ? "\n" : "")
      }
      sub(/\n+$/, "\n", out); printf "%s", out
      exit conflict
    }' "$1" "$2" "$3" > "$2.hbmerge"; rc=$?
  mv "$2.hbmerge" "$2"; return $rc
}
ensure_merge_setup(){ # đăng ký bộ gộp cho repo dữ liệu (cấu hình git là riêng từng máy, .gitattributes đi theo kho)
  [ -d "$DIR/.git" ] || return 0
  g config merge.hostbook.name "gộp theo từng server (hostbook)"
  g config merge.hostbook.driver "$(printf %q "$SELF") _merge %O %A %B %P"
  local changed=""
  grep -qs 'merge=hostbook' "$DIR/.gitattributes" || { printf '*.conf merge=hostbook\ngroups.tsv merge=hostbook\n' >> "$DIR/.gitattributes"; changed=1; }
  # .gitignore dạng whitelist: chỉ file hostbook quản lý mới vào kho (key hay file lạ lỡ chép vào thì bị bỏ qua)
  grep -qsx '\*' "$DIR/.gitignore" || { { printf '*\n!*.conf\n!.gitignore\n!groups.tsv\n'; cat "$DIR/.gitignore" 2>/dev/null; } > "$DIR/.gitignore.new" && mv "$DIR/.gitignore.new" "$DIR/.gitignore"; changed=1; }
  grep -qsx '!.gitattributes' "$DIR/.gitignore" || { printf '!.gitattributes\n' >> "$DIR/.gitignore"; changed=1; }
  grep -qsx '!secrets/' "$DIR/.gitignore" || { printf '!secrets/\n!secrets/*.age\n!secrets/*.pub\n!secrets/*.meta\n' >> "$DIR/.gitignore"; changed=1; }
  grep -qs '^secrets/\* -merge' "$DIR/.gitattributes" || { printf 'secrets/* -merge\n' >> "$DIR/.gitattributes"; changed=1; }   # git không tự trộn nội dung secret
  [ -n "$changed" ] && g add .gitattributes .gitignore && g commit -qm "Bật gộp theo từng server" -- .gitattributes .gitignore >/dev/null
  return 0
}

# ---------- đồng bộ với kho ----------
set_status(){ printf '%s\n%s\n%s\n' "$1" "${2:-}" "$(date +%s)" > "$ST"; }
notify_fzf(){ [ -n "${FZF_PORT:-}" ] && have curl && curl -s -m 2 -XPOST -H "x-api-key: ${FZF_API_KEY:-}" "localhost:$FZF_PORT" -d "reload('$SELF' _list)+transform-header('$SELF' _header)" >/dev/null 2>&1; return 0; }
# Chỉ một lần đồng bộ chạy tại một thời điểm (mkdir là thao tác nguyên tử). Khoá cũ hơn 2 phút coi như bị bỏ quên.
lock(){ local w=${1:-0} i=0
  while ! mkdir "$STATE/sync.lock" 2>/dev/null; do
    if [ -n "$(find "$STATE/sync.lock" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then rmdir "$STATE/sync.lock" 2>/dev/null; continue; fi
    [ $i -ge "$w" ] && return 1; sleep 1; i=$((i+1)); done
  LOCK_HELD=1; }
unlock(){ rmdir "$STATE/sync.lock" 2>/dev/null; LOCK_HELD=""; }
# Commit mọi thay đổi trong ~/ssh-hosts nếu config còn hợp lệ.
commit_all(){ local msg=$1 e
  [ -z "$(g status --porcelain)" ] && return 0
  if ! e=$(validate); then set_status invalid "$(printf '%s' "$e" | head -1 | sed "s|$DIR/||")"; return 1; fi
  g add -A && g commit -qm "$msg" >/dev/null
}
# Kéo, đẩy, ghi trạng thái. Không bao giờ hỏi gì: chạy được ở nền.
sync_quiet(){
  lock "${1:-0}" || return 0
  sync_locked; local rc=$?; unlock; notify_fzf; return $rc
}
sync_locked(){
  local before after behind ahead new
  ensure_merge_setup
  commit_all "Sửa ngoài hostbook" || return 1
  has_remote || return 0
  export GIT_SSH_COMMAND; GIT_SSH_COMMAND=$(git_ssh 4)
  if ! g fetch -q origin 2>/dev/null; then
    ahead=$(g rev-list --count '@{u}..HEAD' 2>/dev/null || g rev-list --count HEAD 2>/dev/null)
    if [ "${ahead:-0}" -gt 0 ]; then set_status pending "$ahead"; else set_status offline; fi; return 1; fi
  if ! g rev-parse -q --verify '@{u}' >/dev/null 2>&1; then
    if g ls-remote --exit-code origin HEAD >/dev/null 2>&1; then g branch -q --set-upstream-to="origin/$(g symbolic-ref --short HEAD)" 2>/dev/null; fi
  fi
  if ! g rev-parse -q --verify '@{u}' >/dev/null 2>&1; then
    if g push -q -u origin HEAD 2>/dev/null; then set_status ok; else set_status offline; fi; return 0; fi
  behind=$(g rev-list --count 'HEAD..@{u}'); ahead=$(g rev-list --count '@{u}..HEAD')
  if [ "$behind" -gt 0 ]; then
    before=$(cut -f1 "$IDX" 2>/dev/null | sort)
    if ! g pull -q --rebase >/dev/null 2>&1; then g rebase --abort 2>/dev/null; set_status conflict; return 1; fi
    build_index; after=$(cut -f1 "$IDX" | sort)
    new=$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | head -5 | tr '\n' ' ')
    if [ -n "$new" ]; then set_status pulled "Server mới từ máy khác: $new"; else set_status pulled "Đã nhận $behind thay đổi từ máy khác"; fi
  else set_status ok; fi
  if [ "$ahead" -gt 0 ] || [ "$behind" -gt 0 ]; then g push -q 2>/dev/null || set_status pending "$ahead"; fi
  return 0
}
cmd_bg_sync(){ # chạy nền mỗi lần mở ô tìm; nếu vừa đồng bộ xong và không có gì mới thì bỏ qua để khỏi gọi mạng liên tục
  local last
  if [ -f "$ST.force" ]; then rm -f "$ST.force"
  else last=$(sed -n 3p "$ST" 2>/dev/null)
    [ -z "$(g status --porcelain 2>/dev/null)" ] && [ "$(sed -n 1p "$ST" 2>/dev/null)" = ok ] && [ $(( $(date +%s) - ${last:-0} )) -lt 60 ] && return 0
  fi
  has_remote && [ "$(sed -n 1p "$ST" 2>/dev/null)" != pulled ] && { set_status checking; notify_fzf; }
  sync_quiet
}
save_and_sync(){ # $1 = mô tả thay đổi
  if commit_all "$1"; then
    if has_remote; then flash "${CG}${ICON_OK} $1${C0}${CD} · đang đồng bộ với kho${C0}"; else flash "${CG}${ICON_OK} $1${C0}${CD} · chưa có kho để sao lưu${C0}"; fi
    : > "$ST.force"
  else flash "${CR}${ICON_ERR} Chưa lưu: file lỗi${C0}"; fi
}

# ---------- kho secret ----------
# Key và mật khẩu nằm trong ~/ssh-hosts/secrets, mã hoá bằng age tới một danh tính (vault.pub). Danh tính đó được khoá bằng
# mật khẩu chính (vault.key.age) và bằng mã khôi phục (vault.recovery.age). Sau lần mở đầu tiên, danh tính được hệ điều hành
# giữ giúp (Keychain / secret-service), nên mật khẩu chính chỉ phải nhập một lần trên mỗi máy.
SEC=$DIR/secrets
KEY_TTL=${HOSTBOOK_KEY_TTL:-$(duration "$(cfg key_ttl 8h)")}
vault_exists(){ [ -f "$SEC/vault.pub" ]; }
vault_id(){ sha256 < "$SEC/vault.pub" | cut -c1-8; }
kc_backend(){
  case ${HOSTBOOK_KEYCHAIN:-} in file:*) echo "$HOSTBOOK_KEYCHAIN"; return;; esac
  if is_mac && have security; then echo mac; return; fi
  if have secret-tool && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then echo st; return; fi
  local d; for d in "${XDG_RUNTIME_DIR:-}" /dev/shm; do [ -n "$d" ] && [ -d "$d" ] && [ -w "$d" ] && { echo "file:$d/hostbook-$(id -u)/identity"; return; }; done
  echo none
}
kc_label(){ case $(kc_backend) in mac) echo Keychain;; st) echo secret-service;; file:*) echo "phiên tạm (mất khi tắt máy)";; *) echo "không nhớ (hỏi mỗi lần)";; esac; }
kc_get(){ local b; b=$(kc_backend); case $b in
  mac) security find-generic-password -s hostbook -a "vault:$(vault_id)" -w 2>/dev/null | base64 -d 2>/dev/null;;
  st) secret-tool lookup service hostbook account "vault:$(vault_id)" 2>/dev/null | base64 -d 2>/dev/null;;
  file:*) cat "${b#file:}-$(vault_id)" 2>/dev/null;;
  *) return 1;; esac; }
kc_set(){ local b v; b=$(kc_backend); v=$(base64 | tr -d '\n'); case $b in   # danh tính qua stdin
  mac) security add-generic-password -U -s hostbook -a "vault:$(vault_id)" -w "$v" >/dev/null 2>&1;;
  st) printf '%s' "$v" | secret-tool store --label "hostbook" service hostbook account "vault:$(vault_id)" 2>/dev/null;;
  file:*) mkdir -p "$(dirname "${b#file:}")"; chmod 700 "$(dirname "${b#file:}")"; printf '%s' "$v" | base64 -d > "${b#file:}-$(vault_id)";;
  *) return 0;; esac; }
kc_del(){ local b; b=$(kc_backend); case $b in
  mac) security delete-generic-password -s hostbook -a "vault:$(vault_id)" >/dev/null 2>&1;;
  st) secret-tool clear service hostbook account "vault:$(vault_id)" 2>/dev/null;;
  file:*) rm -f "${b#file:}-$(vault_id)";; esac; return 0; }
id_ok(){ [ "$(age-keygen -y 2>/dev/null)" = "$(cat "$SEC/vault.pub")" ]; }   # danh tính qua stdin
age_pw_enc(){ AGE_PASSPHRASE=$1 age -e -j batchpass -a; }
age_pw_dec(){ AGE_PASSPHRASE=$1 age -d -j batchpass "$2" 2>/dev/null; }
# In danh tính ra stdout. Chỉ dùng qua pipe: không đưa vào biến môi trường hay tham số lệnh.
vault_identity(){
  local id pw i
  vault_exists || return 1
  id=$(kc_get) && [ -n "$id" ] && printf '%s\n' "$id" | id_ok && { printf '%s\n' "$id"; return 0; }
  for i in 1 2 3; do
    if [ -n "${HOSTBOOK_MASTER:-}" ]; then pw=$HOSTBOOK_MASTER; else pw=$(gum input --password --header "Mật khẩu chính của kho secret") || return 1; fi
    if id=$(age_pw_dec "$pw" "$SEC/vault.key.age") && [ -n "$id" ]; then printf '%s\n' "$id" | kc_set; printf '%s\n' "$id"; return 0; fi
    err "Sai mật khẩu chính" >&2; [ -n "${HOSTBOOK_MASTER:-}" ] && return 1
  done
  confirm "Dùng mã khôi phục?" && vault_recover >&2 && vault_identity
}
# Đọc hữu hạn: tr | head trên /dev/urandom bị treo trên macOS khi SIGPIPE bị bỏ qua.
recovery_new(){ od -An -N20 -tu1 /dev/urandom | awk 'BEGIN{s="0123456789ABCDEFGHJKMNPQRSTVWXYZ"}
  {for(i=1;i<=NF;i++){printf "%s",substr(s,$i%32+1,1);n++}} END{if(n!=20)exit 1}'; }
recovery_fmt(){ echo "HB-$(printf '%s' "$1" | sed 's/..../&-/g; s/-$//')"; }
recovery_norm(){ printf '%s' "$1" | tr 'a-z' 'A-Z' | sed 's/^HB-//' | tr -d ' -'; }
vault_create(){ # mật-khẩu-chính → tạo kho, in mã khôi phục
  local pw=$1 id rc; mkdir -p "$SEC"; chmod 700 "$SEC"
  id=$(age-keygen 2>/dev/null) || return 1
  printf '%s\n' "$id" | age-keygen -y > "$SEC/vault.pub"
  printf '%s\n' "$id" | age_pw_enc "$pw" > "$SEC/vault.key.age"
  rc=$(recovery_new) || return 1; printf '%s\n' "$id" | age_pw_enc "$rc" > "$SEC/vault.recovery.age"
  printf '%s\n' "$id" | kc_set
  ensure_merge_setup
  recovery_fmt "$rc"
}
ask_new_pw(){ # tiêu-đề số-ký-tự-tối-thiểu → in mật khẩu
  local a b
  while :; do a=$(gum input --password --header "$1 · ít nhất $2 ký tự") || return 1
    [ ${#a} -ge "$2" ] || { err "Cần ít nhất $2 ký tự" >&2; continue; }
    b=$(gum input --password --header "Nhập lại") || return 1
    [ "$a" = "$b" ] && { printf '%s' "$a"; return 0; }; err "Hai lần nhập không khớp" >&2; done
}
show_recovery(){ # mã
  box title "Mã khôi phục" "${CB}$1${C0}" "Dùng khi quên mật khẩu chính. Cất vào trình quản lý mật khẩu hoặc ghi ra giấy." "Mã này chỉ hiện một lần."
  while :; do case $(pick "" "Đã cất, tiếp tục" "Copy mã vào clipboard") in 1) printf '%s' "$1" | copy && ok "Đã copy";; *) return 0;; esac; done
}
# Tạo kho secret nếu chưa có. Mọi thứ in ra stderr vì hàm này hay được gọi bên trong $(...).
vault_init(){
  vault_exists && return 0
  check_age || return 1
  local pw code
  { title "Tạo kho secret"; dim "Kho secret giữ key và mật khẩu đã mã hoá, đồng bộ qua kho cùng danh sách server."; echo; } >&2
  pw=$(ask_new_pw "Mật khẩu chính" 10) || return 1
  code=$(vault_create "$pw") || { err "Không tạo được kho secret" >&2; return 1; }
  save_and_sync "Tạo kho secret"
  { ok "Đã tạo kho secret · máy này sẽ nhớ ($(kc_label)), không hỏi lại"; echo; show_recovery "$code"; } >&2
  migrate_keys >&2
  return 0
}
vault_passwd(){
  local id pw; id=$(vault_identity) || return 1
  pw=$(ask_new_pw "Mật khẩu chính mới" 10) || return 1
  printf '%s\n' "$id" | age_pw_enc "$pw" > "$SEC/vault.key.age" && save_and_sync "Đổi mật khẩu chính của kho secret" && ok "Đã đổi mật khẩu chính"
}
vault_new_recovery(){ # danh tính qua stdin → ghi mã mới, in mã
  local rc; rc=$(recovery_new) || return 1; age_pw_enc "$rc" > "$SEC/vault.recovery.age" && recovery_fmt "$rc"
}
vault_recover(){ # [mã] [mật khẩu mới] (hai tham số chỉ dùng khi kiểm thử)
  local code=${1:-} pw=${2:-} id new
  [ -n "$code" ] || code=$(ask "Mã khôi phục" "HB-XXXX-XXXX-XXXX-XXXX-XXXX") || return 1
  id=$(age_pw_dec "$(recovery_norm "$code")" "$SEC/vault.recovery.age") && [ -n "$id" ] || { err "Mã khôi phục không đúng"; return 1; }
  [ -n "$pw" ] || pw=$(ask_new_pw "Mật khẩu chính mới" 10) || return 1
  printf '%s\n' "$id" | age_pw_enc "$pw" > "$SEC/vault.key.age"
  new=$(printf '%s\n' "$id" | vault_new_recovery); printf '%s\n' "$id" | kc_set
  save_and_sync "Khôi phục kho secret"
  if [ -n "${1:-}" ]; then echo "$new"; else ok "Đã đặt mật khẩu chính mới. Mã khôi phục cũ hết hiệu lực."; show_recovery "$new"; fi
}
vault_recovery_code(){ local id new; id=$(vault_identity) || return 1; new=$(printf '%s\n' "$id" | vault_new_recovery) && save_and_sync "Mã khôi phục mới" && show_recovery "$new"; }

# ---------- secret ----------
valid_secret_name(){ case $1 in vault|"") return 1;; esac; printf '%s' "$1" | grep -qE '^[a-z0-9][a-z0-9._-]{0,39}$'; }
secret_exists(){ [ -f "$SEC/$1.meta" ]; }
secret_meta(){ sed -n "s/^$2=//p" "$SEC/$1.meta" 2>/dev/null | head -1; }
secret_names(){ local f; for f in "$SEC"/*.meta; do [ -f "$f" ] && basename "$f" .meta; done; return 0; }
secret_users(){ awk -F'\t' -v s="$1" '$12==s{print $1}' "$IDX"; }
secret_label(){ if [ "$(secret_meta "$1" type)" = password ]; then echo "mật khẩu"; else echo "key $(secret_meta "$1" keytype)"; fi; }
secret_enc(){ age -e -a -r "$(cat "$SEC/vault.pub")"; }
secret_get(){ vault_identity | age -d -i - "$SEC/$1.age" 2>/dev/null; }
secret_slug(){ printf '%s' "$1" | tr 'A-Z_ ' 'a-z--' | tr -cd 'a-z0-9.-' | sed 's/^[.-]*//' | cut -c1-40; }
# Chuẩn hoá và kiểm tra một file key; gỡ passphrase nếu có (kho secret đã mã hoá thay). In "fingerprint<TAB>loại".
key_prepare(){
  local f=$1 pp
  tr -d '\r' < "$f" > "$f.n" && mv "$f.n" "$f"; [ -n "$(tail -c1 "$f")" ] && echo >> "$f"; chmod 600 "$f"
  if ! ssh-keygen -y -P "" -f "$f" >/dev/null 2>&1; then
    if ssh-keygen -y -P "" -f "$f" 2>&1 | grep -qi 'passphrase'; then
      pp=${HOSTBOOK_KEY_PASSPHRASE:-}; [ -n "$pp" ] || pp=$(gum input --password --header "Key này có passphrase. Nhập để gỡ (kho secret sẽ mã hoá thay)") || return 1
      ssh-keygen -q -p -P "$pp" -N "" -f "$f" >/dev/null 2>&1 || { err "Sai passphrase" >&2; return 1; }
    else err "Không phải private key hợp lệ" >&2; return 1; fi
  fi
  ssh-keygen -lf "$f" | awk '{ t=$NF; gsub(/[()]/,"",t); print $2 "\t" tolower(t) }'
}
secret_write_key(){ # tên file-key fp loại
  ssh-keygen -y -f "$2" > "$SEC/$1.pub" && chmod 600 "$SEC/$1.pub"
  printf 'type=key\nfp=%s\nkeytype=%s\ncreated=%s\n' "$3" "$4" "$(date +%F)" > "$SEC/$1.meta"
  secret_enc < "$2" > "$SEC/$1.age"
}
ask_secret_name(){ # mặc-định → in tên hợp lệ, chưa dùng
  local n=$1
  while :; do n=$(ask "Tên secret · chữ thường, số, dấu gạch" "key-booking" "$n") || return 1
    if ! valid_secret_name "$n"; then err "Tên chỉ gồm chữ thường, số và . _ -" >&2; elif secret_exists "$n"; then err "Đã có secret tên $n" >&2; else echo "$n"; return 0; fi; done
}
# Thêm key vào kho secret. In tên secret ra stdout (tên đã có nếu key trùng fingerprint).
secret_add_key(){ # nguồn(clip|gen|đường dẫn) [tên] [replace]
  local src=$1 name=${2:-} replace=${3:-} d f info fp kt dup def oldpub=""
  vault_init || return 1
  d=$(tmpd); f=$d/key
  case $src in
    clip) clip_get > "$f" 2>/dev/null
          if ! grep -q 'PRIVATE KEY' "$f"; then printf '# Dán private key vào đây, lưu rồi đóng. Dòng bắt đầu bằng "# " bị bỏ qua.\n' > "$f"
            ${VISUAL:-${EDITOR:-$(have nano && echo nano || echo vi)}} "$f" </dev/tty >/dev/tty; grep -v '^# ' "$f" > "$f.x"; mv "$f.x" "$f"; fi
          def="";;
    gen)  rm -f "$f"; ssh-keygen -q -t ed25519 -N "" -C "${name:-hostbook}" -f "$f" || return 1; def="";;
    *)    cp "${src/#\~/$HOME}" "$f" 2>/dev/null || { err "Không đọc được $src" >&2; return 1; }; def=$(secret_slug "$(basename "$src")");;
  esac
  info=$(key_prepare "$f") || { rm -rf "$d"; return 1; }
  fp=${info%%"$TAB"*}; kt=${info#*"$TAB"}
  dup=$(grep -lxF "fp=$fp" "$SEC"/*.meta 2>/dev/null | head -1)
  if [ -n "$dup" ]; then dup=$(basename "$dup" .meta); rm -rf "$d"
    if [ -n "$replace" ]; then err "Key này đã có trong kho secret với tên $dup" >&2; return 1; fi
    dim "Key này đã có trong kho secret với tên $dup" >&2; echo "$dup"; return 0; fi
  if [ -n "$replace" ]; then secret_exists "$name" || return 1; cp "$SEC/$name.pub" "$d/old.pub" 2>/dev/null && oldpub=$d/old.pub
  elif [ -n "$name" ]; then valid_secret_name "$name" && ! secret_exists "$name" || { err "Tên secret không hợp lệ hoặc đã có: $name" >&2; rm -rf "$d"; return 1; }
  else name=$(ask_secret_name "$def") || { rm -rf "$d"; return 1; }; fi
  secret_write_key "$name" "$f" "$fp" "$kt" || { rm -rf "$d"; return 1; }
  [ -n "$oldpub" ] && ssh-add -q -d "$oldpub" 2>/dev/null
  rm -rf "$d"
  save_and_sync "$( [ -n "$replace" ] && echo "Đã thay key của secret $name" || echo "Đã thêm secret $name")"
  echo "$name"
}
secret_add_password(){ # [tên] [mật khẩu] → in tên
  local name=${1:-} pw=${2:-}
  vault_init || return 1
  if [ -n "$name" ]; then valid_secret_name "$name" && ! secret_exists "$name" || { err "Tên secret không hợp lệ hoặc đã có: $name" >&2; return 1; }
  else name=$(ask_secret_name "") || return 1; fi
  [ -n "$pw" ] || pw=$(ask_new_pw "Mật khẩu đăng nhập server" 1) || return 1
  printf 'type=password\ncreated=%s\n' "$(date +%F)" > "$SEC/$name.meta"
  printf '%s\n' "$pw" | secret_enc > "$SEC/$name.age"
  save_and_sync "Đã thêm secret $name"; echo "$name"
}
pick_key_file(){ # → in đường dẫn một private key
  local list=() f i
  for f in "$HOME"/.ssh/*; do [ -f "$f" ] && head -1 "$f" 2>/dev/null | grep -q 'PRIVATE KEY' && list+=("${f/#$HOME/~}"); done
  list+=("Đường dẫn khác…")
  i=$(pick "Key nào?" "${list[@]}") || return 1
  if [ "$i" -eq $(( ${#list[@]} - 1 )) ]; then gum file --all "$HOME"; else echo "${list[$i]}"; fi
}
# Chọn cách đăng nhập cho một server. In tên secret (rỗng = ssh tự lo). Mã 1 = huỷ.
pick_login(){ # [secret gợi ý] [lý do]
  local sug=${1:-} why=${2:-} items=() keys=() n i c f nm
  ensure_index
  for n in $(secret_names | awk -v s="$sug" '$0==s'; secret_names | awk -v s="$sug" '$0!=s'); do
    c=$(secret_users "$n" | grep -c .)
    if [ "$n" = "$sug" ] && [ -n "$why" ]; then items+=("$n|$(secret_label "$n") · $why"); else items+=("$n|$(secret_label "$n") · $c server"); fi
    keys+=("s:$n"); done
  items+=("+ Dán key mới|copy key trước rồi chọn mục này" "+ Nhập key từ file" "+ Tạo key mới|ed25519" "+ Mật khẩu mới" "Không lưu|ssh tự lo: agent riêng, YubiKey…")
  keys+=(clip file gen pass none)
  i=$(pick "Đăng nhập bằng" "${items[@]}") || return 1
  case ${keys[$i]} in
    s:*) echo "${keys[$i]#s:}";;
    clip) secret_add_key clip;;
    file) f=$(pick_key_file) || return 1; secret_add_key "$f";;
    gen) vault_init || return 1; nm=$(ask_secret_name "") || return 1; secret_add_key gen "$nm" >/dev/null || return 1
         { ok "Đã tạo key $nm. Public key (thêm vào ~/.ssh/authorized_keys trên server):"; cat "$SEC/$nm.pub"; cat "$SEC/$nm.pub" | copy && dim "Đã copy public key vào clipboard"; pause "enter để tiếp tục"; } >&2; echo "$nm";;
    pass) secret_add_password;;
    none) echo;;
  esac
}
# Đưa các key mà server đang trỏ tới (file trên máy này) vào kho secret và viết lại config.
# Chỉ tính dòng IdentityFile được ghi rõ trong các file .conf (không tính key mặc định mà "ssh -G" tự điền), và file phải tồn tại.
legacy_keys(){ # in "đường dẫn<TAB>số server"
  local k
  cat "$DIR"/*.conf 2>/dev/null | awk 'tolower($1)=="identityfile" && $2 !~ /secrets\/[^\/]+\.pub$/ {print $2}' | sort -u | while read -r k; do
    [ -f "${k/#\~/$HOME}" ] && printf '%s\t%s\n' "$k" "$(awk -F'\t' -v k="$k" '$12=="" && $7==k' "$IDX" | grep -c .)"; done
}
migrate_keys_raw(){ # không hỏi; in số key đã chuyển
  local k c nm n=0 f full
  ensure_index
  while IFS="$TAB" read -r k c; do
    nm=$(secret_slug "$(basename "$k")"); while secret_exists "$nm" && [ "$(secret_meta "$nm" fp)" != "$(ssh-keygen -lf "${k/#\~/$HOME}" 2>/dev/null | awk '{print $2}')" ]; do nm="$nm-2"; done
    nm=$(secret_add_key "$k" "$( secret_exists "$nm" || echo "$nm")" 2>/dev/null) || { warn "Bỏ qua $k (không đọc được hoặc không phải key hợp lệ)" >&2; continue; }
    full=${k/#\~/$HOME}
    for f in "$DIR"/*.conf; do [ -f "$f" ] || continue
      awk -v a="$k" -v b="$full" -v nm="$nm" -v pub="$(printf '%s' "$SEC/$nm.pub" | sed "s|^$HOME|~|")" '
        function flush(  i){ for (i=1;i<=nb;i++) print buf[i]; nb=0 }
        # gom từng khối Host; khối nào có IdentityFile trỏ tới key này thì đổi sang .pub của secret
        tolower($1)=="host" || tolower($1)=="match" { flush(); hostline=NR; wild=($0 ~ /[*?]/); hit=0; hasio=0 }
        { buf[++nb]=$0 }
        tolower($1)=="identityfile" && ($2==a || $2==b) { match($0,/^[ \t]*/); ind=substr($0,1,RLENGTH); buf[nb]=ind "IdentityFile " pub "\n" ind "IdentitiesOnly yes"; hit=1
            if (!wild) { for (i=nb;i>=1;i--) if (tolower(buf[i]) ~ /^[ \t]*host[ \t]/) { if (i==1 || buf[i-1] !~ /#[ \t]*secret:/) buf[i]="# secret: " nm "\n" buf[i]; break } } }
        END { flush() }' "$f" > "$f.tmp"
      cmp -s "$f" "$f.tmp" && rm -f "$f.tmp" || mv "$f.tmp" "$f"
    done
    n=$((n+1))
  done < <(legacy_keys)
  echo "$n"
}
migrate_keys(){
  local list n; ensure_index; list=$(legacy_keys); [ -n "$list" ] || return 0
  echo; echo "Các server đang dùng key nằm trên máy này:"
  printf '%s\n' "$list" | while IFS="$TAB" read -r k c; do printf '  %s  %s%s server%s\n' "$k" "$CD" "$c" "$C0"; done; echo
  case $(pick "" "Đưa vào kho secret|khuyên dùng: đồng bộ và chia sẻ được, file gốc giữ nguyên" "Để sau") in 0) ;; *) return 0;; esac
  n=$(migrate_keys_raw)
  if validate >/dev/null; then build_index; save_and_sync "Đưa $n key vào kho secret"; ok "Đã đưa $n key vào kho secret"
  else g checkout -q -- '*.conf' 2>/dev/null; build_index; err "Config lỗi sau khi chuyển nên đã trả lại như cũ"; fi
}

# ---------- dùng secret khi kết nối ----------
agent_ok(){ ssh-add -l >/dev/null 2>&1; [ $? -le 1 ]; }
agent_ready(){ # dùng agent sẵn có (để ssh gõ tay và VS Code cũng thấy key); không có thì dựng agent riêng
  agent_ok && return 0
  if [ -f "$STATE/agent.env" ]; then . "$STATE/agent.env" >/dev/null 2>&1; export SSH_AUTH_SOCK SSH_AGENT_PID; agent_ok && return 0; fi
  local d; d=$(mktemp -d /tmp/hb-XXXXXX) || return 1   # đường dẫn socket phải ngắn
  ssh-agent -a "$d/a.sock" > "$STATE/agent.env" 2>/dev/null; . "$STATE/agent.env" >/dev/null 2>&1; export SSH_AUTH_SOCK SSH_AGENT_PID
  [ "${SSH_AUTH_SOCK:-}" = "$d/a.sock" ] && agent_ok
}
load_secret(){ # nạp một key secret vào agent, có hạn
  local n=$1 fp; [ "$(secret_meta "$n" type)" = key ] || return 0
  fp=$(secret_meta "$n" fp); ssh-add -l 2>/dev/null | grep -qF "$fp" && return 0
  secret_get "$n" | ssh-add -q -t "$KEY_TTL" - 2>/dev/null
  ssh-add -l 2>/dev/null | grep -qF "$fp"
}
secrets_for(){ # secret của server và của mọi máy trung gian (tối đa 5 tầng)
  local n=$1 depth=${2:-0} j s
  s=$(host_field "$n" 12); [ -n "$s" ] && echo "$s"
  [ "$depth" -ge 5 ] && return 0
  for j in $(host_field "$n" 6 | tr ',' ' '); do host_exists "$j" && secrets_for "$j" $((depth+1)); done
  return 0
}
ASKPASS_ON=""
prepare_login(){ # server… → nạp key, bật askpass nếu có secret mật khẩu. Trả 1 nếu không mở được kho secret
  local h s need=""
  ASKPASS_ON=""
  for h in "$@"; do for s in $(secrets_for "$h" | sort -u); do
    secret_exists "$s" || { warn "Secret $s không còn trong kho secret"; continue; }
    if [ "$(secret_meta "$s" type)" = password ]; then ASKPASS_ON=1
    else agent_ready || { err "Không dựng được ssh-agent"; return 1; }
      load_secret "$s" || { err "Chưa mở được kho secret nên chưa nạp được key $s"; return 1; }; fi
  done; done
  if [ -n "$ASKPASS_ON" ]; then
    printf '#!/bin/sh\nexec %s _askpass "$@"\n' "$(printf %q "$SELF")" > "$STATE/askpass"; chmod 700 "$STATE/askpass"
    vault_identity >/dev/null || { err "Chưa mở được kho secret"; return 1; }   # mở khoá ở đây, khi còn hỏi được người dùng
  fi
  return 0
}
ssh_login(){ # chạy sshx với askpass khi cần. $1 = tên server (để chọn secret mặc định), còn lại là tham số ssh
  local h=$1; shift
  if [ -n "$ASKPASS_ON" ]; then
    SSH_ASKPASS="$STATE/askpass" SSH_ASKPASS_REQUIRE=force HB_ASKPASS_HOST="$h" HB_ASKPASS_COUNT="${HB_ASKPASS_COUNT:-$(tmpd)/count}" sshx "$@"
  else sshx "$@"; fi
}
tty_ask(){ # prompt [ẩn] → hỏi trên terminal, in trả lời
  local a; [ -n "${HB_ASKPASS_NOTTY:-}" ] && { echo "${HB_ASKPASS_ANSWER:-}"; return 0; }   # HB_ASKPASS_ANSWER: chỉ dùng trong kiểm thử
  printf '%s' "$1" > /dev/tty
  if [ -n "${2:-}" ]; then stty -echo < /dev/tty 2>/dev/null; IFS= read -r a < /dev/tty; stty echo < /dev/tty 2>/dev/null; printf '\n' > /dev/tty
  else IFS= read -r a < /dev/tty; fi
  printf '%s\n' "$a"
}
# ssh gọi hàm này (qua $STATE/askpass) mỗi khi cần hỏi. Mật khẩu đã lưu chỉ được đưa ra ở lần hỏi đầu;
# nếu server hỏi lại nghĩa là mật khẩu đó sai, khi ấy hỏi người dùng.
cmd_askpass(){
  local prompt=${1:-} who host user s="" cnt=${HB_ASKPASS_COUNT:-/dev/null}
  [ -n "${HB_ASKPASS_LOG:-}" ] && printf '%s\n' "$prompt" >> "$HB_ASKPASS_LOG"
  case $prompt in
    *yes/no*) tty_ask "$prompt"; return;;
    *[Pp]assword*)
      ensure_index
      who=$(printf '%s' "$prompt" | grep -oE '[A-Za-z0-9._-]+@[A-Za-z0-9._:-]+' | head -1); user=${who%%@*}; host=${who#*@}
      # câu hỏi dành cho chính server đang kết nối → secret của nó; dành cho máy khác (máy trung gian) → tra theo user@máy
      local th=${HB_ASKPASS_HOST:-}
      if [ -z "$who" ] || { [ "$(host_field "$th" 3)" = "$host" ] && [ "$(host_field "$th" 4)" = "$user" ]; }; then s=$(host_field "$th" 12)
      else s=$(awk -F'\t' -v h="$host" -v u="$user" '$3==h && $4==u && $12!="" {print $12; exit}' "$IDX"); [ -n "$s" ] || s=$(host_field "$th" 12); fi
      if [ -n "$s" ] && [ "$(secret_meta "$s" type)" = password ] && ! grep -qxF "$s" "$cnt" 2>/dev/null; then
        echo "$s" >> "$cnt" 2>/dev/null; secret_get "$s"; return; fi
      [ -n "$s" ] && [ -z "${HB_ASKPASS_NOTTY:-}" ] && printf '%sMật khẩu đã lưu trong secret %s không đúng.%s\n' "$CY" "$s" "$C0" > /dev/tty
      tty_ask "$prompt" hide;;
    *) tty_ask "$prompt" hide;;
  esac
}
cmd_unlock(){
  local n c=0; vault_exists || { warn "Chưa có kho secret"; return 1; }
  agent_ready || { err "Không dựng được ssh-agent"; return 1; }
  for n in $(secret_names); do [ "$(secret_meta "$n" type)" = key ] || continue; load_secret "$n" && c=$((c+1)) || { err "Không nạp được $n"; return 1; }; done
  ok "Đã nạp $c key vào ssh-agent, dùng được trong $((KEY_TTL/3600)) giờ (ssh, scp, VS Code đều thấy)"
}
cmd_lock(){
  local n; for n in $(secret_names); do [ -f "$SEC/$n.pub" ] && ssh-add -q -d "$SEC/$n.pub" 2>/dev/null; done
  if [ "${1:-}" = --forget ]; then kc_del; ok "Đã gỡ key khỏi ssh-agent và quên danh tính kho secret trên máy này"; else ok "Đã gỡ key của hostbook khỏi ssh-agent"; fi
}

# ---------- quản lý secret ----------
secret_set_password(){ # tên [mật khẩu]
  local n=$1 pw=${2:-}; [ -n "$pw" ] || pw=$(ask_new_pw "Mật khẩu mới cho $n" 1) || return 1
  printf '%s\n' "$pw" | secret_enc > "$SEC/$n.age" && save_and_sync "Đã đổi mật khẩu của secret $n" && ok "Đã đổi mật khẩu của $n"
}
secret_rename_raw(){ # cũ mới
  local o=$1 n=$2 f e; valid_secret_name "$n" && ! secret_exists "$n" || return 1
  for e in age meta pub; do [ -f "$SEC/$o.$e" ] && mv "$SEC/$o.$e" "$SEC/$n.$e"; done
  for f in "$DIR"/*.conf; do [ -f "$f" ] || continue
    awk -v o="$o" -v n="$n" '
      /^[ \t]*#[ \t]*secret:/ { v=$0; sub(/^[ \t]*#[ \t]*secret:[ \t]*/,"",v); sub(/[ \t]+$/,"",v); if (v==o) { print "# secret: " n; next } }
      tolower($1)=="identityfile" { i=index($0, "secrets/" o ".pub"); if (i && i+length("secrets/" o ".pub")-1==length($0)) { print substr($0,1,i-1) "secrets/" n ".pub"; next } }
      { print }' "$f" > "$f.tmp"; if cmp -s "$f" "$f.tmp"; then rm -f "$f.tmp"; else mv "$f.tmp" "$f"; fi
  done
}
secret_delete_raw(){ # tên: xoá file và gỡ mọi dòng đăng nhập do hostbook ghi cho secret này
  local n=${1:?} f ispw="" e; [ "$(secret_meta "$n" type)" = password ] && ispw=1
  [ -f "$SEC/$n.pub" ] && ssh-add -q -d "$SEC/$n.pub" 2>/dev/null
  for f in "$DIR"/*.conf; do [ -f "$f" ] || continue
    awk -v n="$n" -v ispw="$ispw" '
      function flush(  i,k){ for (i=1;i<=nb;i++) { k=tolower(key[i])
          if (hit && buf[i] ~ /^[ \t]*#[ \t]*secret:/) continue
          if (hit && !ispw && ((k=="identityfile" && index(buf[i], "secrets/" n ".pub")) || k=="identitiesonly")) continue
          if (hit && ispw && (k=="pubkeyauthentication" || k=="preferredauthentications")) continue
          print buf[i] } nb=0; hit=0 }
      # một khối = các dòng comment ngay trên Host + Host + thân; gom rồi mới quyết định
      /^[ \t]*#/ { if (inbody) { flush(); inbody=0 } }
      tolower($1)=="host" || tolower($1)=="match" { if (inbody) flush(); inbody=1 }
      { buf[++nb]=$0; key[nb]=$1 }
      /^[ \t]*#[ \t]*secret:/ { v=$0; sub(/^[ \t]*#[ \t]*secret:[ \t]*/,"",v); sub(/[ \t]+$/,"",v); if (v==n) hit=1 }
      tolower($1)=="identityfile" && index($0, "secrets/" n ".pub") { hit=1 }
      END { flush() }' "$f" > "$f.tmp"; if cmp -s "$f" "$f.tmp"; then rm -f "$f.tmp"; else mv "$f.tmp" "$f"; fi
  done
  for e in age meta pub; do [ -f "${SEC:?}/$n.$e" ] && rm -f "${SEC:?}/${n:?}.$e"; done
  return 0
}
secret_edit(){
  local n=$1 d f info type; type=$(secret_meta "$n" type); d=$(tmpd); f=$d/s
  secret_get "$n" > "$f" || { err "Chưa mở được kho secret"; return 1; }; cp "$f" "$f.orig"; chmod 600 "$f"
  ${VISUAL:-${EDITOR:-$(have nano && echo nano || echo vi)}} "$f"
  if cmp -s "$f" "$f.orig"; then dim "Không có thay đổi"; return 0; fi
  if [ "$type" = password ]; then
    [ "$(grep -c . "$f")" = 1 ] || { err "Mật khẩu phải là đúng một dòng"; return 1; }
    head -1 "$f" | secret_enc > "$SEC/$n.age"
  else
    info=$(key_prepare "$f") || return 1
    [ -f "$SEC/$n.pub" ] && ssh-add -q -d "$SEC/$n.pub" 2>/dev/null
    secret_write_key "$n" "$f" "${info%%"$TAB"*}" "${info#*"$TAB"}"
  fi
  save_and_sync "Đã sửa secret $n"; ok "Đã lưu $n"
}
# Sau khi thay key: dùng key cũ (còn trong agent) để thêm key mới lên từng server, rồi thử key mới.
push_new_key(){ # tên-secret file-pub-cũ [yes = không hỏi, không gỡ key cũ]
  local sc=$1 oldpub=$2 auto=${3:-} h hosts okh="" bad="" oldblob
  hosts=$(secret_users "$sc"); [ -n "$hosts" ] || return 0
  [ -n "$auto" ] || confirm "Đưa key mới lên $(printf '%s\n' "$hosts" | grep -c .) server đang dùng $sc? (đăng nhập bằng key cũ)" || return 0
  agent_ready && load_secret "$sc" || return 1
  for h in $hosts; do
    printf '  %s … ' "$h"
    if sshx -o BatchMode=yes -o ConnectTimeout=8 -o IdentitiesOnly=yes -o IdentityFile="$oldpub" "$h" 'umask 077; mkdir -p ~/.ssh; cat >> ~/.ssh/authorized_keys' < "$SEC/$sc.pub" 2>/dev/null \
       && sshx -o BatchMode=yes -o ConnectTimeout=8 "$h" true </dev/null 2>/dev/null; then okh="$okh $h"; printf "%s${ICON_OK} key mới vào được%s\n" "$CG" "$C0"
    else bad="$bad $h"; printf "%s${ICON_ERR} chưa đưa được key mới%s\n" "$CR" "$C0"; fi
  done
  [ -n "$bad" ] && warn "Các server này vẫn chỉ nhận key cũ:$bad. Thêm public key mới bằng tay rồi thử lại."
  [ -n "$auto" ] && [ "$auto" != remove ] && return 0
  if [ -n "$okh" ] && { [ "$auto" = remove ] || confirm --default=false "Gỡ key cũ khỏi các server đã vào được bằng key mới?"; }; then
    oldblob=$(awk '{print $2}' "$oldpub")
    for h in $okh; do
      if sshx -o BatchMode=yes -o ConnectTimeout=8 "$h" "grep -vF '$oldblob' ~/.ssh/authorized_keys > ~/.ssh/authorized_keys.hb && mv ~/.ssh/authorized_keys.hb ~/.ssh/authorized_keys" </dev/null 2>/dev/null; then printf "  %s ${ICON_OK} đã gỡ key cũ\n" "$h"; else printf "  %s %s${ICON_ERR} chưa gỡ được%s\n" "$h" "$CR" "$C0"; fi; done
  fi
}
secret_replace(){ # tên nguồn(clip|file|gen|đường dẫn) [auto: yes|remove]
  local n=$1 src=$2 auto=${3:-} d
  [ "$src" = file ] && { src=$(pick_key_file) || return 1; }
  d=$(tmpd); cp "$SEC/$n.pub" "$d/old.pub"; chmod 600 "$d/old.pub"
  secret_get "$n" > "$d/old.key" || { err "Chưa mở được kho secret"; return 1; }; chmod 600 "$d/old.key"
  secret_add_key "$src" "$n" replace >/dev/null || return 1
  ok "Đã thay key của $n"; [ "$src" = gen ] && { echo "Public key mới:"; cat "$SEC/$n.pub"; }
  build_index
  # nạp tạm key cũ (10 phút) để còn đăng nhập được mà đưa key mới lên
  if agent_ready && ssh-add -q -t 600 "$d/old.key" 2>/dev/null; then push_new_key "$n" "$d/old.pub" "$auto"; ssh-add -q -d "$d/old.pub" 2>/dev/null; fi
  return 0
}
secret_manager(){
  local items keys n i c
  while :; do
    ensure_index; items=(); keys=()
    for n in $(secret_names); do c=$(secret_users "$n" | grep -c .)
      items+=("$n|$(secret_label "$n") · $( [ "$c" = 0 ] && echo 'không server nào dùng' || echo "$c server")$( [ "$(secret_meta "$n" type)" = key ] && echo " · $(secret_meta "$n" fp | cut -c1-17)…")"); keys+=("s:$n"); done
    [ -n "$(legacy_keys)" ] && { items+=("Đưa key trên máy này vào kho secret|$(legacy_keys | grep -c .) key đang được server dùng"); keys+=(migrate); }
    items+=("+ Thêm key (từ clipboard)" "+ Thêm key từ file" "+ Tạo key mới" "+ Thêm mật khẩu"); keys+=(clip file gen pass)
    vault_exists && { items+=("Kho secret|đổi mật khẩu chính, mã khôi phục, khoá"); keys+=(vault); }
    clear; title "Secret"
    i=$(pick "$(if vault_exists; then echo "Kho secret: $(kc_get >/dev/null 2>&1 && echo "đã mở trên máy này ($(kc_label))" || echo 'chưa mở trên máy này')"; else echo 'Chưa có kho secret: sẽ được tạo khi bạn thêm secret đầu tiên'; fi)" "${items[@]}") || return 0
    case ${keys[$i]} in
      s:*) secret_actions "${keys[$i]#s:}" && return 0;;
      migrate) migrate_keys; pause;;
      clip) secret_add_key clip >/dev/null; pause;;
      file) n=$(pick_key_file) && secret_add_key "$n" >/dev/null; pause;;
      gen) vault_init && n=$(ask_secret_name "") && secret_add_key gen "$n" >/dev/null && { ok "Public key của $n:"; cat "$SEC/$n.pub"; pause; };;
      pass) secret_add_password >/dev/null;;
      vault) case $(pick "Kho secret" "Đổi mật khẩu chính" "Tạo mã khôi phục mới|mã cũ hết hiệu lực" "Khoá trên máy này|gỡ key khỏi ssh-agent và quên danh tính; lần sau hỏi mật khẩu chính" "Nạp mọi key vào ssh-agent|để ssh, scp, VS Code dùng được") in
               0) vault_passwd; pause;; 1) vault_recovery_code;; 2) cmd_lock --forget; pause;; 3) cmd_unlock; pause;; esac;;
    esac
  done
}
secret_actions(){ # trả 0 nếu cần thoát hẳn màn Secret (để về ô tìm)
  local n=$1 type users; type=$(secret_meta "$n" type); users=$(secret_users "$n" | tr '\n' ' ')
  clear; title "Secret $n"; dim "$(secret_label "$n")$( [ "$type" = key ] && echo " · $(secret_meta "$n" fp)") · tạo $(secret_meta "$n" created)"; dim "Server đang dùng: ${users:-không có}"; echo
  if [ "$type" = key ]; then
    case $(pick "" "Xem server đang dùng|mở ô tìm với secret:$n" "Copy public key" "Thay bằng key khác (từ clipboard)" "Thay bằng key khác (từ file)" "Tạo key mới thay thế" "Sửa nội dung" "Đổi tên" "Xoá") in
      0) SECRET_QUERY="secret:$n"; return 0;;
      1) cat "$SEC/$n.pub" | copy && ok "Đã copy public key"; pause;;
      2) secret_replace "$n" clip; pause;; 3) secret_replace "$n" file; pause;; 4) secret_replace "$n" gen; pause;;
      5) secret_edit "$n"; pause;; 6) secret_rename "$n";; 7) secret_delete "$n";;
    esac
  else
    case $(pick "" "Xem server đang dùng|mở ô tìm với secret:$n" "Đổi mật khẩu" "Sửa nội dung" "Đổi tên" "Xoá") in
      0) SECRET_QUERY="secret:$n"; return 0;;
      1) secret_set_password "$n"; pause;; 2) secret_edit "$n"; pause;; 3) secret_rename "$n";; 4) secret_delete "$n";;
    esac
  fi
  return 1
}
secret_rename(){ local n=$1 m; m=$(ask_secret_name "$n") || return 1; apply_change "Đã đổi tên secret $n → $m" secret_rename_raw "$n" "$m"; }
secret_delete(){
  local n=$1 users; users=$(secret_users "$n" | tr '\n' ' ')
  confirm --default=false "Xoá secret $n?${users:+ Các server $users sẽ không còn cách đăng nhập đã lưu.} Có thể hoàn tác trong Công cụ." || return 1
  apply_change "Đã xoá secret $n" secret_delete_raw "$n"
}

# ---------- kết nối & báo lỗi ----------
CTO=${HOSTBOOK_CONNECT_TIMEOUT:-$(cfg connect_timeout 15)}   # giây chờ tối đa trước khi coi là không kết nối được (mặc định của hệ thống có thể tới 75 giây)
# Theo dõi nhật ký "ssh -v" và hiện một dòng tiến trình: đang ở bước nào, đã chờ bao lâu.
# Dòng tiến trình nằm ở dòng phía trên con trỏ và được sửa bằng lưu/khôi phục vị trí con trỏ (ESC 7 / ESC 8),
# nên dù ssh đã kịp in câu hỏi mật khẩu hay host key ở dòng dưới thì câu hỏi đó cũng không bị viết đè.
conn_line(){ printf '\0337\033[1A\r\033[K%s\0338' "$1" >/dev/tty; }
conn_progress(){ # log ip cổng máy_trung_gian tên
  local log=$1 ip=$2 port=$3 jump=$4 n=$5 t0 el k=0 sp='⣾⣽⣻⢿⡿⣟⣯⣷' need=1 msg tail cols
  cols=$(term_cols)   # dòng tiến trình phải nằm gọn một dòng: xuống hàng thì "lên một dòng để sửa" sẽ in lặp
  [ -n "$jump" ] && need=2   # đi qua máy trung gian thì có hai lần "server trả lời": máy trung gian, rồi server đích
  t0=$(date +%s); sleep 0.3   # đợi tmux chia xong bố cục trước khi vẽ khung đầu
  while :; do
    el=$(( $(date +%s) - t0 )); cols=$(term_cols)   # đo lại mỗi lần: ô tmux có thể vừa được chia lại
    if [ "$(grep -c 'Remote protocol version' "$log" 2>/dev/null)" -ge $need ]; then
      msg="$n trả lời sau ${el}s · đang đăng nhập"; [ $(( ${#msg} + 3 )) -gt "$cols" ] && msg="$n trả lời sau ${el}s"
      conn_line "$(printf "%s${ICON_OK}%s %s" "$CG" "$C0" "$msg")"; : > "$log.done"; return 0; fi
    if [ "$el" -ge $((CTO + 3)) ]; then   # chốt chặn: ssh không áp thời hạn cho bước vào máy trung gian
      echo "hostbook: hết $CTO giây chờ" >> "$log"; pkill -TERM -P $$ -x ssh 2>/dev/null; return 0; fi
    if [ -n "$jump" ]; then
      if grep -q 'Authenticated to' "$log" 2>/dev/null; then msg="Đã vào $jump, đang nối tới $ip:$port"; else msg="Đang vào máy trung gian $jump"; fi
    elif grep -q 'Connection established' "$log" 2>/dev/null; then msg="Đã thông mạng tới $ip:$port, chờ SSH trả lời"
    else msg="Đang mở kết nối tới $ip:$port"; fi
    tail=" · ${el}s / tối đa ${CTO}s · ctrl-c để huỷ"
    [ $(( ${#msg} + ${#tail} + 3 )) -gt "$cols" ] && tail=" · ${el}s/${CTO}s"
    [ $(( ${#msg} + ${#tail} + 3 )) -gt "$cols" ] && msg=${msg:0:$(( cols - ${#tail} - 4 ))}…
    conn_line "$(printf '%s%s%s %s%s%s%s' "$CP" "${sp:k%8:1}" "$C0" "$msg" "$CD" "$tail" "$C0")"
    k=$((k+1)); sleep 0.15
  done
}
# Kết nối và cho thấy từng bước. Trả về mã của ssh. $2=pane: đang chạy trong một ô tmux, không mở menu.
connect(){
  local n=$1 pane=${2:-} log rc jump ip port t0 wp
  prepare_login "$n" || { [ -z "$pane" ] && pause; return 1; }
  log=$(mktemp); jump=$(host_field "$n" 6); ip=$(host_field "$n" 3); port=$(host_field "$n" 5); port=${port:-22}
  record "$n"
  printf '%s→ ssh %s%s%s%s\n' "$CB" "$n" "$C0" "$CD${jump:+ qua $jump}$C0" "$(is_prod "$n" && printf "   %s${ICON_PROD} PROD%s" "$CR$CB" "$C0")"
  t0=$(date +%s); printf '\n' >/dev/tty   # dòng trống: chỗ cho dòng tiến trình
  ( conn_progress "$log" "$ip" "$port" "$jump" "$n" ) & wp=$!
  trap 'true' INT   # ctrl-c chỉ huỷ ssh, không thoát hostbook
  ssh_login "$n" -v -E "$log" -o ConnectTimeout="$CTO" "$n" 2>>"$log"; rc=$?   # stderr vào nhật ký; câu hỏi mật khẩu/host key đi qua /dev/tty nên vẫn hiện
  trap - INT
  kill $wp 2>/dev/null; wait $wp 2>/dev/null
  [ -f "$log.done" ] || printf '\033[1A\r\033[K' >/dev/tty   # chưa tới được server: bỏ dòng tiến trình, khung lỗi sẽ thay chỗ
  local need=1 entered=0; [ -n "$jump" ] && need=2   # ssh con đi qua máy trung gian cũng ghi các dấu mốc này một lần
  [ "$(grep -c 'Entering interactive session' "$log")" -ge $need ] && entered=1
  if { [ $rc -eq 255 ] || grep -q 'hostbook: hết' "$log"; } && [ $entered = 0 ]; then explain "$n" "$log" "$pane"; rc=255
  elif [ $entered = 1 ]; then
    local m=$(( ($(date +%s) - t0) / 60 )) msg
    msg="Đã ngắt kết nối $n sau $( [ $m -gt 0 ] && echo "$m phút" || echo "chưa tới 1 phút")$( [ $rc -ne 0 ] && [ $rc -ne 255 ] && echo " · lệnh cuối trả về mã $rc")"
    printf '%s← %s%s\n' "$CD" "$msg" "$C0"; flash "${CD}$msg${C0}"
  fi
  rm -f "$log" "$log.done"; return $rc
}
# Đọc nhật ký kết nối: đi tới bước nào, hỏng ở đâu, vì sao.
explain(){ # tên log [pane]
  local n=$1 f=$2 pane=${3:-} ip user key port j kind="" net=0 banner=0 auth=0 jump_ok=0 need=1 raw lines=() acts=()
  ip=$(host_field "$n" 3); user=$(host_field "$n" 4); key=$(host_field "$n" 7); port=$(host_field "$n" 5); port=${port:-22}; j=$(host_field "$n" 6)
  local sc sctype=""; sc=$(host_field "$n" 12); [ -n "$sc" ] && sctype=$(secret_meta "$sc" type); [ -n "$sc" ] && key="secret $sc"
  [ -n "$j" ] && need=2
  grep -q 'Connection established' "$f" && net=1
  [ "$(grep -c 'Remote protocol version' "$f")" -ge $need ] && banner=1
  [ -n "$j" ] && grep -q 'Authenticated to' "$f" && jump_ok=1   # lần "Authenticated to" đầu tiên là của máy trung gian
  if grep -qiE 'IDENTIFICATION HAS CHANGED|Host key verification failed' "$f"; then kind=hostkey
  elif grep -qi 'Permission denied' "$f" && [ "$sctype" = key ] && ! ssh-add -l 2>/dev/null | grep -qF "$(secret_meta "$sc" fp)"; then kind=locked   # key của secret chưa nằm trong agent
  elif grep -qi 'Permission denied' "$f"; then kind=denied
  elif grep -qi 'Could not resolve hostname' "$f"; then kind=dns
  elif grep -qi 'Connection refused' "$f"; then kind=refused
  elif grep -qiE 'No route to host|Network is unreachable|Host is down' "$f"; then kind=unreachable
  elif grep -qiE 'timed out|hostbook: hết' "$f"; then kind=timeout
  elif grep -qiE 'Connection closed|Connection reset|kex_exchange_identification|Broken pipe' "$f"; then kind=closed
  else kind=cancel; fi
  raw=$(tr -d '\r' < "$f" | grep -vE '^(debug[0-9]|OpenSSH_|Warning: Permanently added|Killed by signal)' | grep . | tail -2 | tr '\n' ' ' | sed 's/ $//')   # ssh ghi "\r\n": bỏ \r kẻo con trỏ quay về đầu dòng làm vỡ khung
  [ $kind = cancel ] && [ -z "$raw" ] && { flash "${CD}Đã huỷ kết nối tới $n${C0}"; return 0; }
  # các bước đã đi qua: ✓ xong, ✗ hỏng ở đây, · chưa tới
  st(){ if [ "$1" = 1 ]; then printf "%s${ICON_OK}%s %s" "$CG" "$C0" "$2"; elif [ "$1" = x ]; then printf "%s${ICON_ERR} %s%s" "$CR" "$2" "$C0"; else printf '%s· %s%s' "$CD" "$2" "$C0"; fi; }
  local s1 s2 s3 s0=""
  if [ -n "$j" ]; then
    s0=$(st $([ $jump_ok = 1 ] && echo 1 || echo x) "Vào máy trung gian $j")
    s1=$(st $([ $banner = 1 ] && echo 1 || { [ $jump_ok = 1 ] && echo x || echo -; }) "Từ $j tới $ip:$port")
  else
    s1=$(st $([ $net = 1 ] && echo 1 || echo x) "Mạng tới $ip:$port")
  fi
  s2=$(st $([ $banner = 1 ] && echo 1 || { { [ $net = 1 ] || [ $jump_ok = 1 ]; } && [ -z "$j" ] && echo x || echo -; }) "Server SSH trả lời")
  s3=$(st $([ $banner = 1 ] && echo x || echo -) "Đăng nhập (user $user)")
  [ $kind = hostkey ] && s3=$(st x "Xác minh host key")
  echo
  case $kind in
    hostkey) lines=("${CR}⚠ Host key của $n đã thay đổi${C0}" "Có thể server vừa được cài lại." "Cũng có thể có người đang chặn giữa đường." "${CR}Chỉ cập nhật khi bạn chắc chắn server vừa được cài lại.${C0}");;
    locked)  lines=("${CY}Kho secret chưa mở trên máy này${C0}" "Server này đăng nhập bằng secret $sc, nhưng key chưa được nạp vào ssh-agent.");;
    denied)  if [ "$sctype" = password ]; then lines=("${CY}$n từ chối đăng nhập${C0}" "Đã thử: user $user, mật khẩu trong secret $sc" "• Mật khẩu đã lưu không còn đúng, hoặc sai user")
             elif grep -q 'Next authentication method: password\|Next authentication method: keyboard' "$f"; then
               lines=("${CY}$n từ chối đăng nhập${C0}" "Đã thử: user $user, ${key/#$HOME/~}, rồi mật khẩu" "• Sai mật khẩu, hoặc sai user" "• Key chưa được thêm lên server nên phải dùng mật khẩu")
             else lines=("${CY}$n từ chối đăng nhập${C0}" "Đã thử: user $user, ${key/#$HOME/~}" "• Public key có thể chưa được thêm lên server" "• Hoặc sai user"); fi;;
    dns)     lines=("${CY}Không tìm thấy địa chỉ $ip${C0}" "• Sai tên máy, hoặc tên này chỉ dùng được trong mạng nội bộ/VPN");;
    refused) lines=("${CY}$ip từ chối kết nối ở cổng $port${C0}" "• Máy có chạy nhưng SSH không mở ở cổng này" "• Hoặc sai cổng");;
    unreachable) lines=("${CY}Không có đường mạng tới $ip${C0}" "• Máy này chưa vào được mạng của server (VPN, mạng nội bộ…)");;
    timeout) if [ -n "$j" ] && [ $jump_ok = 1 ]; then lines=("${CY}$j không nối tới được $ip:$port sau $CTO giây${C0}" "• Server đích đang tắt, hoặc sai IP" "• Hoặc tường lửa chặn từ $j tới server")
             elif [ -n "$j" ]; then lines=("${CY}Không vào được máy trung gian $j sau $CTO giây${C0}" "• Máy này chưa vào được mạng của $j (VPN…)" "• Hoặc $j đang tắt")
             elif [ $net = 1 ]; then lines=("${CY}$ip:$port nhận kết nối nhưng SSH không trả lời sau $CTO giây${C0}" "• Server đang quá tải, hoặc cổng này không phải SSH")
             else lines=("${CY}Không có phản hồi từ $ip:$port sau $CTO giây${C0}" "• Máy này chưa vào được mạng của server (VPN, mạng nội bộ…)" "• Server đang tắt, sai IP, hoặc tường lửa chặn"); fi;;
    closed)  lines=("${CY}$n đóng kết nối giữa chừng${C0}" "• Server có thể đang chặn IP của máy này (fail2ban…) hoặc giới hạn số kết nối" "• Hoặc cổng này không phải SSH");;
    *)       lines=("${CY}Không kết nối được $n${C0}");;
  esac
  box warn "${lines[@]}" "" ${s0:+"$s0"} "$s1" "$s2" "$s3" ${raw:+"${CD}ssh báo: $raw${C0}"}
  if [ -n "$pane" ]; then return 0; fi
  if [ $kind = hostkey ]; then
    case $(pick "Làm gì tiếp?" "Quay lại ô tìm|an toàn" "Tôi đã kiểm tra, cập nhật host key") in
      1) ssh-keygen -R "$ip" >/dev/null 2>&1; ssh-keygen -R "[$ip]:$port" >/dev/null 2>&1; ssh-keygen -R "$n" >/dev/null 2>&1; connect "$n";; esac; return 0
  fi
  acts=("Thử lại" "Sửa server này")
  [ $kind = locked ] && acts=("Mở khoá và thử lại")
  [ $kind = denied ] && [ "$sctype" = key ] && acts+=("Copy public key của $sc")
  [ $kind = denied ] && [ "$sctype" = password ] && acts+=("Đổi mật khẩu của $sc")
  [ $kind = denied ] && acts+=("Đổi cách đăng nhập")
  acts+=("Xem nhật ký kết nối" "Quay lại ô tìm")
  local logcopy; logcopy=$(mktemp); cp "$f" "$logcopy"
  while :; do
    case ${acts[$(pick "Làm gì tiếp?" "${acts[@]}" || echo 99)]:-} in
      "Thử lại") rm -f "$logcopy"; connect "$n"; return 0;;
      "Sửa server này") rm -f "$logcopy"; edit_host "$n"; return 0;;
      "Mở khoá và thử lại") rm -f "$logcopy"; cmd_unlock && connect "$n"; return 0;;
      "Copy public key của "*) cat "$SEC/$sc.pub" | copy && ok "Đã copy. Thêm dòng này vào ~/.ssh/authorized_keys của user $user trên server.";;
      "Đổi mật khẩu của "*) secret_set_password "$sc";;
      "Đổi cách đăng nhập") rm -f "$logcopy"; change_login "$n"; return 0;;
      "Xem nhật ký kết nối") grep -vE '^debug[0-9]: (Reading|/|channel|client_input|pledge|kex|SSH2_MSG|expecting|rekey|setting up|identity file|Local version|compat|Skipping|load_hostkeys|checking match|hostkeys_find|get_agent|fd [0-9])' "$logcopy" | sed "s|$HOME|~|g" | gum pager --soft-wrap;;
      *) rm -f "$logcopy"; return 0;;
    esac
  done
}
# ---------- thêm & sửa ----------
# Gợi ý khi thêm server: chấm điểm từng server đã có theo độ giống với server mới, rồi suy ra dự án và các giá trị.
# In TSV:  project<TAB>tên<TAB>điểm<TAB>độ chắc<TAB>lý do   (tối đa 3, điểm >= 15, giảm dần)
#          peer<TAB>tên<TAB>điểm<TAB>lý do                   (server giống nhất, khi điểm >= 60)
#          auto<TAB>0|1                                       (1 = đủ chắc để tự chọn dự án đứng đầu)
#          group<TAB>dự án dùng để tính các field (tham số thứ 5, hoặc dự án đứng đầu)
#          field<TAB>user|port|jump|secret|tags|prefix<TAB>giá trị<TAB>lý do
suggest(){ # địa-chỉ tên user cổng [dự-án]
  ensure_index
  LC_ALL=C awk -F'\t' -v ip="$1" -v name="$2" -v user="$3" -v port="$4" -v force="${5:-}" -v me="$ME" -v now="$(date +%s)" '
    function isip(h){ return h ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ }
    function rest(h){ if (index(h,".")==0) return ""; return substr(h, index(h,".")+1) }
    function base(h,  n,a){ n=split(h,a,"."); if (n>=3 && length(a[n])==2 && length(a[n-1])<=3) return a[n-2] "." a[n-1] "." a[n]; if (n>=2) return a[n-1] "." a[n]; return h }
    function pfx(s,  c){ if (match(s, /[-._0-9]/)) { if (RSTART==1) return ""; c=substr(s,RSTART,1); return substr(s,1,RSTART-1) (c ~ /[-._]/ ? c : "") } return "" }
    function addlab(nm,l,w){ L[nm]=L[nm] (L[nm]==""?"":"|") l; if (!(l in LW)) { LW[l]=w; LO[++nl]=l } }
    function dots(v){ return v>=80 ? "●●●" : (v>=45 ? "●●○" : "●○○") }
    FILENAME==ARGV[1] { if (now-$1 < 604800) recent[$2]=1; next }
    { n=$1; N++; nm[N]=n; P[n]=$2; U[n]=$4; J[n]=$6; SC[n]=$12; TG[n]=$8
      if (!($2 in pseen)) { pseen[$2]=1; po[++np]=$2 }
      m=split($8,t," "); for (i=1;i<=m;i++) pool[t[i]]=1
      a=0
      if (isip(ip) && isip($3)) { split(ip,x,"."); split($3,y,".")
        if (x[1]==y[1] && x[2]==y[2] && x[3]==y[3]) { a=50; addlab(n, "cùng dải " x[1] "." x[2] "." x[3] ".x", 50) }
        else if (x[1]==y[1] && x[2]==y[2]) { a=15; addlab(n, "cùng dải " x[1] "." x[2] ".x.x", 15) } }
      else if (!isip(ip) && !isip($3) && index(ip,".")) {
        if (index(rest(ip),".") && rest(ip)==rest($3)) { a=55; addlab(n, "cùng đuôi ." rest(ip), 55) }
        else if (base(ip)==base($3)) { a=40; addlab(n, "cùng tên miền " base(ip), 40) } }
      AD[n]=a; s=a
      if (name!="") { p1=pfx(name); p2=pfx(n)
        if (p1!="" && p1==p2) { s+=40; addlab(n, "tên bắt đầu bằng " p1, 40) }
        c=0; m=split(tolower(name),t,/[-_.0-9]+/); k=split(tolower(n),q,/[-_.0-9]+/)
        for (i=(p1!=""?2:1); i<=m && c<2; i++) if (t[i]!="") for (j=(p2!=""?2:1); j<=k; j++) if (q[j]==t[i]) { s+=10; c++; addlab(n, "tên có chữ " t[i], 10); break } }
      if (port!="" && port!="22" && $5==port) { s+=10; addlab(n, "cùng cổng " port, 10) }
      if (user!="" && $4==user) { s+=10; addlab(n, "cùng user " user, 10) }
      if (s>0 && (n in recent)) s+=5
      S[n]=s }
    END {
      # điểm dự án = tổng 3 server giống nhất, chia 1,5
      for (i=1;i<=N;i++) { n=nm[i]; p=P[n]; v=S[n]
        if (v>T1[p]) { T3[p]=T2[p]; T2[p]=T1[p]; T1[p]=v } else if (v>T2[p]) { T3[p]=T2[p]; T2[p]=v } else if (v>T3[p]) T3[p]=v
        if (v>0) { m=split(L[n],t,"|"); for (j=1;j<=m;j++) LC[p SUBSEP t[j]]++ } }
      for (i=1;i<=np;i++) PS[po[i]]=(T1[po[i]]+T2[po[i]]+T3[po[i]])/1.5
      top=""; second=0
      for (r=1;r<=3;r++) { best=""; bv=14.999
        for (i=1;i<=np;i++) { p=po[i]; if (!(p in used) && PS[p]>bv) { bv=PS[p]; best=p } }
        if (best=="") break; used[best]=1
        if (r==1) { top=best; topv=bv } else if (r==2) second=bv
        why=""; c=0
        for (w=55; w>=10 && c<3; w-=5) for (j=1;j<=nl && c<3;j++) { l=LO[j]; if (LW[l]==w && ((best SUBSEP l) in LC)) { why=why (why==""?"":" · ") l " (" LC[best SUBSEP l] " server)"; c++ } }
        printf "project\t%s\t%d\t%s\t%s\n", best, bv, dots(bv), why }
      print "auto\t" ((top!="" && topv>=80 && topv-second>=30) ? 1 : 0)
      bp=""; bs=59.999; for (i=1;i<=N;i++) if (S[nm[i]]>bs) { bs=S[nm[i]]; bp=nm[i] }
      if (bp!="") { why=L[bp]; gsub(/\|/," · ",why); printf "peer\t%s\t%d\t%s\n", bp, bs, why }
      G=(force!="") ? force : top
      print "group\t" G
      ba=""; bv=14.999; for (i=1;i<=N;i++) if (AD[nm[i]]>bv) { bv=AD[nm[i]]; ba=nm[i] }
      if (ba!="" && pfx(ba)!="") { why=L[ba]; sub(/\|.*/,"",why); printf "field\tprefix\t%s\t%s\n", pfx(ba), why }
      print "field\tport\t" (port==""?"22":port) "\t"
      ng=0; for (i=1;i<=N;i++) if (P[nm[i]]==G) { n=nm[i]; ng++; UW[U[n]]+=S[n]+1; if (!(U[n] in useen)) { useen[U[n]]=1; uo[++nu]=U[n] } }
      if (user!="") print "field\tuser\t" user "\t"
      else { bu=""; bv=0; for (i=1;i<=nu;i++) if (UW[uo[i]]>bv) { bv=UW[uo[i]]; bu=uo[i] }
        if (bu!="") print "field\tuser\t" bu "\tgiống các server trong " G; else print "field\tuser\t" me "\tuser của máy này" }
      cu=(user!="") ? user : bu
      if (G=="" || ng==0) exit
      tot=0; for (i=1;i<=N;i++) { n=nm[i]; if (P[n]!=G) continue; if ((" " TG[n] " ") ~ / bastion /) continue; tot++; if (J[n]!="") { JC[J[n]]++; if (!(J[n] in jseen)) { jseen[J[n]]=1; jo[++nj]=J[n] } } }
      for (i=1;i<=nj;i++) if (tot>0 && JC[jo[i]] >= 0.8*tot) { print "field\tjump\t" jo[i] "\tcác server khác trong " G " đều đi qua máy này"; break }
      for (i=1;i<=N;i++) { n=nm[i]; if (P[n]!=G || SC[n]=="") continue; if (!(SC[n] in sseen)) { sseen[SC[n]]=1; so[++ns]=SC[n] }; SA[SC[n]]++; if (U[n]==cu) SU[SC[n]]++ }
      bsn=""; bv=0; for (i=1;i<=ns;i++) if (SU[so[i]]>bv) { bv=SU[so[i]]; bsn=so[i] }
      if (bsn=="") for (i=1;i<=ns;i++) if (SA[so[i]]>bv) { bv=SA[so[i]]; bsn=so[i] }
      if (bsn!="") print "field\tsecret\t" bsn "\tđang dùng cho " SA[bsn] " server trong " G
      tags=""
      for (i=1;i<=N;i++) { n=nm[i]; if (P[n]!=G) continue; m=split(TG[n],t," "); for (j=1;j<=m;j++) { TC[t[j]]++; if (!(t[j] in tseen)) { tseen[t[j]]=1; to[++nt]=t[j] } } }
      for (i=1;i<=nt;i++) if (TC[to[i]] >= 0.6*ng) { tags=tags (tags==""?"":" ") to[i]; chosen[to[i]]=1 }
      extra=0; m=split(tolower(name),t,/[-_.0-9]+/)
      for (i=1;i<=m;i++) if (t[i]!="" && (t[i] in pool) && !(t[i] in chosen)) { tags=tags (tags==""?"":" ") t[i]; chosen[t[i]]=1; extra=1 }
      if (tags!="") print "field\ttags\t" tags "\ttừ " G (extra ? " và tên server" : "")
    }' "$HIST" "$IDX"
}
sug_val(){ awk -F'\t' -v k="$2" '$1=="field" && $2==k {print $3; exit}' "$1"; }
sug_why(){ awk -F'\t' -v k="$2" '$1=="field" && $2==k {print $4; exit}' "$1"; }
# Đặt các biến group/user/port/jump/secret/tags (và src_*) từ gợi ý. Không hỏi gì: dùng cho nhập nhiều dòng.
read_suggest(){ # địa-chỉ tên user cổng [dự-án]
  local f; f=$(tmpd)/sug
  suggest "$1" "$2" "$3" "$4" "${5:-}" > "$f"
  group=$(awk -F'\t' '$1=="group"{print $2}' "$f"); [ -n "$group" ] || group=imported
  [ "$group" = "${5:-$group}" ] || suggest "$1" "$2" "$3" "$4" "$group" > "$f"
  user=$(sug_val "$f" user); port=$(sug_val "$f" port); jump=$(sug_val "$f" jump); secret=$(sug_val "$f" secret); tags=$(sug_val "$f" tags)
  src_user=$(sug_why "$f" user); src_jump=$(sug_why "$f" jump); src_secret=$(sug_why "$f" secret); src_tags=$(sug_why "$f" tags)
  src_group=$(awk -F'\t' -v g="$group" '$1=="project" && $2==g {print $5}' "$f")
}
pick_project(){ # file-gợi-ý → in tên dự án
  local f=$1 items=() keys=() p sc dt why i
  while IFS="$TAB" read -r _ p sc dt why; do items+=("$p|$dt $why"); keys+=("$p"); done < <(grep '^project' "$f")
  for p in $(cut -f2 "$IDX" | sort -u); do case " ${keys[*]:-} " in *" $p "*) ;; *) items+=("$p"); keys+=("$p");; esac; done
  items+=("+ Dự án mới"); keys+=("+")
  i=$(pick "Dự án nào?" "${items[@]}") || return 1
  if [ "${keys[$i]}" = "+" ]; then p=$(ask "Tên dự án mới · chữ thường, số, dấu gạch ngang" "project-d") || return 1
    case $p in ""|*[!a-z0-9-]*) err "Tên dự án không hợp lệ" >&2; return 1;; esac; echo "$p"
  else echo "${keys[$i]}"; fi
}
pick_tags(){ # dự-án tags-hiện-tại → in tags mới
  local g=$1 cur=$2 all sel
  all=$( { printf '%s\n' $cur; awk -F'\t' -v g="$g" '$2==g{print $8}' "$IDX" | tr ' ' '\n'; } | grep . | awk '!s[$0]++')
  sel=$( { printf '%s\n' "$all"; echo "+ Tag khác…"; } | grep . | gum choose --no-limit --header "Tags · space để bật/tắt, enter để xong" --selected "$(printf '%s' "$cur" | tr ' ' ',')") || return 1
  if printf '%s\n' "$sel" | grep -qx '+ Tag khác…'; then sel=$(printf '%s\n' "$sel" | grep -vx '+ Tag khác…'; ask "Thêm tag · cách nhau dấu cách" "prod web" "" | tr ' ' '\n'); fi
  printf '%s\n' "$sel" | grep . | tr -cd 'A-Za-z0-9._\n-' | tr '\n' ' ' | sed 's/ $//'
}
parse_addr(){ # "user@host:port" → in ra 3 dòng user, host, port
  local s=$1 u="" p=""
  case $s in *@*) u=${s%%@*}; s=${s#*@};; esac
  case $s in *:*) p=${s##*:}; s=${s%:*};; esac
  case $s in ""|*[!A-Za-z0-9._-]*) return 1;; esac
  case $u in *[!A-Za-z0-9._-]*) return 1;; esac
  case $p in ""|[0-9]|[0-9][0-9]|[0-9][0-9][0-9]|[0-9][0-9][0-9][0-9]|[0-9][0-9][0-9][0-9][0-9]) ;; *) return 1;; esac
  printf '%s\n%s\n%s\n' "$u" "$s" "$p"
}
# Khối Host cho server mới. Ghi rõ Port / ProxyJump none khi một khối wildcard của dự án đặt giá trị khác,
# vì ssh lấy giá trị khớp đầu tiên và wildcard có thể đứng trước.
login_lines(){ # tên secret → các dòng đăng nhập của khối Host. Có "/" = đường dẫn key kiểu cũ
  local sc=$1; [ -n "$sc" ] || return 0
  case $sc in */*) printf '  IdentityFile %s\n' "$sc"; return;; esac
  if [ "$(secret_meta "$sc" type)" = password ]; then printf '  PubkeyAuthentication no\n  PreferredAuthentications password,keyboard-interactive\n'
  else printf '  IdentityFile %s\n  IdentitiesOnly yes\n' "$(printf '%s' "$SEC/$sc.pub" | sed "s|^$HOME|~|")"; fi
}
host_block(){ # name ip user port jump secret tags desc
  local cur_port cur_jump
  cur_port=$(sshx -G "$1" 2>/dev/null | awk '$1=="port"{print $2}'); cur_jump=$(sshx -G "$1" 2>/dev/null | awk '$1=="proxyjump"{print $2}')
  [ -n "$7" ] && printf '# tags: %s\n' "$7"; [ -n "$8" ] && printf '# desc: %s\n' "$8"
  case $6 in ""|*/*) ;; *) printf '# secret: %s\n' "$6";; esac
  printf 'Host %s\n  HostName %s\n  User %s\n' "$1" "$2" "$3"
  { [ "$4" != 22 ] || [ "${cur_port:-22}" != 22 ]; } && printf '  Port %s\n' "$4"
  if [ -n "$5" ]; then printf '  ProxyJump %s\n' "$5"; elif [ -n "$cur_jump" ] && [ "$cur_jump" != none ]; then printf '  ProxyJump none\n'; fi
  login_lines "$6"
}
# Đổi cách đăng nhập của một server: gỡ các dòng đăng nhập cũ trong khối, ghi dòng mới.
set_host_secret(){ # tên-server tên-secret(rỗng = ssh tự lo)
  local n=$1 sc=${2:-} f l r old oldpw="" ll
  f=$(host_field "$n" 10); l=$(host_field "$n" 11); r=$(block_range "$n"); old=$(host_field "$n" 12)
  [ -n "$old" ] && [ "$(secret_meta "$old" type)" = password ] && oldpw=1
  ll=$(tmpd)/ll; login_lines "$sc" > "$ll"
  awk -v s="${r% *}" -v e="${r#* }" -v l="$l" -v sc="$sc" -v oldpw="$oldpw" -v ll="$ll" '
    NR>=s && NR<=e {
      k=tolower($1); skip=0
      if ($0 ~ /^[ \t]*#[ \t]*secret:/ || k=="identityfile" || k=="identitiesonly") skip=1
      if (oldpw && (k=="pubkeyauthentication" || k=="preferredauthentications")) skip=1
      if (NR==l && sc!="" && sc !~ /\//) print "# secret: " sc
      if (!skip) print
      if (NR==e) while ((getline x < ll) > 0) print x
      next }
    { print }' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
}
# Ghi khối Host vào <dự án>.conf, đặt trước khối wildcard đầu tiên để giá trị riêng của server được ssh ưu tiên.
write_host(){ # project block-file
  local f=$DIR/$1.conf
  if [ -f "$f" ] && grep -qE '^[[:space:]]*[Hh][Oo][Ss][Tt][[:space:]].*[*?]' "$f"; then
    awk -v blk="$2" 'BEGIN{ while ((getline l < blk) > 0) b=b l "\n" } !done && /^[ \t]*[Hh][Oo][Ss][Tt][ \t].*[*?]/ { printf "%s\n", b; done=1 } { print }' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  else { [ -s "$f" ] && echo; cat "$2"; } >> "$f"; fi
}
add_host(){ # [địa chỉ] [tên]: hỏi tối thiểu, đoán phần còn lại, cho xem lại rồi lưu
  local raw=${1:-} name=${2:-} u h p pre line i blk f dup
  local group="" src_group="" user="" src_user="" port="" tags="" src_tags="" jump="" src_jump="" secret="" src_secret="" desc=""
  while :; do
    [ -n "$raw" ] || raw=$(ask "Địa chỉ server · dán kiểu nào cũng được: 10.0.1.13, ubuntu@10.0.1.13, 10.0.1.13:2222" "10.0.1.13") || return 1
    if line=$(parse_addr "$raw"); then break; fi; err "Không đọc được \"$raw\". Ví dụ: ubuntu@10.0.1.13"; raw=""
  done
  u=$(echo "$line" | sed -n 1p); h=$(echo "$line" | sed -n 2p); p=$(echo "$line" | sed -n 3p)
  local sug peer peerwhy cloned="" prewhy
  sug=$(tmpd)/sug; suggest "$h" "" "$u" "$p" > "$sug"
  pre=$(sug_val "$sug" prefix); prewhy=$(sug_why "$sug" prefix)
  while :; do
    [ -n "$name" ] || name=$(ask "Tên server${pre:+ · đã điền sẵn \"$pre\" vì $prewhy}" "${pre}web3" "$pre") || return 1
    case $name in
      *-) err "Tên chưa xong: \"$name\""; pre=$name; name="";;
      *) if ! valid_name "$name"; then err "Tên chỉ gồm chữ, số và . _ -"; name=""
         elif host_exists "$name"; then err "Đã có server tên $name"; name=""; else break; fi;; esac
  done
  suggest "$h" "$name" "$u" "$p" > "$sug"
  peer=$(awk -F'\t' '$1=="peer"{print $2}' "$sug"); peerwhy=$(awk -F'\t' '$1=="peer"{print $4}' "$sug")
  if [ -n "$peer" ]; then   # có một server rất giống: đề nghị sao chép thiết lập của nó
    clear; title "Thêm server $name"
    echo "Giống ${CB}$peer${C0} nhất ${CD}($peerwhy)${C0}"
    dim "Thiết lập của $peer: user $(host_field "$peer" 4)$( [ -n "$(host_field "$peer" 12)" ] && echo " · $(host_field "$peer" 12)")$( [ -n "$(host_field "$peer" 6)" ] && echo " · qua $(host_field "$peer" 6)") · dự án $(host_field "$peer" 2)"; echo
    confirm "Sao chép thiết lập của $peer?" && cloned=1
  fi
  if [ -n "$cloned" ]; then group=$(host_field "$peer" 2)
  elif [ "$(awk -F'\t' '$1=="auto"{print $2}' "$sug")" = 1 ]; then group=$(awk -F'\t' '$1=="group"{print $2}' "$sug")
  elif [ ! -s "$IDX" ]; then group=servers
  else clear; title "Thêm server $name"; group=$(pick_project "$sug") || return 1; fi
  read_suggest "$h" "$name" "$u" "$p" "$group"
  if [ -n "$cloned" ]; then
    [ -n "$u" ] || { user=$(host_field "$peer" 4); src_user="giống $peer"; }
    jump=$(host_field "$peer" 6); src_jump=${jump:+giống $peer}; secret=$(host_field "$peer" 12); src_secret=${secret:+giống $peer}; src_group="giống $peer"
  fi
  if [ -z "$secret" ]; then clear; title "Thêm server $name"; secret=$(pick_login) || return 1; fi   # chưa có gì để gợi ý: hỏi luôn
  while :; do
    clear; title "Thêm server"
    dup=$(awk -F'\t' -v ip="$h" '$3==ip{print $1; exit}' "$IDX")
    box dim "$(row "Tên" "$name"
      row "Địa chỉ" "$user@$h$( [ "$port" != 22 ] && echo ":$port")" "$src_user"
      row "Dự án" "$group" "$src_group"
      row "Tags" "${tags:-—}" "$src_tags"
      row "Máy trung gian" "${jump:-không}" "$src_jump"
      row "Đăng nhập" "$( [ -n "$secret" ] && echo "$secret ($(secret_label "$secret"))" || echo "ssh tự lo")" "$src_secret"
      row "Mô tả" "${desc:-(trống)}")"
    [ -n "$dup" ] && warn "Trùng IP với $dup"
    case $(pick "" "Lưu|kiểm tra rồi tự đồng bộ" "Sửa một mục…" "Huỷ") in
      0) break;;
      1) case $(pick "Sửa mục nào?" "Tên|$name" "Địa chỉ|$user@$h:$port" "Dự án|$group" "Tags|${tags:-—}" "Máy trung gian|${jump:-không}" "Đăng nhập|${secret:-ssh tự lo}" "Mô tả|${desc:-(trống)}") in
           0) i=$(ask "Tên" "" "$name") && { if valid_name "$i" && ! host_exists "$i"; then name=$i; else err "Tên không hợp lệ hoặc đã có"; sleep 1; fi; };;
           1) i=$(ask "Địa chỉ" "ubuntu@10.0.1.13:22" "$user@$h:$port") && line=$(parse_addr "$i") && { u=$(echo "$line" | sed -n 1p); h=$(echo "$line" | sed -n 2p); p=$(echo "$line" | sed -n 3p); user=${u:-$user}; port=${p:-22}; src_user=""; };;
           2) i=$(pick_project "$sug") && { group=$i; src_group=""; };;
           3) i=$(pick_tags "$group" "$tags") && { tags=$i; src_tags=""; };;
           4) i=$( { echo "Không"; awk -F'\t' '$8 ~ /(^| )bastion( |$)/ {print $1}' "$IDX"; } | gum choose --header "Máy trung gian (ProxyJump)") && { [ "$i" = Không ] && jump="" || jump=$i; src_jump=""; };;
           5) i=$(pick_login "$secret" "$src_secret") && { secret=$i; src_secret=""; };;
           6) i=$(ask "Mô tả · một dòng" "Nginx chính" "$desc") && desc=$(printf '%s' "$i" | tr -d '\t\n\r');;
         esac;;
      *) return 1;;
    esac
  done
  blk=$(mktemp); host_block "$name" "$h" "$user" "$port" "$jump" "$secret" "$tags" "$desc" > "$blk"
  f=$DIR/$group.conf; [ -f "$f" ] && cp "$f" "$blk.bak"
  write_host "$group" "$blk"
  if ! i=$(validate); then
    if [ -f "$blk.bak" ]; then mv "$blk.bak" "$f"; else rm -f "$f"; fi
    err "Không lưu được vì config lỗi:"; dim "$i"; rm -f "$blk"; pause; return 1
  fi
  rm -f "$blk" "$blk.bak"; build_index
  save_and_sync "Đã thêm $name"
  ADDED=$name
}
edit_host(){ # mở file ở đúng dòng, kiểm tra khi đóng, hỏi lại nếu hỏng
  local n=$1 f l ed e bak
  f=$(host_field "$n" 10); l=$(host_field "$n" 11); [ -n "$f" ] || return 1
  ed=${VISUAL:-${EDITOR:-$(have nano && echo nano || echo vi)}}
  bak=$(mktemp); cp "$f" "$bak"
  while :; do
    case $ed in code*|cursor*) $ed -g "$f:$l" --wait;; *) $ed "+$l" "$f";; esac
    cmp -s "$f" "$bak" && { rm -f "$bak"; return 0; }
    if e=$(validate); then rm -f "$bak"; build_index; save_and_sync "Đã sửa $n"; return 0; fi
    echo; box err "${CR}Chưa đồng bộ: file lỗi sẽ không được đẩy sang máy khác.${C0}" "$(printf '%s' "$e" | sed "s|$DIR/||" | head -3)"
    l=$(printf '%s' "$e" | sed -n 's/.*line \([0-9][0-9]*\).*/\1/p' | head -1); l=${l:-1}
    case $(pick "Làm gì tiếp?" "Mở lại để sửa|tới dòng $l" "Bỏ thay đổi|khôi phục bản trước") in
      0) ;;
      *) cp "$bak" "$f"; rm -f "$bak"; build_index; flash "${CG}↩ Đã khôi phục $(basename "$f")${C0}"; return 0;;
    esac
  done
}


# ---------- xoá, đổi tên, chuyển dự án ----------
# block_range tên → "đầu cuối": khối Host của server, gồm các dòng "# tags:"/"# desc:" ngay phía trên, bỏ dòng trống cuối
block_range(){ local f l; f=$(host_field "$1" 10); l=$(host_field "$1" 11)
  awk -v l="$l" '{ line[NR]=$0 } END { s=l; while (s>1 && line[s-1] ~ /^[ \t]*#[ \t]*(tags|desc|secret):/) s--
    e=l; for (i=l+1;i<=NR;i++) { if (tolower(line[i]) ~ /^[ \t]*(host|match)[ \t]/) break; e=i }
    # dòng trống và comment ở cuối thuộc về khối kế tiếp (tags/desc/secret của server sau)
    while (e>l && (line[e] ~ /^[ \t]*$/ || line[e] ~ /^[ \t]*#/)) e--; print s, e }' "$f"; }
host_shared(){ local f l; f=$(host_field "$1" 10); l=$(host_field "$1" 11); [ "$(awk -v l="$l" 'NR==l{print NF-1; exit}' "$f")" -gt 1 ]; }
jump_users(){ awk -F'\t' -v n="$1" '{ m=split($6,a,","); for (i=1;i<=m;i++) if (a[i]==n) print $1 }' "$IDX" | tr '\n' ' '; }
groups_rename(){ # cũ [mới]: đổi hoặc bỏ tên server trong mọi nhóm; nhóm không còn server nào thì bỏ luôn
  [ -f "$GRP" ] || return 0
  awk -F'\t' -v OFS='\t' -v o="$1" -v n="${2:-}" '{ m=split($3,a," "); out=""; for (i=1;i<=m;i++) { h=(a[i]==o?n:a[i]); if (h!="") out=out (out==""?"":" ") h } $3=out; if (out!="") print }' "$GRP" > "$GRP.tmp" && mv "$GRP.tmp" "$GRP"
}
delete_host_raw(){ # tên [giữ-nhóm]
  local n=$1 f l r
  f=$(host_field "$n" 10); l=$(host_field "$n" 11)
  if host_shared "$n"; then
    awk -v l="$l" -v n="$n" 'NR==l { out=$1; for (i=2;i<=NF;i++) if ($i!=n) out=out " " $i; print out; next } { print }' "$f" > "$f.tmp"
  else r=$(block_range "$n")
    awk -v s="${r% *}" -v e="${r#* }" 'NR>=s && NR<=e { next } { if ($0 ~ /^[ \t]*$/ && prevblank) next; prevblank=($0 ~ /^[ \t]*$/); print }' "$f" > "$f.tmp"
  fi
  mv "$f.tmp" "$f"; [ -s "$f" ] && grep -q '[^[:space:]]' "$f" || rm -f "$f"   # file chỉ còn dòng trống thì bỏ
  [ -n "${2:-}" ] || groups_rename "$n"
}
rename_host_raw(){ # cũ mới: đổi tên trên dòng Host, trong ProxyJump của server khác, trong nhóm và lịch sử
  local o=$1 n=$2 f l c
  f=$(host_field "$o" 10); l=$(host_field "$o" 11)
  awk -v l="$l" -v o="$o" -v n="$n" 'NR==l { for (i=2;i<=NF;i++) if ($i==o) $i=n } { print }' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  for c in "$DIR"/*.conf; do
    awk -v o="$o" -v n="$n" 'tolower($1)=="proxyjump" { m=split($2,a,","); v=""; for (i=1;i<=m;i++) v=v (i>1?",":"") (a[i]==o?n:a[i]); match($0,/^[ \t]*/); print substr($0,1,RLENGTH) $1 " " v; next } { print }' "$c" > "$c.tmp"
    cmp -s "$c" "$c.tmp" && rm -f "$c.tmp" || mv "$c.tmp" "$c"
  done
  groups_rename "$o" "$n"
  awk -F'\t' -v OFS='\t' -v o="$o" -v n="$n" '$2==o{$2=n} {print}' "$HIST" > "$HIST.tmp" && mv "$HIST.tmp" "$HIST"
}
effective(){ sshx -G "$1" 2>/dev/null | awk '$1=="hostname"||$1=="user"||$1=="port"||$1=="proxyjump" {print $1 " " $2} $1=="identityfile"&&!k {k=1; print $1 " " $2}'; }
move_host_raw(){ # tên dự_án: chuyển nguyên khối, rồi ghi rõ các giá trị trước đây được thừa hưởng từ wildcard của dự án cũ
  local n=$1 to=$2 f r blk before after line k v nf nl
  host_shared "$n" && { echo "shared"; return 1; }
  f=$(host_field "$n" 10); r=$(block_range "$n"); before=$(effective "$n")
  blk=$(mktemp); sed -n "${r% *},${r#* }p" "$f" > "$blk"
  delete_host_raw "$n" keep; write_host "$to" "$blk"; rm -f "$blk"
  after=$(effective "$n"); [ "$before" = "$after" ] && return 0
  nf=$DIR/$to.conf; nl=$(awk -v n="$n" 'tolower($1)=="host" { for (i=2;i<=NF;i++) if ($i==n) { print NR; exit } }' "$nf")
  printf '%s\n' "$before" | while read -r k v; do
    printf '%s\n' "$after" | grep -qx "$k $v" && continue
    case $k in hostname) k=HostName;; user) k=User;; port) k=Port;; proxyjump) k=ProxyJump;; identityfile) k=IdentityFile;; esac
    printf '  %s %s\n' "$k" "$v"
  done > "$nf.extra"
  awk -v l="$nl" -v x="$nf.extra" '{ print } NR==l { while ((getline y < x) > 0) print y }' "$nf" > "$nf.tmp" && mv "$nf.tmp" "$nf"; rm -f "$nf.extra"
}
# Bọc các thao tác trên: kiểm tra config, nếu hỏng thì trả lại nguyên trạng bằng git.
apply_change(){ # mô tả lệnh...
  local msg=$1 e; shift
  "$@" || { g checkout -q -- . 2>/dev/null; g clean -fdq -- '*.conf' secrets 2>/dev/null; return 1; }
  if ! e=$(validate); then g checkout -q -- . 2>/dev/null; g clean -fdq -- '*.conf' secrets 2>/dev/null; build_index; err "Không đổi được vì config sẽ lỗi:"; dim "$e"; return 1; fi
  build_index; save_and_sync "$msg"
}
delete_server(){
  local n=$1 users; users=$(jump_users "$n")
  confirm --default=false "Xoá $n?${users:+ Các server $users đang đi qua máy này sẽ không vào được nữa.} Có thể hoàn tác trong Công cụ." || return 1
  apply_change "Đã xoá $n" delete_host_raw "$n"
}
rename_server(){
  local n=$1 m
  m=$(ask "Tên mới cho $n" "" "$n") || return 1
  [ "$m" = "$n" ] && return 0
  valid_name "$m" || { err "Tên chỉ gồm chữ, số và . _ -"; pause; return 1; }
  host_exists "$m" && { err "Đã có server tên $m"; pause; return 1; }
  apply_change "Đã đổi tên $n → $m" rename_host_raw "$n" "$m"
}
move_server(){
  local n=$1 to
  host_shared "$n" && { err "$n được khai báo chung một dòng Host với server khác. Sửa bằng ^e."; pause; return 1; }
  to=$( { awk -F'\t' -v c="$(host_field "$n" 2)" '$2!=c{print $2}' "$IDX" | sort -u; echo "+ Dự án mới"; } | gum choose --header "Chuyển $n sang dự án") || return 1
  if [ "$to" = "+ Dự án mới" ]; then to=$(ask "Tên dự án mới · chữ thường, số, dấu gạch ngang" "project-d") || return 1
    case $to in ""|*[!a-z0-9-]*) err "Tên dự án không hợp lệ"; pause; return 1;; esac; fi
  apply_change "Đã chuyển $n sang $to" move_host_raw "$n" "$to"
}

# ---------- nhập nhiều server ----------
# Mỗi dòng: "tên địa_chỉ [#tag …]" hoặc chỉ "địa_chỉ" (tên lấy từ phần đầu của tên máy). Dấu phẩy, tab đều được.
# In "tên<TAB>user<TAB>máy<TAB>cổng<TAB>tags"; dòng lỗi in ra stderr kèm số dòng.
import_parse(){
  local no=0 line a b rest name addr tags p u h pt
  while IFS= read -r line || [ -n "$line" ]; do no=$((no+1))
    line=$(printf '%s' "$line" | tr ',\t' '  ' | sed 's/^ *//; s/ *$//')
    case $line in ""|\#*) continue;; esac
    tags=$(printf '%s\n' "$line" | tr ' ' '\n' | sed -n 's/^#//p' | tr '\n' ' ' | sed 's/ $//')
    rest=$(printf '%s\n' "$line" | tr ' ' '\n' | grep -v '^#' | grep . | tr '\n' ' ')
    set -- $rest
    if [ $# -ge 2 ]; then name=$1; addr=$2
    elif [ $# -eq 1 ]; then addr=$1; h=${addr#*@}; h=${h%%:*}
      case $h in *[A-Za-z]*) name=${h%%.*};; *) echo "dòng $no: thiếu tên server cho $addr" >&2; continue;; esac
    else continue; fi
    valid_name "$name" || { echo "dòng $no: tên \"$name\" có ký tự lạ" >&2; continue; }
    p=$(parse_addr "$addr") || { echo "dòng $no: không đọc được địa chỉ \"$addr\"" >&2; continue; }
    u=$(echo "$p" | sed -n 1p); h=$(echo "$p" | sed -n 2p); pt=$(echo "$p" | sed -n 3p)
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$u" "$h" "$pt" "$(printf '%s' "$tags" | tr -cd 'A-Za-z0-9._ -')" | sed 's/\t\t/\t-\t/g; s/\t\t/\t-\t/g; s/\t$/\t-/'   # cột trống ghi "-": read với IFS=tab gộp tab liền nhau
  done
}
import_write(){ # file-tsv dự_án(rỗng = đoán theo dải IP) → ghi tất cả, in số server đã ghi
  local list=$1 to=$2 n u h pt tg blk cnt=0 seen=" "
  local group src_group user src_user port tags src_tags jump src_jump secret src_secret
  blk=$(mktemp)
  while IFS="$TAB" read -r n u h pt tg; do
    [ "$u" = - ] && u=""; [ "$pt" = - ] && pt=""; [ "$tg" = - ] && tg=""
    case $seen in *" $n "*) continue;; esac; host_exists "$n" && continue; seen="$seen$n "
    group=""; user=""; port=""; tags=""; jump=""; secret=""
    read_suggest "$h" "$n" "$u" "$pt" "$to"
    [ -n "$tg" ] && tags=$tg
    host_block "$n" "$h" "$user" "$port" "$jump" "$secret" "$tags" "" > "$blk"
    write_host "$group" "$blk"; cnt=$((cnt+1))
  done < "$list"
  rm -f "$blk"; echo "$cnt"
}
import_flow(){ # [file]
  local src=${1:-} raw list errs n to cnt to_dir
  title "Nhập nhiều server"
  list=$(mktemp); errs=$(mktemp)
  if [ -n "$src" ] && is_pack "$src"; then import_pack "$src"; return; fi
  if [ -z "$src" ] && clip_get 2>/dev/null | head -c 300 | grep -q '^# hostbook-share v1'; then   # đang copy sẵn một gói chia sẻ
    to_dir=$(tmpd)/clip.hbshare; clip_get > "$to_dir"; import_pack "$to_dir"; return; fi
  if [ -n "$src" ]; then raw=$(cat "$src") || return 1
  else
    # soạn trong trình soạn thảo: dán bao nhiêu dòng cũng được (ô nhập của gum 2 coi enter là nộp)
    local tf ed; tf=$(mktemp); ed=${VISUAL:-${EDITOR:-$(have nano && echo nano || echo vi)}}
    printf '%s\n' "# Dán danh sách server bên dưới, lưu rồi đóng trình soạn thảo. Dòng bắt đầu bằng \"# \" được bỏ qua." \
      "# Mỗi dòng: tên địa_chỉ [#tag …]   ví dụ:  a-web1 ubuntu@10.0.1.11 #prod #web" \
      "# Dán nguyên một ssh config (các khối Host) cũng được." "" > "$tf"
    $ed "$tf"
    if grep -q 'BEGIN AGE ENCRYPTED FILE' "$tf"; then { echo "# hostbook-share v1"; sed -n '/BEGIN AGE ENCRYPTED FILE/,$p' "$tf"; } > "$tf.pack"; rm -f "$tf"; import_pack "$tf.pack"; rm -f "$tf.pack"; return; fi
    raw=$(grep -v '^# ' "$tf" | sed '/./,$!d'); rm -f "$tf"   # bỏ dòng trống đầu để số dòng báo lỗi khớp với phần đã dán
    [ -n "$(printf '%s' "$raw" | tr -d '[:space:]')" ] || return 1
  fi
  if printf '%s\n' "$raw" | grep -qiE '^[[:space:]]*host[[:space:]]'; then   # dán nguyên ssh config: giữ nguyên, tách theo tên
    printf '%s\n' "$raw" > "$list"; to_dir=$(mktemp -d)
    split_config "$list" "$to_dir" "$to_dir/global" >/dev/null
    n=$(cat "$to_dir"/*.conf 2>/dev/null | grep -ciE '^[[:space:]]*host[[:space:]]+[^*]' )
    dim "Đây là ssh config: $n khối Host, sẽ chia vào dự án theo phần đầu của tên."
    confirm "Nhập?" || { rm -rf "$list" "$errs" "$to_dir"; return 1; }
    apply_change "Đã nhập $n server" merge_split "$to_dir"; rm -rf "$list" "$errs" "$to_dir"; return
  fi
  printf '%s\n' "$raw" | import_parse > "$list" 2> "$errs"
  n=$(grep -c . "$list"); [ -s "$errs" ] && { warn "Bỏ qua $(grep -c . "$errs") dòng:"; sed 's/^/  /' "$errs" | head -10; }
  [ "$n" -gt 0 ] || { err "Không có dòng nào hợp lệ"; pause; rm -f "$list" "$errs"; return 1; }
  ensure_index
  local dupe; dupe=$(cut -f1 "$list" | while read -r x; do host_exists "$x" && printf '%s ' "$x"; done)
  [ -n "$dupe" ] && warn "Đã có, bỏ qua: $dupe"
  echo; to=$( { echo "Đoán theo dải IP từng server"; awk -F'\t' '{print $2}' "$IDX" | sort -u; } | gum choose --header "Đưa $n server vào dự án nào?") || { rm -f "$list" "$errs"; return 1; }
  [ "$to" = "Đoán theo dải IP từng server" ] && to=""
  apply_change "Đã nhập server từ danh sách" import_write "$list" "$to" >/dev/null && ok "Đã nhập · $(grep -c . "$IDX") server trong danh sách"
  rm -f "$list" "$errs"; pause
}
# Tách một ssh config thành các file theo phần đầu của tên (a-web1 → a.conf) khi phần đó có từ 2 server;
# còn lại vào imported.conf. Khối "Host *" và "Match" giữ trong file global (đặt lại vào ~/.ssh/config).
split_config(){ # file-nguồn thư-mục-đích file-global
  awk -v out="$2" -v glob="$3" '
    function pfx(p,  q){ q=tolower(p); if (q !~ /-/) return ""; sub(/-.*/,"",q); gsub(/[^a-z0-9]/,"-",q); return q }
    tolower($1)=="host" || tolower($1)=="match" { nb++; kind[nb]=tolower($1); pat[nb]=$2; txt[nb]=pend $0 "\n"; pend=""; next }
    !nb { head=head $0 "\n"; next }
    /^[ \t]*#/ { pend=pend $0 "\n"; next }
    { if (pend!="") { txt[nb]=txt[nb] pend; pend="" } txt[nb]=txt[nb] $0 "\n" }
    END {
      if (pend!="") txt[nb]=txt[nb] pend
      for (i=1;i<=nb;i++) if (kind[i]=="host" && pat[i] !~ /[*?]/) { k=pfx(pat[i]); if (k!="") c[k]++ }
      printf "%s", head > glob
      for (i=1;i<=nb;i++) {
        if (kind[i]=="match" || pat[i]=="*") { printf "%s", txt[i] >> glob; continue }
        k=pfx(pat[i]); f=(k!="" && c[k]>=2) ? k : "imported"
        printf "%s", txt[i] >> (out "/" f ".conf"); n++
      }
      print n
    }' "$1"
}
merge_split(){ # thư-mục: nối từng file tách ra vào ~/ssh-hosts (file trùng tên thì ghi tiếp vào cuối)
  local f
  for f in "$1"/*.conf; do [ -f "$f" ] || continue; { [ -s "$DIR/$(basename "$f")" ] && echo; cat "$f"; } >> "$DIR/$(basename "$f")"; done
}

# ---------- xung đột với kho ----------
# Gộp bằng merge (không rebase) để không mất phần không xung đột của cả hai bên.
resolve_conflict(){ # [ours|theirs] để chạy không hỏi (kiểm thử)
  local how=${1:-} files e f
  export GIT_SSH_COMMAND; GIT_SSH_COMMAND=$(git_ssh 8)
  lock 10 || { err "Đang có một lần đồng bộ khác, thử lại sau"; [ -z "$how" ] && pause; return 1; }
  g fetch -q origin 2>/dev/null || { unlock; err "Không kết nối được kho"; [ -z "$how" ] && pause; return 1; }
  ensure_merge_setup
  if g merge -q --no-edit '@{u}' >/dev/null 2>&1 && validate >/dev/null; then g push -q 2>/dev/null; set_status ok; unlock; build_index; ok "Đã gộp, không còn xung đột"; [ -z "$how" ] && pause; return 0; fi
  files=$(g diff --name-only --diff-filter=U | tr '\n' ' ')
  if [ -z "$how" ]; then
    title "Gộp xung đột"
    warn "Kho và máy này cùng sửa: $files"; echo
    g -c color.ui=always diff | head -40; echo
    case $(pick "Giữ bản nào? Server chỉ sửa ở một bên đã được gộp sẵn." \
        "Sửa tay|mở file, chọn giữa hai bản được đánh dấu <<<<<<< máy này / >>>>>>> kho" "Lấy bản trong kho|cho các server bị sửa ở cả hai nơi" "Giữ bản của máy này|cho các server bị sửa ở cả hai nơi" "Để sau") in
      0) how=edit;; 1) how=theirs;; 2) how=ours;; *) g merge --abort; unlock; return 1;;
    esac
  fi
  case $how in
    ours|theirs) g merge --abort; HOSTBOOK_MERGE_PREFER=$how g merge -q --no-edit '@{u}' >/dev/null 2>&1
       # secret không tự trộn được: lấy nguyên file của phía đã chọn
       for f in $(g diff --name-only --diff-filter=U 2>/dev/null); do case $f in secrets/*) g checkout -q "--$how" -- "$f" 2>/dev/null || g rm -q --cached "$f" 2>/dev/null; g add -A -- "$f" 2>/dev/null;; esac; done
       if [ -n "$(g diff --name-only --diff-filter=U 2>/dev/null)" ]; then g merge --abort; unlock; err "Không gộp được"; return 1; fi
       [ -f "$DIR/.git/MERGE_HEAD" ] && g commit -q --no-edit >/dev/null 2>&1;;
    edit) local l ed sn side seen=" "; ed=${VISUAL:-${EDITOR:-$(have nano && echo nano || echo vi)}}
      for f in $(g diff --name-only --diff-filter=U); do case $f in secrets/*) sn=$(basename "$f"); sn=${sn%.*}
        case $seen in *" $sn "*) ;; *) seen="$seen$sn "; case $(pick "Secret $sn bị sửa ở cả hai nơi" "Giữ bản của máy này" "Lấy bản trong kho") in 1) side=theirs;; *) side=ours;; esac
          for l in age meta pub; do g checkout -q "--$side" -- "secrets/$sn.$l" 2>/dev/null; g add -A -- "secrets/$sn.$l" 2>/dev/null; done;; esac;; esac; done
      while :; do
        for f in $(g diff --name-only --diff-filter=U | grep -v '^secrets/'); do l=$(grep -n '^<<<<<<<' "$DIR/$f" | head -1 | cut -d: -f1); $ed "+${l:-1}" "$DIR/$f"; done
        if grep -l '^<<<<<<<\|^>>>>>>>' "$DIR"/*.conf "$GRP" >/dev/null 2>&1; then warn "Vẫn còn dấu <<<<<<< chưa xử lý"
        elif ! e=$(validate); then warn "Config lỗi: $(printf '%s' "$e" | head -1)"
        else g add -A; g commit -qm "Gộp với kho" >/dev/null; break; fi
        confirm "Mở lại để sửa tiếp?" || { g merge --abort; unlock; return 1; }
      done;;
  esac
  if ! e=$(validate); then g reset -q --hard ORIG_HEAD 2>/dev/null; unlock; err "Bản gộp làm config lỗi nên đã huỷ: $e"; return 1; fi
  g push -q 2>/dev/null && set_status ok || set_status pending 1
  unlock; build_index; flash "${CG}${ICON_OK} Đã gộp với kho${C0}"
}

# ---------- kiểm tra kết nối ----------
# Một dòng lý do cho một lần kết nối hỏng (bản rút gọn của explain, dùng khi kiểm tra nhiều server).
classify_log(){ # tên log
  local n=$1 f=$2 ip port j sc type
  ip=$(host_field "$n" 3); port=$(host_field "$n" 5); port=${port:-22}; j=$(host_field "$n" 6); sc=$(host_field "$n" 12); type=""; [ -n "$sc" ] && type=$(secret_meta "$sc" type)
  if grep -qiE 'IDENTIFICATION HAS CHANGED|Host key verification failed' "$f"; then echo "host key đã thay đổi, cần bạn tự kiểm tra"
  elif grep -qi 'Permission denied' "$f"; then
    if [ "$type" = password ]; then echo "mật khẩu trong secret $sc không đúng, hoặc sai user"
    elif [ "$type" = key ]; then echo "server không nhận key của secret $sc (chưa thêm public key, hoặc sai user)"
    else echo "server từ chối đăng nhập (chưa có cách đăng nhập được lưu)"; fi
  elif grep -qi 'Could not resolve hostname' "$f"; then echo "không tìm thấy địa chỉ $ip"
  elif grep -qi 'Connection refused' "$f"; then echo "$ip từ chối kết nối ở cổng $port"
  elif grep -qiE 'No route to host|Network is unreachable|Host is down' "$f"; then echo "không có đường mạng tới $ip"
  elif grep -qiE 'timed out|hostbook: hết' "$f"; then
    if [ -n "$j" ] && ! grep -q 'Authenticated to' "$f"; then echo "không vào được máy trung gian $j"
    elif [ -n "$j" ]; then echo "$j không nối tới được $ip:$port"
    else echo "không có phản hồi từ $ip:$port (máy này chưa vào mạng/VPN của server?)"; fi
  elif grep -qiE 'Connection closed|Connection reset|kex_exchange_identification' "$f"; then echo "server đóng kết nối giữa chừng"
  else echo "không kết nối được: $(tr -d '\r' < "$f" | grep -vE '^(debug[0-9]|OpenSSH_|Warning: Permanently)' | grep . | tail -1 | cut -c1-80)"; fi
}
check_one(){ # tên thư-mục → ghi <thư mục>/<tên>.res = "ok|fail<TAB>lý do". Thử đăng nhập rồi thoát ngay, không chạy lệnh nào trên server.
  local h=$1 d=$2 sc type pid i=0 rc
  sc=$(host_field "$h" 12); type=""; [ -n "$sc" ] && type=$(secret_meta "$sc" type)
  if [ "$type" = password ]; then   # BatchMode sẽ tắt đăng nhập bằng mật khẩu, nên dùng askpass ở chế độ không hỏi người dùng
    SSH_ASKPASS="$STATE/askpass" SSH_ASKPASS_REQUIRE=force HB_ASKPASS_NOTTY=1 HB_ASKPASS_HOST="$h" HB_ASKPASS_COUNT="$d/$h.cnt" \
      sshx -v -E "$d/$h.log" -o ConnectTimeout=5 -o NumberOfPasswordPrompts=1 -o StrictHostKeyChecking=accept-new "$h" true </dev/null >/dev/null 2>&1 & pid=$!
  else sshx -v -E "$d/$h.log" -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new "$h" true </dev/null >/dev/null 2>&1 & pid=$!; fi
  while kill -0 $pid 2>/dev/null && [ $i -lt 80 ]; do sleep 0.1; i=$((i+1)); done   # chốt chặn 8 giây
  if kill -0 $pid 2>/dev/null; then kill $pid 2>/dev/null; echo "hostbook: hết 8 giây chờ" >> "$d/$h.log"; rc=124; else wait $pid; rc=$?; fi
  if [ $rc -eq 0 ]; then printf 'ok\tđăng nhập được%s\n' "${sc:+ bằng $sc}" > "$d/$h.res"; else printf 'fail\t%s\n' "$(classify_log "$h" "$d/$h.log")" > "$d/$h.res"; fi
}
# Kiểm tra nhiều server: theo tầng máy trung gian, mỗi lượt 8 server song song. Kết quả ghi vào $STATE/last-check.tsv.
check_run(){ # tên…
  local d=$STATE/check all="$*" h j pending done_ok=" " done_bad=" " batch n=0 total=$# lvl st why res
  [ -d "$d" ] && rm -rf "${d:?}"; mkdir -p "$d"; : > "$STATE/last-check.tsv"
  prepare_login "$@" || return 1
  [ -f "$STATE/askpass" ] || { printf '#!/bin/sh\nexec %s _askpass "$@"\n' "$(printf %q "$SELF")" > "$STATE/askpass"; chmod 700 "$STATE/askpass"; }
  pending=" $all "
  while [ -n "${pending// /}" ]; do
    lvl=""
    for h in $pending; do j=$(host_field "$h" 6 | cut -d, -f1)
      case $done_bad in *" $j "*) [ -n "$j" ] && { printf '%s\tskip\tbỏ qua: máy trung gian %s không vào được\n' "$h" "$j" >> "$STATE/last-check.tsv"; done_bad="$done_bad$h "; pending=${pending/ $h / }; n=$((n+1)); [ -z "${HB_PLAIN:-}" ] && printf '\r\033[K  %s·%s %s  %sbỏ qua: máy trung gian %s không vào được%s\n' "$CD" "$C0" "$h" "$CD" "$j" "$C0"; continue; };; esac
      case " $pending " in *" $j "*) [ -n "$j" ] && continue;; esac   # máy trung gian còn chờ kiểm tra: để lượt sau
      lvl="$lvl $h"; done
    [ -n "$lvl" ] || break
    set -- $lvl
    while [ $# -gt 0 ]; do
      batch=""; for h in "$1" "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" "${7:-}" "${8:-}"; do [ -n "$h" ] && { batch="$batch $h"; check_one "$h" "$d" & }; done
      [ -z "${HB_PLAIN:-}" ] && printf '\r\033[K  %s… đang kiểm tra %s/%s%s' "$CD" "$n" "$total" "$C0"
      wait
      for h in $batch; do IFS="$TAB" read -r st why < "$d/$h.res"; printf '%s\t%s\t%s\n' "$h" "$st" "$why" >> "$STATE/last-check.tsv"; n=$((n+1)); pending=${pending/ $h / }
        if [ "$st" = ok ]; then done_ok="$done_ok$h "; [ -z "${HB_PLAIN:-}" ] && printf "\r\033[K  %s${ICON_OK}%s %s  %s%s%s\n" "$CG" "$C0" "$h" "$CD" "$why" "$C0"
        else done_bad="$done_bad$h "; [ -z "${HB_PLAIN:-}" ] && printf "\r\033[K  %s${ICON_ERR}%s %s  %s\n" "$CR" "$C0" "$h" "$why"; fi; done
      shift $(( $# < 8 ? $# : 8 ))
    done
  done
  [ -z "${HB_PLAIN:-}" ] && printf '\r\033[K'
  return 0
}
check_hosts(){ # tên…
  local nok nbad h
  [ $# -gt 30 ] && { confirm "Kiểm tra kết nối $# server? Mỗi server tối đa 8 giây, chạy 8 server một lượt." || return 0; }
  while :; do
    clear; title "Kiểm tra kết nối · $# server"; dim "Mỗi server thử đăng nhập rồi thoát ngay, không chạy lệnh nào."; echo
    check_run "$@" || { pause; return 1; }
    nok=$(awk -F'\t' '$2=="ok"' "$STATE/last-check.tsv" | grep -c .); nbad=$(awk -F'\t' '$2!="ok"' "$STATE/last-check.tsv" | grep -c .)
    echo; printf "%s${ICON_OK} %s vào được%s%s\n" "$CG" "$nok" "$C0" "$( [ "$nbad" -gt 0 ] && printf " · %s${ICON_ERR} %s không vào được%s" "$CR" "$nbad" "$C0")"; echo
    [ "$nbad" -gt 0 ] || { pause; return 0; }
    case $(pick "" "Xem chi tiết lỗi" "Thử lại các server lỗi" "Xong") in
      0) h=$(awk -F'\t' '$2=="fail"{print $1}' "$STATE/last-check.tsv" | gum choose --header "Server nào?") && { clear; explain "$h" "$STATE/check/$h.log" pane; pause; };;
      1) set -- $(awk -F'\t' '$2!="ok"{print $1}' "$STATE/last-check.tsv");;
      *) return 0;;
    esac
  done
}

# ---------- chia sẻ ----------
SHARE_WORDS="cam chanh dua xoai mit oi tao le nho man dao mo buoi na khe vai meo cho ga vit bo trau ngua de heo tho cao soi gau ho bao voi chim ca tom cua oc ech ran rua ong buom kien ve muoi nhen luon muc nui song bien suoi rung dong lua gio mua nang may sao trang sam chop suong ban ghe tu den quat chen bat dia thia noi chao binh ly coc am ro xanh do tim vang nau hong xam bac lon be dai ngan nhanh cham nong lanh di chay bay boi leo nhay hat doc viet nghe nhin cuoi an uong ngu choi nha cong duong cau pho lang que truong lop san vuon ao ruong thuyen xe tau"
share_password(){ # 4 từ + 2 chữ số, ví dụ cam-sao-bien-lua-73
  local w=($SHARE_WORDS) out="" i r
  for i in 1 2 3 4; do r=$(od -An -N2 -tu2 /dev/urandom | tr -d ' '); out="$out${w[$((r % ${#w[@]}))]}-"; done
  r=$(od -An -N2 -tu2 /dev/urandom | tr -d ' '); printf '%s%02d\n' "$out" $((r % 100))
}
# Các dòng tuỳ chọn riêng của một khối Host (không phải các dòng hostbook tự sinh lại được).
block_extras(){ # file dòng-Host
  awk -v l="$2" 'NR>l { if (tolower($1)=="host" || tolower($1)=="match") exit
      k=tolower($1); if ($0 ~ /^[ \t]*(#|$)/) next
      if (k=="hostname"||k=="user"||k=="port"||k=="proxyjump"||k=="identityfile"||k=="identitiesonly"||k=="pubkeyauthentication"||k=="preferredauthentications") next
      print }' "$1"
}
in_list(){ case " $2 " in *" $1 "*) return 0;; esac; return 1; }   # tách riêng: bash 3.2 không đọc được "case" nằm trong $(...)
share_closure(){ # tên… → in các tên, kèm máy trung gian còn thiếu (đệ quy)
  local all=" $* " h j changed=1
  while [ -n "$changed" ]; do changed=""
    for h in $all; do for j in $(host_field "$h" 6 | tr ',' ' '); do host_exists "$j" || continue
      case $all in *" $j "*) ;; *) all="$all$j "; changed=1;; esac; done; done; done
  printf '%s\n' $all
}
# Dựng thư mục gói (chưa mã hoá). Khối Host được "làm phẳng": giá trị hiệu lực, không phụ thuộc khối wildcard của người gửi.
share_build(){ # thư-mục kèm-secret(0|1) tên…
  local out=$1 ws=$2 h sc p used=" " line n; shift 2
  mkdir -p "$out/conf"; [ "$ws" = 1 ] && mkdir -p "$out/secrets"
  for h in "$@"; do
    host_exists "$h" || continue
    sc=$(host_field "$h" 12); [ "$ws" = 1 ] && secret_exists "$sc" || sc=""
    p=$(host_field "$h" 2)
    { [ -s "$out/conf/$p.conf" ] && echo
      host_block "$h" "$(host_field "$h" 3)" "$(host_field "$h" 4)" "$(host_field "$h" 5)" "$(host_field "$h" 6)" "$sc" "$(host_field "$h" 8)" "$(host_field "$h" 9)" | awk '$1=="ProxyJump" && $2=="none" {next} {print}'
      block_extras "$(host_field "$h" 10)" "$(host_field "$h" 11)"; } >> "$out/conf/$p.conf"
    [ -n "$sc" ] && case $used in *" $sc "*) ;; *) used="$used$sc ";; esac
  done
  for sc in $used; do
    cp "$SEC/$sc.meta" "$out/secrets/$sc.meta"
    if [ "$(secret_meta "$sc" type)" = password ]; then secret_get "$sc" > "$out/secrets/$sc.pass" || return 1
    else secret_get "$sc" > "$out/secrets/$sc.key" || return 1; cp "$SEC/$sc.pub" "$out/secrets/$sc.pub"; fi
  done
  : > "$out/groups.tsv"
  [ -f "$GRP" ] && while IFS= read -r line; do [ -n "$line" ] || continue; group_line "$line"
    n=""; for h in $GH; do case " $* " in *" $h "*) n="$n${n:+ }$h";; esac; done
    [ "$(printf '%s\n' $n | grep -c .)" -ge 2 ] && printf '%s\t%s\t%s\n' "$GN" "$GM" "$n" >> "$out/groups.tsv"
  done < "$GRP"
  printf 'version=1\nfrom=%s\ndate=%s\nhosts=%s\nsecrets=%s\n' "$(hostname -s)" "$(date +%FT%T)" "$#" "$(printf '%s\n' $used | grep -c .)" > "$out/manifest"
}
share_pack(){ # thư-mục mật-khẩu → in gói
  printf '# hostbook-share v1 · %s server · từ %s\n' "$(sed -n 's/^hosts=//p' "$1/manifest")" "$(sed -n 's/^from=//p' "$1/manifest")"
  tar -czf - -C "$1" . | age_pw_enc "$2"
}
share_flow(){ # tên…
  local all extra d ws=1 pw pack f np ns ng i h
  ensure_index
  all=$(share_closure "$@" | tr '\n' ' '); extra=$(for h in $all; do in_list "$h" "$*" || printf '%s ' "$h"; done)
  set -- $all; [ $# -gt 0 ] || { warn "Không có server nào để chia sẻ"; pause; return 1; }
  np=0; for h in "$@"; do is_prod "$h" && np=$((np+1)); done
  ns=$(for h in "$@"; do host_field "$h" 12; done | grep . | sort -u | tr '\n' ' ')
  clear; title "Chia sẻ"
  printf '%s server%s%s\n' "$#" "$( [ -n "$ns" ] && echo " · secret: $ns")" "$( [ $np -gt 0 ] && printf "   %s${ICON_PROD} %s server prod%s" "$CR" "$np" "$C0")"
  for i in $(for h in "$@"; do host_field "$h" 2; done | sort -u); do printf '  %s%s%s  %s\n' "$CU" "$i" "$C0" "$(for h in "$@"; do [ "$(host_field "$h" 2)" = "$i" ] && printf '%s ' "$h"; done | cut -c1-90)"; done
  [ -n "$extra" ] && dim "  kèm vì là máy trung gian: $extra"
  echo
  if [ -n "$ns" ]; then case $(pick "" "Tạo gói (kèm secret)|người nhận dùng được ngay" "Tạo gói không kèm secret|người nhận tự chọn cách đăng nhập" "Huỷ") in 0) ws=1;; 1) ws=0;; *) return 1;; esac
  else ws=0; confirm "Tạo gói chia sẻ?" || return 1; fi
  d=$(tmpd)/pack; share_build "$d" "$ws" "$@" || { err "Chưa mở được kho secret"; pause; return 1; }
  pw=$(share_password); pack=$(share_pack "$d" "$pw"); rm -rf "${d:?}"
  if printf '%s\n' "$pack" | copy 2>/dev/null; then ok "Đã copy gói vào clipboard ($(( ${#pack} / 1024 + 1 )) KB)"; else f=1; fi
  if [ -n "${f:-}" ] || [ ${#pack} -gt 4000 ]; then f="$( [ -d "$HOME/Downloads" ] && echo "$HOME/Downloads" || pwd)/hostbook-$(date +%Y%m%d-%H%M).hbshare"; printf '%s\n' "$pack" > "$f"; ok "Đã lưu gói tại ${f/#$HOME/~}"; fi
  echo; box ok "Mật khẩu của gói:  ${CB}$pw${C0}" "Gửi mật khẩu này qua kênh KHÁC với kênh gửi gói." "Người nhận: copy gói rồi mở hostbook, hoặc hostbook import <file>."
  case $(pick "" "Xong" "Copy mật khẩu|thay cho gói trong clipboard") in 1) printf '%s' "$pw" | copy && ok "Đã copy mật khẩu"; pause;; esac
}

# ---------- nhập gói chia sẻ ----------
is_pack(){ head -c 300 "$1" 2>/dev/null | grep -q '^# hostbook-share v1'; }
pack_open(){ # file-gói → in thư mục đã giải nén (trong tmpd); hỏi mật khẩu gói
  local f=$1 d pw i bad
  d=$(tmpd)
  for i in 1 2 3; do
    pw=${HB_PACK_PW:-}; [ -n "$pw" ] || pw=$(ask "Mật khẩu của gói" "cam-sao-bien-lua-73") || return 1
    if sed -n '/BEGIN AGE ENCRYPTED FILE/,$p' "$f" > "$d/pack.age" && age_pw_dec "$pw" "$d/pack.age" > "$d/pack.tgz" && [ -s "$d/pack.tgz" ]; then break; fi
    err "Sai mật khẩu gói" >&2; [ -n "${HB_PACK_PW:-}" ] && return 1; [ $i = 3 ] && return 1
  done
  # chỉ nhận đúng bố cục của gói; từ chối đường dẫn tuyệt đối hay có ".."
  bad=$(tar -tzf "$d/pack.tgz" 2>/dev/null | grep -vE '^(\./)?(manifest|groups\.tsv|conf/|secrets/|conf/[A-Za-z0-9._-]+\.conf|secrets/[a-z0-9._-]+\.(key|pass|meta|pub))?$')
  [ -z "$bad" ] && ! tar -tzf "$d/pack.tgz" | grep -q '\.\.' || { err "Gói có nội dung lạ, không nhập" >&2; return 1; }
  mkdir -p "$d/x" && tar -xzf "$d/pack.tgz" -C "$d/x" || return 1
  rm -f "$d/pack.age" "$d/pack.tgz"; echo "$d/x"
}
pack_index(){ # thư-mục-gói → chỉ mục của gói (cùng định dạng index.tsv)
  local x=$1 f
  printf 'Include %s/conf/*.conf\n' "$x" > "$x/cfg"
  ( SSHCFG=$x/cfg; for f in "$x"/conf/*.conf; do [ -f "$f" ] && index_file "$f"; done ) 2>/dev/null
}
# Ánh xạ secret của gói sang kho secret của máy này. In "tên-trong-gói<TAB>tên-ở-đây<TAB>mới|có sẵn|đổi tên".
pack_secret_map(){ # thư-mục-gói
  local x=$1 m n fp loc t
  for m in "$x"/secrets/*.meta; do [ -f "$m" ] || continue; n=$(basename "$m" .meta)
    if grep -q '^type=password' "$m"; then
      if secret_exists "$n"; then if [ "$(secret_meta "$n" type)" = password ] && [ "$(secret_get "$n")" = "$(cat "$x/secrets/$n.pass")" ]; then printf '%s\t%s\tcó sẵn\n' "$n" "$n"; continue; fi
        t=$n-2; while secret_exists "$t"; do t=$t-2; done; printf '%s\t%s\tđổi tên\n' "$n" "$t"
      else printf '%s\t%s\tmới\n' "$n" "$n"; fi
    else fp=$(sed -n 's/^fp=//p' "$m"); loc=$(grep -lxF "fp=$fp" "$SEC"/*.meta 2>/dev/null | head -1)
      if [ -n "$loc" ]; then printf '%s\t%s\tcó sẵn\n' "$n" "$(basename "$loc" .meta)"
      elif secret_exists "$n"; then t=$n-2; while secret_exists "$t"; do t=$t-2; done; printf '%s\t%s\tđổi tên\n' "$n" "$t"
      else printf '%s\t%s\tmới\n' "$n" "$n"; fi; fi
  done
}
# Phân loại từng server của gói: new | same | diff | ipdup. In "tên<TAB>loại<TAB>chi tiết".
pack_classify(){ # thư-mục-gói
  local x=$1
  ensure_index; pack_index "$x" > "$x/index"; pack_secret_map "$x" > "$x/smap"
  awk -F'\t' -v smap="$x/smap" '
    BEGIN { while ((getline l < smap) > 0) { split(l,a,"\t"); M[a[1]]=a[2] } }
    FILENAME==ARGV[1] { L[$1]=1; for (i=3;i<=12;i++) V[$1,i]=$i; ADDR[$3 ":" $5]=$1; next }
    { n=$1; sc=($12 in M) ? M[$12] : $12
      if (n in L) { d=""
        if (V[n,3]!=$3) d=d "HostName " V[n,3] " → " $3 "; "
        if (V[n,4]!=$4) d=d "User " V[n,4] " → " $4 "; "
        if (V[n,5]!=$5) d=d "Port " V[n,5] " → " $5 "; "
        if (V[n,6]!=$6) d=d "máy trung gian " (V[n,6]==""?"không":V[n,6]) " → " ($6==""?"không":$6) "; "
        if (V[n,8]!=$8) d=d "tags [" V[n,8] "] → [" $8 "]; "
        if (V[n,9]!=$9) d=d "mô tả đổi; "
        if (V[n,12]!=sc && $12!="") d=d "đăng nhập " (V[n,12]==""?"ssh tự lo":V[n,12]) " → " sc "; "
        sub(/; $/,"",d); print n "\t" (d==""?"same":"diff") "\t" d }
      else if (($3 ":" $5) in ADDR) print n "\tipdup\t" ADDR[$3 ":" $5]
      else print n "\tnew\t" }' "$IDX" "$x/index"
}
pack_block(){ # thư-mục-gói tên [tên-mới] → khối Host để ghi vào máy này (secret theo ánh xạ)
  local x=$1 n=$2 as=${3:-$2} r sc
  r=$(awk -F'\t' -v n="$n" '$1==n' "$x/index"); sc=$(printf '%s' "$r" | cut -f12)
  [ -n "$sc" ] && sc=$(awk -F'\t' -v s="$sc" '$1==s{print $2}' "$x/smap")
  host_block "$as" "$(printf '%s' "$r" | cut -f3)" "$(printf '%s' "$r" | cut -f4)" "$(printf '%s' "$r" | cut -f5)" "$(printf '%s' "$r" | cut -f6)" "$sc" "$(printf '%s' "$r" | cut -f8)" "$(printf '%s' "$r" | cut -f9)"
  block_extras "$(printf '%s' "$r" | cut -f10)" "$(printf '%s' "$r" | cut -f11)"
}
# Áp dụng theo file quyết định: "tên<TAB>add|skip|update|both|replace:<tên đang có>". Ghi tên đã thêm/cập nhật vào last-import.
pack_apply_raw(){ # thư-mục-gói file-quyết-định
  local x=$1 dec=$2 n act p blk line t st new loc m needed
  : > "$STATE/last-import"; blk=$(tmpd)/blk
  # chỉ nhập secret mà một server được nhập thật sự dùng tới
  needed=$(awk -F'\t' 'NR==FNR { if ($2!="skip") act[$1]=1; next } ($1 in act) && $12!="" {print $12}' "$dec" "$x/index" | sort -u | tr '\n' ' ')
  while IFS="$TAB" read -r n loc st; do   # secret trước, vì khối Host tham chiếu tới chúng
    [ "$st" = "có sẵn" ] && continue
    case " $needed " in *" $n "*) ;; *) continue;; esac
    vault_exists || return 1
    if [ -f "$x/secrets/$n.pass" ]; then cp "$x/secrets/$n.meta" "$SEC/$loc.meta"; secret_enc < "$x/secrets/$n.pass" > "$SEC/$loc.age"
    else cp "$x/secrets/$n.meta" "$SEC/$loc.meta"; cp "$x/secrets/$n.pub" "$SEC/$loc.pub"; chmod 600 "$SEC/$loc.pub"; secret_enc < "$x/secrets/$n.key" > "$SEC/$loc.age"; fi
  done < "$x/smap"
  while IFS="$TAB" read -r n act; do
    p=$(awk -F'\t' -v n="$n" '$1==n{print $2}' "$x/index"); t=$n
    case $act in
      skip) continue;;
      update) build_index; delete_host_raw "$n" keep;;
      replace:*) build_index; delete_host_raw "${act#replace:}";;
      both) t=$n-2; build_index; while host_exists "$t"; do t=$t-2; done;;
    esac
    pack_block "$x" "$n" "$t" > "$blk"; write_host "$p" "$blk"; echo "$t" >> "$STATE/last-import"
  done < "$dec"
  build_index
  [ -s "$x/groups.tsv" ] && while IFS= read -r line; do group_line "$line"
    new=$(for m in $GH; do host_exists "$m" && printf '%s ' "$m"; done)
    if [ -n "$(group_field "$GN" 1)" ]; then new=$(printf '%s\n' $(group_field "$GN" 3) $new | awk '!s[$0]++' | tr '\n' ' ')
      awk -F'\t' -v OFS='\t' -v n="$GN" -v h="${new% }" '$1==n{$3=h} {print}' "$GRP" > "$GRP.tmp" && mv "$GRP.tmp" "$GRP"
    elif [ "$(printf '%s\n' $new | grep -c .)" -ge 2 ]; then printf '%s\t%s\t%s\n' "$GN" "$GM" "${new% }" >> "$GRP"; fi
  done < "$x/groups.tsv"
  return 0
}
pack_decide(){ # thư-mục-gói chế-độ(pack|mine|ask) → in file quyết định
  local x=$1 mode=$2 n c det all=""
  while IFS="$TAB" read -r -u 3 n c det; do
    case $c in
      new) printf '%s\tadd\n' "$n";;
      same) printf '%s\tskip\n' "$n";;
      diff) if [ "$mode" = pack ] || [ "$all" = update ]; then printf '%s\tupdate\n' "$n"; elif [ "$mode" = mine ] || [ "$all" = skip ]; then printf '%s\tskip\n' "$n"
            else { clear; title "$n khác bản của bạn"; printf '%s\n' "$det" | tr ';' '\n' | sed 's/^ */  /'; echo; } >&2
              case $(pick "" "Cập nhật theo gói" "Giữ bản của tôi" "Giữ cả hai|bản trong gói thành $n-2" "Cập nhật tất cả các server còn lại" "Giữ bản của tôi cho tất cả còn lại") in
                0) printf '%s\tupdate\n' "$n";; 2) printf '%s\tboth\n' "$n";; 3) all=update; printf '%s\tupdate\n' "$n";; 4) all=skip; printf '%s\tskip\n' "$n";; *) printf '%s\tskip\n' "$n";; esac; fi;;
      ipdup) if [ "$mode" = pack ]; then printf '%s\tadd\n' "$n"; elif [ "$mode" = mine ]; then printf '%s\tskip\n' "$n"
             else { clear; title "$n trùng địa chỉ với $det"; } >&2
               case $(pick "" "Thêm như server mới" "Bỏ qua" "Thay thế $det") in 0) printf '%s\tadd\n' "$n";; 2) printf '%s\treplace:%s\n' "$n" "$det";; *) printf '%s\tskip\n' "$n";; esac; fi;;
    esac
  done 3< "$x/classes"
}
import_pack(){ # file
  local f=$1 x from nh nnew nsame ndiff ndup dec mode np n
  x=$(pack_open "$f") || { pause; return 1; }
  if ls "$x"/secrets/*.meta >/dev/null 2>&1; then vault_init || { pause; return 1; }; fi
  pack_classify "$x" > "$x/classes"
  from=$(sed -n 's/^from=//p' "$x/manifest"); nh=$(grep -c . "$x/classes")
  nnew=$(grep -c "${TAB}new${TAB}" "$x/classes"); nsame=$(grep -c "${TAB}same${TAB}" "$x/classes"); ndiff=$(grep -c "${TAB}diff${TAB}" "$x/classes"); ndup=$(grep -c "${TAB}ipdup${TAB}" "$x/classes")
  np=$(awk -F'\t' '(" " $8 " ") ~ / prod /' "$x/index" | grep -c .)
  clear; title "Nhập gói chia sẻ"
  printf 'Gói từ %s · %s server · %s nhóm · %s secret%s\n\n' "$from" "$nh" "$(grep -c . "$x/groups.tsv" 2>/dev/null)" "$(grep -c . "$x/smap")" "$( [ "$np" -gt 0 ] && printf "   %s${ICON_PROD} %s server prod%s" "$CR" "$np" "$C0")"
  [ "$nnew" -gt 0 ] && printf '  %s+ %s server mới%s            %s\n' "$CG" "$nnew" "$C0" "$(awk -F'\t' '$2=="new"{printf "%s ", $1}' "$x/classes" | cut -c1-70)"
  [ "$nsame" -gt 0 ] && printf '  %s= %s server giống hệt%s      bỏ qua\n' "$CD" "$nsame" "$C0"
  [ "$ndiff" -gt 0 ] && { printf '  %s≠ %s server khác bản của bạn%s\n' "$CY" "$ndiff" "$C0"; awk -F'\t' '$2=="diff"{printf "      %-14s %s\n", $1, $3}' "$x/classes" | cut -c1-110; }
  [ "$ndup" -gt 0 ] && { printf '  %s! %s server trùng địa chỉ%s\n' "$CY" "$ndup" "$C0"; awk -F'\t' '$2=="ipdup"{printf "      %s trong gói trùng địa chỉ với %s của bạn\n", $1, $3}' "$x/classes"; }
  [ -s "$x/smap" ] && { printf '\n  Secret: '; awk -F'\t' '{printf "%s (%s%s) · ", $1, $3, ($1!=$2 ? " → " $2 : "")}' "$x/smap" | sed 's/ · $//'; echo; }
  echo
  if [ $((nnew + ndiff + ndup)) -eq 0 ]; then ok "Mọi server trong gói đã có và giống hệt. Không có gì để nhập."; pause; return 0; fi
  case $(pick "" "Nhập theo đề xuất|thêm mới, bỏ qua giống hệt$( [ $((ndiff + ndup)) -gt 0 ] && echo ', hỏi từng server còn lại')" "Cập nhật tất cả theo gói" "Giữ tất cả bản của tôi|chỉ thêm server mới" "Huỷ") in
    0) mode=ask;; 1) mode=pack;; 2) mode=mine;; *) return 1;; esac
  dec=$x/decisions; pack_decide "$x" "$mode" > "$dec"
  apply_change "Nhập gói từ $from: +$(grep -c "${TAB}add$" "$dec") ~$(grep -cE "${TAB}(update|replace:.*|both)$" "$dec")" pack_apply_raw "$x" "$dec" || { pause; return 1; }
  import_done "$(grep -c "${TAB}add$" "$dec")" "$(grep -cE "${TAB}(update|replace:.*)$" "$dec")" "$(grep -c "${TAB}skip$" "$dec")"
}
import_done(){ # số-mới số-cập-nhật số-bỏ-qua
  local n; n=$(grep -c . "$STATE/last-import")
  clear; ok "Đã nhập: $1 mới · $2 cập nhật · $3 bỏ qua"; echo
  [ "$n" -gt 0 ] || { pause; return 0; }
  echo "Kiểm tra kết nối $n server vừa nhập?"; dim "  Mỗi server thử đăng nhập rồi thoát ngay, không chạy lệnh nào, tối đa 8 giây."
  case $(pick "" "Kiểm tra" "Để sau" "Xem các server vừa nhập" "Hoàn tác lần nhập này") in
    0) check_hosts $(cat "$STATE/last-import");;
    2) ONLY_NEXT=$STATE/last-import;;
    3) undo_last;;
  esac
}
batch_actions(){ # tên… (đang chọn nhiều server)
  case $(pick "Với $# server đã chọn" "Mở cùng lúc" "Kiểm tra kết nối" "Chia sẻ" "Lưu thành nhóm") in
    0) open_many "" "$@";; 1) check_hosts "$@";; 2) share_flow "$@";; 3) save_group "$@";;
  esac
}
clip_offer(){ # có gói chia sẻ trong clipboard thì hỏi nhập (mỗi gói chỉ hỏi một lần)
  local c h f
  c=$(clip_get 2>/dev/null | head -c 200000) || return 0
  printf '%s' "$c" | head -c 300 | grep -q '^# hostbook-share v1' || return 0
  h=$(printf '%s' "$c" | sha256); [ "$h" = "$(cat "$STATE/last-offer" 2>/dev/null)" ] && return 0
  echo "$h" > "$STATE/last-offer"
  clear; confirm "Có gói chia sẻ trong clipboard ($(printf '%s' "$c" | head -1 | sed 's/^# hostbook-share v1 · //')). Nhập?" || return 0
  f=$(tmpd)/clip.hbshare; printf '%s\n' "$c" > "$f"; import_pack "$f"
}

# ---------- nhóm, nhiều server, tmux ----------
suggest_group_name(){ # tag chung của các server, rồi tới phần tên chung
  ensure_index
  local base n=2 name
  # lấy tối đa 2 tag mà mọi server đều có, theo thứ tự tag của server đầu tiên; không có thì dùng tên server bỏ số cuối
  base=$(awk -F'\t' -v want=" $* " -v first="$1" 'index(want, " " $1 " ") { k++; m=split($8,a," "); for (i=1;i<=m;i++) c[a[i]]++ }
    $1==first { order=$8; nm=$1 }
    END { m=split(order,a," "); out=""; used=0
      for (i=1;i<=m && used<2;i++) if (c[a[i]]==k) { out=out (out==""?"":"-") a[i]; used++ }
      if (out=="") { sub(/[0-9]+$/,"",nm); sub(/-$/,"",nm); out=nm }
      print out }' "$IDX" | tr -cd 'a-z0-9-')
  [ -n "$base" ] || base=nhom-moi; name=$base
  while [ -n "$(group_field "$name" 1)" ]; do name=$base-$n; n=$((n+1)); done
  echo "$name"
}
save_group(){
  local hosts="$*" name
  title "Lưu thành nhóm"; dim "Gồm $# server: $hosts"; dim "Nhóm được lưu trong kho nên máy khác cũng thấy."; echo
  while :; do
    name=$(ask "Tên nhóm · đã gợi ý từ tag chung" "nhom-moi" "$(suggest_group_name "$@")") || return 1
    case $name in ""|*[!a-z0-9-]*) err "Chỉ dùng chữ thường, số và dấu gạch ngang";; *) [ -n "$(group_field "$name" 1)" ] && err "Đã có nhóm tên $name" || break;; esac
  done
  printf '%s\t\t%s\n' "$name" "$hosts" >> "$GRP"
  save_and_sync "Đã lưu nhóm $name"
}
need_tmux(){
  have tmux && return 0
  if is_mac && have brew; then confirm "Cần tmux để mở nhiều server cùng lúc. Cài ngay bằng brew install tmux?" && gum spin --title "Đang cài tmux" -- brew install tmux && return 0
  else box warn "Cần tmux để mở nhiều server cùng lúc." "Cài bằng trình quản lý gói của máy, ví dụ: sudo apt install tmux"; pause; fi
  return 1
}
open_many(){ # group-name-or-empty host...
  local grp=$1; shift
  local mode="" s first=1 h nprod=0 last ok_hosts="" missing="" sshcmd=ssh
  need_tmux || return 1
  for h in "$@"; do if valid_name "$h" && host_exists "$h"; then ok_hosts="$ok_hosts $h"; else missing="$missing $h"; fi; done
  [ -n "$missing" ] && warn "Bỏ qua server không còn trong danh sách:$missing"
  set -- $ok_hosts; [ $# -gt 0 ] || { err "Không còn server nào để mở"; pause; return 1; }
  [ -n "$grp" ] && mode=$(group_field "$grp" 2)
  if [ -z "$grp" ] && [ $# -eq 1 ]; then   # một server: không hỏi kiểu mở; đang ở trong tmux thì mở thành tab của phiên hiện tại
    record "$1"; sshcmd=$(pane_cmd)
    if [ -n "${TMUX:-}" ]; then tmux new-window -n "$1" "$sshcmd $(printf %q "$1")"; return; fi
    mode=tabs
  fi
  if [ -z "$mode" ]; then
    last=$(cat "$STATE/lastmode" 2>/dev/null || echo sync)
    title "Mở $# server"; dim "$*"; echo
    case $last in split) last="Chia ô";; tabs) last="Mỗi server một tab";; *) last="Chạy đồng loạt";; esac
    mode=$(printf 'Chia ô\nChạy đồng loạt\nMỗi server một tab\n' | gum choose --header "Mở thế nào?$( [ -n "$grp" ] && echo " · sẽ nhớ cho nhóm $grp")" --selected "$last") || return 1
    case $mode in Chia*) mode=split;; Chạy*) mode=sync;; *) mode=tabs;; esac
    echo "$mode" > "$STATE/lastmode"
    [ -n "$grp" ] && { set_group_mode "$grp" "$mode"; save_and_sync "Nhóm $grp: mở bằng $(mode_label "$mode")"; }
  fi
  for h in "$@"; do is_prod "$h" && nprod=$((nprod+1)); done
  if [ "$mode" = sync ] && [ $nprod -gt 0 ]; then
    confirm --default=false --affirmative "Mở" --negative "Không" "Chạy đồng loạt trên $nprod server PROD? Mọi phím bạn gõ sẽ gửi tới tất cả." || return 1
  fi
  # phiên của nhóm mang tên nhóm; bộ chọn tạm mang tên server đầu + số server + mã của cả bộ, để hai bộ khác nhau không vào nhầm phiên
  if [ -n "$grp" ]; then s="hb-$grp"; elif [ $# -eq 1 ]; then s="hb-$1"
  else s="hb-$1+$(( $# - 1 ))-$(printf '%s\n' "$@" | sort | cksum | cut -c1-4)"; fi
  s=$(printf '%s' "$s" | tr -c 'a-zA-Z0-9_+-' '-')
  if tmux has-session -t "=$s" 2>/dev/null; then attach "$s"; return; fi
  prepare_login "$@" || { pause; return 1; }   # mở khoá và nạp key một lần ở đây, để các ô không cùng hỏi
  record "$@"
  sshcmd=$(pane_cmd)
  for h in "$@"; do
    if [ $first = 1 ]; then tmux new-session -d -s "$s" -n "${grp:-$h}" "$sshcmd $(printf %q "$h")"; first=0
    elif [ "$mode" = tabs ]; then tmux new-window -t "$s" -n "$h" "$sshcmd $(printf %q "$h")"
    else tmux split-window -t "$s" "$sshcmd $(printf %q "$h")"; tmux select-layout -t "$s" tiled >/dev/null; fi
    tmux select-pane -t "$s" -T "$h$(is_prod "$h" && echo ' · PROD')"
    is_prod "$h" && tmux set -p -t "$s" pane-border-style "fg=$(tmux_color "$TH_ERR")" \; set -p -t "$s" pane-active-border-style "fg=$(tmux_color "$TH_ERR"),bold" 2>/dev/null
  done
  local pfx; pfx=$(tmux show -gv prefix 2>/dev/null | sed 's/^C-/^/'); pfx=${pfx:-^b}
  tmux set -t "$s" remain-on-exit on \; set -t "$s" pane-border-status top \; set -t "$s" pane-border-format ' #{pane_title} ' \; \
    set -t "$s" status-style "bg=$(tmux_color "$TH_OK"),fg=$(tmux_color "$TH_CHIP_FG")" \; set -t "$s" status-left "[${s#hb-}] " \; \
    set -t "$s" status-right " $pfx d: ẩn phiên (vẫn chạy) · $pfx x: đóng ô " \; set -t "$s" status-left-length 30 >/dev/null
  if [ "$mode" = sync ]; then tmux set-window-option -t "$s" synchronize-panes on >/dev/null; tmux set -t "$s" status-right " ĐỒNG LOẠT · $pfx d: ẩn phiên " >/dev/null; fi
  [ "$mode" = tabs ] && tmux select-window -t "$s:^" 2>/dev/null
  attach "$s"
}
# Lệnh chạy trong mỗi ô tmux: chính hostbook, để ô nào cũng có dòng tiến trình và lời giải thích khi lỗi.
# tmux server có thể đã chạy từ trước nên không mang theo biến môi trường của lần chạy này: truyền rõ ra.
pane_cmd(){ local v e=""
  for v in HOSTBOOK_DIR HOSTBOOK_STATE HOSTBOOK_SSH_CONFIG HOSTBOOK_CONNECT_TIMEOUT HOSTBOOK_KEYCHAIN HOSTBOOK_MASTER XDG_CONFIG_HOME SSH_AUTH_SOCK LC_CTYPE; do eval "[ -n \"\${$v:-}\" ] && e=\"\$e $v=\$(printf %q \"\${$v}\")\""; done
  printf 'env%s %q _connect' "$e" "$SELF"; }
attach(){ if [ -n "${TMUX:-}" ]; then tmux switch-client -t "$1"; else tmux attach -t "$1"; fi; }

# ---------- thao tác trên một server ----------
pf_presets(){ # tên → "cổng|mô tả|cách dùng"
  local t=" $(host_field "$1" 8) "
  case $t in *" postgres "*) echo "5432|PostgreSQL|psql -h localhost -p 5432";; esac
  case $t in *" mysql "*) echo "3306|MySQL|mysql -h 127.0.0.1 -P 3306";; esac
  case $t in *" redis "*) echo "6379|Redis|redis-cli -p 6379";; esac
  case $t in *" rabbitmq "*) echo "15672|RabbitMQ web|mở http://localhost:15672";; esac
  case $t in *" elastic "*) echo "9200|Elasticsearch|curl localhost:9200";; esac
  echo "8080|Web app|mở http://localhost:8080"
}
port_forward(){ # name [cổng]
  local n=$1 port=${2:-} use="" lp
  if [ -z "$port" ]; then port=$(ask "Cổng trên server" "3000") || return 1; fi
  case $port in ""|*[!0-9]*) err "Cổng phải là số"; pause; return 1;; esac
  use=$(pf_presets "$n" | awk -F'|' -v p="$port" '$1==p{print $3}')
  lp=$port; while port_open 127.0.0.1 "$lp"; do lp=$((lp+1)); done
  echo; box ok "${CG}${CB}localhost:$lp  →  $n:$port${C0}" "Dùng: ${use:-localhost:$lp}" "$( [ "$lp" != "$port" ] && echo "Cổng $port trên máy này đang bận nên dùng $lp.")" "${CD}Ctrl-C để dừng chuyển tiếp${C0}"
  record "$n"
  sshx -N -o ExitOnForwardFailure=yes -L "$lp:localhost:$port" "$n"
}
send_file(){
  local n=$1 src dst
  src=$(gum file --header "Chọn file hoặc thư mục để gửi lên $n" --all "$PWD") || return 1
  dst=$(ask "Lưu vào thư mục nào trên $n" "~" "~") || return 1
  record "$n"; scpx -r "$src" "$n:${dst:-~}/" && ok "Đã gửi $(basename "$src") lên $n:${dst:-~}/" || err "Không gửi được"; pause
}
get_file(){
  local n=$1 src
  src=$(ask "Đường dẫn file hoặc thư mục trên $n" "/var/log/nginx/error.log") || return 1
  [ -n "$src" ] || return 1
  record "$n"; scpx -r "$n:$src" "$PWD/" && ok "Đã tải về $PWD/$(basename "$src")" || err "Không tải được"; pause
}
change_login(){
  local n=$1 sc
  host_shared "$n" && { err "$n được khai báo chung một dòng Host với server khác. Sửa bằng ^e."; pause; return 1; }
  sc=$(pick_login "$(host_field "$n" 12)") || return 1
  ensure_index
  apply_change "Đổi cách đăng nhập của $n" set_host_secret "$n" "$sc"
}
host_actions(){
  local n=$1 ip p1 pport pname
  ip=$(host_field "$n" 3); p1=$(pf_presets "$n" | head -1); pport=${p1%%|*}; pname=$(printf '%s' "$p1" | cut -d'|' -f2)
  title "$n$(is_prod "$n" && printf "  %s${ICON_PROD} PROD%s" "$CR" "$C0")"; dim "$(host_field "$n" 9)"; echo
  local tmx="Mở trong tmux|giữ kết nối khi đóng terminal"; [ -n "${TMUX:-}" ] && tmx="Mở trong tab tmux mới"
  case $(pick "" "SSH vào server|enter ở ô tìm" "$tmx" "Chuyển tiếp cổng $pname|localhost:$pport → $n:$pport" "Chuyển tiếp cổng khác…" \
      "Gửi file lên server…" "Tải file về máy này…" "Copy IP|$ip" "Copy lệnh ssh|ssh $n" \
      "Sửa|^e" "Đổi tên" "Chuyển sang dự án khác|đang ở $(host_field "$n" 2)" "Xoá server" "Đổi cách đăng nhập|đang là: $(host_field "$n" 12 | grep . || echo 'ssh tự lo')" "Kiểm tra kết nối" "Chia sẻ server này") in
    0) connect "$n";;
    1) open_many "" "$n";;
    2) port_forward "$n" "$pport";;
    3) port_forward "$n";;
    4) send_file "$n";;
    5) get_file "$n";;
    6) printf '%s' "$ip" | copy && flash "${CG}${ICON_OK} Đã copy $ip${C0}";;
    7) printf 'ssh %s' "$n" | copy && flash "${CG}${ICON_OK} Đã copy: ssh $n${C0}";;
    8) edit_host "$n";;
    9) rename_server "$n";;
    10) move_server "$n";;
    11) delete_server "$n";;
    12) change_login "$n";;
    13) check_hosts "$n";;
    14) share_flow "$n";;
  esac
}
group_actions(){
  local n=$1
  case $(pick "Nhóm $n" "Mở nhóm" "Đổi kiểu mở|đang là: $(mode_label "$(group_field "$n" 2)")" "Xoá nhóm|server không bị xoá") in
    0) open_many "$n" $(group_field "$n" 3);;
    1) set_group_mode "$n" ""; open_many "$n" $(group_field "$n" 3);;
    2) confirm --default=false "Xoá nhóm $n?" && { awk -F'\t' -v n="$n" '$1!=n' "$GRP" > "$GRP.tmp" && mv "$GRP.tmp" "$GRP"; save_and_sync "Đã xoá nhóm $n"; };;
  esac
}

# ---------- kho, máy mới, key ----------
# Các máy thấy được qua mạng: LAN (mDNS) và Tailscale nếu có. In "địa_chỉ|mô tả".
discover(){
  local tmp p inst me; tmp=$(mktemp -d)
  if is_mac && have dns-sd; then
    me=$(scutil --get LocalHostName 2>/dev/null).local
    dns-sd -B _ssh._tcp local. > "$tmp/b" 2>/dev/null & p=$!; sleep 1.2; kill $p 2>/dev/null; wait $p 2>/dev/null
    # dns-sd -B chỉ cho tên hiển thị của máy; dns-sd -L đổi ra tên mạng dạng xxx.local
    awk -F'_ssh._tcp.' '/ Add / { n=$2; sub(/^[ \t]+/,"",n); print n }' "$tmp/b" | sort -u > "$tmp/names"
    while IFS= read -r inst; do ( dns-sd -L "$inst" _ssh._tcp local. > "$tmp/r.$RANDOM" 2>/dev/null & q=$!; sleep 1; kill $q 2>/dev/null ) & done < "$tmp/names"; wait
    cat "$tmp"/r.* 2>/dev/null | sed -n 's/.*reached at \([^ ]*\)\.:[0-9]*.*/\1/p' | sort -u | grep -vx "$me" | sed 's/$/|cùng mạng LAN/'
  elif have avahi-browse; then avahi-browse -tpr _ssh._tcp 2>/dev/null | awk -F';' '$1=="=" {print $7}' | sort -u | grep -vx "$(hostname).local" | sed 's/$/|cùng mạng LAN/'; fi
  # điện thoại (iOS, Android) không chứa kho được nên không liệt kê
  if have tailscale; then tailscale status 2>/dev/null | awk 'NR>1 && $1 ~ /^100\./ && !/offline/ && tolower($4) !~ /^(ios|android)$/ {print $2 "|qua Tailscale"}'; fi
  rm -rf "$tmp"
}
pick_machine(){ # header [url] → in đúng một dòng "user@máy" (hoặc URL git nếu cho phép) ra stdout; lời nhắn đi stderr vì hàm này được gọi trong $(...)
  local header=$1 allow_url=${2:-} list=() x i m
  while IFS= read -r x; do [ -n "$x" ] && list+=("$ME@$x"); done < <(gum spin --title "Đang tìm máy trong mạng" --show-output -- "$SELF" _discover)
  list+=("Nhập địa chỉ khác…|tên máy hoặc IP, user mặc định là $ME")
  [ -n "$allow_url" ] && list+=("Dùng URL git…|ví dụ git@github.com:ban/ssh-hosts-private.git")
  dim "Chỉ cần thấy máy đó qua mạng: cùng Wi-Fi/LAN, VPN hay Tailscale đều được." >&2; echo >&2
  i=$(pick "$header" "${list[@]}") || return 1
  if [ -n "$allow_url" ] && [ "$i" -eq $(( ${#list[@]} - 1 )) ]; then
    m=$(ask "URL git của kho · repo phải là private" "git@github.com:ban/ssh-hosts-private.git") || return 1
    is_url "$m" || { err "Không phải URL git: $m" >&2; return 1; }
    case $m in *[[:space:]\;\|\&\$\`]*) err "URL có ký tự lạ" >&2; return 1;; esac
    printf '%s\n' "$m"; return 0
  elif [ "$i" -eq $(( ${#list[@]} - ${allow_url:+2}${allow_url:-1} )) ]; then
    m=$(ask "Tên máy hoặc IP · có thể kèm user@" "home.local hoặc 192.168.1.20") || return 1
    case $m in *@*) ;; *) m="$ME@$m";; esac
  else x=${list[$i]}; m=${x%%|*}; fi
  case ${m#*@} in ""|*[!A-Za-z0-9._-]*) err "Địa chỉ không hợp lệ: $m" >&2; return 1;; esac
  case ${m%%@*} in ""|*[!A-Za-z0-9._-]*) err "User không hợp lệ: $m" >&2; return 1;; esac
  printf '%s\n' "$m"
}
ensure_key(){ # có key để đăng nhập máy $1; nếu chưa thì tạo key và ssh-copy-id (hỏi mật khẩu một lần)
  local m=$1
  sshx -o BatchMode=yes -o ConnectTimeout=5 "$m" true 2>/dev/null && return 0
  if [ ! -f "$HOME/.ssh/id_ed25519" ] && [ ! -f "$HOME/.ssh/id_rsa" ]; then mkdir -p "$HOME/.ssh"; ssh-keygen -q -t ed25519 -N "" -f "$HOME/.ssh/id_ed25519" && ok "Đã tạo key ~/.ssh/id_ed25519"; fi
  dim "Lần đầu kết nối: nhập mật khẩu của $m một lần để thêm key của máy này."
  ssh-copy-id ${SSHCFG:+-F "$SSHCFG"} "$m" || { err "Không đăng nhập được $m"; return 1; }
  ok "Đã thêm key lên $m"
}
connect_kho(){ # nối ~/ssh-hosts với kho trên máy khác
  local m url
  title "$(has_remote && echo 'Đổi kho' || echo 'Kết nối kho')"; dim "Kho giữ bản gốc danh sách server. Mọi máy nối cùng một kho sẽ luôn giống nhau."; echo
  m=$(pick_machine "Kho ở máy nào?" url) || return 1
  if is_url "$m"; then url=$m   # kho là một repo git bất kỳ (GitHub private, Gitea…): không cần tạo
  else
    ensure_key "$m" || { pause; return 1; }
    if ! sshx -o ConnectTimeout=8 "$m" 'test -d ~/repos/ssh-hosts.git' 2>/dev/null; then
      confirm "Máy $m chưa có kho. Tạo kho trên máy đó?" || return 1
      sshx "$m" 'git init -q --bare ~/repos/ssh-hosts.git' || { err "Không tạo được kho (máy đó đã cài git chưa?)"; pause; return 1; }
      ok "Đã tạo kho trên $m"
    fi
    url="$m:repos/ssh-hosts.git"
  fi
  if has_remote; then g remote set-url origin "$url"; else g remote add origin "$url"; fi
  export GIT_SSH_COMMAND; GIT_SSH_COMMAND=$(git_ssh 8)
  lock 10 || { err "Đang có một lần đồng bộ khác, thử lại sau"; pause; return 1; }
  ensure_merge_setup
  if ! g ls-remote origin >/dev/null 2>&1; then unlock; err "Không đọc được kho ở $url (sai địa chỉ, hoặc máy này chưa có quyền)"; pause; return 1; fi
  if g fetch -q origin 2>/dev/null && g ls-remote --exit-code origin HEAD >/dev/null 2>&1; then
    # kho đã có dữ liệu: gộp với danh sách của máy này (lịch sử khác nhau nên cần --allow-unrelated-histories)
    g branch -q --set-upstream-to="origin/$(g symbolic-ref --short HEAD)" 2>/dev/null || { g fetch -q origin "+refs/heads/*:refs/remotes/origin/*"; g branch -q --set-upstream-to="origin/$(g remote show origin 2>/dev/null | sed -n 's/.*HEAD branch: //p')"; }
    if ! g merge -q --no-edit --allow-unrelated-histories '@{u}' >/dev/null 2>&1; then
      g merge --abort 2>/dev/null; unlock; err "Danh sách trên máy này và trong kho cùng có một file nhưng khác nội dung. Cần gộp tay trong ~/ssh-hosts."; pause; return 1
    fi
  fi
  sync_locked; unlock; build_index
  case $(sed -n 1p "$ST") in ok|pulled) ok "Đã nối với kho ở $(kho_addr)"; flash "${CG}${ICON_OK} Đã nối với kho ở $(kho_addr)${C0}";; *) warn "Đã đặt kho ở $(kho_addr) nhưng chưa đồng bộ được: $(sed -n 1p "$ST")";; esac
  pause "enter để tiếp tục"
}
make_kho_here(){
  local addrs
  title "Tạo kho trên máy này"; dim "Chạy một lần trên máy luôn bật. Các máy khác chỉ cần thấy máy này qua mạng."; echo
  if ! port_open 127.0.0.1 22; then
    if is_mac; then box warn "${CY}Cần bật SSH trên máy này:${C0}" "System Settings → General → Sharing → Remote Login"
    else box warn "${CY}Cần bật SSH trên máy này:${C0}" "sudo systemctl enable --now ssh"; fi
    pause "bật xong nhấn enter để kiểm tra lại"; port_open 127.0.0.1 22 || { err "SSH vẫn chưa bật"; pause; return 1; }
  fi
  ok "SSH đang bật"
  [ -d "$HOME/repos/ssh-hosts.git" ] || git init -q --bare "$HOME/repos/ssh-hosts.git"; ok "Kho: ~/repos/ssh-hosts.git"
  if [ -d "$DIR/.git" ]; then
    if has_remote; then g remote set-url origin "$HOME/repos/ssh-hosts.git"; else g remote add origin "$HOME/repos/ssh-hosts.git"; fi
    g push -q -u origin HEAD 2>/dev/null && ok "Đã đưa danh sách của máy này vào kho"
  fi
  addrs="$( (is_mac && echo "$(scutil --get LocalHostName 2>/dev/null).local"); (is_mac && ipconfig getifaddr en0 2>/dev/null) || hostname -I 2>/dev/null | awk '{print $1}'; have tailscale && tailscale ip -4 2>/dev/null | head -1 ) | grep . | tr '\n' ' ')"
  echo; box ok "${CG}Kho đã sẵn sàng.${C0}" "Máy khác vào được bằng: $addrs" "Mở hostbook trên máy khác cùng mạng, app sẽ tự tìm thấy kho này." "${CD}Khi khác mạng, dùng VPN hoặc Tailscale để các máy thấy kho.${C0}"
  pause
}
undo_last(){
  local msg; msg=$(g log -1 --format=%s 2>/dev/null) || return 1
  confirm --default=false "Hoàn tác \"$msg\"?" || return 1
  g revert --no-edit HEAD >/dev/null 2>&1 || { err "Không hoàn tác được"; pause; return 1; }
  if ! validate >/dev/null; then g reset -q --hard HEAD~1; err "Hoàn tác sẽ làm hỏng config nên đã dừng"; pause; return 1; fi
  build_index; flash "${CG}${ICON_OK} Đã hoàn tác \"$msg\"${C0}"; : > "$ST.force"
}
doctor(){
  local n e
  title "Kiểm tra máy này"
  ok "hostbook $VERSION"
  check_deps report
  e=$(cfg_errors); [ -z "$e" ] || warn "$e"
  n=$(cfg theme hostbook); if ! theme_builtin "$n" >/dev/null; then e=$(theme_check "$CONF/themes/$n.theme" 2>&1) || warn "$e"; fi
  have tmux && ok "tmux đã cài" || warn "tmux chưa có · sẽ hỏi cài khi mở nhiều server"
  [ -d "$DIR/.git" ] && ok "~/ssh-hosts là git repo" || err "~/ssh-hosts chưa phải git repo"
  if has_remote; then
    if GIT_SSH_COMMAND=$(git_ssh 4) g ls-remote -q origin >/dev/null 2>&1; then ok "Kho ở $(kho_addr) kết nối được"; else warn "Không kết nối được kho ở $(kho_addr)"; fi
  else warn "Chưa có kho · Công cụ → Kết nối kho"; fi
  grep -qs "Include.*ssh-hosts" "$HOME/.ssh/config" && ok "~/.ssh/config có Include ~/ssh-hosts/*.conf" || err "~/.ssh/config chưa Include ~/ssh-hosts/*.conf · chạy: hostbook setup"
  if e=$(validate); then ensure_index; ok "Cú pháp ssh config hợp lệ · $(wc -l < "$IDX" | tr -d ' ') server"; else err "ssh config lỗi: $(printf '%s' "$e" | head -1)"; fi
  [ -s "$STATE/skipped" ] && warn "Bỏ qua server có tên chứa ký tự lạ: $(sed "s|$DIR/||" "$STATE/skipped" | head -3 | tr '\n' ' ')"
  if vault_exists; then
    if kc_get >/dev/null 2>&1; then ok "Kho secret: đã mở trên máy này ($(kc_label)) · $(secret_names | grep -c .) secret"; else warn "Kho secret: chưa mở trên máy này · sẽ hỏi mật khẩu chính khi cần"; fi
    for n in $(secret_names); do [ -f "$SEC/$n.pub" ] && [ "$(perm "$SEC/$n.pub")" != 600 ] && chmod 600 "$SEC/$n.pub"; done
    n=$(awk -F'\t' '$12!=""{print $12}' "$IDX" | sort -u | while read -r e; do secret_exists "$e" || printf '%s ' "$e"; done)
    [ -n "$n" ] && err "Server tham chiếu secret không còn trong kho secret: $n"
    n=$(for e in $(secret_names); do [ -n "$(secret_users "$e")" ] || printf '%s ' "$e"; done); [ -n "$n" ] && dim "  secret không server nào dùng: $n"
  else dim "· Chưa có kho secret (sẽ tạo khi bạn thêm secret đầu tiên)"; fi
  n=$(legacy_keys | grep -c .); [ "$n" -gt 0 ] && warn "$n key còn nằm ngoài kho secret · Công cụ → Secret → Đưa key trên máy này vào kho secret"
  case $(perm "$DIR") in 700) ok "~/ssh-hosts chỉ chủ máy đọc được";; *) warn "~/ssh-hosts người khác trên máy đọc được · chmod 700 ~/ssh-hosts";; esac
  if [ -d "$HOME/.config/ghostty" ] || [ -d /Applications/Ghostty.app ]; then grep -qs 'ssh-env' "$HOME/.config/ghostty/config" && ok "Ghostty: ssh-env đang bật" || warn "Ghostty chưa bật ssh-env · chạy: hostbook setup"; fi
  [ -n "$(g status --porcelain 2>/dev/null)" ] && warn "Có thay đổi chưa commit" || ok "Không có thay đổi chờ lưu"
  case $(sed -n 1p "$ST" 2>/dev/null) in pending) warn "$(sed -n 2p "$ST") thay đổi chờ đẩy lên kho";; conflict) err "Kho và máy này cùng sửa một chỗ · Công cụ → Gộp xung đột";; esac
  pause
}
tools(){
  local items=() keys=()
  [ "$(sed -n 1p "$ST" 2>/dev/null)" = conflict ] && { items+=("Gộp xung đột|kho và máy này cùng sửa một chỗ"); keys+=(conflict); }
  items+=("Nhập nhiều server|dán danh sách hoặc ssh config" "Đồng bộ ngay|thường không cần, app tự đồng bộ" "Kiểm tra máy này|phần mềm, ssh config, quyền key, kết nối" \
    "Hoàn tác thay đổi gần nhất|$(g log -1 --format=%s 2>/dev/null)" \
    "$(has_remote && echo "Đổi kho|đang dùng kho ở $(kho_addr)" || echo 'Kết nối kho|để sao lưu và dùng trên nhiều máy')" \
    "Secret|key và mật khẩu đăng nhập server" "Tạo kho trên máy này|chạy một lần trên máy luôn bật" "Giao diện|kiểu danh sách, khung, biểu tượng và theme")
  keys+=(import sync doctor undo kho keys hub settings)
  local i; i=$(pick "Công cụ · việc ít dùng, phần lớn app đã tự làm" "${items[@]}") || return
  case ${keys[$i]} in
    conflict) resolve_conflict;; import) import_flow;;
    sync) gum spin --title "Đang đồng bộ với kho" -- "$SELF" _sync_now;;
    doctor) doctor;; undo) undo_last;; kho) connect_kho;; keys) SECRET_QUERY=""; secret_manager;; hub) make_kho_here;; settings) settings;;
  esac
}
show_help(){
  local cols rows out; cols=$(term_cols); rows=$( { stty size </dev/tty; } 2>/dev/null | cut -d' ' -f1); rows=${rows:-24}
  # màn rộng: hai cột; màn hẹp: phím một dòng, mô tả thụt lề ở dòng dưới
  r(){ if [ "$cols" -ge 80 ]; then printf '  %s%s%*s%s %s\n' "$CP" "$1" $((28-${#1})) '' "$C0" "$2"
       else printf '  %s%s%s\n' "$CP" "$1" "$C0"; printf '%s\n' "$2" | fold -s -w $((cols - 8)) | sed 's/^/      /'; fi; }
  h(){ printf '\n%s%s%s\n' "$CU" "$1" "$C0"; }
  local pf; pf=$(tmux show -gv prefix 2>/dev/null | sed 's/^C-/^/'); pf=${pf:-^b}
  out=$( printf '%s‹%s %sTrợ giúp · hostbook %s%s\n' "$CD" "$C0" "$CU$CB" "$VERSION" "$C0"
    h 'Tìm kiếm'
    r 'web prod' 'khớp cả hai (dấu cách nghĩa là VÀ)'; r 'aweb1' 'tìm mờ, khớp a-web1'; r '#prod' 'có tag prod'; r '@deploy' 'user là deploy'
    r '^b-' 'tên bắt đầu bằng b-'; r '!staging' 'loại server có chữ staging'; r 'db | cache' 'db HOẶC cache'; r '10.8' 'theo IP'
    h 'Phím'
    r enter 'ssh, mở nhóm, hoặc vào lại phiên'; r '→' 'thao tác: chuyển tiếp cổng, gửi/tải file, đổi tên, chuyển dự án, xoá'
    r tab 'chọn nhiều server'; r '^g' 'lưu các server đã chọn thành nhóm'
    r '^y' 'chia sẻ các server đang lọc (hoặc đã chọn) thành một gói mã hoá'; r '→ khi chọn nhiều' 'mở cùng lúc, kiểm tra kết nối, chia sẻ, lưu nhóm'; r '^a / ^e' 'thêm / sửa server'
    r '^s' 'đồng bộ ngay (thường không cần)'; r '^o' 'công cụ: nhập nhiều server, secret, kho, hoàn tác'
    r '^t / ctrl-/' 'đổi thẻ ↔ gọn / ẩn hiện ô chi tiết'; r 'hb settings' 'giao diện, theme, xem trước trước khi lưu'
    h 'Secret (key và mật khẩu đăng nhập)'
    r '^o → Secret' 'thêm, thay, sửa, đổi tên, xoá; xem server nào đang dùng'
    r 'hostbook unlock' "nạp mọi key vào ssh-agent ($((KEY_TTL/3600)) giờ) để ssh, scp, VS Code dùng được"
    r 'hostbook lock' 'gỡ key khỏi ssh-agent (thêm --forget để hỏi lại mật khẩu chính)'
    r esc 'xoá ô tìm, nhấn lần nữa để bỏ chọn, lần nữa để thoát'
    h 'Khi kết nối'
    r 'dòng tiến trình' "cho biết đang ở bước nào và đã chờ bao lâu; quá $CTO giây thì dừng và nói hỏng ở bước nào"
    r 'ctrl-c' 'huỷ kết nối đang chờ, quay lại hostbook'
    h 'Trong phiên nhiều server (tmux)'
    r "$pf d" 'ẩn phiên, vẫn chạy nền'; r "$pf mũi tên" 'đổi ô'; r "$pf n / p" 'tab sau / trước'; r "$pf x" 'đóng ô đang chọn'
    h 'Từ dòng lệnh'
    r 'hostbook web1' 'vào thẳng nếu đúng tên, hoặc chỉ một server khớp'; r 'hostbook add ubuntu@10.0.1.13' 'thêm nhanh, các mục khác tự đoán'
    r 'hostbook import [file]' 'nhập danh sách server, hoặc một gói chia sẻ (.hbshare)'; r 'hostbook share [tìm]' 'tạo gói chia sẻ'; r 'hostbook check [tìm]' 'kiểm tra kết nối'; r 'hostbook sync · doctor' 'đồng bộ · kiểm tra'
    r 'hostbook setup · update' 'cài cho máy này · cập nhật app'; r 'hostbook vault passwd · recover' 'đổi mật khẩu chính · dùng mã khôi phục'; r "$(shortcut_name || true)" 'lối tắt của hostbook trên máy này' )
  clear
  if [ "$(printf '%s\n' "$out" | wc -l)" -gt $(( rows - 3 )) ]; then printf '%s\n' "$out" | less -R   # dài hơn màn hình: cuộn được, q để quay lại
  else printf '%s\n' "$out"; pause; fi
}

# ---------- tuỳ chỉnh giao diện, xem trước bằng cùng bộ dựng danh sách ----------
preset_data(){
  case $1 in
    cards) echo 'cards rounded right on unicode hostbook';;
    compact) echo 'compact rounded right off unicode hostbook';;
    minimal) echo 'minimal none hidden off unicode terminal';;
    dracula) echo 'cards rounded right on unicode dracula';;
    nord) echo 'compact sharp right off unicode nord';;
    light) echo 'cards rounded right on unicode light';;
    high-contrast) echo 'compact bold right off ascii high-contrast';;
    *) return 1;;
  esac
}
apply_preset(){
  local values; values=$(preset_data "$1") || return 1; set -- $values
  cfg_set list "$1" && cfg_set border "$2" && cfg_set preview "$3" && cfg_set separator "$4" && cfg_set icons "$5" && cfg_set theme "$6"
}
setting_options(){
  case $1 in
    preset) printf 'cards\tThẻ (mặc định)\ncompact\tGọn\nminimal\tTối giản\ndracula\tDracula\nnord\tNord gọn\nlight\tSáng\nhigh-contrast\tTương phản cao\n';;
    list) printf 'cards\tThẻ hai dòng\ncompact\tGọn một dòng\nminimal\tChỉ tên và IP\n';;
    border) printf '%s\n' rounded sharp bold double none;;
    preview) printf 'right\tBên phải\nbottom\tBên dưới\nhidden\tẨn (ctrl-/ để hiện)\n';;
    separator) printf 'on\tCó\noff\tKhông\n';;
    icons) printf 'unicode\tUnicode\nascii\tASCII\nnerd\tNerd Font (cần font hỗ trợ)\n';;
    theme) theme_names; local f n; for f in "$CONF"/themes/*.theme; do [ -f "$f" ] || continue; n=$(basename "$f" .theme); valid_theme_name "$n" && { theme_builtin "$n" >/dev/null || echo "$n"; }; done;;
  esac
}
setting_pick(){
  local key=$1 heading=${2:-Chọn giao diện} selected=${3:-} out
  if [ -z "$selected" ] && [ "$key" != preset ]; then
    selected=$(setting_options "$key" | awk -F'\t' -v v="$(cfg_raw "$key")" '$1==v {print NR; exit}')
  fi
  # Bộ chọn luôn là một dòng; --read0 chỉ dành cho danh sách server dạng thẻ.
  out=$(setting_options "$key" | awk -F'\t' '{if(NF==1) print $0 "\t" $0; else print}' |
    fzf --ansi --layout=reverse --height=100% --delimiter="$TAB" --with-nth=2 --accept-nth=1 \
      --prompt='> ' --header "$heading · enter lưu · esc huỷ" --color="$(fzf_colors)" \
      --preview "'$SELF' _demo '$key='{1}" --preview-window='right,65%,wrap' \
      ${selected:+--bind="load:pos($selected)"}) || return 1
  if [ "$key" = preset ]; then apply_preset "$out"; else cfg_set "$key" "$out"; fi
  apply_theme
}
custom_theme(){
  local n f current
  n=$(ask 'Tên theme mới (chữ, số, - và _)') || return 1
  valid_theme_name "$n" || { err 'Tên theme không hợp lệ'; pause; return 1; }
  theme_builtin "$n" >/dev/null && { err 'Tên trùng theme có sẵn'; pause; return 1; }
  f=$CONF/themes/$n.theme; mkdir -p "$CONF/themes"
  if [ -f "$f" ]; then confirm --default=false "Theme $n đã có. Mở để chỉnh sửa?" || return 1
  else current=$(cfg theme hostbook)
    { printf '# Màu: 0–255, #rrggbb, hoặc tên ANSI. base: dark, light, 16.\n# accent: nhấn; title: tiêu đề; dim: phụ; ok/warn/err: trạng thái.\n# border: khung; sel_bg: nền chọn; chip_fg/chips: chữ/nền chip dự án.\n'
      theme_builtin "$current" || cat "$CONF/themes/$current.theme"; } > "$f"
  fi
  while :; do
    ${EDITOR:-vi} "$f"
    theme_check "$f" && break
    confirm 'Theme có lỗi. Mở lại để sửa?' || return 1
  done
  "$SELF" _demo "theme=$n"
  confirm 'Dùng theme này?' && cfg_set theme "$n"
  apply_theme
}
settings(){
  local i k
  while :; do
    clear; title 'Giao diện'
    i=$(pick 'Thay đổi chỉ áp dụng trên máy này' \
      'Bộ có sẵn|chọn nhanh, có xem trước' "Kiểu danh sách|$(cfg list cards)" "Khung|$(cfg border rounded)" \
      "Ô chi tiết|$(cfg preview right)" "Đường kẻ giữa thẻ|$(cfg separator on)" "Biểu tượng|$(cfg icons unicode)" \
      "Theme màu|$(cfg theme hostbook)" 'Tự tạo theme…|chỉnh file màu bằng editor' 'Đặt lại mặc định|Thẻ · hostbook') || return 0
    case $i in
      0) k=preset;; 1) k=list;; 2) k=border;; 3) k=preview;; 4) k=separator;; 5) k=icons;; 6) k=theme;;
      7) custom_theme; continue;; 8) confirm --default=false 'Đặt lại giao diện mặc định?' && apply_preset cards; apply_theme; continue;;
    esac
    setting_pick "$k" || :
  done
}
demo_rows(){
  printf '%s\n' \
    'h:booking-api|booking-api|booking|10.0.1.11|ubuntu|prod api|API chính, nhận đặt phòng|key-prod|2h' \
    'h:booking-web|booking-web|booking|10.0.1.12|ubuntu|prod web|Nginx chính, mô tả dài sẽ tự cắt khi cửa sổ hẹp|key-prod|1d' \
    'h:booking-db|booking-db|booking|10.0.1.20|postgres|prod db|Cơ sở dữ liệu|key-prod|3h' \
    'h:staging-api|staging-api|booking|10.0.2.11|deploy|staging api|Môi trường thử nghiệm|key-dev|5m' \
    'h:infra-gate|infra-gate|infra|203.0.113.10|admin|bastion|Cổng vào mạng nội bộ|key-infra|1h' \
    'h:infra-cache|infra-cache|infra|10.8.0.5|admin|cache|Redis|key-infra|-' \
    'g:booking-prod|booking-prod|||||nhóm · 3 server · chia ô||booking-api booking-web booking-db' | tr '|' '\t'
}
cmd_demo(){ # dữ liệu mẫu cố định, không kiểm tra mạng hay sửa cấu hình thật
  local arg=${1:-preset=cards} d key value cols border preview width left right body rendered record rule IDX CFG
  d=$(tmpd); CFG=$d/config; IDX=$d/index
  [ ! -f "$CONF/config" ] || cp "$CONF/config" "$CFG"
  key=${arg%%=*}; value=${arg#*=}
  if [ "$key" = preset ]; then apply_preset "$value" || return 1; else cfg_set "$key" "$value" || return 1; fi
  apply_theme
  demo_rows | awk -F'\t' '$1~/^h:/ {print $2 "\t" $3}' > "$IDX"
  cols=${FZF_PREVIEW_COLUMNS:-80}; [[ $cols =~ ^[0-9]+$ ]] || cols=80; [ "$cols" -ge 20 ] || cols=20
  border=$(cfg border rounded); preview=$(cfg preview right); width=$((cols - 6))
  if [ "$preview" = right ] && [ $((cols * 38 / 100)) -ge 36 ]; then width=$((cols * 60 / 100 - 6)); fi
  demo_rows | list_rows "$(cfg list cards)" "$width" > "$d/rows"
  if [ "$(cfg list cards)" = cards ]; then
    rule=$(printf '%*s' "$width" '' | tr ' ' '-')
    rendered=$(while IFS= read -r -d '' record; do
      record=${record#*"$TAB"}; printf '%s\n' "${record%"$TAB"*}"
      [ "$(cfg separator on)" != on ] || printf '%s%s%s\n' "$CD" "$rule" "$C0"
    done < "$d/rows")
  else rendered=$(cut -f2 "$d/rows"); fi
  left=$(printf '%sTìm > booking%s\n\n%s\n\n%senter ssh · tab chọn · ^t đổi kiểu%s' "$CP" "$C0" "$rendered" "$CD" "$C0")
  right=$(printf '%sbooking-api  %sprod%s\n10.0.1.11 · @ubuntu\nĐăng nhập: key-prod\nLần dùng: 2 giờ trước' "$CU$CB" "$CR" "$C0")
  if [ "$preview" = right ] && [ $((cols * 38 / 100)) -ge 36 ]; then
    body=$(gum join --horizontal --align top "$(gum style --width "$((width + 2))" "$left")" "$(gum style --width "$((cols - width - 8))" "$right")")
  elif [ "$preview" = bottom ]; then body=$(printf '%s\n\n%sChi tiết%s\n%s' "$left" "$CU" "$C0" "$right")
  else body=$left; fi
  printf '%s%s · %s · %s%s\n' "$CU" "$(cfg list cards)" "$(cfg theme hostbook)" "$preview" "$C0"
  case $border in sharp) border=normal;; bold) border=thick;; esac
  gum style --border "$border" --border-foreground "$(gum_color "$TH_BORDER")" --width "$((cols - 2))" "$body"
}

# ---------- màn chính ----------
home(){
  local q=${1:-} out rc key sel first t n hosts opt opts=()
  # khoá cho cổng điều khiển của fzf: chỉ tiến trình con của lần chạy này gửi lệnh được
  FZF_API_KEY=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n'); [ ${#FZF_API_KEY} -eq 32 ] || { err 'Không tạo được khoá cho ô tìm'; return 1; }; export FZF_API_KEY
  clip_offer
  while :; do
    [ -n "${ONLY_NEXT:-}" ] && { export HOSTBOOK_ONLY=$ONLY_NEXT; ONLY_NEXT=""; q=""; }
    ADDED=""; rm -f "$STATE/current" "$STATE/share-request"
    opts=(); while IFS= read -r opt; do opts+=("$opt"); done < <(fzf_opts)
    out=$(cmd_list | fzf "${opts[@]}" --ansi --multi --layout=reverse --height=100% --no-separator \
      --delimiter="$TAB" --with-nth=2.. --accept-nth=1 --tiebreak=index --info=inline-right \
      --prompt='> ' --ghost='Tìm theo tên, #tag, @user, IP, mô tả…' --marker='+' \
      --header "$(cmd_header)" --footer "$(cmd_footer)" \
      --preview "'$SELF' _preview {1}" --gutter=' ' --ellipsis='' --no-hscroll \
      --bind "resize:reload('$SELF' _list)+transform-header('$SELF' _header)+transform-footer('$SELF' _footer {1})" \
      --listen --bind "start:execute-silent('$SELF' _bg_sync >/dev/null 2>&1 &)" \
      --bind 'tab:transform:case {1} in h:*) echo toggle+down;; *) echo down;; esac' \
      --bind "ctrl-y:execute-silent(touch '$STATE/share-request')+transform:[ \"\${FZF_SELECT_COUNT:-0}\" -gt 0 ] && echo accept || echo select-all+accept" \
      --bind "focus:transform-footer('$SELF' _footer {1})" --bind "multi:transform-footer('$SELF' _footer {1})" \
      --bind 'esc:transform:if [ -n "$FZF_QUERY" ]; then echo clear-query; elif [ "${FZF_SELECT_COUNT:-0}" -gt 0 ]; then echo clear-selection; else echo abort; fi' \
      --expect='enter,ctrl-a,ctrl-e,ctrl-g,ctrl-o,ctrl-s,ctrl-t,right,?' --print-query --query "$q"); rc=$?
    if [ $rc -eq 130 ] && [ -n "${HOSTBOOK_ONLY:-}" ]; then unset HOSTBOOK_ONLY; q=""; continue; fi   # esc trong chế độ lọc: về danh sách đầy đủ
    [ $rc -eq 130 ] || [ $rc -eq 2 ] && return 0
    q=$(printf '%s\n' "$out" | sed -n 1p); key=$(printf '%s\n' "$out" | sed -n 2p); sel=$(printf '%s\n' "$out" | sed -n '3,$p')
    first=$(printf '%s\n' "$sel" | sed -n 1p)
    case $key in right|ctrl-e) [ -s "$STATE/current" ] && first=$(cat "$STATE/current");; esac
    t=${first%%:*}; n=${first#*:}
    hosts=$(printf '%s\n' "$sel" | sed -n 's/^h://p' | tr '\n' ' ')
    clear
    if [ -f "$STATE/share-request" ]; then   # ^y: chia sẻ các dòng đã chọn, hoặc mọi dòng đang khớp
      rm -f "$STATE/share-request"
      set -- $hosts $(printf '%s\n' "$sel" | sed -n 's/^g://p' | while read -r n; do group_field "$n" 3; done)
      share_flow $(printf '%s\n' "$@" | awk '!s[$0]++'); continue
    fi
    case $key in
      ''|enter) set -- $hosts
         if [ $# -ge 2 ]; then open_many "" "$@"
         elif [ "$t" = h ]; then connect "$n"
         elif [ "$t" = g ]; then open_many "$n" $(group_field "$n" 3)
         elif [ "$t" = s ]; then attach "$n"; fi;;
      ctrl-a) add_host; [ -n "${ADDED:-}" ] && q=$ADDED;;
      ctrl-e) [ "$t" = h ] && edit_host "$n";;
      ctrl-g) set -- $hosts; if [ $# -ge 2 ]; then save_group "$@"; else flash "${CY}Chọn ít nhất 2 server bằng tab rồi nhấn ^g${C0}"; fi;;
      ctrl-o) SECRET_QUERY=""; tools; [ -n "${SECRET_QUERY:-}" ] && q=$SECRET_QUERY;;
      ctrl-t) if [ "$(cfg list cards)" = cards ]; then cfg_set list compact; else cfg_set list cards; fi;;
      ctrl-s) gum spin --title "Đang đồng bộ với kho" -- "$SELF" _sync_now;;
      right) set -- $hosts; if [ $# -ge 2 ]; then batch_actions "$@"; continue; fi
             case $t in h) host_actions "$n";; g) group_actions "$n";;
               s) confirm --default=false "Đóng hẳn phiên ${n#hb-}? Các kết nối trong đó sẽ bị ngắt." && tmux kill-session -t "$n" && flash "Đã đóng phiên ${n#hb-}";; esac;;
      '?') show_help;;
    esac
  done
}

# ---------- cài đặt, phiên bản ----------
# Lối tắt chỉ được thêm khi chưa có lệnh, alias hay hàm nào trùng tên. Hỏi chính shell của người dùng ở chế độ tương tác,
# để thấy cả alias do plugin (oh-my-zsh…) tạo ra chứ không chỉ những gì nằm trong PATH.
shortcut_free(){ local out; out=$("${SHELL:-/bin/sh}" -ic "type $1" </dev/null 2>/dev/null) || return 0
  case $out in *hostbook*) return 0;; esac; return 1; }
shortcut_name(){ grep -hoE '^alias (hb|hop)=hostbook$' "$HOME/.zshrc" "$HOME/.bashrc" 2>/dev/null | head -1 | sed 's/^alias //; s/=hostbook$//'; }
check_age(){ have age && have age-plugin-batchpass && have age-keygen || { err "Cần age >= $AGE_MIN cho kho secret. Cài lại: curl -fsSL $REPO_URL/raw/main/install.sh | bash" >&2; return 1; }; }
check_deps(){ # report: in từng dòng; im lặng: trả về 1 và in hướng dẫn nếu thiếu
  local bad=0 v
  have git || { err "Thiếu git"; bad=1; }
  if have age && have age-plugin-batchpass; then v=$(age --version | sed 's/^v//'); if ver_ge "$v" "$AGE_MIN"; then [ "${1:-}" = report ] && ok "age $v"; else err "age $v quá cũ, cần >= $AGE_MIN"; bad=1; fi
  else err "Thiếu age (kèm age-plugin-batchpass)"; bad=1; fi
  if have fzf; then v=$(fzf --version | awk '{print $1}')
    if ver_ge "$v" "$FZF_MIN"; then [ "${1:-}" = report ] && ok "fzf $v"; else err "fzf $v quá cũ, cần >= $FZF_MIN"; bad=1; fi
  else err "Thiếu fzf"; bad=1; fi
  if have gum; then v=$(gum --version | awk '{print $3}' | sed 's/^v//')
    if ver_ge "$v" "$GUM_MIN"; then [ "${1:-}" = report ] && ok "gum $v"; else err "gum $v quá cũ, cần >= $GUM_MIN"; bad=1; fi
  else err "Thiếu gum"; bad=1; fi
  [ $bad = 0 ] && return 0
  [ "${1:-}" = report ] || dim "Cài lại để lấy đúng phiên bản: curl -fsSL $REPO_URL/raw/main/install.sh | bash"
  return 1
}
setup(){
  local rc_file
  title "Cài hostbook cho máy này"
  mkdir -p "$HOME/.local/bin"; ln -sf "$SELF" "$HOME/.local/bin/hostbook"; ok "Lệnh hostbook: ~/.local/bin/hostbook"
  mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
  if ! grep -qs "Include.*ssh-hosts" "$HOME/.ssh/config"; then
    [ -f "$HOME/.ssh/config" ] && cp "$HOME/.ssh/config" "$HOME/.ssh/config.bak"
    { echo "# Danh sách server nằm trong ~/ssh-hosts (hostbook đồng bộ với kho)"; echo "Include ~/ssh-hosts/*.conf"; echo; cat "$HOME/.ssh/config" 2>/dev/null || true; } > "$HOME/.ssh/config.new" && mv "$HOME/.ssh/config.new" "$HOME/.ssh/config"
    chmod 600 "$HOME/.ssh/config"; ok "Đã thêm Include vào ~/.ssh/config$( [ -f "$HOME/.ssh/config.bak" ] && echo ', bản cũ ở ~/.ssh/config.bak')"
  else ok "~/.ssh/config đã có Include"; fi
  case ${SHELL:-} in */zsh) rc_file=$HOME/.zshrc;; */bash) rc_file=$HOME/.bashrc;; *) rc_file="";; esac
  if [ -n "$rc_file" ]; then
    # bản cũ dùng lối tắt "s" (quá chung chung, dễ trùng): bỏ đi, chuyển sang hb
    if grep -qsE '^alias s=(sshm|hostbook)$' "$rc_file"; then
      sed -i.bak -E '/^# (sshm|hostbook): tìm và kết nối server SSH$/d; /^alias s=(sshm|hostbook)$/d' "$rc_file" && rm -f "$rc_file.bak"; ok "Đã bỏ lối tắt cũ s"; fi
    if ! grep -qsE '^alias (hb|hop)=hostbook$' "$rc_file"; then
      local sc="" c
      for c in hb hop; do shortcut_free "$c" && { sc=$c; break; }; done
      if [ -n "$sc" ]; then printf '\n# hostbook: tìm và kết nối server SSH\nalias %s=hostbook\n' "$sc" >> "$rc_file"
        if [ "$sc" = hb ]; then ok "Lối tắt: hb"; else ok "hb đã được dùng cho việc khác trên máy này, lối tắt là hop"; fi
      else warn "hb và hop đều đã được dùng cho việc khác, không thêm lối tắt: gõ hostbook"; fi
    fi
    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) grep -qs '.local/bin' "$rc_file" || { printf 'export PATH="$HOME/.local/bin:$PATH"\n' >> "$rc_file"; ok "Đã thêm ~/.local/bin vào PATH"; };; esac
  fi
  if [ -d /Applications/Ghostty.app ] || have ghostty; then
    mkdir -p "$HOME/.config/ghostty"
    grep -qs 'ssh-env' "$HOME/.config/ghostty/config" || { printf '# ssh-env: khi ssh, dùng TERM=xterm-256color để server không có terminfo của Ghostty vẫn hiển thị đúng\nshell-integration-features = ssh-env\n' >> "$HOME/.config/ghostty/config"; ok "Đã bật ssh-env cho Ghostty"; }
  fi
  [ -d "$DIR" ] && { chmod 700 "$DIR"; build_index; ok "Sẵn sàng · $(wc -l < "$IDX" | tr -d ' ') server"; }
  return 0
}
update(){
  local d; d=$(dirname "$SELF")
  if [ -d "$d/.git" ]; then git -C "$d" pull -q --ff-only && ok "Đã cập nhật hostbook lên $("$SELF" --version)" || err "Không cập nhật được, thử: curl -fsSL $REPO_URL/raw/main/install.sh | bash"
  else dim "Bản này không cài bằng git. Cập nhật bằng: curl -fsSL $REPO_URL/raw/main/install.sh | bash"; fi
}
first_run(){ # chưa có ~/ssh-hosts
  local i m url n
  clear; box title "${CU}${CB}Chào mừng đến hostbook${C0}" "Máy này chưa có danh sách server."; echo
  i=$(pick "Bắt đầu thế nào?" "Dùng kho ở máy khác|lấy danh sách server về máy này" "Đây là máy đầu tiên|tạo danh sách ở máy này, kho để sau" "Tạo kho trên máy này|máy luôn bật, các máy khác đồng bộ với nó") || return 1
  case $i in
    0) m=$(pick_machine "Kho ở máy nào?" url) || return 1
       if is_url "$m"; then url=$m; else ensure_key "$m" || return 1; url="$m:repos/ssh-hosts.git"; fi
       GIT_SSH_COMMAND=$(git_ssh 8) gum spin --title "Lấy danh sách từ kho" -- git clone -q "$url" "$DIR" || { err "Không lấy được kho từ $url"; return 1; };;
    *) mkdir -p "$DIR"; git -C "$DIR" init -q; printf '*\n!*.conf\n!.gitignore\n!.gitattributes\n!groups.tsv\n!secrets/\n!secrets/*.age\n!secrets/*.pub\n!secrets/*.meta\n' > "$DIR/.gitignore"
       if [ -f "$HOME/.ssh/config" ] && grep -qiE '^[[:space:]]*host[[:space:]]+[^*]' "$HOME/.ssh/config" && confirm "Nhập các server đang có trong ~/.ssh/config?"; then
         cp "$HOME/.ssh/config" "$HOME/.ssh/config.bak"
         n=$(split_config "$HOME/.ssh/config.bak" "$DIR" "$HOME/.ssh/config")
         ok "Đã chuyển $n khối Host sang ~/ssh-hosts, chia dự án theo phần đầu tên (bản cũ ở ~/.ssh/config.bak)"
         dim "Khối Host * và Match vẫn để trong ~/.ssh/config vì chúng là cấu hình riêng của máy này."
       fi
       g add -A && g commit -qm "Tạo danh sách" >/dev/null;;
  esac
  chmod 700 "$DIR"; ensure_merge_setup
  setup
  [ "$i" = 2 ] && make_kho_here
  [ "$i" = 1 ] && confirm --negative "Để sau" "Kết nối kho ngay để sao lưu và dùng trên nhiều máy?" && connect_kho
  cfg_set list cards
  local pos=1; case ${COLORFGBG:-} in 7|15|*\;7|*\;15) pos=6;; esac
  setting_pick preset "Chọn giao diện · đổi lại trong Công cụ → Giao diện" "$pos" || :
  pause "enter để bắt đầu"
}

