# Host block for a new server. Write explicit Port / ProxyJump none when a project wildcard sets a different value,
# because SSH uses the first matching value and the wildcard may appear first.
login_lines(){ # name secret → login lines for the Host block. A "/" indicates a legacy key path
  local sc=$1; [ -n "$sc" ] || return 0
  case $sc in */*) printf '  IdentityFile %s\n' "$(ssh_path "$sc")"; return;; esac
  if [ "$(secret_meta "$sc" type)" = password ]; then printf '  PubkeyAuthentication no\n  PreferredAuthentications password,keyboard-interactive\n'
  else printf '  IdentityFile %s\n  IdentitiesOnly yes\n' "$(ssh_path "${SEC/#$HOME/\~}/$sc.pub")"; fi
