theme_check(){ # never source/eval user-written files
  local line k v c i=0 bad=0 seen=' '
  while IFS= read -r line || [ -n "$line" ]; do
    i=$((i+1)); line=${line%$'\r'}; k=$(printf '%s' "${line%%=*}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'); case $k in ''|\#*) continue;; esac
    v=$(printf '%s' "${line#*=}" | sed 's/[[:space:]]# .*$//;s/^[[:space:]]*//;s/[[:space:]]*$//')
    case $k in base) case $v in dark|light|16) ;; *) bad=1;; esac;;
      accent|title|dim|ok|warn|err|border|sel_bg|chip_fg|chips)
        [ -n "$v" ] || bad=1
        if [ "$k" = chips ]; then for c in $v; do valid_color "$c" || bad=1; done
        else valid_color "$v" || bad=1; fi;;
      *) bad=1;;
    esac
    if [ "$bad" = 1 ]; then { t theme_bad_line "$1" "$i" "$line"; echo; } >&2; return 1; fi
    seen="$seen$k "
  done < "$1"
  for k in accent title dim ok warn err border sel_bg chip_fg chips base; do
    case $seen in *" $k "*) ;; *) { t theme_missing "$1" "$k"; echo; } >&2; return 1;; esac
  done
