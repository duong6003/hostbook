      if (tags!="") print "field\ttags\t" tags "\t" sprintf(extra ? sg_tags2 : sg_tags, G)
    }' "$HIST" "$IDX"
}
sug_val(){ awk -F'\t' -v k="$2" '$1=="field" && $2==k {print $3; exit}' "$1"; }
sug_why(){ awk -F'\t' -v k="$2" '$1=="field" && $2==k {print $4; exit}' "$1"; }
# Set group/user/port/jump/secret/tags (and src_*) from suggestions. No prompts: used for bulk import.
read_suggest(){ # address name user port [project]
  local f; f=$(tmpd) || return 1; f=$f/sug
  suggest "$1" "$2" "$3" "$4" "${5:-}" > "$f"
  group=$(awk -F'\t' '$1=="group"{print $2}' "$f"); [ -n "$group" ] || group=imported
  [ "$group" = "${5:-$group}" ] || suggest "$1" "$2" "$3" "$4" "$group" > "$f"
  user=$(sug_val "$f" user); port=$(sug_val "$f" port); jump=$(sug_val "$f" jump); secret=$(sug_val "$f" secret); tags=$(sug_val "$f" tags)
  src_user=$(sug_why "$f" user); src_jump=$(sug_why "$f" jump); src_secret=$(sug_why "$f" secret); src_tags=$(sug_why "$f" tags)
  src_group=$(awk -F'\t' -v g="$group" '$1=="project" && $2==g {print $5}' "$f")
