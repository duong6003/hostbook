# After a width change only the list reload runs at once. The header is recomputed in the background. The footer files are
# rewritten by $fd/bgfoot, started from $fd/relayout, which numbers each run synchronously (no forks): an older run that
# finishes late sees a newer number and drops its files and its transform-footer (#6). bg-transform needs fzf 0.63 (FZF_MIN).
relayout_actions(){ # footer-dir
  printf '%s' "reload($(self_cmd) _list)+bg-transform-header($(self_cmd) _header)+transform:. $(printf %q "$1")/relayout"
}
write_relayout(){ # footer-dir: the two POSIX scripts behind relayout_actions. Paths are quoted for sh, then for single quotes.
  local d=$1 q qb qf sq="'" bq="'\\''"
  q=$(printf %q "$d"); qb=$(printf %q "$d/bgfoot"); qf=$(printf %q "$d/foot")
  printf '%s\n' "IFS= read -r g < $q/gen 2>/dev/null || g=0; g=\$((g+1)); echo \$g > $q/gen" \
    "printf 'bg-transform:sh %s %s\\n' '${qb//$sq/$bq}' \$g" > "$d/relayout"
  printf '%s\n' "D=$q; g=\$1" 'mkdir "$D/n$g" || exit 1' \
    "$(self_cmd) _footer_data | while IFS='$TAB' read -r key line; do printf '%s\\n' \"\$line\" > \"\$D/n\$g/\$key\" || exit 1; done" \
    'IFS= read -r c < "$D/gen"' \
    "if [ \"\$c\" = \"\$g\" ]; then mv -f \"\$D/n\$g\"/f-* \"\$D\"/ && printf 'transform-footer:. %s\\n' '${qf//$sq/$bq}'; fi" \
    'rm -rf "$D/n$g"' > "$d/bgfoot"
}
fzf_opts(){ # footer-dir → one argument per line for a Bash array, without eval
  local border preview
  border=$(cfg border rounded); preview=$(cfg preview right)
  if [ "$border" = none ]; then printf '%s\n' --style=minimal
  else printf '%s\n' "--style=full:$border" "--input-label= $(t fzf_find) " "--list-label= $(t fzf_servers "$(wc -l < "$IDX" | tr -d ' ')") " "--preview-label= $(t fzf_detail) "; fi
  case $preview in right) echo '--preview-window=right,38%,wrap,<36(hidden)';; bottom) echo '--preview-window=down,40%,wrap';; hidden) echo '--preview-window=right,38%,wrap,hidden,<36(hidden)';; esac
  printf '%s\n' "--bind=ctrl-/:toggle-preview+$(relayout_actions "$1")" "--color=$(fzf_colors)" "--pointer=$ICON_PTR" '--highlight-line'
  if [ "$(cfg list cards)" = cards ]; then
    echo --read0
    if [ "$(cfg separator on)" = on ]; then printf '%s\n' --gap '--gap-line=╌'; fi
  fi
}

cmd_preview(){
  local t=${1%%:*} n=${1#*:}
  case $t in
    h) ensure_index || return
       # One awk does everything and no network I/O: host row, secret meta, history and the cached result of the last check.
       local lc=$STATE/last-check.tsv kx=0 l r i
       while IFS= read -r l; do [ "${l%%$TAB*}" = "$n" ] && { r=$l; break; }; done < "$IDX"   # key path: test it here, never read it in awk (directory/FIFO)
       if [ -n "${r:-}" ]; then for i in 1 2 3 4 5 6; do r=${r#*$TAB}; done; r=${r%%$TAB*}; [ -n "$r" ] && [ -f "${r/#\~/$HOME}" ] && kx=1; fi
       awk -F'\t' -v n="$n" -v cb="$CB" -v c0="$C0" -v cd="$CD" -v cu="$CU" -v cr="$CR" -v cy="$CY" -v cg="$CG" -v iprod="$ICON_PROD" \
         -v iok="$ICON_OK" -v ierr="$ICON_ERR" -v kx="$kx" -v home="$HOME" -v sec="$SEC" -v hist="$HIST" -v lc="$lc" \
         -v w_am="$L_ago_min" -v w_ah="$L_ago_hour" -v w_ad="$L_ago_day" -v w_now="$L_ago_now" -v w_nodesc="$L_pv_nodesc" -v w_notag="$L_pv_notag" \
         -v w_login="$L_pv_login" -v w_pw="$L_pv_pw" -v w_key="$L_pv_key" -v w_gone="$L_pv_login_gone" -v w_local="$L_pv_login_local" \
         -v w_never="$L_pv_never" -v w_last="$L_pv_last" -v w_cnone="$L_pv_chk_none" -v w_cok="$L_pv_chk_ok" -v w_cskip="$L_pv_chk_skip" -v w_cbad="$L_pv_chk_bad" '
         function tilde(s,  o, i) { if (home=="") return s; while ((i=index(s,home))) { o=o substr(s,1,i-1) "~"; s=substr(s,i+length(home)) } return o s }
         function ago(d) { if (d<0) d=0; return d<3600? sprintf(w_am, int(d/60)) : d<86400? sprintf(w_ah, int(d/3600)) : sprintf(w_ad, int(d/86400)) }
         function meta(f, k,  l, v) { while ((getline l < f) > 0) if (index(l, k "=")==1) { v=substr(l, length(k)+2); break }; close(f); return v }
         BEGIN { srand(); now=srand() }   # srand() returns the previous seed, which is the current time: no date fork
         { sub(/\r$/,"") } $1==n { r=$0; split($0, f, "\t"); exit }
         END {
           if (r=="") exit
           prod=(" " f[8] " " ~ / prod /)
           o=sprintf("%s%s%s%s\n", cb, f[1], c0, (prod? "  " cr cb iprod " PROD" c0 : ""))
           o=o sprintf("%s%s%s\n", cd, (f[9]==""?w_nodesc:f[9]), c0)
           t=f[8]; gsub(/ /," #",t); o=o sprintf("%s%s%s\n\n", cu, (f[8]==""?w_notag:"#" t), c0)
           o=o sprintf("%sHost%s %s\n  %sHostName%s %s\n  %sUser%s %s\n", cu, c0, f[1], cd, c0, f[3], cd, c0, f[4])
           if (f[5]!="22") o=o sprintf("  %sPort%s %s\n", cd, c0, f[5])
           if (f[6]!="") o=o sprintf("  %sProxyJump%s %s\n", cd, c0, f[6])
           if (f[12]=="" && f[7]!="") o=o sprintf("  %sIdentityFile%s %s\n", cd, c0, f[7])
           o=o sprintf("\n%s%s:%s%s\n", cd, f[10], f[11], c0)
           printf "%s", tilde(o)
           ps=f[12]
           if (ps!="") {
             mf=sec "/" ps ".meta"
             if ((getline x < mf) >= 0) { close(mf); ty=meta(mf, "type"); lb=(ty=="password" ? w_pw : sprintf(w_key, meta(mf, "keytype")))
               printf "%s%s%s %s %s(%s)%s\n", cd, w_login, c0, ps, cd, lb, c0 }
             else printf "%s" sprintf(w_gone, ps) "%s\n", cr, c0
           } else if (kx) printf "%s%s%s\n", cy, w_local, c0
           while ((getline l < hist) > 0) { split(l, h, "\t"); if (h[2]==n) { c++; if (h[1]>last) last=h[1] } }
           if (!c) printf "%s%s%s\n", cd, w_never, c0
           else printf "%s" sprintf(w_last, ago(now-last), c) "%s\n", cd, c0
           while ((getline l < lc) > 0) { split(l, h, "\t"); if (h[1]==n) { st=h[2]; why=h[3]; ep=h[4]; break } }
           when=(ep=="" ? "" : " · " (now-ep<60 ? w_now : ago(now-ep)))   # old 3-column rows have no time
           if (st=="") printf "%s%s%s\n", cd, w_cnone, c0
           else if (st=="ok") printf "%s%s %s%s%s\n", cg, iok, w_cok, when, c0
           else if (st=="skip") { sub(/^[^:]*: /, "", why); printf "%s· %s%s%s\n", cd, sprintf(w_cskip, why), when, c0 }   # the stored reason starts "<word>: " in the language it was checked in
           else printf "%s%s %s%s%s\n", cy, ierr, sprintf(w_cbad, why), when, c0
         }' "$IDX" ;;
    g) local h; ensure_index
       printf '%s%s%s\n%s' "$CU$CB" "$n" "$C0" "$CD"; t pv_group "$(mode_label "$(group_field "$n" 2)")"; printf '%s\n\n' "$C0"
       for h in $(group_field "$n" 3); do
         if ! host_exists "$h"; then printf '  %s%s  %s%s\n' "$CD" "$h" "$L_pv_removed" "$C0"
         elif is_prod "$h"; then printf '  %s%s%s  %s%s%s\n' "$CR" "$h" "$C0" "$CD" "$(host_field "$h" 3)" "$C0"
         else printf '  %s  %s%s%s\n' "$h" "$CD" "$(host_field "$h" 3)" "$C0"; fi; done
       printf '\n%s%s%s\n' "$CD" "$L_pv_group_hint" "$C0" ;;
    s) printf '%s%s%s\n%s%s%s\n\n' "$CG$CB" "${n#hb-}" "$C0" "$CD" "$L_pv_sess" "$C0"
       tmux list-panes -s -t "$n" -F "  #{pane_title}#{?pane_dead, ($L_pv_exited),}" 2>/dev/null
       printf '\n%s%s%s\n' "$CD" "$L_pv_sess_hint" "$C0" ;;
  esac
}

strip_ansi(){ # text var: remove SGR codes (ESC [ digits/; m), as sed 's/\033\[[0-9;]*m//g' did
  local s=$1 o= r
  while :; do case $s in *"$E["*) ;; *) break;; esac
    o=$o${s%%"$E["*}; s=${s#*"$E["}; r=${s%%[!0-9;]*}
    case ${s#"$r"} in m*) s=${s#"$r"m};; *) o=$o$E[;; esac
  done
  printf -v "$2" '%s' "$o$s"
}
cmd_header(){
  local n state long="" short="" t f fl="" cols line1 p1 pl
  ensure_index || return
  n=0; [ ! -s "$IDX" ] || { n=$(wc -l < "$IDX"); n=$((n)); }; list_width cols; cols=$((cols + 2))   # keep the header inside the list column, without overflowing into the preview
  if [ -f "$FLASH" ]; then IFS="$TAB" read -r t f < "$FLASH"; [ $(( $(date +%s) - t )) -lt 30 ] && fl=$f; fi
  # each state has a long and short version; use the short one on narrow screens
  state=; f=; { IFS= read -r state; IFS= read -r f; } 2>/dev/null < "$ST" || :
  local w1 w2 w3   # words come from the language files through builtins only (hot path)
  if [ "$state" = invalid ]; then tv w1 hd_bad_long "$f"; tv w2 hd_bad_short "${f%%:*}"; long="${CR}${ICON_ERR} $w1${C0}"; short="${CR}${ICON_ERR} $w2${C0}"   # report errors even without a shared repository
  elif ! has_remote; then long="${CY}${ICON_PROD} $L_hd_norepo${C0}${CD}$L_hd_norepo_k${C0}"; short="${CY}${ICON_PROD} $L_hd_norepo_s${C0}${CD} · ^o${C0}"
  else
    case $state in
      ok) long="${CD}${ICON_OK} $L_hd_ok_long${C0}"; short="${CD}${ICON_OK} $L_hd_ok_short${C0}";;
      checking) long="${CP}… $L_hd_checking${C0}"; short=$long;;
      offline) tv w1 hd_off_long "$(kho_addr)"; long="${CY}⏸ $w1${C0}${CD}$L_hd_retry${C0}"; short="${CY}⏸ $L_hd_off_short${C0}${CD} · ^s${C0}";;
      pending) tv w1 hd_pend_long "$f"; tv w2 hd_pend_short "$f"; long="${CY}⏸ $w1${C0}${CD}$L_hd_retry${C0}"; short="${CY}⏸ $w2${C0}${CD} · ^s${C0}";;
      conflict) long="${CR}${ICON_ERR} $L_hd_conf_long${C0}${CD}$L_hd_conf_k${C0}"; short="${CR}${ICON_ERR} $L_hd_conf_short${C0}${CD} · ^o${C0}";;
      invalid) tv w1 hd_bad_long "$f"; long="${CR}${ICON_ERR} $w1${C0}"; short="${CR}${ICON_ERR} $L_hd_bad_tiny${C0}${CD}$L_hd_inv_k${C0}";;
      pulled) long="${CG}↓ $f${C0}"; short="${CG}↓ $L_hd_pulled${C0}";;
      *) tv w1 hd_unk_long "$(kho_addr)"; long="${CD}$w1${C0}"; short="${CD}$L_hd_unk_short${C0}";;
    esac
  fi
  local hn ps room; hn=${HOSTNAME%%.*}; room=$(( cols - ${#n} - 22 ))   # truncate long machine names (CI or corporate machines)
  [ ${#hn} -gt $room ] && { [ $room -gt 4 ] && hn="${hn:0:$((room - 1))}…" || hn=""; }
  tv w3 hd_count "$n"; line1="${CU}${CB}hostbook${C0} ${CD}${hn:+$hn · }$w3${C0}"; strip_ansi "$line1" p1
  strip_ansi "$long" pl; strip_ansi "$short" ps
  if [ $(( ${#p1} + ${#pl} + 6 )) -le "$cols" ]; then printf '%s %s· %s%s\n' "$line1" "$CD" "$C0" "$long"
  elif [ $(( ${#pl} + 4 )) -le "$cols" ]; then printf '%s\n%s\n' "$line1" "$long"
  elif [ $(( ${#p1} + ${#ps} + 6 )) -le "$cols" ]; then printf '%s %s· %s%s\n' "$line1" "$CD" "$C0" "$short"
  else printf '%s\n%s\n' "$line1" "$short"; fi
  [ -n "$fl" ] && printf '%s\n' "$fl"
  [ -n "${HOSTBOOK_ONLY:-}" ] && [ -f "${HOSTBOOK_ONLY:-}" ] && { printf '%s' "$CU"; t hd_only "$(grep -c . "$HOSTBOOK_ONLY")"; printf '%s\n' "$C0"; }
  if [ "$n" = 0 ]; then   # empty state: one action per line, without clipping on narrow screens
    printf '\n%s%s%s\n\n' "$CB" "$L_hd_empty" "$C0"
    printf '  %s^a%s  %s %s%s%s\n' "$CP" "$C0" "$L_hd_empty_add" "$CD" "$L_hd_empty_add_h" "$C0"
    printf '  %s^o%s  %s\n' "$CP" "$C0" "$L_hd_empty_tools"
    printf '  %s?%s   %s\n' "$CP" "$C0" "$L_fk_help"
  fi
  return 0
}

cmd_footer(){
  [ -n "$LEGACY_READONLY" ] || [ -z "${1:-}" ] || printf '%s\n' "$1" > "$STATE/current"   # current row for → and ^e (fzf returns selected rows only)
  local cols; list_width cols; footer_line "${1%%:*}" "${FZF_SELECT_COUNT:-0}" "$cols"
}
# The focus/multi binds read these files inline: booting hostbook there blocked every cursor move ~100 ms (#1).
cmd_footer_data(){ # render footer cache entries without opening any output paths
  local cols t n o w; list_width cols
  for t in h g s x; do printf 'f-%s\t' "$t"; footer_line "$t" 0 "$cols"; done
  for n in 1 10 100 1000; do
    o=$(footer_line '' "$n" "$cols"); o=${o//\%/%%}; tv w fk_open "$n"
    printf 'f-m%s\t%s\n' "${#n}" "${o/"$w"/$L_fk_open}"
  done
}
cmd_footers(){ # populate a previously admitted session directory
  [ -z "$LEGACY_READONLY" ] || return 65
  local key line cols; list_width cols
  legacy_destinations "$1" || return 65
  while IFS="$TAB" read -r key line; do printf '%s\n' "$line" > "$1/$key" || return; done < <(cmd_footer_data)
  [ $# -lt 2 ] || { [ -z "$2" ] || printf '%s\n' "$2" > "$STATE/current"; footer_line "${2%%:*}" "${FZF_SELECT_COUNT:-0}" "$cols"; }
}
footer_line(){ # row-type select-count list-width
  local t=$1 c=$2 cols=$3 used=2 w   # labels are the $L_fk_* words, read without forks
  k(){ local w=$(( ${#1} + ${#2} + 4 )); [ $(( used + w )) -gt "$cols" ] && return 0; used=$(( used + w )); printf '%s%s%s %s%s%s   ' "$CP" "$1" "$C0" "$CD" "$2" "$C0"; }   # omit lower-priority keys at the end when space runs out
  if [ "$c" -gt 0 ]; then tv w fk_open "$c"; k enter "$w"; k '→' "$L_fk_more"; k '^y' "$L_fk_share"; k esc "$L_fk_unselect"; k '^g' "$L_fk_savegroup"; k tab "$L_fk_selmore"
  else case $t in
    h) k enter ssh; k '→' "$L_fk_actions"; k '?' "$L_fk_help"; k '^a' "$L_fk_add"; k '^o' "$L_fk_tools"; k '^t' "$L_fk_style"; k tab "$L_fk_multi"; k '^y' "$L_fk_share"; k '^e' "$L_fk_edit";;
    g) k enter "$L_fk_open_group"; k '→' "$L_fk_group_more"; k '?' "$L_fk_help"; k '^a' "$L_fk_add"; k '^o' "$L_fk_tools";;
    s) k enter "$L_fk_rejoin"; k '→' "$L_fk_close_session"; k '?' "$L_fk_help"; k '^a' "$L_fk_add"; k '^o' "$L_fk_tools";;
    *) k '^a' "$L_fk_add_server"; k '^o' "$L_fk_tools"; k '?' "$L_fk_help";;
  esac; fi
  echo
}


# ---------- per-server merging ----------
# Git merges lines, so two machines appending servers to the same file can cause a conflict.
# This merger splits files into Host blocks (groups.tsv: rows keyed by group name), then performs a three-way merge by block:
# only differing edits to the same server on both sides are real conflicts.
merge_driver(){ ( # base ours theirs path; hold the actual output directory as this worker's cwd
  local base=$1 ours=$2 theirs=$3 kind=conf rc tmp leaf dir
  case $base in /*) ;; *) base=$PWD/$base;; esac
  case $ours in /*) ;; *) ours=$PWD/$ours;; esac
  case $theirs in /*) ;; *) theirs=$PWD/$theirs;; esac
  dir=${ours%/*}; leaf=${ours##*/}
  CDPATH= cd -P -- "${dir:-/}" || return 65
  legacy_destinations "$PWD/$leaf" || return 65
  [ -f "$leaf" ] && [ ! -L "$leaf" ] || return 65
  local create=/usr/bin/mktemp; [ -x "$create" ] || create=/bin/mktemp
  tmp=$("$create" .hostbook-merge.XXXXXXXX) || return 65
  trap 'rm -f -- "$tmp"' EXIT
  case ${4:-} in *.tsv) kind=tsv;; esac
  # The conflict markers carry a label in the user's own file: this one is data, written in the language in use when merging.
  awk -v kind="$kind" -v prefer="${HOSTBOOK_MERGE_PREFER:-}" -v lm="$(t merge_mine)" -v lt="$(t merge_theirs)" '
    function norm(t){ sub(/\n+$/, "", t); return t }
    function add(fi, key, t){ if (!((fi, key) in txt)) { ord[fi, ++cnt[fi]]=key } txt[fi, key]=txt[fi, key] t }
    FNR==1 { if (fi && pend!="") add(fi, (blk==""?"__head__":blk), pend)
             fi=(FILENAME==ARGV[1])?1:(FILENAME==ARGV[2])?2:3; blk=""; pend="" }   # identify inputs by filename: an empty base file has no rows
    kind=="tsv" { if ($0 ~ /^[ \t]*$/) next; k=$0; sub(/\t.*/, "", k); add(fi, "g:" k, $0 "\n"); next }
    tolower($1)=="host" || tolower($1)=="match" { k=tolower($0); gsub(/[ \t]+/, " ", k); sub(/^ /, "", k); blk=k; add(fi, blk, pend $0 "\n"); pend=""; next }
    /^[ \t]*#/ { pend=pend $0 "\n"; next }   # comments (tags, desc) belong to the Host block immediately below
    blk=="" { if (pend!="") { add(fi, "__head__", pend); pend="" } add(fi, "__head__", $0 "\n"); next }
    { if (pend!="") { add(fi, blk, pend); pend="" } add(fi, blk, $0 "\n") }
    END {
      if (fi && pend!="") add(fi, (blk==""?"__head__":blk), pend)
      n=0
      for (j=1;j<=cnt[2];j++) { k=ord[2,j]; if (!(k in inl)) { inl[k]=1; L[++n]=k } }
      # insert repository-only blocks before the first wildcard block so wildcard values do not take precedence
      firstw=n+1; for (j=1;j<=n;j++) if (L[j] ~ /^host .*[*?]/) { firstw=j; break }
      m=0; for (j=1;j<=cnt[3];j++) { k=ord[3,j]; if (!(k in inl)) { inl[k]=1; X[++m]=k } }
      out=""; conflict=0
      for (j=1;j<=n+m;j++) {
        if (j<firstw) k=L[j]; else if (j<firstw+m) k=X[j-firstw+1]; else k=L[j-m]
        b=((1,k) in txt) ? norm(txt[1,k]) : "\001"; o=((2,k) in txt) ? norm(txt[2,k]) : "\001"; t=((3,k) in txt) ? norm(txt[3,k]) : "\001"
        if (o==t) r=o; else if (o==b) r=t; else if (t==b) r=o
        else if (o=="\001") r=t; else if (t=="\001") r=o          # one side edits, the other deletes: preserve the edited version to avoid data loss
        else if (prefer=="ours") r=o; else if (prefer=="theirs") r=t
        else { r="<<<<<<< " lm "\n" o "\n=======\n" t "\n>>>>>>> " lt; conflict=1 }
        if (r=="\001") continue
        out=out r "\n" (kind=="conf" && k!="__head__" ? "\n" : "")
      }
      sub(/\n+$/, "\n", out); printf "%s", out
      exit conflict
    }' "$base" "$ours" "$theirs" > "$tmp"; rc=$?
  [ "$rc" -le 1 ] || return "$rc"
  if legacy_authority_present; then
    guard_python -I -B -S "$LEGACY_GUARD_LIB" _legacy_merge_install "$tmp" "$leaf" || return 65
  else
    mv -f -- "$tmp" "$leaf" || return 65
  fi
  return "$rc"
); }
ensure_merge_setup(){ # register the merger for the data repo (git config is machine-local; .gitattributes is synced)
  legacy_destinations || return 65
  [ -d "$DIR/.git" ] || return 0
  revert_in_progress && return 0   # a path-limited commit would clear the revert state
  g config merge.hostbook.name "hostbook: merge per server"   # git config in the user's repo (data, not screen text)
  g config merge.hostbook.driver "$(printf %q "$SELF") _merge %O %A %B %P"
  local changed=""
  grep -qs 'merge=hostbook' "$DIR/.gitattributes" || { printf '*.conf merge=hostbook\ngroups.tsv merge=hostbook\n' >> "$DIR/.gitattributes"; changed=1; }
  # allowlist .gitignore: track only hostbook-managed files (ignore keys or unrelated files copied in accidentally)
  grep -qsx '\*' "$DIR/.gitignore" || { { printf '*\n!*.conf\n!.gitignore\n!groups.tsv\n'; cat "$DIR/.gitignore" 2>/dev/null; } > "$DIR/.gitignore.new" && mv "$DIR/.gitignore.new" "$DIR/.gitignore"; changed=1; }
  grep -qsx '!.gitattributes' "$DIR/.gitignore" || { printf '!.gitattributes\n' >> "$DIR/.gitignore"; changed=1; }
  grep -qsx '!secrets/' "$DIR/.gitignore" || { printf '!secrets/\n!secrets/*.age\n!secrets/*.pub\n!secrets/*.meta\n' >> "$DIR/.gitignore"; changed=1; }
  grep -qs '^secrets/\* -merge' "$DIR/.gitattributes" || { printf 'secrets/* -merge\n' >> "$DIR/.gitattributes"; changed=1; }   # git must not merge secret contents automatically
  [ -n "$changed" ] && g add .gitattributes .gitignore && g commit -qm "Bật gộp theo từng server" -- .gitattributes .gitignore >/dev/null
  return 0
}

# ---------- shared repository sync ----------
set_status(){ printf '%s\n%s\n%s\n' "$1" "${2:-}" "$(date +%s)" > "$ST"; }
notify_fzf(){ # [reload]: refresh the header (and the list when asked) without blocking input
  [ -n "${FZF_PORT:-}" ] && have curl && curl -s -m 2 -XPOST -H "x-api-key: ${FZF_API_KEY:-}" "localhost:$FZF_PORT" -d "${1:+reload($(self_cmd) _list)+}bg-transform-header($(self_cmd) _header)" >/dev/null 2>&1; return 0; }
# What the header and list show: status state+text (not its timestamp), flash, index. Notify fzf only when this changes (#6).
# tmux session rows (s:) are not covered: listing them costs several tmux/grep forks, and a sync never changes them.
list_sig(){ { cksum < "$IDX"; cksum < "$DIR/groups.tsv"; } 2>/dev/null; }
visible_sig(){ { sed -n 1,2p "$ST"; cat "$FLASH"; list_sig; } 2>/dev/null; }
# Keep the gate inode stable. The kernel lock covers metadata changes only,
# so editors, Git and SSH invoked by a writer cannot inherit it.
lock_edit(){ (
  local wait=$1; shift
  if is_mac; then
    if [ "$wait" = 0 ]; then "$LOCK_TOOL" -s -t 0 9; else "$LOCK_TOOL" -s 9; fi
  else
    if [ "$wait" = 0 ]; then "$LOCK_TOOL" -n 9; else "$LOCK_TOOL" 9; fi
  fi || return 1
  "$@"
) 9>>"$STATE/sync.lock.gate"; }
lock_try(){ # caller holds the native metadata gate
  local owner=$1 path=$STATE/sync.lock o= token= seen= seen_token= stale identity
  if ! mkdir "$path" 2>/dev/null; then
    # Identify the directory before inspecting its contents or age.
    identity=$(stat -c '%d:%i' "$path" 2>/dev/null || stat -f '%d:%i' "$path" 2>/dev/null) || return 1
    IFS= read -r o 2>/dev/null < "$path/pid" || :
    IFS= read -r token 2>/dev/null < "$path/owner" || :
    case $o in ''|*[!0-9]*) o=;; esac
    case $token in *[!0-9.]*) token=;; esac
    if [ -n "$o" ]; then
      kill -0 "$o" 2>/dev/null && return 1
    else
      [ -n "$(find "$path" -maxdepth 0 -mmin +2 2>/dev/null)" ] || return 1
    fi
    IFS= read -r seen 2>/dev/null < "$path/pid" || :
    IFS= read -r seen_token 2>/dev/null < "$path/owner" || :
    # The kernel releases the gate if the reclaimer dies. Old reap.* directories
    # inside a verified stale lock are removed with it.
    stale=$STATE/sync-abandoned.$$.$RANDOM
    if [ "$seen" != "$o" ] || [ "$seen_token" != "$token" ] ||
       { [ -n "$o" ] && kill -0 "$o" 2>/dev/null; } ||
       [ "$identity" != "$(stat -c '%d:%i' "$path" 2>/dev/null || stat -f '%d:%i' "$path" 2>/dev/null)" ] ||
       ! mv "$path" "$stale" 2>/dev/null; then
      return 1
    fi
    rm -rf "$stale"
    mkdir "$path" 2>/dev/null || return 1
  fi
  printf '%s\n' "$owner" > "$path/owner" && printf '%s\n' "$$" > "$path/pid" || {
    rm -rf "$path" 2>/dev/null
    return 1
  }
}
lock(){
  local w=${1:-0} i=0 token=$$.$RANDOM.$RANDOM
  have "$LOCK_TOOL" || { err "$(t dep_missing "$LOCK_TOOL")" >&2; return 1; }
  until lock_edit 0 lock_try "$token"; do
    [ "$i" -lt "$w" ] || return 1
    sleep 1; i=$((i+1))
  done
  LOCK_HELD=$token
}
unlock_owned(){
  local token= o=
  IFS= read -r token 2>/dev/null < "$STATE/sync.lock/owner" || :
  IFS= read -r o 2>/dev/null < "$STATE/sync.lock/pid" || :
  if [ "$token" = "$LOCK_HELD" ] && [ "$o" = "$$" ]; then
    rm -rf "$STATE/sync.lock" 2>/dev/null
  fi
}
unlock(){
  if [ -n "$LOCK_HELD" ] && lock_edit 1 unlock_owned; then LOCK_HELD=""; fi
}
# Commit all changes in ~/ssh-hosts if the config is valid.
# Commit messages ("Gộp với kho", apply_change descriptions…) and the share-file header are data written into the user's repo and files, not screen text: they stay as they are.
commit_all(){ local msg=$1 e
  legacy_destinations "$DIR/.git" || return 65
  if revert_in_progress; then set_status invalid "$(t err_undo_restore)"; return 1; fi
  if ! e=$(validate); then set_status invalid "$(printf '%s' "$e" | head -1 | sed "s|$DIR/||")"; return 1; fi
  [ -z "$(g status --porcelain)" ] && return 0
  g add -A && g commit -qm "$msg" >/dev/null
}
# Pull, push, and record status. Never prompt, so this can run in the background.
sync_quiet(){
  lock "${1:-0}" || return 75
  local sig rows rc; sig=$(visible_sig); rows=$(list_sig); PULLED=""
  if [ "${2:-}" = checking ] && has_remote && [ "$(sed -n 1p "$ST" 2>/dev/null)" != pulled ]; then set_status checking; notify_fzf; fi
  sync_locked; rc=$?; unlock
  if [ -n "$PULLED" ] || [ "$(list_sig)" != "$rows" ]; then notify_fzf reload   # a pull always refreshes, even when the status text repeats
  elif [ "$(visible_sig)" != "$sig" ]; then notify_fzf; fi
  return $rc
}
sync_locked(){
  legacy_destinations "$DIR/.git" || return 65
  local before after behind ahead new branch remote_branch remote_head checkpoint e
  ensure_merge_setup || return 1
  commit_all "Sửa ngoài hostbook" || return 1
  has_remote || return 0
  export GIT_SSH_COMMAND; GIT_SSH_COMMAND=$(git_ssh 4)
  if ! g fetch -q origin 2>/dev/null; then
    ahead=$(g rev-list --count '@{u}..HEAD' 2>/dev/null || g rev-list --count HEAD 2>/dev/null)
    if [ "${ahead:-0}" -gt 0 ]; then set_status pending "$ahead"; else set_status offline; fi; return 1; fi
  if ! g rev-parse -q --verify '@{u}' >/dev/null 2>&1; then
    branch=$(g symbolic-ref --short HEAD) || { set_status conflict; return 1; }
    if g show-ref --verify --quiet "refs/remotes/origin/$branch"; then remote_branch=$branch
    else
      remote_head=$(g ls-remote --symref origin HEAD 2>/dev/null) || { set_status offline; return 1; }
      remote_branch=$(printf '%s\n' "$remote_head" | awk '$1=="ref:" && $3=="HEAD" {sub(/^refs\/heads\//,"",$2); print $2; exit}')
    fi
    if [ -n "$remote_branch" ]; then
      g branch -q --set-upstream-to="origin/$remote_branch" 2>/dev/null || { set_status conflict; return 1; }
    elif [ -n "$(g for-each-ref --format='%(refname)' refs/remotes/origin/)" ]; then
      # A populated remote with no usable HEAD needs an explicit branch, never a silent new history.
      set_status conflict; return 1
    fi
  fi
  if ! g rev-parse -q --verify '@{u}' >/dev/null 2>&1; then
    if g push -q -u origin HEAD 2>/dev/null; then set_status ok; return 0; else set_status pending "$(g rev-list --count HEAD)"; return 1; fi
  fi
  branch=$(g symbolic-ref --short HEAD) || { set_status conflict; return 1; }
  [ "$(g config --get "branch.$branch.remote")" = origin ] || { set_status conflict; return 1; }
  remote_branch=$(g config --get "branch.$branch.merge"); remote_branch=${remote_branch#refs/heads/}
  behind=$(g rev-list --count 'HEAD..@{u}'); ahead=$(g rev-list --count '@{u}..HEAD')
  if [ "$behind" -gt 0 ]; then
    checkpoint=$(g rev-parse HEAD) || return 1
    before=$(cut -f1 "$IDX" 2>/dev/null | sort)
    if ! g pull -q --rebase >/dev/null 2>&1; then g rebase --abort 2>/dev/null; set_status conflict; return 1; fi
    if ! e=$(validate); then
      # Local edits were committed before pulling. --keep refuses to overwrite concurrent manual edits.
      g reset -q --keep "$checkpoint" 2>/dev/null || :
      build_index
      set_status invalid "$(printf '%s' "$e" | head -1 | sed "s|$DIR/||")"
      return 1
    fi
    build_index; after=$(cut -f1 "$IDX" | sort)
    new=$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | head -5 | tr '\n' ' ')
    PULLED=1
    if [ -n "$new" ]; then set_status pulled "$(t sync_new_servers "$new")"; else set_status pulled "$(t sync_got "$behind")"; fi
  else set_status ok; fi
  if [ "$ahead" -gt 0 ] || [ "$behind" -gt 0 ]; then
    ahead=$(g rev-list --count '@{u}..HEAD')
    g push -q origin "HEAD:refs/heads/$remote_branch" 2>/dev/null || { set_status pending "$ahead"; return 1; }
  fi
  return 0
}
cmd_bg_sync(){ # run in the background when opening search; skip if recently synced with no changes to avoid repeated network calls
  local last
  if [ -f "$ST.force" ]; then rm -f "$ST.force"
  else last=$(sed -n 3p "$ST" 2>/dev/null)
    [ -z "$(g status --porcelain 2>/dev/null)" ] && [ "$(sed -n 1p "$ST" 2>/dev/null)" = ok ] && [ $(( $(date +%s) - ${last:-0} )) -lt 60 ] && return 0
  fi
  sync_quiet 0 checking
}
saved_notice(){ # The data commit already succeeded; a notification failure must never roll it back.
  if has_remote; then flash "${CG}${ICON_OK} $1${C0}${CD}$(t sync_suffix_syncing)${C0}"; else flash "${CG}${ICON_OK} $1${C0}${CD}$(t sync_suffix_norepo)${C0}"; fi
  : > "$ST.force"
  return 0
}
save_and_sync(){ # $1 = change description
  local rc
  lock 10 || { flash "${CY}${ICON_WARN} $(t sync_busy)${C0}"; return 1; }
  commit_all "$1"; rc=$?
  unlock
  if [ "$rc" = 0 ]; then saved_notice "$1"
  else flash "${CR}${ICON_ERR} $(t err_not_saved)${C0}"; return 1; fi
}
sync_text(){ # → one line about the last sync outcome, from the status file
  local st f; st=$(sed -n 1p "$ST" 2>/dev/null); f=$(sed -n 2p "$ST" 2>/dev/null)
  case $st in ok) t sync_ok;; pulled) t sync_pulled;; pending) t sync_pending "${f:-0}";; offline) t sync_offline;; conflict) t sync_conflict;; invalid) t sync_invalid "$f";; *) t sync_unknown;; esac
}
sync_ui(){ # ^s and Tools → Sync now: a progress screen, then a flash with the outcome
  local d rc c=$CG i=$ICON_OK st; at "$(t sync_title)"
  d=$(tmpd) || return 1
  if ! has_remote; then
    sync_quiet 10 >/dev/null 2>&1; rc=$?
    if [ "$rc" = 0 ]; then flash "${CG}${ICON_OK} $(t sync_norepo)${C0}"; rm -rf "$d"; return 0; fi
  else
    clear; title "$UI_AT"; dimw "$(t sync_intro)"; echo
    run_progress "$(t sync_running)" 30 "$d/out" bash "$SELF" _sync_now; rc=$?
  fi
  if [ "$rc" = 75 ]; then flash "${CY}${ICON_WARN} $(t sync_busy)${C0}"; rm -rf "$d"; return 1; fi
  if [ $rc -ge 124 ]; then   # clean up abandoned work only while owning the writer lock
    if lock 0; then
      { [ -d "$DIR/.git/rebase-merge" ] || [ -d "$DIR/.git/rebase-apply" ]; } && g rebase --abort >/dev/null 2>&1
      unlock
    fi
    if [ $rc = 130 ]; then flash "${CD}$(t sync_cancelled)${C0}"; else flash "${CY}${ICON_WARN} $(t sync_timeout 30)${C0}"; fi
    rm -rf "${d:?}"; return 0; fi
  st=$(sed -n 1p "$ST" 2>/dev/null)
  if [ -z "$st" ] && [ -d "$STATE/sync.lock" ]; then flash "${CY}${ICON_WARN} $(t sync_busy)${C0}"; rm -rf "${d:?}"; return 0; fi
  case $st in ok|pulled) ;; invalid|conflict) c=$CR; i=$ICON_ERR;; *) c=$CY; i=$ICON_WARN;; esac
  flash "$c$i $(sync_text)$C0"; rm -rf "${d:?}"
}

# ---------- secret vault ----------
# Keys and passwords live in ~/ssh-hosts/secrets, encrypted with age to an identity (vault.pub). That identity is protected by
# a master password (vault.key.age) and a recovery code (vault.recovery.age). After the first unlock, the operating system
# stores the identity (Keychain / secret-service).
SEC=$DIR/secrets
KEY_TTL=${HOSTBOOK_KEY_TTL:-}; [ -n "$KEY_TTL" ] || { cfg key_ttl 8h KEY_TTL; duration "$KEY_TTL" KEY_TTL; }
vault_exists(){ [ -f "$SEC/vault.pub" ]; }
vault_started(){ local f; [ ! -L "$SEC" ] || return 0; for f in "$SEC/vault.pub" "$SEC/vault.key.age" "$SEC/vault.recovery.age"; do [ ! -e "$f" ] && [ ! -L "$f" ] || return 0; done; return 1; }
vault_id(){ sha256 < "$SEC/vault.pub" | cut -c1-8; }
kc_backend(){
  case ${HOSTBOOK_KEYCHAIN:-} in file:*) echo "$HOSTBOOK_KEYCHAIN"; return;; esac
  if is_mac && have security; then echo mac; return; fi
  if have secret-tool && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then echo st; return; fi
  local d; for d in "${XDG_RUNTIME_DIR:-}" /dev/shm; do [ -n "$d" ] && [ -d "$d" ] && [ -w "$d" ] && { echo "file:$d/hostbook-$(id -u)/identity"; return; }; done
  echo none
}
kc_label(){ case $(kc_backend) in mac) t kc_mac;; st) t kc_st;; file:*) t kc_file;; *) t kc_none;; esac; }
kc_get(){ local b; b=$(kc_backend); case $b in
  mac) security find-generic-password -s hostbook -a "vault:$(vault_id)" -w 2>/dev/null | base64 -d 2>/dev/null;;
  st) secret-tool lookup service hostbook account "vault:$(vault_id)" 2>/dev/null | base64 -d 2>/dev/null;;
  file:*) cat "${b#file:}-$(vault_id)" 2>/dev/null;;
  *) return 1;; esac; }
kc_set(){ local b v; b=$(kc_backend)
  v=$(base64 | tr -d '\n'); case $b in   # identity via stdin
  mac) security add-generic-password -U -s hostbook -a "vault:$(vault_id)" -w "$v" >/dev/null 2>&1;;
  st) printf '%s' "$v" | secret-tool store --label "hostbook" service hostbook account "vault:$(vault_id)" 2>/dev/null;;
  file:*) mkdir -p "$(dirname "${b#file:}")"; chmod 700 "$(dirname "${b#file:}")"; printf '%s' "$v" | base64 -d > "${b#file:}-$(vault_id)";;
  *) return 0;; esac; }
kc_del(){ local b; b=$(kc_backend); case $b in
  mac) security delete-generic-password -s hostbook -a "vault:$(vault_id)" >/dev/null 2>&1;;
  st) secret-tool clear service hostbook account "vault:$(vault_id)" 2>/dev/null;;
  file:*) rm -f "${b#file:}-$(vault_id)";; esac; return 0; }
id_ok(){ [ "$(age-keygen -y 2>/dev/null)" = "$(cat "$SEC/vault.pub")" ]; }   # identity via stdin
age_pw_enc(){ AGE_PASSPHRASE=$1 age -e -j batchpass -a; }
age_pw_dec(){ AGE_PASSPHRASE=$1 age -d -j batchpass "$2" 2>/dev/null; }
# Print the identity to stdout. Use only through a pipe; never put it in environment variables or command arguments.
vault_identity(){ # → the identity on stdout; the unlock screen's breadcrumb must not leak into the caller's
  local r at0=$UI_AT; vault_identity_run; r=$?; UI_AT=$at0; return $r
}
vault_identity_run(){
  local id pw i e=
  vault_exists || return 1
  id=$(kc_get) && [ -n "$id" ] && printf '%s\n' "$id" | id_ok && { printf '%s\n' "$id"; return 0; }
  UI_AT="${UI_AT:+$UI_AT|}$(t vault_unlock_title)"
  for i in 1 2 3; do
    if [ -n "${HOSTBOOK_MASTER:-}" ]; then pw=$HOSTBOOK_MASTER; else pw=$(ask_pw "$(t vault_unlock_head)" "$e") || return 1; fi
    if id=$(age_pw_dec "$pw" "$SEC/vault.key.age") && [ -n "$id" ]; then printf '%s\n' "$id" | kc_set || return 1; printf '%s\n' "$id"; return 0; fi
    e=$(t err_master_wrong); [ -n "${HOSTBOOK_MASTER:-}" ] && { err "$e" >&2; return 1; }
  done
  ui_confirm --affirmative "$(t vault_recover_yes)" --negative "$(t cancel)" "$(t vault_recover_q)" >&2 && vault_recover >&2 && vault_identity
}
# Bound the read: tr | head on /dev/urandom hangs on macOS when SIGPIPE is ignored.
recovery_new(){ od -An -N20 -tu1 /dev/urandom | awk 'BEGIN{s="0123456789ABCDEFGHJKMNPQRSTVWXYZ"}
  {for(i=1;i<=NF;i++){printf "%s",substr(s,$i%32+1,1);n++}} END{if(n!=20)exit 1}'; }
recovery_fmt(){ echo "HB-$(printf '%s' "$1" | sed 's/..../&-/g; s/-$//')"; }
recovery_norm(){ printf '%s' "$1" | tr 'a-z' 'A-Z' | sed 's/^HB-//' | tr -d ' -'; }
vault_create(){ # master-password → create the vault and print the recovery code
  legacy_destinations "$SEC"/* || return 65
  local pw=$1 id rc; [ ! -L "$SEC" ] || return 1; private_dir "$DIR" || return 1; private_dir "$SEC" || return 1
  id=$(age-keygen 2>/dev/null) || return 1
  printf '%s\n' "$id" | age-keygen -y > "$SEC/vault.pub" || return 1
  printf '%s\n' "$id" | age_pw_enc "$pw" > "$SEC/vault.key.age" || return 1
  rc=$(recovery_new) || return 1; printf '%s\n' "$id" | age_pw_enc "$rc" > "$SEC/vault.recovery.age" || return 1
  printf '%s\n' "$id" | kc_set || return 1
  ensure_merge_setup
  recovery_fmt "$rc"
}
ask_new_pw(){ # heading minimum-length [intro] → print the password (the caller sets the breadcrumb with "at")
  local a b e= head=$1
  [ "$2" -le 1 ] || head=$(t pw_head_min "$1" "$2")
  while :; do
    { clear; title "$UI_AT"; [ -z "${3:-}" ] || { dimw "$3"; echo; }; [ -z "$e" ] || err "$e"; ui_keys "enter:$(t key_confirm)" "esc:$(t key_cancel)"; printf '\n\n'; } >&2
    a=$(gum input --password --placeholder "" --header "$head") || return 1
    [ ${#a} -ge "$2" ] || { e=$(t err_pw_short "$2"); continue; }
    b=$(gum input --password --placeholder "" --header "$(t pw_again)") || return 1
    [ "$a" = "$b" ] && { printf '%s' "$a"; return 0; }; e=$(t err_pw_mismatch); done
}
show_recovery(){ # code [finished-step line]: a plain text screen, not a frame, so selecting the code with the mouse takes nothing else
  local note= k
  while :; do
    { clear; title "${UI_AT:-$(t rec_title)}"; [ -z "${2:-}" ] || printf '%s\n\n' "$2"
      printf '%s%s%s\n\n  %s%s%s\n\n' "$CB" "$(t rec_title)" "$C0" "$CG$CB" "$1" "$C0"; dimw "$(t rec_note)"; dimw "$(t rec_once)"
      [ -z "$note" ] || printf '\n%s\n' "$note"; printf '\n'; ui_keys "enter:$(t key_continue)" "c:$(t key_copy_code)"; printf '\n'; } >&2
    IFS= read -rsn1 k </dev/tty || return 0
    case $k in c|C) printf '%s' "$1" | copy && note="$CG$ICON_OK$C0 $(t rec_copied)";; *) return 0;; esac
  done
}
# Create the secret vault if absent. Print everything to stderr because this is often called inside $(...).
vault_init(){
  legacy_destinations "$SEC"/* || return 65
  [ ! -L "$SEC" ] || { err "$(t err_vault_partial)" >&2; return 1; }
  if vault_started; then
    [ -s "$SEC/vault.pub" ] && [ -s "$SEC/vault.key.age" ] && [ -s "$SEC/vault.recovery.age" ] && return 0
    err "$(t err_vault_partial)" >&2; return 1
  fi
  check_age || return 1
  local pw code at0=$UI_AT
  at "$(t vault_title)|$(t add_step 1 2)"
  pw=$(ask_new_pw "$(t vault_master)" 10 "$(t vault_intro)") || { UI_AT=$at0; return 1; }
  code=$(vault_create "$pw") || { err "$(t err_vault_create)" >&2; UI_AT=$at0; return 1; }
  save_and_sync "$(t done_vault_created)"
  at "$(t vault_title)|$(t add_step 2 2)"
  show_recovery "$code" "$CG$ICON_OK$C0 $(t vault_created "$(kc_label)")" >&2
  UI_AT=$at0
  return 0
}
vault_passwd(){
  legacy_destinations "$SEC"/* || return 65
  local id pw at0=$UI_AT; id=$(vault_identity) || return 1
  at "${at0:+$at0|}$(t vault_passwd_title)"
  pw=$(ask_new_pw "$(t vault_master_new)" 10) || { UI_AT=$at0; return 1; }
  UI_AT=$at0; shown
  printf '%s\n' "$id" | age_pw_enc "$pw" > "$SEC/vault.key.age" && save_and_sync "$(t done_master_changed)" && ok "$(t ok_master_changed)"
}
vault_new_recovery(){ # identity via stdin → write and print a new code
  legacy_destinations "$SEC/vault.recovery.age" || return 65
  local rc; rc=$(recovery_new) || return 1; age_pw_enc "$rc" > "$SEC/vault.recovery.age" && recovery_fmt "$rc"
}
vault_recover(){ # [code] [new password] (both arguments are for tests only)
  legacy_destinations "$SEC"/* || return 65
  local code=${1:-} pw=${2:-} id new at0=$UI_AT
  at "${at0:+$at0|}$(t vault_recover_title)"
  [ -n "$code" ] || code=$(ui_field "$(t rec_label)" "" text "$(t rec_rule)"$'\n'"$(t example HB-XXXX-XXXX-XXXX-XXXX-XXXX)") || { UI_AT=$at0; return 1; }
  id=$(age_pw_dec "$(recovery_norm "$code")" "$SEC/vault.recovery.age") && [ -n "$id" ] || { err "$(t err_rec_wrong)" >&2; UI_AT=$at0; return 1; }
  [ -n "$pw" ] || pw=$(ask_new_pw "$(t vault_master_new)" 10) || { UI_AT=$at0; return 1; }
  printf '%s\n' "$id" | age_pw_enc "$pw" > "$SEC/vault.key.age"
  new=$(printf '%s\n' "$id" | vault_new_recovery); printf '%s\n' "$id" | kc_set || return 1
  save_and_sync "$(t done_recovered)"
  if [ -n "${1:-}" ]; then echo "$new"; else show_recovery "$new" "$CG$ICON_OK$C0 $(t ok_recovered)"; fi
  UI_AT=$at0
}
vault_recovery_code(){ local id new at0=$UI_AT; id=$(vault_identity) || return 1; at "${at0:+$at0|}$(t rec_title)"; new=$(printf '%s\n' "$id" | vault_new_recovery) && save_and_sync "$(t done_rec_new)" && show_recovery "$new"; UI_AT=$at0; }

# ---------- secrets ----------
valid_secret_name(){ case $1 in vault|vault.*|"") return 1;; esac; printf '%s' "$1" | grep -qE '^[a-z0-9][a-z0-9._-]{0,39}$'; }
secret_exists(){ [ -f "$SEC/$1.meta" ]; }
secret_meta(){ sed -n "s/^$2=//p" "$SEC/$1.meta" 2>/dev/null | head -1; }
secret_names(){ local f; for f in "$SEC"/*.meta; do [ -f "$f" ] && basename "$f" .meta; done; return 0; }
secret_users(){ awk -F'\t' -v s="$1" '$12==s{print $1}' "$IDX"; }
secret_label(){ if [ "$(secret_meta "$1" type)" = password ]; then t secret_password; echo; else t pv_key "$(secret_meta "$1" keytype)"; echo; fi; }
secret_enc(){ age -e -a -r "$(cat "$SEC/vault.pub")"; }
secret_get(){ vault_identity | age -d -i - "$SEC/$1.age" 2>/dev/null; }
secret_slug(){ printf '%s' "$1" | tr 'A-Z_ ' 'a-z--' | tr -cd 'a-z0-9.-' | sed 's/^[.-]*//' | cut -c1-40; }
# Normalize and validate a key file; remove its passphrase if present (the vault provides encryption). Print "fingerprint<TAB>type".
key_prepare(){
  local f=$1 pp
  tr -d '\r' < "$f" > "$f.n" && mv "$f.n" "$f"; [ -n "$(tail -c1 "$f")" ] && echo >> "$f"; chmod 600 "$f"
  if ! ssh-keygen -y -P "" -f "$f" >/dev/null 2>&1; then
    if ssh-keygen -y -P "" -f "$f" 2>&1 | grep -qi 'passphrase'; then
      pp=${HOSTBOOK_KEY_PASSPHRASE:-}; [ -n "$pp" ] || pp=$(ask_pw "$(t key_pp_head)") || return 1
      ssh-keygen -q -p -P "$pp" -N "" -f "$f" >/dev/null 2>&1 || { err "$(t err_pp_wrong)" >&2; return 1; }
    else err "$(t err_key_invalid)" >&2; return 1; fi
  fi
  ssh-keygen -lf "$f" | awk '{ t=$NF; gsub(/[()]/,"",t); print $2 "\t" tolower(t) }'
}
secret_write_key(){ # name key-file fingerprint type [output-directory]
  legacy_destinations "${5:-$SEC}/$1.age" "${5:-$SEC}/$1.pub" "${5:-$SEC}/$1.meta" || return 65
  local out=${5:-$SEC}
  ssh-keygen -y -f "$2" > "$out/$1.pub" && chmod 600 "$out/$1.pub" || return 1
  printf 'type=key\nfp=%s\nkeytype=%s\ncreated=%s\n' "$3" "$4" "$(date +%F)" > "$out/$1.meta" || return 1
  secret_enc < "$2" > "$out/$1.age"
}
ask_secret_name(){ # default [preview] [own name to leave out of the taken list] → print a valid, unused name
  local n=$1 prev=${2:-} e= rule d; d=$(tmpd) || return 1; secret_names | awk -v x="${3:-}" '$0!=x' > "$d/taken"
  [ -n "$prev" ] || prev=$(t secret_name_preview '%s')
  while :; do
    rule=$(t secret_name_rule); [ -n "$n" ] || rule=$rule$'\n'$(t example key-booking)
    n=$(UI_TAKEN=err_secret_taken ui_field "$(t secret_name_label)" "$n" "lname:$d/taken" "$rule" "$prev" "$e") || return 1
    valid_secret_name "$n" && { echo "$n"; return 0; }
    e="$CR$ICON_ERR $(t err_secret_name)$C0"
  done
}
# Add a key to the vault. Print the secret name to stdout (the existing name if the fingerprint is already stored).
secret_add_key(){ # source(clip|gen|path) [name] [replace]
  legacy_destinations "$SEC"/* || return 65
  local src=$1 name=${2:-} replace=${3:-} d f info fp kt dup def ext oldpub=""
  vault_init || return 1
  d=$(tmpd) || return 1; f=$d/key
  case $src in
    clip) clip_get > "$f" 2>/dev/null
          if ! grep -q 'PRIVATE KEY' "$f"; then
            if [ -n "${IMPORT_KEY_MODE:-}" ]; then err "$(t err_import_key_clipboard)" >&2; rm -rf "$d"; return 1; fi
            printf '%s\n' "$(t secret_clip_note)" > "$f"
            ${VISUAL:-${EDITOR:-$(have nano && echo nano || echo vi)}} "$f" </dev/tty >/dev/tty; grep -v '^# ' "$f" > "$f.x"; mv "$f.x" "$f"; fi
          def="";;
    gen)  rm -f "$f"; ssh-keygen -q -t ed25519 -N "" -C "${name:-hostbook}" -f "$f" || return 1; def="";;
    *)    cp "${src/#\~/$HOME}" "$f" 2>/dev/null || { err "$(t err_secret_read "$src")" >&2; return 1; }; def=$(secret_slug "$(basename "$src")");;
  esac
  info=$(key_prepare "$f") || { rm -rf "$d"; return 1; }
  fp=${info%%"$TAB"*}; kt=${info#*"$TAB"}
  dup=$(grep -lxF "fp=$fp" "$SEC"/*.meta 2>/dev/null | head -1)
  if [ -n "$dup" ]; then dup=$(basename "$dup" .meta); rm -rf "$d"
    if [ -n "$replace" ]; then err "$(t sc_dup "$dup")" >&2; return 1; fi
    dim "$(t sc_dup "$dup")" >&2; echo "$dup"; return 0; fi
  if [ -n "$replace" ]; then secret_exists "$name" || return 1; cp "$SEC/$name.pub" "$d/old.pub" 2>/dev/null && oldpub=$d/old.pub
  elif [ -n "$name" ]; then valid_secret_name "$name" && ! secret_exists "$name" || { err "$(t err_secret_bad "$name")" >&2; rm -rf "$d"; return 1; }
  else name=$(ask_secret_name "$def") || { rm -rf "$d"; return 1; }; fi
  if [ -n "${IMPORT_KEY_MODE:-}" ]; then
    [ -z "$replace" ] && secret_write_key "$name" "$f" "$fp" "$kt" "$d" || { rm -rf "$d"; return 1; }
    lock 10 || { rm -rf "$d"; err "$(t sync_busy)" >&2; return 1; }
    [ ! -L "$SEC" ] || { unlock; rm -rf "$d"; return 1; }
    dup=$(grep -lxF "fp=$fp" "$SEC"/*.meta 2>/dev/null | head -1)
    if [ -n "$dup" ]; then dup=$(basename "$dup" .meta); unlock; rm -rf "$d"; dim "$(t sc_dup "$dup")" >&2; echo "$dup"; return 0; fi
    for ext in pub meta age; do [ ! -e "$SEC/$name.$ext" ] && [ ! -L "$SEC/$name.$ext" ] || { unlock; rm -rf "$d"; return 1; }; done
    for ext in pub meta age; do cp -p "$d/$name.$ext" "$SEC/$name.$ext" || { import_discard_secret "$name"; unlock; rm -rf "$d"; return 1; }; done
    import_commit_secret "$name" || { import_discard_secret "$name"; unlock; rm -rf "$d"; return 1; }
    unlock; rm -rf "$d"; echo "$name"; return 0
  fi
  secret_write_key "$name" "$f" "$fp" "$kt" || { rm -rf "$d"; return 1; }
  [ -n "$oldpub" ] && ssh-add -q -d "$oldpub" 2>/dev/null
  rm -rf "$d"
  save_and_sync "$( if [ -n "$replace" ]; then t done_secret_key_replaced "$name"; else t done_secret_added "$name"; fi)"
  echo "$name"
}
secret_add_password(){ # [name] [password] → print the name
  legacy_destinations "$SEC"/* || return 65
  local name=${1:-} pw=${2:-}
  vault_init || return 1
  if [ -n "$name" ]; then valid_secret_name "$name" && ! secret_exists "$name" || { err "$(t err_secret_bad "$name")" >&2; return 1; }
  else name=$(ask_secret_name "") || return 1; fi
  [ -n "$pw" ] || pw=$(ask_new_pw "$(t pw_login_head)" 1) || return 1
  printf 'type=password\ncreated=%s\n' "$(date +%F)" > "$SEC/$name.meta"
  printf '%s\n' "$pw" | secret_enc > "$SEC/$name.age"
  save_and_sync "$(t done_secret_added "$name")"; echo "$name"
}
# Choose a login method for a server. Print the secret name (empty = SSH handles it). Return 1 on cancellation.
pick_login(){ # [suggested secret] [reason] [key: require a stored key]
  local sug=${1:-} why=${2:-} kind=${3:-} items=() keys=() n i c f nm d head
  local UI_AT=$UI_AT base=$UI_AT
  ensure_index
  while :; do
    UI_AT=$base; items=(); keys=()
    for n in $(secret_names | awk -v s="$sug" '$0==s'; secret_names | awk -v s="$sug" '$0!=s'); do
      [ "$kind" != key ] || [ "$(secret_meta "$n" type)" = key ] || continue
      [ ${#keys[@]} -eq 0 ] && items+=("#$(t login_vault_items)")
      c=$(secret_users "$n" | grep -c .); d=$(secret_label "$n")
      if [ "$n" = "$sug" ] && [ -n "$why" ]; then d="$d · $why"; else if [ "$c" = 0 ]; then d="$d · $(t sc_unused)"; else d="$d · $(t sc_users "$c")"; fi; [ "$n" = "$sug" ] && d="$d · $(t current)"; fi
      items+=("$n|$d"); keys+=("s:$n"); done
    head=$(t login_vault_intro)
    [ ${#keys[@]} -gt 0 ] || head=$(t login_vault_empty)
    items+=("$(t login_add_vault)"); keys+=(add)
    if [ "$kind" != key ]; then items+=("#$(t sec_other)" "$(t act_no_login)|$(t act_no_login_hint)"); keys+=(none); fi
    i=$(UI_HEAD="${UI_HEAD:+$UI_HEAD$NL}$head" ui_menu "$(t login_head)" "${items[@]}") || return 1
    case ${keys[$i]} in
      s:*) echo "${keys[$i]#s:}"; return 0;;
      none) echo; return 0;;
      add) ;;
      *) return 1;;
    esac
    UI_AT="$base|$(t login_add_vault)"
    items=("$(t act_key_file)" "$(t act_key_paste)|$(t act_key_paste_hint)" "$(t act_key_new)|ed25519"); keys=(file clip gen)
    if [ "$kind" != key ]; then items+=("$(t act_pw_new)"); keys+=(pass); fi
    i=$(UI_HEAD="$(t login_import_intro)" ui_choice "$(t login_add_vault)" "${items[@]}") || continue
    case ${keys[$i]} in
      file) f=$(pick_key_file) || continue; nm=$(secret_add_key "$f") || return 1;;
      clip) nm=$(secret_add_key clip) || return 1;;
      gen) vault_init || return 1; nm=$(ask_secret_name "") || continue
           nm=$(secret_add_key gen "$nm") || return 1
           { shown; ok "$(t login_made "$nm")"; cat "$SEC/$nm.pub"; cat "$SEC/$nm.pub" | copy && dim "$(t login_copied)"; pause "$(t pause_continue)"; } >&2;;
      pass) nm=$(secret_add_password) || return 1;;
      *) return 1;;
    esac
    ok "$(t login_vault_saved "$nm")" >&2
    printf '%s\n' "$nm"; return 0
  done
}
# Move local key files referenced by servers into the vault and rewrite the config.
# Only include explicit IdentityFile entries in .conf files, not defaults from "ssh -G"; the key file must exist.
legacy_keys(){ # print "path<TAB>server count"
  local k
  cat "$DIR"/*.conf 2>/dev/null | awk '{sub(/\r$/,"")} tolower($1)=="identityfile" {p=$0; sub(/^[ \t]*[^ \t]+[ \t]+/,"",p); gsub(/^"|"$/,"",p); if(p !~ /secrets\/[^\/]+\.pub$/) print p}' | sort -u | while read -r k; do
    [ -f "${k/#\~/$HOME}" ] && printf '%s\t%s\n' "$k" "$(awk -F'\t' -v k="$k" '$12=="" && $7==k' "$IDX" | grep -c .)"; done
}
migrate_keys_raw(){ # no prompts; print the number of migrated keys
  legacy_destinations "$DIR"/*.conf "$SEC"/* || return 65
  local k c nm n=0 f full
  ensure_index
  while IFS="$TAB" read -r k c; do
    nm=$(secret_slug "$(basename "$k")"); while secret_exists "$nm" && [ "$(secret_meta "$nm" fp)" != "$(ssh-keygen -lf "${k/#\~/$HOME}" 2>/dev/null | awk '{print $2}')" ]; do nm="$nm-2"; done
    nm=$(secret_add_key "$k" "$( secret_exists "$nm" || echo "$nm")" 2>/dev/null) || { warn "$(t warn_mig_skip "$k")" >&2; continue; }
    full=${k/#\~/$HOME}
    for f in "$DIR"/*.conf; do [ -f "$f" ] || continue
      awk -v a="$k" -v b="$full" -v nm="$nm" -v pub="$(ssh_path "${SEC/#$HOME/\~}/$nm.pub")" '
        function flush(  i){ for (i=1;i<=nb;i++) print buf[i]; nb=0 }
        # collect Host blocks; replace references to this IdentityFile with the secret public-key path
        tolower($1)=="host" || tolower($1)=="match" { flush(); hostline=NR; wild=($0 ~ /[*?]/); hit=0; hasio=0 }
        { buf[++nb]=$0 }
        tolower($1)=="identityfile" { path=$0; sub(/\r$/,"",path); sub(/^[ \t]*[^ \t]+[ \t]+/,"",path); gsub(/^"|"$/,"",path) }
        tolower($1)=="identityfile" && (path==a || path==b) { match($0,/^[ \t]*/); ind=substr($0,1,RLENGTH); buf[nb]=ind "IdentityFile " pub "\n" ind "IdentitiesOnly yes"; hit=1
            if (!wild) { for (i=nb;i>=1;i--) if (tolower(buf[i]) ~ /^[ \t]*host[ \t]/) { if (i==1 || buf[i-1] !~ /#[ \t]*secret:/) buf[i]="# secret: " nm "\n" buf[i]; break } } }
        END { flush() }' "$f" > "$f.tmp"
      cmp -s "$f" "$f.tmp" && rm -f "$f.tmp" || mv "$f.tmp" "$f"
    done
    n=$((n+1))
  done < <(legacy_keys)
  echo "$n"
}
migrate_keys(){
  local list n lines=() k c; ensure_index; list=$(legacy_keys); [ -n "$list" ] || return 0
  lines=("$(t mig_head)")
  while IFS="$TAB" read -r k c; do lines+=("  $(t mig_line "$k" "$c")"); done <<< "$list"
  lines+=(" " "$CD$(t mig_note)$C0")
  ui_confirm --affirmative "$(t mig_yes)" --negative "$(t mig_later)" "$(t mig_q)" "${lines[@]}" || return 0
  n=$(migrate_keys_raw)
  if validate >/dev/null; then build_index; save_and_sync "$(t done_migrated "$n")"; ok "$(t done_migrated "$n")"
  else g checkout -q -- '*.conf' 2>/dev/null; build_index; err "$(t err_mig_broken)"; fi
}

# ---------- using secrets for connections ----------
agent_ok(){ ssh-add -l >/dev/null 2>&1; [ $? -le 1 ]; }
agent_ready(){ # reuse the existing agent (also visible to manual SSH and VS Code); otherwise start a private agent
  agent_ok && return 0
  if [ -f "$STATE/agent.env" ]; then . "$STATE/agent.env" >/dev/null 2>&1; export SSH_AUTH_SOCK SSH_AGENT_PID; agent_ok && return 0; fi
  local d; d=$(mktemp -d /tmp/hb-XXXXXX) || return 1   # keep the socket path short
  ssh-agent -a "$d/a.sock" > "$STATE/agent.env" 2>/dev/null
  . "$STATE/agent.env" >/dev/null 2>&1; export SSH_AUTH_SOCK SSH_AGENT_PID
  [ "${SSH_AUTH_SOCK:-}" = "$d/a.sock" ] && agent_ok
}
load_secret(){ # load one secret key into the agent with an expiry
  local n=$1 fp; [ "$(secret_meta "$n" type)" = key ] || return 0
  fp=$(secret_meta "$n" fp); ssh-add -l 2>/dev/null | grep -qF "$fp" && return 0
  secret_get "$n" | ssh-add -q -t "$KEY_TTL" - 2>/dev/null
  ssh-add -l 2>/dev/null | grep -qF "$fp"
}
secrets_for(){ # secrets for the server and all jump hosts (up to five levels)
  local n=$1 depth=${2:-0} j s
  s=$(host_field "$n" 12); [ -n "$s" ] && echo "$s"
  [ "$depth" -ge 5 ] && return 0
  for j in $(host_field "$n" 6 | tr ',' ' '); do host_exists "$j" && secrets_for "$j" $((depth+1)); done
  return 0
}
ASKPASS_ON=""
prepare_login(){ # server… → load keys and enable askpass for password secrets. Return 1 if the vault cannot be opened
  local h s need=""
  ASKPASS_ON=""
  for h in "$@"; do for s in $(secrets_for "$h" | sort -u); do
    secret_exists "$s" || { warn "$(t warn_secret_gone "$s")"; continue; }
    if [ "$(secret_meta "$s" type)" = password ]; then ASKPASS_ON=1
    else agent_ready || { err "$(t err_agent)"; return 1; }
      load_secret "$s" || { err "$(t err_load_key "$s")"; return 1; }; fi
  done; done
  if [ -n "$ASKPASS_ON" ]; then
    printf '#!/bin/sh\nexec %s _askpass "$@"\n' "$(printf %q "$SELF")" > "$STATE/askpass"; chmod 700 "$STATE/askpass"
    vault_identity >/dev/null || { err "$(t err_vault_locked)"; return 1; }   # unlock here while user prompts are still possible
  fi
  return 0
}
ssh_login(){ # run sshx with askpass when needed. $1 = server name (for its default secret); remaining arguments go to SSH
  local h=$1 d count=${HB_ASKPASS_COUNT:-}; shift
  if [ -n "$ASKPASS_ON" ]; then
    if [ -z "$count" ]; then d=$(tmpd) || return 1; count=$d/count; fi
    SSH_ASKPASS="$STATE/askpass" SSH_ASKPASS_REQUIRE=force HB_ASKPASS_HOST="$h" HB_ASKPASS_COUNT="$count" sshx "$@"
  else sshx "$@"; fi
}
tty_ask(){ # prompt [hidden] → prompt on the terminal and print the answer
  local a; [ -n "${HB_ASKPASS_NOTTY:-}" ] && { echo "${HB_ASKPASS_ANSWER:-}"; return 0; }   # HB_ASKPASS_ANSWER: for tests only
  printf '%s' "$1" > /dev/tty
  if [ -n "${2:-}" ]; then stty -echo < /dev/tty 2>/dev/null; IFS= read -r a < /dev/tty; stty echo < /dev/tty 2>/dev/null; printf '\n' > /dev/tty
  else IFS= read -r a < /dev/tty; fi
  printf '%s\n' "$a"
}
# SSH calls this (through $STATE/askpass) for each prompt. Supply the stored password only on the first attempt;
# if the server asks again, the password was wrong, so prompt the user.
cmd_askpass(){
  local prompt=${1:-} who host user s="" cnt=${HB_ASKPASS_COUNT:-/dev/null}
  [ -n "${HB_ASKPASS_LOG:-}" ] && printf '%s\n' "$prompt" >> "$HB_ASKPASS_LOG"
  case $prompt in
    *yes/no*) tty_ask "$prompt"; return;;
    *[Pp]assword*)
      ensure_index
      who=$(printf '%s' "$prompt" | grep -oE '[A-Za-z0-9._-]+@[A-Za-z0-9._:-]+' | head -1); user=${who%%@*}; host=${who#*@}
      # a prompt for the destination uses its secret; a prompt for another machine (jump host) looks up user@host
      local th=${HB_ASKPASS_HOST:-}
      if [ -z "$who" ] || { [ "$(host_field "$th" 3)" = "$host" ] && [ "$(host_field "$th" 4)" = "$user" ]; }; then s=$(host_field "$th" 12)
      else s=$(awk -F'\t' -v h="$host" -v u="$user" '$3==h && $4==u && $12!="" {print $12; exit}' "$IDX"); [ -n "$s" ] || s=$(host_field "$th" 12); fi
      if [ -n "$s" ] && [ "$(secret_meta "$s" type)" = password ] && ! grep -qxF "$s" "$cnt" 2>/dev/null; then
        echo "$s" >> "$cnt" 2>/dev/null; secret_get "$s"; return; fi
      [ -n "$s" ] && [ -z "${HB_ASKPASS_NOTTY:-}" ] && printf '%s%s%s\n' "$CY" "$(t askpass_wrong "$s")" "$C0" > /dev/tty
      tty_ask "$prompt" hide;;
    *) tty_ask "$prompt" hide;;
  esac
}
cmd_unlock(){
  local n c=0; vault_exists || { warn "$(t doc_vault_none)"; return 1; }
  agent_ready || { err "$(t err_agent)"; return 1; }
  for n in $(secret_names); do [ "$(secret_meta "$n" type)" = key ] || continue; load_secret "$n" && c=$((c+1)) || { err "$(t err_load_one "$n")"; return 1; }; done
  ok "$(t ok_unlocked "$c" "$((KEY_TTL/3600))")"
}
cmd_lock(){
  agent_ready || { err "$(t err_agent_conn)"; return 1; }
  local n; for n in $(secret_names); do [ -f "$SEC/$n.pub" ] && ssh-add -q -d "$SEC/$n.pub" 2>/dev/null; done
  if [ "${1:-}" = --forget ]; then kc_del; ok "$(t ok_forgot)"; else ok "$(t ok_locked)"; fi
}

# ---------- secret management ----------
secret_set_password(){ # name [password]
  legacy_destinations "$SEC/$1.age" || return 65
  local n=$1 pw=${2:-}; [ -n "$pw" ] || pw=$(ask_new_pw "$(t pw_new_for "$n")" 1) || return 1
  printf '%s\n' "$pw" | secret_enc > "$SEC/$n.age" && save_and_sync "$(t done_pw_changed "$n")" && ok "$(t ok_pw_changed "$n")"
}
secret_rename_raw(){ # old new
  legacy_destinations "$SEC"/* "$DIR"/*.conf || return 65
  local o=$1 n=$2 f e; valid_secret_name "$n" && ! secret_exists "$n" || return 1
  for e in age meta pub; do
    [ ! -f "$SEC/$o.$e" ] || mv "$SEC/$o.$e" "$SEC/$n.$e" || return 1
  done
  for f in "$DIR"/*.conf; do [ -f "$f" ] || continue
    awk -v o="$o" -v n="$n" '
      /^[ \t]*#[ \t]*secret:/ { v=$0; sub(/^[ \t]*#[ \t]*secret:[ \t]*/,"",v); sub(/[ \t]+$/,"",v); if (v==o) { print "# secret: " n; next } }
      tolower($1)=="identityfile" { i=index($0, "secrets/" o ".pub"); if (i && (i+length("secrets/" o ".pub")-1==length($0) || substr($0,i+length("secrets/" o ".pub"))=="\"")) { print substr($0,1,i-1) "secrets/" n ".pub" substr($0,i+length("secrets/" o ".pub")); next } }
      { print }' "$f" > "$f.tmp" || return 1
    if cmp -s "$f" "$f.tmp"; then rm -f "$f.tmp" || return 1; else mv "$f.tmp" "$f" || return 1; fi
  done
  return 0
}
secret_delete_raw(){ # name: delete the files and remove all login lines written by hostbook for this secret
  legacy_destinations "$SEC"/* "$DIR"/*.conf || return 65
  local n=${1:?} f ispw="" e; [ "$(secret_meta "$n" type)" = password ] && ispw=1
  [ -f "$SEC/$n.pub" ] && ssh-add -q -d "$SEC/$n.pub" 2>/dev/null
  for f in "$DIR"/*.conf; do [ -f "$f" ] || continue
    awk -v n="$n" -v ispw="$ispw" '
      function flush(  i,k){ for (i=1;i<=nb;i++) { k=tolower(key[i])
          if (hit && buf[i] ~ /^[ \t]*#[ \t]*secret:/) continue
          if (hit && !ispw && ((k=="identityfile" && index(buf[i], "secrets/" n ".pub")) || k=="identitiesonly")) continue
          if (hit && ispw && (k=="pubkeyauthentication" || k=="preferredauthentications")) continue
          print buf[i] } nb=0; hit=0 }
      # a block consists of comments immediately above Host, the Host line, and its body; collect it before deciding
      /^[ \t]*#/ { if (inbody) { flush(); inbody=0 } }
      tolower($1)=="host" || tolower($1)=="match" { if (inbody) flush(); inbody=1 }
      { buf[++nb]=$0; key[nb]=$1 }
      /^[ \t]*#[ \t]*secret:/ { v=$0; sub(/^[ \t]*#[ \t]*secret:[ \t]*/,"",v); sub(/[ \t]+$/,"",v); if (v==n) hit=1 }
      tolower($1)=="identityfile" && index($0, "secrets/" n ".pub") { hit=1 }
      END { flush() }' "$f" > "$f.tmp" || return 1
    if cmp -s "$f" "$f.tmp"; then rm -f "$f.tmp" || return 1; else mv "$f.tmp" "$f" || return 1; fi
  done
  for e in age meta pub; do [ ! -f "${SEC:?}/$n.$e" ] || rm -f "${SEC:?}/${n:?}.$e" || return 1; done
  return 0
}
secret_edit(){
  local n=$1 d f info type; type=$(secret_meta "$n" type); d=$(tmpd) || return 1; f=$d/s
  secret_get "$n" > "$f" || { err "$(t err_vault_locked)"; return 1; }; cp "$f" "$f.orig"; chmod 600 "$f"
  ${VISUAL:-${EDITOR:-$(have nano && echo nano || echo vi)}} "$f"
  if cmp -s "$f" "$f.orig"; then dim "$(t sc_nochange)"; return 0; fi
  if [ "$type" = password ]; then
    [ "$(grep -c . "$f")" = 1 ] || { err "$(t err_pw_oneline)"; return 1; }
    head -1 "$f" | secret_enc > "$SEC/$n.age"
  else
    info=$(key_prepare "$f") || return 1
    [ -f "$SEC/$n.pub" ] && ssh-add -q -d "$SEC/$n.pub" 2>/dev/null
    secret_write_key "$n" "$f" "${info%%"$TAB"*}" "${info#*"$TAB"}"
  fi
  save_and_sync "$(t done_secret_edited "$n")"; ok "$(t ok_saved "$n")"
}
# After replacing a key, use the old key (still in the agent) to install the new key on each server, then test it.
push_new_key(){ # secret-name old-public-key-file [yes = no prompts, keep the old key]
  local sc=$1 oldpub=$2 auto=${3:-} h hosts okh="" bad="" oldblob
  hosts=$(secret_users "$sc"); [ -n "$hosts" ] || return 0
  [ -n "$auto" ] || { at "$(t secrets_title)|$sc|$(t pn_title)"; ui_confirm --affirmative "$(t pn_yes)" --negative "$(t cancel)" "$(t pn_q "$(printf '%s\n' "$hosts" | grep -c .)" "$sc")" "$CD$(t pn_how)$C0" "  • $(printf '%s ' $hosts)"; } || return 0
  agent_ready && load_secret "$sc" || return 1
  for h in $hosts; do
    printf '  %s … ' "$h"
    if sshx -o BatchMode=yes -o ConnectTimeout=8 -o IdentitiesOnly=yes -o IdentityFile="$oldpub" "$h" 'umask 077; mkdir -p ~/.ssh; cat >> ~/.ssh/authorized_keys' < "$SEC/$sc.pub" 2>/dev/null \
       && sshx -o BatchMode=yes -o ConnectTimeout=8 "$h" true </dev/null 2>/dev/null; then okh="$okh $h"; printf "%s${ICON_OK} %s%s\n" "$CG" "$(t pn_ok)" "$C0"
    else bad="$bad $h"; printf "%s${ICON_ERR} %s%s\n" "$CR" "$(t pn_fail)" "$C0"; fi
  done
  [ -n "$bad" ] && warn "$(t pn_warn "$bad")"
  [ -n "$auto" ] && [ "$auto" != remove ] && return 0
  if [ -n "$okh" ] && { [ "$auto" = remove ] || { at "$(t secrets_title)|$sc|$(t pn_remove_title)"
      ui_confirm --danger --default=false --affirmative "$(t pn_remove_yes)" --negative "$(t cancel)" "$(t pn_remove_q)" "$CB$(t delete_removes)$C0" "  • $(t pn_removes)" "    ${okh# }" " " "$CB$(t delete_keeps)$C0" "  • $(t pn_keeps)" " " "$CD$(t pn_undo)$C0"; }; }; then
    oldblob=$(awk '{print $2}' "$oldpub")
    for h in $okh; do
      if sshx -o BatchMode=yes -o ConnectTimeout=8 "$h" "grep -vF '$oldblob' ~/.ssh/authorized_keys > ~/.ssh/authorized_keys.hb && mv ~/.ssh/authorized_keys.hb ~/.ssh/authorized_keys" </dev/null 2>/dev/null; then printf "  %s ${ICON_OK} %s\n" "$h" "$(t pn_removed)"; else printf "  %s %s${ICON_ERR} %s%s\n" "$h" "$CR" "$(t pn_not_removed)" "$C0"; fi; done
  fi
}
secret_replace(){ # name source(clip|file|gen|path) [auto: yes|remove]
  local n=$1 src=$2 auto=${3:-} d
  [ "$src" = file ] && { src=$(pick_key_file) || return 1; }
  d=$(tmpd) || return 1; cp "$SEC/$n.pub" "$d/old.pub"; chmod 600 "$d/old.pub"
  secret_get "$n" > "$d/old.key" || { err "$(t err_vault_locked)"; return 1; }; chmod 600 "$d/old.key"
  secret_add_key "$src" "$n" replace >/dev/null || return 1
  ok "$(t ok_replaced "$n")"; [ "$src" = gen ] && { t pub_new; echo; cat "$SEC/$n.pub"; }
  build_index
  # temporarily load the old key (10 minutes) so it can authenticate while installing the new key
  if agent_ready && ssh-add -q -t 600 "$d/old.key" 2>/dev/null; then push_new_key "$n" "$d/old.pub" "$auto"; ssh-add -q -d "$d/old.pub" 2>/dev/null; fi
  return 0
}
secret_manager(){
  local items keys n i c d lk hdr vs
  while :; do
    ensure_index; items=(); keys=(); at "$(t secrets_title)"
    for n in $(secret_names); do
      [ ${#keys[@]} -eq 0 ] && items+=("#$(t sec_secrets)")
      c=$(secret_users "$n" | grep -c .); if [ "$c" = 0 ]; then d=$(t sc_unused); else d=$(t sc_users "$c"); fi
      d="$(secret_label "$n") · $d"; [ "$(secret_meta "$n" type)" = key ] && d="$d · $(secret_meta "$n" fp | cut -c1-17)…"
      items+=("$n|$d"); keys+=("s:$n"); done
    c=${#keys[@]}
    items+=("$(t login_add_vault)"); keys+=(add)
    lk=$(legacy_keys | grep -c .)
    [ "$lk" -gt 0 ] && { items+=("$(t act_migrate)|$(t act_migrate_hint "$lk")"); keys+=(migrate); }
    vault_exists && { items+=("#$(t sec_vault)" "$(t act_vault)|$(t act_vault_hint)"); keys+=(vault); }
    if vault_exists; then if kc_get >/dev/null 2>&1; then hdr=$(t vault_open "$(kc_label)"); else hdr=$(t vault_locked); fi; else hdr=$(t vault_none); fi
    [ "$c" -gt 0 ] || hdr="$hdr$NL$(t secrets_empty)"
    i=$(ui_menu "$hdr" "${items[@]}") || return 0
    if [ "${keys[$i]}" = add ]; then
      at "$(t secrets_title)|$(t login_add_vault)"
      vs=$(UI_HEAD="$(t secrets_add_intro)" ui_choice "$(t login_add_vault)" "$(t act_key_file)" "$(t act_key_paste)|$(t act_key_paste_hint)" "$(t act_key_new)|ed25519" "$(t act_pw_new)") || continue
      case $vs in 0) keys[$i]=file;; 1) keys[$i]=clip;; 2) keys[$i]=gen;; 3) keys[$i]=pass;; *) continue;; esac
    fi
    case ${keys[$i]} in
      s:*) secret_actions "${keys[$i]#s:}" && return 0;;
      migrate) clear; title "$(t secrets_title)|$(t act_migrate)"; migrate_keys; pause;;
      clip) clear; title "$(t secrets_title)|$(t act_key_paste)"; n=$(secret_add_key clip) && ok "$(t secrets_saved "$n")"; pause;;
      file) at "$(t secrets_title)|$(t act_key_file)"; n=$(pick_key_file) || continue
            shown; n=$(secret_add_key "$n") && ok "$(t secrets_saved "$n")"; pause;;
      gen) at "$(t secrets_title)|$(t act_key_new)"
           vault_init && n=$(ask_secret_name "") && secret_add_key gen "$n" >/dev/null && { shown; ok "$(t sc_pub_of "$n")"; cat "$SEC/$n.pub"; pause; };;
      pass) at "$(t secrets_title)|$(t act_pw_new)"; n=$(secret_add_password) && ok "$(t secrets_saved "$n")"; pause;;
      vault) at "$(t secrets_title)|$(t act_vault)"
             vs=$(ui_menu "" "$(t vault_passwd)" "$(t vault_recovery)|$(t vault_recovery_hint)" "$(t vault_lock)|$(t vault_lock_hint)" "$(t vault_unlock)|$(t vault_unlock_hint)") || continue
             shown
             case $vs in 0) vault_passwd; pause;; 1) vault_recovery_code;; 2) cmd_lock --forget; pause;; 3) cmd_unlock; pause;; esac;;
    esac
  done
}
secret_actions(){ # return 0 to leave the Secrets screen entirely and return to search
  local n=$1 type users hdr items keys i
  type=$(secret_meta "$n" type); users=$(secret_users "$n" | tr '\n' ' '); at "$(t secrets_title)|$n"
  hdr="$C0$CD$(secret_label "$n")$( [ "$type" = key ] && echo " · $(secret_meta "$n" fp)") · $(t sc_created "$(secret_meta "$n" created)")"$'\n'"$(t sc_used_by "${users:-$(t sc_none)}")"
  items=("#$(t sec_view)" "$(t act_sc_users)|$(t act_sc_users_hint "$n")"); keys=(users)
  if [ "$type" = key ]; then
    items+=("#$(t sec_edit)" "$(t act_copy_pub)" "$(t act_replace_clip)" "$(t act_replace_file)" "$(t act_replace_new)" "$(t act_sc_edit)" "$(t act_rename)"); keys+=(pub rclip rfile rgen edit rename)
  else items+=("#$(t sec_edit)" "$(t act_pw_change)" "$(t act_sc_edit)" "$(t act_rename)"); keys+=(pw edit rename); fi
  items+=("#$(t sec_danger)" "!$(t act_sc_delete)|$(t act_delete_hint)"); keys+=(delete)
  i=$(ui_menu "$hdr" "${items[@]}") || return 1
  case ${keys[$i]} in
    users) SECRET_QUERY="secret:$n"; return 0;;
    pub) shown; cat "$SEC/$n.pub" | copy && ok "$(t done_pub_copied)"; pause;;
    rclip) shown; secret_replace "$n" clip; pause;; rfile) shown; secret_replace "$n" file; pause;; rgen) shown; secret_replace "$n" gen; pause;;
    pw) shown; secret_set_password "$n"; pause;; edit) shown; secret_edit "$n"; pause;;
    rename) secret_rename "$n";; delete) secret_delete "$n";;
  esac
  return 1
}
secret_rename(){
  local n=$1 m users prev; users=$(secret_users "$n" | tr '\n' ' '); at "$(t secrets_title)|$n|$(t act_rename)"
  prev="$n ${CD}→$C0 $CP$CB%s$C0"; [ -z "$users" ] || prev="$prev"$'\n'"$CD$(t secret_rename_users "$users")$C0"
  m=$(ask_secret_name "$n" "$prev" "$n") || return 1
  [ "$m" = "$n" ] && return 0
  apply_change "$(t done_secret_renamed "$n" "$m")" secret_rename_raw "$n" "$m"
}
secret_delete(){
  local n=$1 users lines=() h prod=; users=$(secret_users "$n" | tr '\n' ' '); at "$(t secrets_title)|$n|$(t act_sc_delete)"
  for h in $users; do is_prod "$h" && prod=1; done
  lines=("$CB$(t delete_removes)$C0" "  • $(t secret_delete_line "$n" "$(secret_label "$n")")")
  [ -z "$users" ] || lines+=("  ${CR}• $(t secret_delete_users "$users")$C0")
  lines+=(" " "$CB$(t delete_keeps)$C0" "  • $(t secret_delete_keeps)" " " "$CD$(t delete_undo)$C0")
  if [ -n "$prod" ]; then   # a PROD server uses it: type the name, so enter alone can never delete it
    UI_TONE=danger UI_ENTER=$(t key_delete) ui_field "$(t delete_type_label "$n")" "" "equals:$n" "$(t secret_delete_type_rule "$n")" "" "$(printf '%s\n' "${lines[@]}")" >/dev/null || return 1
  else
    ui_confirm --danger --default=false --affirmative "$(t secret_delete_yes "$n")" --negative "$(t cancel)" "$(t secret_delete_q "$n")" "${lines[@]}" || return 1
  fi
  apply_change "$(t done_secret_deleted "$n")" secret_delete_raw "$n"
}

# ---------- connections and error reporting ----------
CTO=${HOSTBOOK_CONNECT_TIMEOUT:-}; [ -n "$CTO" ] || cfg connect_timeout 15 CTO   # maximum connection wait in seconds (the system default can be as long as 75 seconds)
# Watch "ssh -v" logs and show a single progress line with the current stage and elapsed time.
# The progress line sits above the cursor and is updated using cursor save/restore (ESC 7 / ESC 8),
# so it cannot overwrite password or host-key prompts that SSH has already printed below.
conn_line(){ printf '\0337\033[1A\r\033[K%s\0338' "$1" >/dev/tty; }
conn_progress(){ # log ip port jump-host name
  local log=$1 ip=$2 port=$3 jump=$4 n=$5 t0 el k=0 sp='⣾⣽⣻⢿⡿⣟⣯⣷' need=1 msg tail cols rp au ce
  cols=$(term_cols)   # progress must fit on one line; wrapping would make "move up one line to update" print duplicates
  trap 'cols=$(term_cols)' WINCH   # tmux resizes the pane: refresh the width on SIGWINCH instead of forking stty every tick
  [ -n "$jump" ] && need=2   # a jump host means two "server responded" events: the jump host, then the destination
  t0=$SECONDS; sleep 0.3   # wait for tmux to finish arranging panes before drawing the first box
  while :; do
    el=$(( SECONDS - t0 ))
    # One awk pass per tick: counts of "Remote protocol version", "Authenticated to" and "Connection established"
    read -r rp au ce <<EOF
$(awk '/Remote protocol version/{r++} /Authenticated to/{a++} /Connection established/{c++} END{print r+0, a+0, c+0}' "$log" 2>/dev/null)
EOF
    if [ "${rp:-0}" -ge $need ]; then
      tv msg cp_ok "$n" "$el"; [ $(( ${#msg} + 3 )) -gt "$cols" ] && tv msg cp_ok_s "$n" "$el"
      conn_line "$(printf "%s${ICON_OK}%s %s" "$CG" "$C0" "$msg")"; : > "$log.done"; return 0; fi
    if [ "$el" -ge $((CTO + 3)) ]; then   # fallback deadline: SSH does not apply its timeout while connecting through the jump host
      echo "hostbook: timeout after ${CTO}s" >> "$log"; pkill -TERM -P $$ -x ssh 2>/dev/null; return 0; fi
    if [ -n "$jump" ]; then
      if [ "${au:-0}" -gt 0 ]; then tv msg cp_jump_in "$jump" "$ip" "$port"; else tv msg cp_jump_to "$jump"; fi
    elif [ "${ce:-0}" -gt 0 ]; then tv msg cp_net "$ip" "$port"
    else tv msg cp_open "$ip" "$port"; fi
    tv tail prog_tail "$el" "$CTO"
    [ $(( ${#msg} + ${#tail} + 3 )) -gt "$cols" ] && tv tail prog_tail_short "$el" "$CTO"
    [ $(( ${#msg} + ${#tail} + 3 )) -gt "$cols" ] && msg=${msg:0:$(( cols - ${#tail} - 4 ))}…
    conn_line "$(printf '%s%s%s %s%s%s%s' "$CP" "${sp:k%8:1}" "$C0" "$msg" "$CD" "$tail" "$C0")"
    k=$((k+1)); sleep 0.15
  done
}
# Connect and show each stage. Return the SSH exit code. $2=pane: running in a tmux pane, so do not open a menu.
connect(){
  local n=$1 pane=${2:-} log rc jump ip port t0 wp
  prepare_login "$n" || { [ -z "$pane" ] && pause; return 1; }
  log=$(mktemp); jump=$(host_field "$n" 6); ip=$(host_field "$n" 3); port=$(host_field "$n" 5); port=${port:-22}
  record "$n"
  printf '%s→ ssh %s%s%s%s\n' "$CB" "$n" "$C0" "$CD$([ -z "$jump" ] || t conn_via "$jump")$C0" "$(is_prod "$n" && printf "   %s${ICON_PROD} PROD%s" "$CR$CB" "$C0")"
  t0=$(date +%s); printf '\n' >/dev/tty   # blank line reserves space for connection progress
  ( conn_progress "$log" "$ip" "$port" "$jump" "$n" ) & wp=$!
  trap 'true' INT   # Ctrl-C cancels SSH without exiting hostbook
  ssh_login "$n" -v -E "$log" -o ConnectTimeout="$CTO" "$n" 2>>"$log"; rc=$?   # send stderr to the log; password/host-key prompts still appear through /dev/tty
  trap - INT
  kill $wp 2>/dev/null; wait $wp 2>/dev/null
  [ -f "$log.done" ] || printf '\033[1A\r\033[K' >/dev/tty   # server not reached: remove progress so the error box can take its place
  local need=1 entered=0; [ -n "$jump" ] && need=2   # the SSH subprocess for the jump host also logs these milestones once
  [ "$(grep -c 'Entering interactive session' "$log")" -ge $need ] && entered=1
  if { [ $rc -eq 255 ] || grep -q 'hostbook: timeout' "$log"; } && [ $entered = 0 ]; then explain "$n" "$log" "$pane"; rc=255
  elif [ $entered = 1 ]; then
    local m=$(( ($(date +%s) - t0) / 60 )) msg
    msg=$(t conn_end "$n" "$( [ $m -gt 0 ] && t conn_min "$m" || t conn_lt_min)")$( [ $rc -ne 0 ] && [ $rc -ne 255 ] && t conn_rc "$rc")
    printf '%s← %s%s\n' "$CD" "$msg" "$C0"; flash "${CD}$msg${C0}"
  fi
  rm -f "$log" "$log.done"; return $rc
}
# Read the connection log: stages reached, failure point, and cause.
explain(){ # name log [pane]
  local n=$1 f=$2 pane=${3:-} ip user key port j kind="" net=0 banner=0 auth=0 jump_ok=0 need=1 raw lines=() acts=() labels=() b
  ip=$(host_field "$n" 3); user=$(host_field "$n" 4); key=$(host_field "$n" 7); port=$(host_field "$n" 5); port=${port:-22}; j=$(host_field "$n" 6)
  local sc sctype=""; sc=$(host_field "$n" 12); [ -n "$sc" ] && sctype=$(secret_meta "$sc" type); [ -n "$sc" ] && key="secret $sc"
  [ -n "$j" ] && need=2
  grep -q 'Connection established' "$f" && net=1
  [ "$(grep -c 'Remote protocol version' "$f")" -ge $need ] && banner=1
  [ -n "$j" ] && grep -q 'Authenticated to' "$f" && jump_ok=1   # the first "Authenticated to" event belongs to the jump host
  if grep -qiE 'IDENTIFICATION HAS CHANGED|Host key verification failed' "$f"; then kind=hostkey
  elif grep -qi 'Permission denied' "$f" && [ "$sctype" = key ] && ! ssh-add -l 2>/dev/null | grep -qF "$(secret_meta "$sc" fp)"; then kind=locked   # the secret key is not loaded in the agent
  elif grep -qi 'Permission denied' "$f"; then kind=denied
  elif grep -qi 'Could not resolve hostname' "$f"; then kind=dns
  elif grep -qi 'Connection refused' "$f"; then kind=refused
  elif grep -qiE 'No route to host|Network is unreachable|Host is down' "$f"; then kind=unreachable
  elif grep -qiE 'timed out|hostbook: timeout' "$f"; then kind=timeout
  elif grep -qiE 'Connection closed|Connection reset|kex_exchange_identification|Broken pipe' "$f"; then kind=closed
  else kind=cancel; fi
  raw=$(tr -d '\r' < "$f" | grep -vE '^(debug[0-9]|OpenSSH_|Warning: Permanently added|Killed by signal)' | grep . | tail -2 | tr '\n' ' ' | sed 's/ $//')   # SSH logs "\r\n": remove \r so the cursor cannot return to the start and break the box
  [ $kind = cancel ] && [ -z "$raw" ] && { flash "${CD}$(t ex_cancelled "$n")${C0}"; return 0; }
  # connection stages: ✓ completed, ✗ failed here, · not reached
  st(){ if [ "$1" = 1 ]; then printf "%s${ICON_OK}%s %s" "$CG" "$C0" "$2"; elif [ "$1" = x ]; then printf "%s${ICON_ERR} %s%s" "$CR" "$2" "$C0"; else printf '%s· %s%s' "$CD" "$2" "$C0"; fi; }
  local s1 s2 s3 s0=""
  if [ -n "$j" ]; then
    s0=$(st $([ $jump_ok = 1 ] && echo 1 || echo x) "$(t ex_st_jump "$j")")
    s1=$(st $([ $banner = 1 ] && echo 1 || { [ $jump_ok = 1 ] && echo x || echo -; }) "$(t ex_st_hop "$j" "$ip" "$port")")
  else
    s1=$(st $([ $net = 1 ] && echo 1 || echo x) "$(t ex_st_net "$ip" "$port")")
  fi
  s2=$(st $([ $banner = 1 ] && echo 1 || { { [ $net = 1 ] || [ $jump_ok = 1 ]; } && [ -z "$j" ] && echo x || echo -; }) "$(t ex_st_ssh)")
  s3=$(st $([ $banner = 1 ] && echo x || echo -) "$(t ex_st_login "$user")")
  [ $kind = hostkey ] && s3=$(st x "$(t ex_st_hostkey)")
  echo
  case $kind in
    hostkey) lines=("${CR}$(t ex_hk_title "$n")${C0}" "$(t ex_hk_1)" "$(t ex_hk_2)" "${CR}$(t ex_hk_3)${C0}");;
    locked)  lines=("${CY}$(t ex_lk_title)${C0}" "$(t ex_lk_1 "$sc")");;
    denied)  if [ "$sctype" = password ]; then lines=("${CY}$(t ex_dn_title "$n")${C0}" "$(t ex_dn_tried_pw "$user" "$sc")" "• $(t ex_dn_b_pw_stale)")
             elif grep -q 'Next authentication method: password\|Next authentication method: keyboard' "$f"; then
               lines=("${CY}$(t ex_dn_title "$n")${C0}" "$(t ex_dn_tried_key_pw "$user" "${key/#$HOME/~}")" "• $(t ex_dn_b_pw_wrong)" "• $(t ex_dn_b_key_missing)")
             else lines=("${CY}$(t ex_dn_title "$n")${C0}" "$(t ex_dn_tried_key "$user" "${key/#$HOME/~}")" "• $(t ex_dn_b_pub)" "• $(t ex_dn_b_user)"); fi;;
    dns)     lines=("${CY}$(t ex_dns "$ip")${C0}" "• $(t ex_dns_b)");;
    refused) lines=("${CY}$(t ex_rf "$ip" "$port")${C0}" "• $(t ex_rf_b1)" "• $(t ex_rf_b2)");;
    unreachable) lines=("${CY}$(t ex_ur "$ip")${C0}" "• $(t ex_vpn)");;
    timeout) if [ -n "$j" ] && [ $jump_ok = 1 ]; then lines=("${CY}$(t ex_to_hop "$j" "$ip" "$port" "$CTO")${C0}" "• $(t ex_to_hop_b1)" "• $(t ex_to_hop_b2 "$j")")
             elif [ -n "$j" ]; then lines=("${CY}$(t ex_to_jump "$j" "$CTO")${C0}" "• $(t ex_to_jump_b1 "$j")" "• $(t ex_to_jump_b2 "$j")")
             elif [ $net = 1 ]; then lines=("${CY}$(t ex_to_nossh "$ip" "$port" "$CTO")${C0}" "• $(t ex_to_nossh_b)")
             else lines=("${CY}$(t ex_to_none "$ip" "$port" "$CTO")${C0}" "• $(t ex_vpn)" "• $(t ex_to_none_b)"); fi;;
    closed)  lines=("${CY}$(t ex_cl "$n")${C0}" "• $(t ex_cl_b1)" "• $(t ex_cl_b2)");;
    *)       lines=("${CY}$(t ex_other "$n")${C0}");;
  esac
  box warn "${lines[@]}" "" ${s0:+"$s0"} "$s1" "$s2" "$s3" ${raw:+"${CD}$(t ex_ssh_says "$raw")${C0}"}
  if [ -n "$pane" ]; then return 0; fi
  if [ $kind = hostkey ]; then
    case $(pick "$(t chk_next)" "$(t act_ex_back)|$(t ex_safe)" "$(t act_ex_hostkey)") in
      1) ssh-keygen -R "$ip" >/dev/null 2>&1; ssh-keygen -R "[$ip]:$port" >/dev/null 2>&1; ssh-keygen -R "$n" >/dev/null 2>&1; connect "$n";; esac; return 0
  fi
  acts=(retry edit)
  [ $kind = locked ] && acts=(unlock)
  [ $kind = denied ] && [ "$sctype" = key ] && acts+=(copypub)
  [ $kind = denied ] && [ "$sctype" = password ] && acts+=(setpw)
  [ $kind = denied ] && acts+=(login)
  acts+=(log back)
  for b in "${acts[@]}"; do case $b in
    retry) labels+=("$(t act_ex_retry)");; edit) labels+=("$(t act_ex_edit)");; unlock) labels+=("$(t act_ex_unlock)");;
    copypub) labels+=("$(t act_ex_copy_pub "$sc")");; setpw) labels+=("$(t act_ex_pw_change "$sc")");; login) labels+=("$(t act_login)");;
    log) labels+=("$(t act_ex_log)");; *) labels+=("$(t act_ex_back)");; esac; done
  local logcopy; logcopy=$(mktemp); cp "$f" "$logcopy"
  while :; do
    case ${acts[$(pick "$(t chk_next)" "${labels[@]}" || echo 99)]:-} in
      retry) rm -f "$logcopy"; connect "$n"; return 0;;
      edit) rm -f "$logcopy"; edit_host "$n"; return 0;;
      unlock) rm -f "$logcopy"; cmd_unlock && connect "$n"; return 0;;
      copypub) cat "$SEC/$sc.pub" | copy && ok "$(t ex_pub_copied "$user")";;
      setpw) secret_set_password "$sc";;
      login) rm -f "$logcopy"; change_login "$n"; return 0;;
      log) { title "${UI_AT:+$UI_AT|}$(t chk_log_title)"; grep -vE '^debug[0-9]: (Reading|/|channel|client_input|pledge|kex|SSH2_MSG|expecting|rekey|setting up|identity file|Local version|compat|Skipping|load_hostkeys|checking match|hostkeys_find|get_agent|fd [0-9])' "$logcopy" | sed "s|$HOME|~|g"; } | less -R;;
      *) rm -f "$logcopy"; return 0;;
    esac
  done
}
# ---------- adding and editing ----------
# Suggestions for a new server: score existing servers by similarity, then infer the project and field values.
# Print TSV: project<TAB>name<TAB>score<TAB>confidence<TAB>reason   (up to three, score >= 15, descending)
#            peer<TAB>name<TAB>score<TAB>reason                   (closest server, when score >= 60)
#            auto<TAB>0|1                                       (1 = confident enough to select the top project)
#            group<TAB>project used to infer fields (argument 5, or the top project)
#            field<TAB>user|port|jump|secret|tags|prefix<TAB>value<TAB>reason
suggest(){ # address name user port [project]
  local r24 r16 tail dom pfx word prt usr cnt like me jmp sec tg tg2
  ensure_index
  tv r24 sg_r24; tv r16 sg_r16; tv tail sg_tail; tv dom sg_dom; tv pfx sg_pfx; tv word sg_word; tv prt sg_port; tv usr sg_user
  tv cnt sg_cnt; tv like sg_like; tv me sg_me; tv jmp sg_jump; tv sec sg_sec; tv tg sg_tags; tv tg2 sg_tags2
  LC_ALL=C awk -F'\t' -v sg_r24="$r24" -v sg_r16="$r16" -v sg_tail="$tail" -v sg_dom="$dom" -v sg_pfx="$pfx" -v sg_word="$word" -v sg_port="$prt" \
    -v sg_user="$usr" -v sg_cnt="$cnt" -v sg_like="$like" -v sg_me="$me" -v sg_jump="$jmp" -v sg_sec="$sec" -v sg_tags="$tg" -v sg_tags2="$tg2" -v ip="$1" -v name="$2" -v user="$3" -v port="$4" -v force="${5:-}" -v me="$ME" -v now="$(date +%s)" '
    function isip(h){ return h ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ }
    function rest(h){ if (index(h,".")==0) return ""; return substr(h, index(h,".")+1) }
    function base(h,  n,a){ n=split(h,a,"."); if (n>=3 && length(a[n])==2 && length(a[n-1])<=3) return a[n-2] "." a[n-1] "." a[n]; if (n>=2) return a[n-1] "." a[n]; return h }
    function pfx(s,  c){ if (match(s, /[-._0-9]/)) { if (RSTART==1) return ""; c=substr(s,RSTART,1); return substr(s,1,RSTART-1) (c ~ /[-._]/ ? c : "") } return "" }
    function addlab(nm,l,w){ L[nm]=L[nm] (L[nm]==""?"":"|") l; if (!(l in LW)) { LW[l]=w; LO[++nl]=l } }
    function dots(v){ return v>=80 ? "●●●" : (v>=45 ? "●●○" : "●○○") }
    FILENAME==ARGV[1] { if (now-$1 < 604800) recent[$2]=1; next }
    { n=$1; N++; nm[N]=n; P[n]=$2; U[n]=$4; J[n]=$6; SC[n]=$12; TG[n]=$8
      if (!($2 in pseen)) { pseen[$2]=1; po[++np]=$2 }
      m=split($8,t," "); for (i=1;i<=m;i++) pool[t[i]]=1
      a=0
      if (isip(ip) && isip($3)) { split(ip,x,"."); split($3,y,".")
        if (x[1]==y[1] && x[2]==y[2] && x[3]==y[3]) { a=50; addlab(n, sprintf(sg_r24, x[1] "." x[2] "." x[3]), 50) }
        else if (x[1]==y[1] && x[2]==y[2]) { a=15; addlab(n, sprintf(sg_r16, x[1] "." x[2]), 15) } }
      else if (!isip(ip) && !isip($3) && index(ip,".")) {
        if (index(rest(ip),".") && rest(ip)==rest($3)) { a=55; addlab(n, sprintf(sg_tail, rest(ip)), 55) }
        else if (base(ip)==base($3)) { a=40; addlab(n, sprintf(sg_dom, base(ip)), 40) } }
      AD[n]=a; s=a
      if (name!="") { p1=pfx(name); p2=pfx(n)
        if (p1!="" && p1==p2) { s+=40; addlab(n, sprintf(sg_pfx, p1), 40) }
        c=0; m=split(tolower(name),t,/[-_.0-9]+/); k=split(tolower(n),q,/[-_.0-9]+/)
        for (i=(p1!=""?2:1); i<=m && c<2; i++) if (t[i]!="") for (j=(p2!=""?2:1); j<=k; j++) if (q[j]==t[i]) { s+=10; c++; addlab(n, sprintf(sg_word, t[i]), 10); break } }
      if (port!="" && port!="22" && $5==port) { s+=10; addlab(n, sprintf(sg_port, port), 10) }
      if (user!="" && $4==user) { s+=10; addlab(n, sprintf(sg_user, user), 10) }
      if (s>0 && (n in recent)) s+=5
      S[n]=s }
    END {
      # project score = sum of the top three server scores, divided by 1.5
      for (i=1;i<=N;i++) { n=nm[i]; p=P[n]; v=S[n]
        if (v>T1[p]) { T3[p]=T2[p]; T2[p]=T1[p]; T1[p]=v } else if (v>T2[p]) { T3[p]=T2[p]; T2[p]=v } else if (v>T3[p]) T3[p]=v
        if (v>0) { m=split(L[n],t,"|"); for (j=1;j<=m;j++) LC[p SUBSEP t[j]]++ } }
      for (i=1;i<=np;i++) PS[po[i]]=(T1[po[i]]+T2[po[i]]+T3[po[i]])/1.5
      top=""; second=0
