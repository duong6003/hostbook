# ---------- deleting, renaming, and moving projects ----------
# block_range name → "start end": the Host block, including preceding "# tags:"/"# desc:" lines, excluding trailing blank lines
block_range(){ local f l; f=$(host_field "$1" 10); l=$(host_field "$1" 11)
