    NR>=s && NR<=e {
      k=tolower($1); skip=0
      if ($0 ~ /^[ \t]*#[ \t]*secret:/ || k=="identityfile" || k=="identitiesonly") skip=1
      if (oldpw && (k=="pubkeyauthentication" || k=="preferredauthentications")) skip=1
