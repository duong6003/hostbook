# A killed run leaves $STATE/tmp/<pid>.* behind, and those can hold decrypted secrets: remove the ones whose pid is gone.
sweep_tmp(){
  local d p
  for d in "$STATE/tmp"/*; do
    [ -e "$d" ] || continue
    p=${d##*/}; p=${p%%.*}
    case $p in ''|*[!0-9]*) continue;; esac
    kill -0 "$p" 2>/dev/null || rm -rf "$d"   # a live pid (including ours) keeps its entries
  done
}

