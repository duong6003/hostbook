    { cat "$initial/header"; printf 'Include %s\n' "$(ssh_path "$DIR/*.conf")"; cat "$initial/global"; } > "$initial/validate" || return 1
    ssh -F "$initial/validate" -G hostbook-validate-probe >/dev/null 2>&1 || return 1
    newcfg=$(mktemp "$HOME/.ssh/.hostbook-config.XXXXXX") || return 1
    { cat "$initial/header"; printf 'Include ~/ssh-hosts/*.conf\n'; cat "$initial/global"; } > "$newcfg" && chmod 600 "$newcfg" || { rm -f "$newcfg"; return 1; }
    IMPORT_KEEP_GLOBAL=1 IMPORT_HEADER="$initial/header" IMPORT_TAIL="$initial/global" import_config_file "$initial/import" || { rm -f "$newcfg"; return 1; }
    cmp -s "$initial/original" "$HOME/.ssh/config" || { rm -f "$newcfg"; return 1; }
    backup=$(mktemp "$HOME/.ssh/config.bak.XXXXXX") || { rm -f "$newcfg"; return 1; }
    cp -p "$initial/original" "$backup" && mv "$newcfg" "$HOME/.ssh/config" || { rm -f "$newcfg"; return 1; }
    ok "$(t first_imported "$(grep -c . "$STATE/last-import")")"
